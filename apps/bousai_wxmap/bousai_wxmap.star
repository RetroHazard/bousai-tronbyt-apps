# ---- src/lib/bousai_core.star ----------------------------------------------

BOUSAI_JST = "Asia/Tokyo"
BOUSAI_UA = {"User-Agent": "bousai-tronbyt-apps (+https://www.jma.go.jp/)"}

BOUSAI_DEFAULT_LOCATION = json.encode({
    "lat": "35.6812",
    "lng": "139.7671",
    "description": "Tokyo Station, Chiyoda, Tokyo, Japan",
    "locality": "Chiyoda",
    "timezone": "Asia/Tokyo",
})

BOUSAI_CLASS20_BOXES = "https://www.jma.go.jp/bosai/common/const/class20relm.json"
BOUSAI_CLASS20_SHAPE = "https://www.jma.go.jp/bosai/common/const/geojson/class20s/%s.json"
BOUSAI_AREA_JSON = "https://www.jma.go.jp/bosai/common/const/area.json"

# ---------------------------------------------------------------------------
# HTTP

def bousai_get_json(url, ttl = 60, params = None):
    """GET url and decode JSON. Returns None on transport-level non-200 or bad JSON."""
    resp = http.get(url, params = params or {}, headers = BOUSAI_UA, ttl_seconds = ttl)
    if resp.status_code != 200:
        return None
    return json.decode(resp.body(), default = None)

def bousai_get_bytes(url, ttl = 60):
    resp = http.get(url, headers = BOUSAI_UA, ttl_seconds = ttl)
    if resp.status_code != 200:
        return None
    return resp.body()

def bousai_guarded_get(url, ttl = 60, params = None, cooldown = 300):
    """GET from a host that may stall, without crash-looping. Returns the body or None.

    A transport error or Pixlet's 5 s HTTP timeout aborts the whole render and Starlark
    cannot catch it. So a "pending:<unix time>" marker is cached before the request and cleared
    after it. A marker older than the HTTP timeout found at the start means an earlier attempt
    died mid-request: the host is then skipped (None) for `cooldown` seconds. A younger marker
    is a concurrent render still in flight and is ignored. Use for third-party feeds (Wolfx,
    P2PQuake, NIED); keep cooldown above the app's render interval.
    """
    key = "bousai_guard:" + url.split("/")[2]
    state = cache.get(key) or ""
    now = time.now().unix
    if state == "down":
        return None
    if state.startswith("pending:") and now - int(state[8:]) > 6:
        cache.set(key, "down", ttl_seconds = cooldown)
        return None
    cache.set(key, "pending:%d" % now, ttl_seconds = cooldown)
    resp = http.get(url, params = params or {}, headers = BOUSAI_UA, ttl_seconds = ttl)
    cache.set(key, "ok", ttl_seconds = 1)
    if resp.status_code != 200:
        return None
    return resp.body()

def bousai_guarded_json(url, ttl = 60, params = None, cooldown = 300):
    """bousai_guarded_get + JSON decode (None on any failure)."""
    body = bousai_guarded_get(url, ttl, params, cooldown)
    return json.decode(body, default = None) if body != None else None

# ---------------------------------------------------------------------------
# Schema

def bousai_schema(fields, location = True, location_desc = "Your location in Japan. Matched to a JMA municipality on the server using JMA's own area polygons; coordinates are never sent anywhere."):
    """Build the app schema: optional location, app fields, then accessibility fields."""
    out = []
    if location:
        out.append(schema.Location(id = "location", name = "Location", desc = location_desc, icon = "locationDot"))
        out.append(schema.Text(id = "area_override", name = "JMA area code (optional)", desc = "7-digit JMA municipality code (e.g. 1310100). Overrides the location lookup.", icon = "mapPin", default = ""))
    out.extend(fields)
    out.extend(bousai_accessibility_fields())
    return schema.Schema(version = "1", fields = out)

def bousai_accessibility_fields():
    return [
        schema.Dropdown(id = "theme", name = "Theme", desc = "Dark or light display theme.", icon = "circleHalfStroke", default = "dark", options = [
            schema.Option(display = "Dark", value = "dark"),
            schema.Option(display = "Light", value = "light"),
        ]),
        schema.Dropdown(id = "palette", name = "Colour vision", desc = "Colour scheme optimised for your colour vision. Levels are always also shown as text.", icon = "eye", default = "normal", options = [
            schema.Option(display = "Normal vision", value = "normal"),
            schema.Option(display = "Protanopia / Deuteranopia (red-green)", value = "protan"),
            schema.Option(display = "Tritanopia (blue-yellow)", value = "tritan"),
            schema.Option(display = "Monochromacy", value = "mono"),
        ]),
        schema.Dropdown(id = "contrast", name = "Contrast", desc = "Low is calmer and paler; high gives brighter text and frames.", icon = "circleHalfStroke", default = "normal", options = [
            schema.Option(display = "Low", value = "low"),
            schema.Option(display = "Normal", value = "normal"),
            schema.Option(display = "High", value = "high"),
        ]),
        schema.Dropdown(id = "text_size", name = "Text size", desc = "Larger text shows fewer lines per page.", icon = "textHeight", default = "standard", options = [
            schema.Option(display = "Small", value = "small"),
            schema.Option(display = "Standard", value = "standard"),
            schema.Option(display = "Large", value = "large"),
            schema.Option(display = "Extra large", value = "xlarge"),
        ]),
        schema.Dropdown(id = "text_weight", name = "Text weight", desc = "Bold draws each glyph one pixel wider.", icon = "bold", default = "normal", options = [
            schema.Option(display = "Normal", value = "normal"),
            schema.Option(display = "Bold", value = "bold"),
        ]),
    ]

def bousai_bool(config, key, default = False):
    v = config.get(key)
    if v == None or v == "":
        return default
    return v == True or v == "true" or v == "True" or v == "1"

# ---------------------------------------------------------------------------
# Colour

def bousai_rgb(c):
    c = c.lstrip("#")
    if len(c) == 3:
        c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2]
    return (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))

def bousai_hex(rgb):
    """(r, g, b) -> '#rrggbb'. Pixlet's % has no width flags, so pad by hand."""
    digits = "0123456789abcdef"
    out = "#"
    for i in range(3):
        v = max(0, min(255, int(rgb[i])))
        out += digits[v // 16] + digits[v % 16]
    return out

def bousai_mix(a, b, t):
    """Blend colour a toward b by fraction t (0..1)."""
    x, y = bousai_rgb(a), bousai_rgb(b)
    return bousai_hex([x[i] + (y[i] - x[i]) * t for i in range(3)])

def bousai_luma(c):
    r, g, b = bousai_rgb(c)
    return 0.299 * r + 0.587 * g + 0.114 * b

def bousai_on(c):
    """Readable text colour (black or white) on background c."""
    return "#000000" if bousai_luma(c) > 140 else "#ffffff"

# Seismic intensity scale. Keys are normalised JMA labels.
BOUSAI_INTENSITY_ORDER = ["0", "1", "2", "3", "4", "5-", "5+", "6-", "6+", "7"]

BOUSAI_INTENSITY_PALETTES = {
    # JMA-like ramp tuned for LEDs.
    "normal": ["#5a6070", "#8899aa", "#3d8bff", "#22c39a", "#f5e15b", "#ffb020", "#ff7a00", "#ff2e2e", "#c8102e", "#c03cff"],
    # Okabe-Ito based: blue/yellow/orange/purple axis plus a luminance ramp, no red-green pairs.
    "protan": ["#5a6070", "#8899aa", "#56b4e9", "#0072b2", "#f0e442", "#e69f00", "#d55e00", "#cc79a7", "#a0307a", "#ffffff"],
    # Red/cyan axis plus luminance, no blue-yellow pairs.
    "tritan": ["#5a6070", "#8899aa", "#4dd0e1", "#00897b", "#ffcdd2", "#ff8a80", "#ff5252", "#d50000", "#8b0000", "#ffffff"],
    "mono": ["#3a3a3a", "#555555", "#707070", "#8a8a8a", "#a3a3a3", "#bcbcbc", "#cfcfcf", "#e0e0e0", "#efefef", "#ffffff"],
}

# Severity scale shared by warnings, tsunami, volcano and alerts:
# 0 none, 1 info/forecast, 2 advisory (Lv2), 3 warning (Lv3), 4 urgent warning (Lv4), 5 emergency (Lv5).
BOUSAI_SEVERITY_PALETTES = {
    "normal": ["#5a6070", "#3d8bff", "#f2e700", "#ff2800", "#c040c0", "#ff40ff"],
    "protan": ["#5a6070", "#56b4e9", "#f0e442", "#e69f00", "#cc79a7", "#ffffff"],
    "tritan": ["#5a6070", "#4dd0e1", "#ffcdd2", "#ff5252", "#d50000", "#ffffff"],
    "mono": ["#555555", "#8a8a8a", "#a3a3a3", "#c8c8c8", "#e6e6e6", "#ffffff"],
}

BOUSAI_SEVERITY_EN = ["None", "Info", "Advisory", "Warning", "Urgent Warning", "Emergency Warning"]

BOUSAI_FONTS = {
    # text_size: (body font, line height, big font for numbers)
    "small": ("CG-pixel-3x5-mono", 6, "tb-8"),
    "standard": ("tom-thumb", 7, "6x13"),
    "large": ("tb-8", 9, "6x13"),
    "xlarge": ("6x10", 11, "10x20"),
}

def bousai_ui(config):
    """Resolve accessibility settings into colours and fonts. Returns a dict."""
    theme = config.get("theme") or "dark"
    palette = config.get("palette") or "normal"
    if palette not in BOUSAI_SEVERITY_PALETTES:
        palette = "normal"
    contrast = config.get("contrast") or "normal"
    size = config.get("text_size") or "standard"
    if size not in BOUSAI_FONTS:
        size = "standard"
    bold = (config.get("text_weight") or "normal") == "bold"

    if theme == "light":
        bg, fg, muted, faint, panel = "#f4f4f4", "#000000", "#555555", "#c8c8c8", "#dddddd"
        land = -0.3
    else:
        bg, fg, muted, faint, panel = "#000000", "#ffffff", "#9a9a9a", "#3a3a3a", "#141414"
        land = -0.62

    sev = list(BOUSAI_SEVERITY_PALETTES[palette])
    inten = list(BOUSAI_INTENSITY_PALETTES[palette])
    if theme == "light":
        # Pull bright LED colours down so they stay readable on a light background.
        sev = [bousai_mix(c, "#000000", 0.3) for c in sev]
        inten = [bousai_mix(c, "#000000", 0.3) for c in inten]

    if contrast == "low":
        fg = bousai_mix(fg, bg, 0.3)
        muted = bousai_mix(muted, bg, 0.3)
        sev = [bousai_mix(c, bg, 0.35) for c in sev]
        inten = [bousai_mix(c, bg, 0.35) for c in inten]
        land = land - 0.1 if theme != "light" else land + 0.1
    elif contrast == "high":
        muted = bousai_mix(muted, fg, 0.45)
        faint = bousai_mix(faint, fg, 0.3)
        land = land + 0.15 if theme != "light" else land - 0.15

    font, line_h, big = BOUSAI_FONTS[size]
    return {
        "theme": theme,
        "palette": palette,
        "contrast": contrast,
        "size": size,
        "bold": bold,
        "bg": bg,
        "fg": fg,
        "muted": muted,
        "faint": faint,
        "panel": panel,
        "accent": sev[1],
        "sev": sev,
        "intensity": dict(zip(BOUSAI_INTENSITY_ORDER, inten)),
        "land_brightness": land,
        "frame": contrast == "high",
        "font": font,
        "line_h": line_h,
        "big_font": big,
        "small_font": "CG-pixel-3x5-mono" if size in ("small", "standard") else font,
        "delay": 100,
    }

# ---------------------------------------------------------------------------
# Text and layout

def bousai_text(ui, s, color = None, font = None):
    """Text honouring the bold setting."""
    font = font or ui["font"]
    color = color or ui["fg"]
    if not ui["bold"]:
        return render.Text(s, font = font, color = color)
    return render.Stack(children = [
        render.Text(s, font = font, color = color),
        render.Padding(pad = (1, 0, 0, 0), child = render.Text(s, font = font, color = color)),
    ])

def bousai_text_width(ui, s, font = None):
    w = render.Text(s, font = font or ui["font"]).size()[0]
    return w + (1 if ui["bold"] else 0)

def bousai_budget_frames():
    """Frames available for the whole animation (dwell time / 100 ms; 150 when unbounded)."""
    budget = canvas.max_duration_ms()
    if budget <= 0:
        budget = 15000
    return max(1, budget // 100)

def bousai_ticker(ui, s, width, color = None, font = None, frames = None):
    """Scroll text that is wider than `width` within exactly `frames` frames.

    Unlike render.Marquee (fixed 1 px/frame, so long text overruns the dwell time), the ticker
    pauses, scrolls at whatever speed fits the frame budget (never faster than needed), then holds.
    """
    frames = frames or bousai_budget_frames()
    text = bousai_text(ui, s, color, font)
    h = bousai_font_height(ui, font) + 1
    travel = bousai_text_width(ui, s, font) - width
    if travel <= 0 or frames < 2:
        return render.Box(width = width, height = h, child = render.Row(expanded = True, children = [text]))
    lead = min(8, frames // 4)
    tail = min(8, frames // 6)
    moving = max(1, frames - lead - tail)
    children = []
    for i in range(frames):
        step = max(0, i - lead)
        if travel <= moving:
            off = min(travel, step)
        else:
            off = min(travel, (step * travel + moving - 1) // moving)
        children.append(render.Box(width = width, height = h, child = render.Row(expanded = True, children = [render.Padding(pad = (-off, 0, 0, 0), child = text)])))
    return render.Animation(children = children)

def bousai_fit(ui, s, width = None, color = None, font = None, align = "start", frames = None):
    """One line of text; scrolls (bounded to `frames`, default the whole dwell) when wider than width."""
    width = width or canvas.width()
    if bousai_text_width(ui, s, font) <= width:
        return render.Box(width = width, height = bousai_font_height(ui, font) + 1, child = render.Row(main_align = align, expanded = True, children = [bousai_text(ui, s, color, font)]))
    return bousai_ticker(ui, s, width, color, font, frames)

def bousai_font_height(ui, font = None):
    return render.Text("Mg", font = font or ui["font"]).size()[1]

def bousai_header(ui, title, color = None, right = None, frames = None):
    """Title band. color is the band colour (defaults to panel); text picks a readable colour."""
    band = color or ui["panel"]
    text_color = bousai_on(band) if color else ui["fg"]
    h = ui["line_h"]
    width = canvas.width()
    right_w = 0
    children = []
    if right:
        right_w = bousai_text_width(ui, right) + 2
    children.append(render.Padding(pad = (1, 0, 0, 0), child = bousai_fit(ui, title, width = width - right_w - 1, color = text_color, frames = frames)))
    if right:
        children.append(render.Padding(pad = (width - right_w + 1, 0, 0, 0), child = bousai_text(ui, right, text_color)))
    return render.Box(width = width, height = h, color = band, child = render.Stack(children = children))

def bousai_row(ui, item, frames = None):
    """Normalise a row: str or (text, color) become a text line inset 1 px from the left edge
    (like the header title); a prebuilt widget is used as is."""
    if type(item) == "string":
        item = (item, None)
    if type(item) == "tuple" or type(item) == "list":
        line = bousai_fit(ui, item[0], width = canvas.width() - 1, color = item[1], frames = frames)
        return render.Padding(pad = (1, 0, 0, 0), child = line)
    return item

def bousai_hold_frames(pages, min_ms = 2500):
    """Frames per page when `pages` pages share the dwell time (at least min_ms each)."""
    return max(min_ms // 100, bousai_budget_frames() // max(1, pages))

def bousai_hold(widget, frames):
    """Keep widget on screen for at least `frames` frames (marquees keep scrolling)."""
    return render.Stack(children = [widget, render.Animation(children = [render.Box(width = 1, height = 1)] * max(1, frames))])

def bousai_pages(ui, header, rows, footer = None):
    """Paginate rows under a header to fit the text size. Returns a widget.

    header: None, a title string, a (title, band_color[, right_text]) tuple, or a prebuilt widget.
    rows: str | (text, color) | widget. Strings/tuples scroll within their page's share of the
    dwell time; prebuilt widgets are used as is (keep their animation within bousai_hold_frames).
    """
    height = canvas.height()
    header_h = ui["line_h"] if header != None else 0
    footer_h = ui["line_h"] if footer != None else 0
    per_page = max(1, (height - header_h - footer_h) // ui["line_h"])
    rows = rows or [("No data", ui["muted"])]
    n_pages = (len(rows) + per_page - 1) // per_page
    frames = bousai_hold_frames(n_pages) if n_pages > 1 else bousai_budget_frames()
    if type(header) == "string":
        header = bousai_header(ui, header, frames = frames)
    elif type(header) == "tuple" or type(header) == "list":
        header = bousai_header(ui, header[0], header[1] if len(header) > 1 else None, header[2] if len(header) > 2 else None, frames = frames)
    rows = [bousai_row(ui, r, frames) for r in rows]
    pages = []
    for i in range(0, len(rows), per_page):
        children = []
        if header != None:
            children.append(header)
        for r in rows[i:i + per_page]:
            children.append(render.Box(width = canvas.width(), height = ui["line_h"], child = r))
        body = render.Box(width = canvas.width(), height = height, child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = children))
        if footer != None:
            body = render.Stack(children = [body, render.Padding(pad = (0, height - footer_h, 0, 0), child = footer)])
        pages.append(body)
    if len(pages) == 1:
        return pages[0]
    return render.Sequence(children = [bousai_hold(p, frames) for p in pages])

def bousai_root(ui, child):
    return render.Root(delay = ui["delay"], child = render.Box(width = canvas.width(), height = canvas.height(), color = ui["bg"], child = child))

def bousai_message(ui, title, lines, color = None):
    """Full-screen notice (errors, 'no data', setup hints)."""
    return bousai_root(ui, bousai_pages(ui, (title, color), [(l, ui["muted"]) for l in lines]))

def bousai_badge(ui, label, color, width = None, font = None):
    """Coloured box with a centred label (colour is never the only cue)."""
    font = font or ui["font"]
    w = width or (bousai_text_width(ui, label, font) + 3)
    h = bousai_font_height(ui, font) + 2
    return render.Box(width = w, height = h, color = color, child = bousai_text(ui, label, bousai_on(color), font))

def bousai_blink(ui, widget, width, height, on_frames = 6, off_frames = 3):
    """Blinking emphasis; kept static in low-contrast mode to avoid stimulation."""
    if ui["contrast"] == "low":
        return widget
    return render.Animation(children = [widget] * on_frames + [render.Box(width = width, height = height)] * off_frames)

# ---------------------------------------------------------------------------
# Severity and seismic intensity

def bousai_sev_color(ui, level):
    return ui["sev"][max(0, min(5, level))]

def bousai_intensity_norm(v):
    """Normalise JMA / P2PQuake / EEW intensity notations to '0'..'7', '5-', '5+', '6-', '6+'. Unknown -> None."""
    if v == None:
        return None
    s = str(v).strip()
    table = {
        "5弱": "5-",
        "5強": "5+",
        "6弱": "6-",
        "6強": "6+",
        "5-": "5-",
        "5+": "5+",
        "6-": "6-",
        "6+": "6+",
        "5L": "5-",
        "5U": "5+",
        "6L": "6-",
        "6U": "6+",
        "10": "1",
        "20": "2",
        "30": "3",
        "40": "4",
        "45": "5-",
        "46": "5-",
        "50": "5+",
        "55": "6-",
        "60": "6+",
        "70": "7",
    }
    if s in table:
        return table[s]
    if s in BOUSAI_INTENSITY_ORDER:
        return s
    if s.startswith("震度"):
        return bousai_intensity_norm(s[2:])
    return None

def bousai_intensity_rank(label):
    """Index in BOUSAI_INTENSITY_ORDER, -1 for unknown."""
    if label in BOUSAI_INTENSITY_ORDER:
        return BOUSAI_INTENSITY_ORDER.index(label)
    return -1

def bousai_intensity_color(ui, label):
    return ui["intensity"].get(label, ui["muted"])

def bousai_intensity_from_value(x):
    if x < 0.5:
        return "0"
    if x < 1.5:
        return "1"
    if x < 2.5:
        return "2"
    if x < 3.5:
        return "3"
    if x < 4.5:
        return "4"
    if x < 5.0:
        return "5-"
    if x < 5.5:
        return "5+"
    if x < 6.0:
        return "6-"
    if x < 6.5:
        return "6+"
    return "7"

# ---------------------------------------------------------------------------
# Time

def bousai_now():
    return time.now().in_location(BOUSAI_JST)

def bousai_parse_time(s):
    """Parse JMA / P2PQuake / Wolfx / NIED timestamps (JST when no offset). Returns None if unparseable."""
    if not s:
        return None
    s = str(s).strip()
    if "T" in s and len(s) >= 19:
        if s.endswith("Z") or "+" in s[10:] or s[-6] == "-":
            return time.parse_time(s)
        return time.parse_time(s[:19], format = "2006-01-02T15:04:05", location = BOUSAI_JST)
    if len(s) == 14 and s.isdigit():
        return time.parse_time(s, format = "20060102150405", location = BOUSAI_JST)
    if len(s) >= 19 and s[4] == "/":
        return time.parse_time(s[:19], format = "2006/01/02 15:04:05", location = BOUSAI_JST)
    if len(s) == 16 and s[4] == "/":
        return time.parse_time(s, format = "2006/01/02 15:04", location = BOUSAI_JST)
    if len(s) >= 19 and s[4] == "-":
        return time.parse_time(s[:19], format = "2006-01-02 15:04:05", location = BOUSAI_JST)
    return None

def bousai_tz(config):
    loc = bousai_location(config)
    return loc["tz"]

def bousai_hhmm(t, tz = BOUSAI_JST):
    return t.in_location(tz).format("15:04") if t else "--:--"

def bousai_mdhm(t, tz = BOUSAI_JST):
    return t.in_location(tz).format("1/2 15:04") if t else "--"

def bousai_ago(t, now = None):
    """Compact relative age: 45s, 12m, 3h, 2d."""
    if not t:
        return "?"
    now = now or time.now()
    secs = int((now - t).seconds)
    if secs < 0:
        secs = 0
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm" % (secs // 60)
    if secs < 86400 * 2:
        return "%dh" % (secs // 3600)
    return "%dd" % (secs // 86400)

def bousai_fixed(x, digits = 1):
    """Format a number with exactly `digits` decimals (Starlark's % lacks precision)."""
    m = int(math.pow(10, digits))
    n = int(math.round(abs(float(x)) * m))
    sign = "-" if x < 0 and n != 0 else ""
    if digits <= 0:
        return sign + str(n)
    frac = str(n % m)
    return "%s%d.%s" % (sign, n // m, "0" * (digits - len(frac)) + frac)

# ---------------------------------------------------------------------------
# Geo

def bousai_distance_km(lat1, lon1, lat2, lon2):
    r = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = p2 - p1
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2) * math.sin(dp / 2) + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) * math.sin(dl / 2)
    return 2 * r * math.atan2(math.sqrt(a), math.sqrt(1 - a))

def bousai_bearing_name(lat1, lon1, lat2, lon2):
    """16-point compass direction from point 1 to point 2."""
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    deg = (math.degrees(math.atan2(y, x)) + 360.0) % 360.0
    names = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    return names[int((deg + 11.25) // 22.5) % 16]

# ---------------------------------------------------------------------------
# Location -> JMA areas

def bousai_location(config):
    """Configured location: {lat, lon, label, tz}. Coordinates rounded to 0.001 deg (~100 m)."""
    raw = config.get("location") or BOUSAI_DEFAULT_LOCATION
    loc = json.decode(raw, default = None) or json.decode(BOUSAI_DEFAULT_LOCATION)
    lat = float(loc.get("lat", "35.6812"))
    lon = float(loc.get("lng", "139.7671"))
    return {
        "lat": math.round(lat * 1000) / 1000.0,
        "lon": math.round(lon * 1000) / 1000.0,
        "label": loc.get("locality") or loc.get("description") or "",
        "tz": loc.get("timezone") or BOUSAI_JST,
    }

def bousai_area_table():
    """JMA area.json (centers/offices/class10s/class15s/class20s with enName). Cached for a day."""
    return bousai_get_json(BOUSAI_AREA_JSON, ttl = 86400)

def bousai_in_ring(lon, lat, ring):
    """Even-odd ray casting; ring is [[lon, lat], ...]."""
    inside = False
    j = len(ring) - 1
    for i in range(len(ring)):
        xi, yi = ring[i][0], ring[i][1]
        xj, yj = ring[j][0], ring[j][1]
        if (yi > lat) != (yj > lat) and lon < (xj - xi) * (lat - yi) / (yj - yi) + xi:
            inside = not inside
        j = i
    return inside

def bousai_in_geometry(lon, lat, geometry):
    """Point in a GeoJSON Polygon / MultiPolygon by even-odd parity over every ring.

    JMA's class20 files store separate islands as extra rings of one Polygon, so rings
    cannot be read as outer + holes; parity handles both islands and real holes.
    """
    polys = [geometry["coordinates"]] if geometry["type"] == "Polygon" else geometry["coordinates"]
    hits = 0
    for poly in polys:
        for ring in poly:
            if bousai_in_ring(lon, lat, ring):
                hits += 1
    return hits % 2 == 1

def bousai_locate_class20(lat, lon):
    """Municipality (class20) containing lat/lon, the way JMA's own pages do it.

    Bounding boxes from class20relm.json pick candidates; their simplified polygons decide.
    A point in no polygon (coast, small islands) takes the nearest box centre within ~25 km.
    Only JMA is contacted, and only with area codes.
    """
    if lat < 20.0 or lat > 46.5 or lon < 122.0 or lon > 154.5:
        return None
    relm = bousai_get_json(BOUSAI_CLASS20_BOXES, ttl = 86400)
    if relm == None:
        return None
    candidates = []
    nearest, best = None, 0.25 * 0.25
    for code, box in relm.items():
        sw, ne = box["sw"], box["ne"]
        if sw[0] <= lat and lat <= ne[0] and sw[1] <= lon and lon <= ne[1]:
            candidates.append(((ne[0] - sw[0]) * (ne[1] - sw[1]), code))
        d = ((sw[0] + ne[0]) / 2.0 - lat) * ((sw[0] + ne[0]) / 2.0 - lat) + ((sw[1] + ne[1]) / 2.0 - lon) * ((sw[1] + ne[1]) / 2.0 - lon)
        if d < best:
            nearest, best = code, d
    for _, code in sorted(candidates)[:8]:
        shape = bousai_get_json(BOUSAI_CLASS20_SHAPE % code, ttl = 30 * 86400)
        if shape and shape.get("features") and bousai_in_geometry(lon, lat, shape["features"][0]["geometry"]):
            return code
    return nearest

def bousai_area(config):
    """Resolve the configured location to JMA forecast areas.

    Returns a dict with keys class20, class15, class10, office, center (codes), pref (2-digit),
    and *_en names; or None when the location is outside Japan / cannot be resolved.
    """
    loc = bousai_location(config)
    override = (config.get("area_override") or "").strip()
    cache_key = "bousai_area:%s:%s:%s" % (override, bousai_fixed(loc["lat"], 3), bousai_fixed(loc["lon"], 3))
    cached = cache.get(cache_key)
    if cached:
        return json.decode(cached, default = None)

    table = bousai_area_table()
    if table == None:
        return None
    class20s = table["class20s"]
    if override:
        code = override if override in class20s else None
    else:
        code = bousai_locate_class20(loc["lat"], loc["lon"])
    if code == None or code not in class20s:
        return None

    c20 = class20s[code]
    c15_code = c20["parent"]
    c15 = table["class15s"].get(c15_code, {})
    c10_code = c15.get("parent", "")
    c10 = table["class10s"].get(c10_code, {})
    office_code = c10.get("parent", "")
    office = table["offices"].get(office_code, {})
    area = {
        "class20": code,
        "class15": c15_code,
        "class10": c10_code,
        "office": office_code,
        "center": office.get("parent", ""),
        "pref": code[:2],
        "class20_en": c20.get("enName", code),
        "class15_en": c15.get("enName", ""),
        "class10_en": c10.get("enName", ""),
        "office_en": office.get("enName", ""),
        "lat": loc["lat"],
        "lon": loc["lon"],
    }
    cache.set(cache_key, json.encode(area), ttl_seconds = 7 * 86400)
    return area

def bousai_land_filter(ui, child):
    """Tint a mid-grey land bitmap for the active theme."""
    return filter.Brightness(child = child, change = ui["land_brightness"])

# ---- src/lib/bousai_mapdata.star -------------------------------------------

# name -> {zoom, x0, y0 (Web Mercator world-pixel origin), w, h, png (base64)}
BOUSAI_BASEMAPS = {
    "japan": {
        "zoom": 4,
        "x0": 3413,
        "y0": 1441,
        "w": 398,
        "h": 375,
        "png": "",
    },
    "pacific": {
        "zoom": 2,
        "x0": 782,
        "y0": 297,
        "w": 242,
        "h": 229,
        "png": "",
    },
}

# ---- src/lib/bousai_map.star -----------------------------------------------

BOUSAI_JMATILE = "https://www.jma.go.jp/bosai/jmatile/data"
BOUSAI_MASK_URL = BOUSAI_JMATILE + "/map/none/none/none/surf/mask/{z}/{x}/{y}.png"

def bousai_world_px(lat, lon, zoom):
    """Web Mercator world pixel coordinates (256 px tiles) at a fractional zoom."""
    size = 256.0 * math.pow(2, zoom)
    lat = max(-85.0, min(85.0, lat))
    r = math.radians(lat)
    x = (lon + 180.0) / 360.0 * size
    y = (1.0 - math.log(math.tan(r) + 1.0 / math.cos(r)) / math.pi) / 2.0 * size
    return x, y

def bousai_view(lat, lon, zoom, width = None, height = None):
    """A map view centred on lat/lon. zoom may be fractional."""
    w = width or canvas.width()
    h = height or canvas.height()
    cx, cy = bousai_world_px(lat, lon, zoom)
    return {"zoom": zoom, "ox": cx - w / 2.0, "oy": cy - h / 2.0, "w": w, "h": h}

def bousai_view_fit(points, width = None, height = None, pad = 3, min_zoom = 2.0, max_zoom = 9.0):
    """Smallest-zoom-out view containing every (lat, lon) in points."""
    w = width or canvas.width()
    h = height or canvas.height()
    xs, ys = [], []
    for p in points:
        x, y = bousai_world_px(p[0], p[1], 0)
        xs.append(x)
        ys.append(y)
    dx = max(max(xs) - min(xs), 0.0001)
    dy = max(max(ys) - min(ys), 0.0001)
    fit = min((w - 2 * pad) / dx, (h - 2 * pad) / dy)
    zoom = max(min_zoom, min(max_zoom, math.log(fit, 2)))
    clat, clon = bousai_unproject((min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0, 0)
    return bousai_view(clat, clon, zoom, w, h)

def bousai_unproject(x, y, zoom):
    size = 256.0 * math.pow(2, zoom)
    lon = x / size * 360.0 - 180.0
    n = math.pi - 2.0 * math.pi * y / size
    lat = math.degrees(math.atan(0.5 * (math.exp(n) - math.exp(-n))))
    return lat, lon

def bousai_view_xy(view, lat, lon):
    """Screen pixel of lat/lon in view (ints, may be off-screen)."""
    x, y = bousai_world_px(lat, lon, view["zoom"])
    return int(math.floor(x - view["ox"])), int(math.floor(y - view["oy"]))

def bousai_in_view(view, x, y):
    return x >= 0 and y >= 0 and x < view["w"] and y < view["h"]

def bousai_place(x, y, child):
    """Position child with its top-left at (x, y); negative offsets are clipped by the parent."""
    return render.Padding(pad = (x, y, 0, 0), child = child)

def bousai_basemap(ui, view, name = "japan"):
    """Embedded land silhouette scaled into the view, tinted for the theme."""
    m = BOUSAI_BASEMAPS[name]
    scale = math.pow(2, view["zoom"] - m["zoom"])
    w = max(1, int(m["w"] * scale + 0.5))
    h = max(1, int(m["h"] * scale + 0.5))
    x = int(math.floor(m["x0"] * scale - view["ox"]))
    y = int(math.floor(m["y0"] * scale - view["oy"]))
    img = render.Image(src = base64.decode(m["png"]), width = w, height = h)
    return bousai_place(x, y, bousai_land_filter(ui, img))

def bousai_tile_layer(view, url_template, tile_zoom, ttl = 300, max_tiles = 9):
    """Slippy-map tiles at integer tile_zoom, scaled into view. Missing tiles (no data) are skipped.

    url_template uses {z}/{x}/{y}. Returns a list of positioned widgets for a render.Stack.
    """
    scale = math.pow(2, view["zoom"] - tile_zoom)
    tile_px = 256.0 * scale
    ox = view["ox"] / scale
    oy = view["oy"] / scale
    tx0 = int(math.floor(ox / 256.0))
    ty0 = int(math.floor(oy / 256.0))
    tx1 = int(math.floor((ox + view["w"] / scale - 0.001) / 256.0))
    ty1 = int(math.floor((oy + view["h"] / scale - 0.001) / 256.0))
    n = int(math.pow(2, tile_zoom))
    out = []
    count = 0
    for ty in range(ty0, ty1 + 1):
        if ty < 0 or ty >= n:
            continue
        for tx in range(tx0, tx1 + 1):
            if count >= max_tiles:
                return out
            count += 1
            src = bousai_get_bytes(url_template.format(z = tile_zoom, x = tx % n, y = ty), ttl = ttl)
            if src == None:
                continue
            px = int(math.floor(tx * tile_px - view["ox"]))
            py = int(math.floor(ty * tile_px - view["oy"]))
            nx = int(math.floor((tx + 1) * tile_px - view["ox"]))
            ny = int(math.floor((ty + 1) * tile_px - view["oy"]))
            out.append(bousai_place(px, py, render.Image(src = src, width = nx - px, height = ny - py)))
    return out

def bousai_jmatile_times(path, ttl = 60):
    """JMA tile target-time index, e.g. 'nowc/targetTimes_N1.json'. Returns [] on failure."""
    return bousai_get_json(BOUSAI_JMATILE + "/" + path, ttl = ttl) or []

def bousai_jmatile_url(kind, basetime, validtime, element, member = "none"):
    """Tile URL template for a JMA tile product (kind: nowc, rasrf, wdist, snow, risk, ...)."""
    return "%s/%s/%s/%s/%s/surf/%s/{z}/{x}/{y}.png" % (BOUSAI_JMATILE, kind, basetime, member, validtime, element)

def bousai_mask_layer(view, tile_zoom):
    """JMA coastline/prefecture border overlay."""
    return bousai_tile_layer(view, BOUSAI_MASK_URL, tile_zoom, ttl = 7 * 86400)

def bousai_marker(ui, view, lat, lon, color, size = 3):
    """Square marker centred on lat/lon, with a contrasting outline when contrast is high."""
    x, y = bousai_view_xy(view, lat, lon)
    half = size // 2
    box = render.Box(width = size, height = size, color = color)
    if ui["frame"]:
        box = render.Box(width = size + 2, height = size + 2, color = ui["bg"], child = box)
        half += 1
    return bousai_place(x - half, y - half, box)

def bousai_cross(ui, view, lat, lon, color, arm = 2):
    """'+' marker for epicentres / your location; haloed in high contrast."""
    x, y = bousai_view_xy(view, lat, lon)
    layers = []
    if ui["frame"]:
        layers.append(bousai_place(x - arm - 1, y - 1, render.Box(width = 2 * arm + 3, height = 3, color = ui["bg"])))
        layers.append(bousai_place(x - 1, y - arm - 1, render.Box(width = 3, height = 2 * arm + 3, color = ui["bg"])))
    layers.append(bousai_place(x - arm, y, render.Box(width = 2 * arm + 1, height = 1, color = color)))
    layers.append(bousai_place(x, y - arm, render.Box(width = 1, height = 2 * arm + 1, color = color)))
    return render.Stack(children = layers)

def bousai_map_frame(ui, view, layers):
    """Clip layers to the view size over the theme background."""
    return render.Box(width = view["w"], height = view["h"], color = ui["bg"], child = render.Stack(children = layers))

# ---- src/lib/bousai_tiles.star ---------------------------------------------

BOUSAI_TILES_AMEDAS = "https://www.jma.go.jp/bosai/amedas/"

# Polygons of JMA's "first forecast areas": the code the regional three-hourly forecast (VPFD) is published under.
BOUSAI_TILES_FIRST_AREA = BOUSAI_JMATILE + "/map/none/none/none/surf/click_first_area/data.geojson"

# Zoom presets: (id, Web-Mercator zoom of the 64 px wide view, menu text). One screen pixel is
# about 0.5 / 1.4 / 4 / 8 km at 36 N, so the 64 x 32 px view spans roughly 30 / 90 / 250 / 500 km.
BOUSAI_TILES_ZOOMS = [
    ("city", 8.0, "City (~30 km)"),
    ("prefecture", 6.5, "Prefecture (~90 km)"),
    ("region", 5.0, "Region (~250 km)"),
    ("wide", 4.0, "Wide (~500 km)"),
]

# Frame delay choices in milliseconds (Pixlet frames are 100 ms ticks).
BOUSAI_TILES_SPEEDS = [("300", "Fast"), ("500", "Normal"), ("900", "Slow")]

# Area each JMA tile family covers (dataArea in the JMA page properties XML): min lat, max lat, min lon, max lon.
BOUSAI_TILES_COVERAGE = {
    "nowc": (20.0, 48.0, 118.0, 150.0),
    "wdist": (23.725, 45.875, 122.40625, 149.34375),
}

# Zoom levels JMA publishes per product, probed 2026-10-21 and in line with zoomUse="even" and maxNativeZoom
# in each JMA page's properties XML: nowcast / rain forecast / snow / risk tiles exist at even zooms only
# (odd zooms are 404 or empty), thunder and tornado stop at z8, the weather distribution has every zoom.
BOUSAI_TILES_PRODUCT_ZOOMS = {
    "hrpns": [4, 6, 8, 10],
    "rasrf": [4, 6, 8, 10],
    "thns": [4, 6, 8],
    "trns": [4, 6, 8],
    "snow": [4, 6, 8, 10],
    "wdist": [3, 4, 5, 6, 7, 8, 9, 10],
    "risk": [4, 6, 8, 10],
}

# ---------------------------------------------------------------------------
# Options and schema

def bousai_tiles_fields(default_zoom = "prefecture", legend = True):
    """Schema fields every tile-map app shares: zoom, location marker, frame delay and the colour key."""
    fields = [
        schema.Dropdown(
            id = "zoom",
            name = "Map zoom",
            desc = "How wide an area is shown around your location.",
            icon = "magnifyingGlassLocation",
            default = default_zoom,
            options = [schema.Option(display = z[2], value = z[0]) for z in BOUSAI_TILES_ZOOMS],
        ),
        schema.Toggle(id = "show_location", name = "Show my location", desc = "Draw a marker at the centre of the map.", icon = "locationCrosshairs", default = True),
        schema.Dropdown(
            id = "delay",
            name = "Frame delay",
            desc = "How long each map frame stays on screen.",
            icon = "gaugeHigh",
            default = "500",
            options = [schema.Option(display = s[1], value = s[0]) for s in BOUSAI_TILES_SPEEDS],
        ),
    ]
    if legend:
        fields.append(schema.Toggle(id = "legend", name = "Show colour key", desc = "End the loop with a text key that explains the JMA map colours.", icon = "key", default = True))
    return fields

def bousai_tiles_schema(app_fields, default_zoom = "prefecture", legend = True):
    """Full schema: location, the app's own fields, the shared tile options, then the accessibility fields."""
    fields = [schema.Location(id = "location", name = "Location", desc = "Centre of the map. It chooses which map tiles are downloaded; coordinates are rounded locally to 0.001 degrees (about 100 m). Requested tiles reveal the selected map region.", icon = "locationDot")]
    fields.extend(app_fields)
    fields.extend(bousai_tiles_fields(default_zoom, legend))
    return bousai_schema(fields, location = False)

def bousai_tiles_options(config, default_zoom = "prefecture"):
    """Resolve the shared options: view zoom (scaled for 2x canvases), marker, frame delay in ms, colour key."""
    key = config.get("zoom") or default_zoom
    zoom = 6.5
    for z in BOUSAI_TILES_ZOOMS:
        if z[0] == key:
            zoom = z[1]
    scale = canvas.width() / 64.0
    if scale > 1.01:
        zoom = zoom + math.log(scale, 2)
    raw = config.get("delay") or "500"
    delay = int(raw) if raw.isdigit() else 500
    delay = max(100, min(2000, (delay // 100) * 100))
    return {
        "zoom_key": key,
        "zoom": zoom,
        "show_location": bousai_bool(config, "show_location", True),
        "delay": delay,
        "legend": bousai_bool(config, "legend", True),
    }

def bousai_tiles_covered(loc, area = "nowc"):
    """True when the location lies inside the area JMA publishes this tile family for."""
    b = BOUSAI_TILES_COVERAGE[area]
    return loc["lat"] >= b[0] and loc["lat"] <= b[1] and loc["lon"] >= b[2] and loc["lon"] <= b[3]

def bousai_tiles_view(loc, opts):
    """Map view centred on the location at the chosen zoom, one pixel per canvas pixel."""
    return bousai_view(loc["lat"], loc["lon"], opts["zoom"], canvas.width(), canvas.height())

# ---------------------------------------------------------------------------
# Time axis

def bousai_tiles_utc(s):
    """Parse a JMA tile timestamp 'YYYYMMDDhhmmss' (UTC). Returns None when malformed."""
    if type(s) != "string" or len(s) != 14 or not s.isdigit():
        return None
    return time.parse_time(s, format = "20060102150405", location = "UTC")

def bousai_tiles_minutes(u, ref_u):
    """Whole minutes (rounded) from ref_u to u, both unix seconds."""
    d = u - ref_u
    if d >= 0:
        return (d + 30) // 60
    return -((-d + 30) // 60)

def bousai_tiles_rel(minutes):
    """Relative time label: Now, -35m, +20m, +1h, -1h5m."""
    if minutes == 0:
        return "Now"
    sign = "+" if minutes > 0 else "-"
    m = abs(minutes)
    if m < 60:
        return "%s%dm" % (sign, m)
    if m % 60 == 0:
        return "%s%dh" % (sign, m // 60)
    return "%s%dh%dm" % (sign, m // 60, m % 60)

def bousai_tiles_clock(t, tz):
    """Local HH:MM of a time object."""
    return t.in_location(tz).format("15:04")

def bousai_tiles_entries(index, element):
    """Rows of a JMA target-time index that carry `element`, oldest valid time first.

    Each row is {base, valid (strings), member, u (valid, unix s), bu (base, unix s), t (valid, time)}.
    When several rows share a valid time the one with the newest base time wins.
    """
    best = {}
    for e in index or []:
        if element not in (e.get("elements") or []):
            continue
        v = bousai_tiles_utc(e.get("validtime"))
        b = bousai_tiles_utc(e.get("basetime"))
        if v == None or b == None:
            continue
        row = {"base": e["basetime"], "valid": e["validtime"], "member": e.get("member") or "none", "u": v.unix, "bu": b.unix, "t": v}
        old = best.get(v.unix)
        if old == None or old["bu"] <= row["bu"]:
            best[v.unix] = row
    return [best[k] for k in sorted(best.keys())]

def bousai_tiles_pick(entries, ref_u, offsets, tol_min = 6):
    """For each offset (minutes from ref_u) the nearest entry within tol_min; every entry is used at most once.

    Returns [(entry, offset)] in the order of offsets.
    """
    out = []
    used = {}
    for off in offsets:
        want = ref_u + off * 60
        best = None
        gap = None
        for e in entries:
            d = abs(e["u"] - want)
            if gap == None or d < gap:
                best = e
                gap = d
        if best != None and gap <= tol_min * 60 and best["u"] not in used:
            used[best["u"]] = True
            out.append((best, off))
    return out

def bousai_tiles_ttl(entry, now_u):
    """Tile cache time: tiles of a base time younger than 20 minutes may still be completed, older ones never change."""
    if now_u - entry["bu"] < 1200:
        return 180
    return 3600

def bousai_tiles_frame(kind, entry, element, label, sub = None, ttl = 3600, hold = 0):
    """A frame description: tile URL template plus the texts that go with it."""
    return {
        "url": bousai_jmatile_url(kind, entry["base"], entry["valid"], element, entry["member"]),
        "t": entry["t"],
        "u": entry["u"],
        "label": label,
        "sub": sub,
        "ttl": ttl,
        "hold": hold,
        "extra": [],
    }

def bousai_tiles_nowc3_frames(element, tz, now_u):
    """Frames for a 10-minute nowcast product of the N3 index (thns thunder, trns tornado).

    30 minutes of analysis, Now (held) and the forecast at +10 ... +60 minutes. Returns
    {"frames": [...], "t0": unix time of the newest analysis, "index": raw index} or None without analysis.
    Each frame carries "ana" (True up to Now) so apps can overlay observations only there.
    """
    index = bousai_jmatile_times("nowc/targetTimes_N3.json", ttl = 60)
    rows = bousai_tiles_entries(index, element)
    ana = [e for e in rows if e["u"] == e["bu"]]
    if len(ana) == 0:
        return None
    newest = ana[-1]
    t0 = newest["u"]
    picks = [(e, "ana") for e, _ in bousai_tiles_pick([e for e in ana if e["u"] < t0], t0, [-30, -20, -10], 4)]
    picks.append((newest, "now"))
    picks.extend([(e, "fcst") for e, _ in bousai_tiles_pick([e for e in rows if e["u"] > t0], t0, [10, 20, 30, 40, 50, 60], 4)])
    frames = []
    for e, kind in picks:
        f = bousai_tiles_frame("nowc", e, element, bousai_tiles_rel(bousai_tiles_minutes(e["u"], t0)), bousai_tiles_clock(e["t"], tz), bousai_tiles_ttl(e, now_u), 1 if kind == "now" else 0)
        f["ana"] = kind != "fcst"
        frames.append(f)
    frames[-1]["hold"] = max(frames[-1]["hold"], 2)
    return {"frames": frames, "t0": t0, "index": index}

# ---------------------------------------------------------------------------
# Tiles

def bousai_tiles_is_blank(src):
    """JMA writes a fully transparent tile as a 334-byte RGBA PNG (colour type 6); real data tiles are palette PNGs."""
    return len(src) == 334 and src[25] == "\x06"

def bousai_tiles_count(view, tile_zoom):
    """Number of tiles needed to cover the view at tile_zoom."""
    scale = math.pow(2, view["zoom"] - tile_zoom)
    ox = view["ox"] / scale
    oy = view["oy"] / scale
    tx0 = int(math.floor(ox / 256.0))
    ty0 = int(math.floor(oy / 256.0))
    tx1 = int(math.floor((ox + view["w"] / scale - 0.001) / 256.0))
    ty1 = int(math.floor((oy + view["h"] / scale - 0.001) / 256.0))
    return (tx1 - tx0 + 1) * (ty1 - ty0 + 1)

def bousai_tiles_pick_zoom(view, zooms, max_tiles = 3):
    """Published tile zoom closest to one level above the view zoom that needs at most max_tiles tiles.

    Finer tiles keep the 'blank' test (no data in view) tight; coarser ones save requests.
    """
    target = view["zoom"] + 1.0
    best = None
    for z in zooms:
        if bousai_tiles_count(view, z) > max_tiles:
            continue
        d = abs(z - target)
        if best == None or d < best[0] - 0.01 or (abs(d - best[0]) <= 0.01 and z < best[1]):
            best = (d, z)
    if best == None:
        return min(zooms)
    return best[1]

def bousai_tiles_fetch(view, url_template, tile_zoom, ttl):
    """Fetch the PNG tiles that cover the view and place them.

    Returns {"widgets": [...], "state": s}: "content" when at least one tile holds pixels, "blank" when every
    tile is empty or absent (404 means JMA has no data there), "unknown" when a request failed and nothing was drawn.
    """
    scale = math.pow(2, view["zoom"] - tile_zoom)
    tile_px = 256.0 * scale
    ox = view["ox"] / scale
    oy = view["oy"] / scale
    tx0 = int(math.floor(ox / 256.0))
    ty0 = int(math.floor(oy / 256.0))
    tx1 = int(math.floor((ox + view["w"] / scale - 0.001) / 256.0))
    ty1 = int(math.floor((oy + view["h"] / scale - 0.001) / 256.0))
    n = int(math.pow(2, tile_zoom))
    widgets = []
    failed = 0
    for ty in range(ty0, ty1 + 1):
        if ty < 0 or ty >= n:
            continue
        for tx in range(tx0, tx1 + 1):
            resp = http.get(url_template.format(z = tile_zoom, x = tx % n, y = ty), headers = BOUSAI_UA, ttl_seconds = ttl)
            if resp.status_code == 404:
                continue
            if resp.status_code != 200:
                failed += 1
                continue
            src = resp.body()
            if len(src) < 40 or src[1:4] != "PNG":
                failed += 1
                continue
            if bousai_tiles_is_blank(src):
                continue
            px = int(math.floor(tx * tile_px - view["ox"]))
            py = int(math.floor(ty * tile_px - view["oy"]))
            nx = int(math.floor((tx + 1) * tile_px - view["ox"]))
            ny = int(math.floor((ty + 1) * tile_px - view["oy"]))
            widgets.append(bousai_place(px, py, render.Image(src = src, width = nx - px, height = ny - py)))
    state = "content"
    if len(widgets) == 0:
        state = "unknown" if failed > 0 else "blank"
    return {"widgets": widgets, "state": state}

# ---------------------------------------------------------------------------
# Frame composition

def bousai_tiles_data_dim(ui):
    """Brightness shift for JMA data tiles: calmer for low contrast, darker on the light theme so pale colours stay visible."""
    if ui["theme"] == "light":
        return -0.3 if ui["contrast"] == "low" else -0.18
    return -0.3 if ui["contrast"] == "low" else 0.0

def bousai_tiles_mask_dim(ui):
    """Brightness shift for the JMA coast and border overlay (bright grey on its own, dimmed for LEDs)."""
    if ui["theme"] == "light":
        return -0.15 if ui["contrast"] == "high" else -0.05
    if ui["contrast"] == "high":
        return -0.2
    return -0.55 if ui["contrast"] == "low" else -0.38

def bousai_tiles_mask(ui, view):
    """Dimmed JMA coast / prefecture border overlay for the view, or None when the tiles are unavailable."""
    mz = max(4, min(11, int(math.floor(view["zoom"] + 1.5))))
    layers = bousai_mask_layer(view, mz)
    if len(layers) == 0:
        return None
    return filter.Brightness(child = render.Stack(children = layers), change = bousai_tiles_mask_dim(ui))

def bousai_tiles_marker(ui, view, lat, lon):
    """Location cross with a halo in the background colour so it reads over any JMA colour."""
    x, y = bousai_view_xy(view, lat, lon)
    arm = 3 if ui["frame"] else 2
    halo = ui["bg"]
    kids = [
        bousai_place(x - arm - 1, y - 1, render.Box(width = 2 * arm + 3, height = 3, color = halo)),
        bousai_place(x - 1, y - arm - 1, render.Box(width = 3, height = 2 * arm + 3, color = halo)),
        bousai_place(x - arm, y, render.Box(width = 2 * arm + 1, height = 1, color = ui["fg"])),
        bousai_place(x, y - arm, render.Box(width = 1, height = 2 * arm + 1, color = ui["fg"])),
    ]
    return render.Stack(children = kids)

def bousai_tiles_backing(ui):
    """Semi-opaque backing colour for text drawn over the map (opaque in high contrast)."""
    return ui["bg"] + ("ff" if ui["frame"] else "d2")

def bousai_tiles_label(ui, text, sub = None):
    """Small time label with a readable backing, drawn at the top-left of the map."""
    font = ui["small_font"]
    full = text if not sub else text + " " + sub
    if bousai_text_width(ui, full, font) > canvas.width() - 3:
        full = text
    w = min(canvas.width(), bousai_text_width(ui, full, font) + 3)
    h = bousai_font_height(ui, font) + 1
    box = render.Box(width = w, height = h, color = bousai_tiles_backing(ui), child = bousai_text(ui, full, ui["fg"], font))
    if ui["frame"]:
        box = render.Box(width = w + 1, height = h + 1, color = ui["muted"], child = box)
    return box

def bousai_tiles_banner(ui, text, frames = None):
    """Full-width text strip at the bottom of the map ('No rain', or a per-frame note such as 'Cloudy 21C')."""
    font = ui["small_font"]
    h = bousai_font_height(ui, font) + 1
    strip = render.Box(width = canvas.width(), height = h, color = bousai_tiles_backing(ui), child = bousai_fit(ui, text, width = canvas.width() - 2, color = ui["fg"], font = font, align = "center", frames = frames))
    return bousai_place(0, canvas.height() - h, strip)

def bousai_tiles_glyph(rows, color, scale = 1):
    """A small hand-drawn bitmap (rows of '#' and '.') as a widget, each pixel scaled to scale x scale."""
    kids = []
    for y in range(len(rows)):
        for x in range(len(rows[y])):
            if rows[y][x] == "#":
                kids.append(bousai_place(x * scale, y * scale, render.Box(width = scale, height = scale, color = color)))
    return render.Box(width = len(rows[0]) * scale, height = len(rows) * scale, child = render.Stack(children = kids))

def bousai_tiles_bar(ui, text, right = None, lead = None, frames = None):
    """Opaque full-width text bar at the top of the map: an optional bitmap glyph (`lead`, rows of '#'/'.', e.g. a
    kanji weekday), the frame time and note ('21h Cldy'), and an optional value pinned to the right edge ('21C').
    The glyph and right value always stay put; only the text between them scrolls when it does not fit.
    The bar is one row taller than the font so a 6-row glyph fits; text sits on the bottom rows.
    """
    font = ui["small_font"]
    h = bousai_font_height(ui, font) + 1
    w = canvas.width()
    rw = bousai_text_width(ui, right, font) if right else 0
    head = []
    lw = w - 1 - (rw + 1 if right else 0)
    if lead:
        scale = max(1, h // len(lead))
        head = [bousai_tiles_glyph(lead, ui["fg"], scale), render.Box(width = scale, height = 1)]
        lw -= len(lead[0]) * scale + scale
    fits = bousai_text_width(ui, text, font) <= lw
    left = bousai_text(ui, text, ui["fg"], font) if fits else bousai_fit(ui, text, width = lw, color = ui["fg"], font = font, frames = frames)
    kids = [render.Padding(pad = (1, 0, 0, 0), child = render.Row(cross_align = "end", children = head + [left]))]
    if right:
        kids.append(bousai_text(ui, right, ui["fg"], font))
    line = render.Row(expanded = True, main_align = "space_between", cross_align = "end", children = kids)
    bar = render.Box(width = w, height = h, color = ui["bg"], child = line)
    if ui["frame"]:
        return render.Column(children = [bar, render.Box(width = w, height = 1, color = ui["muted"])])
    return bar

def bousai_tiles_gradient(colors):
    """Colour-key footer for the bottom of the map: the tile colours left to right as one smooth gradient, outlined in black.

    The colours sit at evenly spaced stops (first at the left edge, last at the right) and every pixel between two
    stops is linearly interpolated, so neighbouring classes run into each other without hard steps.
    """
    inner = canvas.width() - 2
    n = len(colors)
    cols = []
    for x in range(inner):
        c = colors[0]
        if n > 1:
            p = x * (n - 1) / (inner - 1.0)
            i = min(n - 2, int(p))
            c = bousai_mix(colors[i], colors[i + 1], p - i)
        cols.append(render.Box(width = 1, height = 2, color = c))
    strip = render.Padding(pad = 1, child = render.Row(children = cols))
    return bousai_place(0, canvas.height() - 4, render.Box(width = canvas.width(), height = 4, color = "#000000", child = strip))

def bousai_tiles_strike(ui, cg):
    """Lightning discharge glyph: a filled square for cloud-to-ground (CG), a cross for cloud-to-cloud (CC).

    Shape carries the meaning, so it does not depend on colour; the halo keeps it readable over any JMA colour.
    """
    if cg:
        return render.Box(width = 4, height = 4, color = ui["bg"], child = render.Box(width = 2, height = 2, color = ui["fg"]))
    return render.Stack(children = [
        render.Box(width = 5, height = 5, color = ui["bg"]),
        bousai_place(1, 2, render.Box(width = 3, height = 1, color = ui["fg"])),
        bousai_place(2, 1, render.Box(width = 1, height = 3, color = ui["fg"])),
    ])

def bousai_tiles_strike_marks(ui, view, strikes, cap = 40):
    """Positioned glyphs for strikes [(lat, lon, is_cg)] that fall inside the view (at most `cap` of each kind)."""
    out = []
    n_cg = 0
    n_cc = 0
    for s in strikes:
        x, y = bousai_view_xy(view, s[0], s[1])
        if not bousai_in_view(view, x, y):
            continue
        if s[2]:
            if n_cg >= cap:
                continue
            n_cg += 1
            out.append(bousai_place(x - 1, y - 1, bousai_tiles_strike(ui, True)))
        else:
            if n_cc >= cap:
                continue
            n_cc += 1
            out.append(bousai_place(x - 2, y - 2, bousai_tiles_strike(ui, False)))
    return out

def bousai_tiles_build(ui, loc, view, opts, frames, spec):
    """Fetch tiles and compose one widget per frame.

    frames: dicts from bousai_tiles_frame, optionally with "extra" (widgets drawn above the mask), "note" (bottom
    text strip, or after the label in the top bar), "right" (top bar only: text pinned to the bar's right edge),
    "lead" (top bar only: bitmap glyph rows drawn before the label) and "quiet" (True: do not claim 'nothing here'
    even when the tiles are blank).
    spec: {"zooms": [tile zooms], "empty": banner text when a frame's tiles are blank (optional),
           "basemap": True to force the land silhouette (default: only when zoomed out),
           "bar": True to write label, note and empty text into one opaque top bar instead (optional),
           "footer": tile colours drawn as a gradient strip along the bottom (optional)}.
    Returns {"widgets": [...], "holds": [extra ticks], "states": ["content"|"blank"|"unknown"], "tile_zoom": z}.
    """
    tile_zoom = bousai_tiles_pick_zoom(view, spec["zooms"])
    under = []
    if spec.get("basemap", view["zoom"] <= 5.5):
        under.append(bousai_basemap(ui, view, "japan"))
    mask = bousai_tiles_mask(ui, view)
    over = [mask] if mask != None else []
    marker = bousai_tiles_marker(ui, view, loc["lat"], loc["lon"]) if opts["show_location"] else None
    dim = bousai_tiles_data_dim(ui)
    footer = bousai_tiles_gradient(spec["footer"]) if spec.get("footer") else None
    widgets = []
    holds = []
    states = []
    for f in frames:
        got = {"widgets": [], "state": "blank"}
        if f.get("url"):
            got = bousai_tiles_fetch(view, f["url"], tile_zoom, f["ttl"])
        kids = list(under)
        if len(got["widgets"]) > 0:
            data = render.Stack(children = got["widgets"])
            kids.append(filter.Brightness(child = data, change = dim) if dim != 0 else data)
        kids.extend(over)
        kids.extend(f.get("extra") or [])
        if marker != None:
            kids.append(marker)
        empty = got["state"] == "blank" and spec.get("empty") and not f.get("quiet")
        if spec.get("bar"):
            if footer != None:
                kids.append(footer)
            parts = [f["label"]]
            if f.get("note"):
                parts.append(f["note"])
            elif empty:
                parts.append(spec["empty"])
            kids.append(bousai_tiles_bar(ui, " ".join(parts), f.get("right"), f.get("lead")))
        else:
            if f.get("note"):
                kids.append(bousai_tiles_banner(ui, f["note"]))
            elif empty:
                kids.append(bousai_tiles_banner(ui, spec["empty"]))
            kids.append(bousai_tiles_label(ui, f["label"], f.get("sub")))
        widgets.append(render.Box(width = view["w"], height = view["h"], color = ui["bg"], child = render.Stack(children = kids)))
        holds.append(f.get("hold") or 0)
        states.append(got["state"])
    return {"widgets": widgets, "holds": holds, "states": states, "tile_zoom": tile_zoom}

def bousai_tiles_all_blank(states):
    """True when every frame's tiles were fetched and none holds any pixel (nothing to see anywhere)."""
    if len(states) == 0:
        return False
    for s in states:
        if s != "blank":
            return False
    return True

def bousai_tiles_presence(frames, states):
    """What the tiles say frame by frame (tile level, so 'in your region'): {"now": bool, "ahead": label or None, "any": bool}.

    "now" is the frame labelled Now, "ahead" the label of the first later frame whose tiles hold data.
    """
    now = False
    ahead = None
    found = False
    seen_now = False
    for i in range(len(frames)):
        has = states[i] == "content"
        found = found or has
        if frames[i]["label"] == "Now":
            seen_now = True
            now = has
        elif seen_now and has and ahead == None:
            ahead = frames[i]["label"]
    return {"now": now, "ahead": ahead, "any": found}

# ---------------------------------------------------------------------------
# Pages: text rows and colour keys

def bousai_tiles_chunks(items, per_page):
    """Split items into pages of per_page."""
    out = []
    for i in range(0, len(items), per_page):
        out.append(items[i:i + per_page])
    return out

def bousai_tiles_text_layout(ui, rows):
    """Row chunks, one per page. Large and extra-large text drops the title band so two or three rows fit a page."""
    head = ui["line_h"] if ui["line_h"] < 9 else 0
    return bousai_tiles_chunks(rows, max(1, (canvas.height() - head) // ui["line_h"]))

def bousai_tiles_text_page(ui, title, rows, ticks):
    """One text page: title band (not for large text) plus rows (str or (text, colour)); long lines scroll within `ticks` frames."""
    kids = [bousai_header(ui, title, frames = ticks)] if ui["line_h"] < 9 else []
    for r in rows:
        kids.append(render.Box(width = canvas.width(), height = ui["line_h"], child = bousai_row(ui, r, ticks)))
    body = render.Box(width = canvas.width(), height = canvas.height(), child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))
    return bousai_hold(body, ticks)

def bousai_tiles_key_layout(ui, entries, titled = True):
    """How a colour key is laid out. The key text uses the small font where there is one, so eight entries fit one page.

    A key without a unit (the weather key) skips the title band, which leaves room for a fifth row.
    """
    font = ui["small_font"]
    lh = bousai_font_height(ui, font) + 1
    head = ui["line_h"] if (ui["line_h"] < 9 and titled) else 0
    sw = 6 if lh <= 9 else 8
    widest = 0
    for e in entries:
        widest = max(widest, bousai_text_width(ui, e[1], font))
    cell = sw + 2 + 1 + 2 + widest
    cols = 2 if 2 * cell <= canvas.width() else 1
    rows = max(1, (canvas.height() - head) // lh)
    return {"cols": cols, "per_page": rows * cols, "sw": sw, "sh": max(3, lh - 3), "lh": lh, "font": font, "banded": head > 0}

def bousai_tiles_key_page(ui, title, entries, unit, ticks, layout):
    """One colour-key page: swatch (the real JMA tile colour, outlined) plus its text, `cols` cells per row."""
    cols = layout["cols"]
    width = canvas.width() // cols
    kids = [bousai_header(ui, title, right = unit, frames = ticks)] if layout["banded"] else []
    for r in range(0, len(entries), cols):
        cells = []
        for e in entries[r:r + cols]:
            shape = e[2] if len(e) > 2 else "box"
            if shape == "cg" or shape == "cc":
                swatch = render.Box(width = layout["sw"] + 2, height = layout["sh"] + 2, child = bousai_tiles_strike(ui, shape == "cg"))
            else:
                swatch = render.Box(width = layout["sw"] + 2, height = layout["sh"] + 2, color = ui["muted"], child = render.Box(width = layout["sw"], height = layout["sh"], color = e[0]))
            label = render.Padding(pad = (2, 0, 0, 0), child = bousai_text(ui, e[1], ui["fg"], layout["font"]))
            cells.append(render.Box(width = width, height = layout["lh"], child = render.Row(expanded = True, main_align = "start", cross_align = "center", children = [render.Padding(pad = (1, 0, 0, 0), child = swatch), label])))
        kids.append(render.Row(children = cells))
    body = render.Box(width = canvas.width(), height = canvas.height(), child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))
    return bousai_hold(body, ticks)

# ---------------------------------------------------------------------------
# Animation budget and root

def bousai_tiles_total(values):
    """Sum of a list of numbers (Starlark has no sum())."""
    out = 0
    for v in values:
        out += v
    return out

def bousai_tiles_root(ui, opts, built, status = None, key = None):
    """Assemble the animation: map frames, then status text pages, then the colour key, all inside the dwell budget.

    built: result of bousai_tiles_build.
    status: {"title": str, "rows": [str | (text, colour)]} or None.
    key: {"title": str, "unit": str or None, "entries": [(tile colour hex, text)]} or None.
    Holds are trimmed first, then page time, then the oldest frames, so the newest frames and the text always fit.
    """
    total = bousai_budget_frames()
    per = max(1, opts["delay"] // 100)
    widgets = built["widgets"]
    holds = built["holds"]

    text_chunks = bousai_tiles_text_layout(ui, status["rows"]) if status else []
    key_layout = None
    key_chunks = []
    if key and len(key["entries"]) > 0:
        key_layout = bousai_tiles_key_layout(ui, key["entries"], key.get("unit") != None)
        key_chunks = bousai_tiles_chunks(key["entries"], key_layout["per_page"])
    n_pages = len(text_chunks) + len(key_chunks)

    frame_ticks = [per * (1 + h) for h in holds]
    page_ticks = [30 if i < len(text_chunks) else 25 for i in range(n_pages)]
    need = bousai_tiles_total(frame_ticks) + bousai_tiles_total(page_ticks)
    if need > total:
        frame_ticks = [per for _ in widgets]
        need = bousai_tiles_total(frame_ticks) + bousai_tiles_total(page_ticks)
    if need > total:
        page_ticks = [min(t, 16) for t in page_ticks]
        need = bousai_tiles_total(frame_ticks) + bousai_tiles_total(page_ticks)
    if need > total:
        page_ticks = [min(t, 12) for t in page_ticks]
        need = bousai_tiles_total(frame_ticks) + bousai_tiles_total(page_ticks)
    first = 0
    if need > total:
        for i in range(max(0, len(widgets) - 2)):
            if need <= total:
                break
            need -= frame_ticks[i]
            first += 1
    shown = []
    for i in range(first, len(widgets)):
        shown.extend([widgets[i]] * frame_ticks[i])
    seq = [render.Animation(children = shown)]
    k = 0
    for chunk in text_chunks:
        seq.append(bousai_tiles_text_page(ui, status["title"], chunk, page_ticks[k]))
        k += 1
    for chunk in key_chunks:
        seq.append(bousai_tiles_key_page(ui, key["title"], chunk, key.get("unit"), page_ticks[k], key_layout))
        k += 1
    if len(seq) == 1:
        return bousai_root(ui, seq[0])
    return bousai_root(ui, render.Sequence(children = seq))

# ---------------------------------------------------------------------------
# AMeDAS numbers for text cues

def bousai_tiles_val(pair):
    """AMeDAS [value, quality] pair -> value, or None when missing or flagged as not observed (quality >= 5)."""
    if type(pair) != "list" or len(pair) == 0 or pair[0] == None:
        return None
    if len(pair) > 1 and pair[1] != None and pair[1] >= 5:
        return None
    return pair[0]

def bousai_tiles_amedas_near(lat, lon, radius_km = 40.0):
    """Latest AMeDAS observations (JMA, 10-minute cadence) around a point.

    Returns None when the feed is unavailable, else {"time": time, "stations": [...]} with the stations inside
    radius_km sorted by distance. Each station: {id, name (English), km, dir (16-point bearing from the point),
    p10 / p1h (precipitation mm over 10 min / 1 h), snow (depth cm), snow1h / snow3h / snow6h / snow12h /
    snow24h (snowfall cm), temp (C)}; a value is None where the station does not report it.
    """
    lt = http.get(BOUSAI_TILES_AMEDAS + "data/latest_time.txt", headers = BOUSAI_UA, ttl_seconds = 60)
    if lt.status_code != 200:
        return None
    stamp = lt.body().strip()
    when = bousai_parse_time(stamp)
    if when == None or len(stamp) < 19:
        return None
    key = stamp[0:4] + stamp[5:7] + stamp[8:10] + stamp[11:13] + stamp[14:16] + stamp[17:19]
    obs = bousai_get_json(BOUSAI_TILES_AMEDAS + "data/map/" + key + ".json", ttl = 300)
    table = bousai_get_json(BOUSAI_TILES_AMEDAS + "const/amedastable.json", ttl = 86400)
    if type(obs) != "dict" or type(table) != "dict":
        return None
    dlat = radius_km / 111.0
    dlon = radius_km / (111.0 * max(0.2, math.cos(math.radians(lat))))
    near = []
    for sid, o in obs.items():
        st = table.get(sid)
        if st == None:
            continue
        slat = st["lat"][0] + st["lat"][1] / 60.0
        slon = st["lon"][0] + st["lon"][1] / 60.0
        if abs(slat - lat) > dlat or abs(slon - lon) > dlon:
            continue
        km = bousai_distance_km(lat, lon, slat, slon)
        if km > radius_km:
            continue
        near.append({
            "id": sid,
            "name": st.get("enName") or st.get("kjName") or sid,
            "km": km,
            "dir": bousai_bearing_name(lat, lon, slat, slon),
            "p10": bousai_tiles_val(o.get("precipitation10m")),
            "p1h": bousai_tiles_val(o.get("precipitation1h")),
            "snow": bousai_tiles_val(o.get("snow")),
            "snow1h": bousai_tiles_val(o.get("snow1h")),
            "snow3h": bousai_tiles_val(o.get("snow3h")),
            "snow6h": bousai_tiles_val(o.get("snow6h")),
            "snow12h": bousai_tiles_val(o.get("snow12h")),
            "snow24h": bousai_tiles_val(o.get("snow24h")),
            "temp": bousai_tiles_val(o.get("temp")),
        })
    return {"time": when, "stations": sorted(near, key = lambda s: s["km"])}

def bousai_tiles_place(st):
    """'Name 12km SE' for an AMeDAS station entry."""
    return "%s %dkm %s" % (st["name"], int(st["km"] + 0.5), st["dir"])

# ---------------------------------------------------------------------------
# JMA first forecast area

def bousai_tiles_first_area(lat, lon):
    """JMA first forecast area containing a point: {"code": "130010", "name": "Tokyo Region"} or None.

    The code is what JMA publishes the regional three-hourly forecast under (wdist/VPFD/<code>.json). It comes
    from JMA's own polygon file (one cached request, point-in-polygon with the core helper), so no geocoder is
    involved; the answer is cached for a week.
    """
    key = "bousai_tiles_first:%s:%s" % (bousai_fixed(lat, 3), bousai_fixed(lon, 3))
    hit = cache.get(key)
    if hit != None:
        return json.decode(hit, default = None) if hit != "-" else None
    data = bousai_get_json(BOUSAI_TILES_FIRST_AREA, ttl = 7 * 86400)
    if type(data) != "dict":
        return None
    found = None
    for f in data.get("features") or []:
        if bousai_in_geometry(lon, lat, f["geometry"]):
            p = f.get("properties") or {}
            found = {"code": p.get("areaCode"), "name": p.get("areaNameEN") or ""}
            break
    cache.set(key, json.encode(found) if found != None else "-", ttl_seconds = 7 * 86400)
    return found

# ---- src/apps/bousai_wxmap/bousai_wxmap.star -------------------------------

WX_ELEMENTS = [
    ("wm", "Weather"),
    ("temp", "Temperature"),
    ("r3", "Rain, 3 hours"),
    ("s3", "Snow, 3 hours"),
]

# JMA weather distribution tile colours in legend order (legend of the JMA weather distribution page), with the class each marks.
WX_KEYS = {
    "wm": [("#ffaa00", "Clear"), ("#aaaaaa", "Cloudy"), ("#0041ff", "Rain"), ("#a0d2ff", "Rain/snow"), ("#f2f2ff", "Snow")],
    "temp": [
        ("#50002e", "40+"),
        ("#b40068", "35+"),
        ("#ff2800", "30+"),
        ("#ff9900", "25+"),
        ("#faf500", "20+"),
        ("#ffff96", "15+"),
        ("#fffff0", "10+"),
        ("#b9ebff", "5+"),
        ("#0096ff", "0+"),
        ("#0041ff", "-5+"),
        ("#002080", "-10+"),
        ("#4d4471", "-15+"),
        ("#776fa4", "-20+"),
        ("#a8a3c5", "-25+"),
        ("#d8d6e4", "<-25"),
    ],
    "r3": [("#ff9900", "20+"), ("#faf500", "15-20"), ("#0041ff", "10-15"), ("#218cff", "5-10"), ("#a0d2ff", "1-5")],
    "s3": [("#0041ff", "6+"), ("#218cff", "3-6"), ("#a0d2ff", "1-3")],
}

# The forecast texts JMA's regional three-hourly forecast uses, abbreviated for the frame bar (JMA weather legend in English).
WX_WEATHER_EN = {"晴れ": "Clr", "くもり": "Cldy", "雨": "Rain", "雨または雪": "R/S", "雪": "Snow"}

# Kanji weekdays as 5x6 bitmaps for the top bar (Pixlet's small fonts have no CJK glyphs), keyed by Go's "Mon" format.
WX_WEEKDAY_KANJI = {
    "Sun": [".####", ".#..#", ".####", ".#..#", ".#..#", ".####"],  # 日
    "Mon": ["..###", "..#.#", "..###", "..#.#", ".#..#", "#..##"],  # 月
    "Tue": ["..#..", "#.#.#", "..#..", "..#..", ".#.#.", "#...#"],  # 火
    "Wed": ["..#..", "###.#", "..##.", "..#..", ".#.#.", "#.#.#"],  # 水
    "Thu": ["..#..", "#####", "..#..", ".###.", "#.#.#", "..#.."],  # 木
    "Fri": ["..#..", ".#.#.", "#####", "..#..", "#.#.#", "#####"],  # 金
    "Sat": ["..#..", "..#..", ".###.", "..#..", "..#..", "#####"],  # 土
}

def wx_number(v):
    return type(v) == "int" or type(v) == "float"

def wx_forecast(loc):
    """JMA regional three-hourly forecast (VPFD) for the area of the location, or None.

    Returns {"wx": {valid unix: abbreviated English weather}, "temp": {valid unix: degrees C}}. Weather periods
    are keyed by their end, which is the tile valid time.
    """
    area = bousai_tiles_first_area(loc["lat"], loc["lon"])
    if area == None:
        return None
    out = {"wx": {}, "temp": {}}
    data = bousai_get_json("%s/wdist/VPFD/%s.json" % (BOUSAI_JMATILE, area["code"]), ttl = 900)
    if type(data) != "dict":
        return out
    series = data.get("areaTimeSeries") or {}
    stamps = series.get("timeDefines") or []
    words = series.get("weather") or []
    for i in range(min(len(stamps), len(words))):
        t = bousai_parse_time(stamps[i].get("dateTime"))
        if t != None and words[i] in WX_WEATHER_EN:
            out["wx"][t.unix + 10800] = WX_WEATHER_EN[words[i]]
    point = data.get("pointTimeSeries") or {}
    stamps = point.get("timeDefines") or []
    values = point.get("temperature") or []
    for i in range(min(len(stamps), len(values))):
        t = bousai_parse_time(stamps[i].get("dateTime"))
        if t != None and wx_number(values[i]):
            out["temp"][t.unix] = int(values[i])
    return out

def wx_frames(element, tz, now_u, fc):
    """Forecast frames from the 3-hourly index, from the current period on, up to midnight of the next day."""
    rows = [e for e in bousai_tiles_entries(bousai_jmatile_times("wdist/targetTimes.json", ttl = 600), element) if e["u"] >= now_u - 5400]
    frames = []
    for e in rows[:14]:
        local = e["t"].in_location(tz)
        hour = local.hour
        window = element in ("r3", "s3")
        label = "%d-%dh" % ((hour + 21) % 24, hour) if window else "%dh" % hour
        f = bousai_tiles_frame("wdist", e, element, label, None, bousai_tiles_ttl(e, now_u))
        f["lead"] = WX_WEEKDAY_KANJI[local.format("Mon")]

        # The weather period ends at the valid time, so it is exactly the rain/snow window. The point temperature
        # (an instant: the end of the frame) goes to the right of the bar.
        if fc != None:
            f["note"] = fc["wx"].get(e["u"])
            if e["u"] in fc["temp"]:
                f["right"] = "%dC" % fc["temp"][e["u"]]
        frames.append(f)
    if len(frames) > 0:
        frames[0]["hold"] = 1
        frames[-1]["hold"] = max(frames[-1]["hold"], 2)
    return frames

def main(config):
    ui = bousai_ui(config)
    loc = bousai_location(config)
    if not bousai_tiles_covered(loc, "wdist"):
        return bousai_message(ui, "Weather map", ["Outside JMA", "forecast grid"])
    opts = bousai_tiles_options(config, "region")
    element = config.get("element") or "wm"
    if element not in WX_KEYS:
        element = "wm"
    fc = wx_forecast(loc)
    frames = wx_frames(element, loc["tz"], time.now().unix, fc)
    if len(frames) == 0:
        return bousai_message(ui, "Weather map", ["No forecast map", "from JMA now"])
    spec = {"zooms": BOUSAI_TILES_PRODUCT_ZOOMS["wdist"], "empty": "No data", "bar": True, "footer": [e[0] for e in WX_KEYS[element]]}
    built = bousai_tiles_build(ui, loc, bousai_tiles_view(loc, opts), opts, frames, spec)
    return bousai_tiles_root(ui, opts, built)

def get_schema():
    return bousai_tiles_schema([
        schema.Dropdown(
            id = "element",
            name = "Layer",
            desc = "Weather, temperature, 3-hour rain or 3-hour snow forecast on JMA's 5 km grid.",
            icon = "cloudSunRain",
            default = "wm",
            options = [schema.Option(display = e[1], value = e[0]) for e in WX_ELEMENTS],
        ),
    ], "region", legend = False)
