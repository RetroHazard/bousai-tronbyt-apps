    "41": "JPFC",
    "42": "JPFE",
    "43": "JPFD",
    "44": "JPFB",
    "45": "JPKA",
    "46": "JPKG",
}

# Hokkaido/Okinawa class10 prefix -> JMA multilingual publishing office.
BOUSAI_MULTI_OFFICE_BY_PREFIX = {
    "011": "JPSA",
    "012": "JPSC",
    "013": "JPSB",
    "014": "JPSD",
    "015": "JPSE",
