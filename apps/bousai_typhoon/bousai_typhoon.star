# ---- src/lib/bousai_core.star ----------------------------------------------

BOUSAI_JST = "Asia/Tokyo"
BOUSAI_UA = {"User-Agent": "bousai-tronbyt-apps (+https://www.jma.go.jp/)"}

BOUSAI_DEFAULT_LOCATION = json.encode({
    "lat": "35.6812",
    "lng": "139.7671",
    "description": "Tokyo Station, Chiyoda, Tokyo, Japan",
    "locality": "Chiyoda",
    "timezone": "Asia/Tokyo",
})

BOUSAI_CLASS20_BOXES = "https://www.jma.go.jp/bosai/common/const/class20relm.json"
BOUSAI_CLASS20_SHAPE = "https://www.jma.go.jp/bosai/common/const/geojson/class20s/%s.json"
BOUSAI_AREA_JSON = "https://www.jma.go.jp/bosai/common/const/area.json"

# ---------------------------------------------------------------------------
# HTTP

def bousai_get_json(url, ttl = 60, params = None):
    """GET url and decode JSON. Returns None on transport-level non-200 or bad JSON."""
    resp = http.get(url, params = params or {}, headers = BOUSAI_UA, ttl_seconds = ttl)
    if resp.status_code != 200:
        return None
    return json.decode(resp.body(), default = None)

def bousai_get_bytes(url, ttl = 60):
    resp = http.get(url, headers = BOUSAI_UA, ttl_seconds = ttl)
    if resp.status_code != 200:
        return None
    return resp.body()

def bousai_guarded_get(url, ttl = 60, params = None, cooldown = 300):
    """GET from a host that may stall, without crash-looping. Returns the body or None.

    A transport error or Pixlet's 5 s HTTP timeout aborts the whole render and Starlark
    cannot catch it. So a "pending:<unix time>" marker is cached before the request and cleared
    after it. A marker older than the HTTP timeout found at the start means an earlier attempt
    died mid-request: the host is then skipped (None) for `cooldown` seconds. A younger marker
    is a concurrent render still in flight and is ignored. Use for third-party feeds (Wolfx,
    P2PQuake, NIED); keep cooldown above the app's render interval.
    """
    key = "bousai_guard:" + url.split("/")[2]
    state = cache.get(key) or ""
    now = time.now().unix
    if state == "down":
        return None
    if state.startswith("pending:") and now - int(state[8:]) > 6:
        cache.set(key, "down", ttl_seconds = cooldown)
        return None
    cache.set(key, "pending:%d" % now, ttl_seconds = cooldown)
    resp = http.get(url, params = params or {}, headers = BOUSAI_UA, ttl_seconds = ttl)
    cache.set(key, "ok", ttl_seconds = 1)
    if resp.status_code != 200:
        return None
    return resp.body()

def bousai_guarded_json(url, ttl = 60, params = None, cooldown = 300):
    """bousai_guarded_get + JSON decode (None on any failure)."""
    body = bousai_guarded_get(url, ttl, params, cooldown)
    return json.decode(body, default = None) if body != None else None

# ---------------------------------------------------------------------------
# Schema

def bousai_schema(fields, location = True, location_desc = "Your location in Japan. Matched to a JMA municipality on the server using JMA's own area polygons; coordinates are never sent anywhere."):
    """Build the app schema: optional location, app fields, then accessibility fields."""
    out = []
    if location:
        out.append(schema.Location(id = "location", name = "Location", desc = location_desc, icon = "locationDot"))
        out.append(schema.Text(id = "area_override", name = "JMA area code (optional)", desc = "7-digit JMA municipality code (e.g. 1310100). Overrides the location lookup.", icon = "mapPin", default = ""))
    out.extend(fields)
    out.extend(bousai_accessibility_fields())
    return schema.Schema(version = "1", fields = out)

def bousai_accessibility_fields():
    return [
        schema.Dropdown(id = "theme", name = "Theme", desc = "Dark or light display theme.", icon = "circleHalfStroke", default = "dark", options = [
            schema.Option(display = "Dark", value = "dark"),
            schema.Option(display = "Light", value = "light"),
        ]),
        schema.Dropdown(id = "palette", name = "Colour vision", desc = "Colour scheme optimised for your colour vision. Levels are always also shown as text.", icon = "eye", default = "normal", options = [
            schema.Option(display = "Normal vision", value = "normal"),
            schema.Option(display = "Protanopia / Deuteranopia (red-green)", value = "protan"),
            schema.Option(display = "Tritanopia (blue-yellow)", value = "tritan"),
            schema.Option(display = "Monochromacy", value = "mono"),
        ]),
        schema.Dropdown(id = "contrast", name = "Contrast", desc = "Low is calmer and paler; high gives brighter text and frames.", icon = "circleHalfStroke", default = "normal", options = [
            schema.Option(display = "Low", value = "low"),
            schema.Option(display = "Normal", value = "normal"),
            schema.Option(display = "High", value = "high"),
        ]),
        schema.Dropdown(id = "text_size", name = "Text size", desc = "Larger text shows fewer lines per page.", icon = "textHeight", default = "standard", options = [
            schema.Option(display = "Small", value = "small"),
            schema.Option(display = "Standard", value = "standard"),
            schema.Option(display = "Large", value = "large"),
            schema.Option(display = "Extra large", value = "xlarge"),
        ]),
        schema.Dropdown(id = "text_weight", name = "Text weight", desc = "Bold draws each glyph one pixel wider.", icon = "bold", default = "normal", options = [
            schema.Option(display = "Normal", value = "normal"),
            schema.Option(display = "Bold", value = "bold"),
        ]),
    ]

def bousai_bool(config, key, default = False):
    v = config.get(key)
    if v == None or v == "":
        return default
    return v == True or v == "true" or v == "True" or v == "1"

# ---------------------------------------------------------------------------
# Colour

def bousai_rgb(c):
    c = c.lstrip("#")
    if len(c) == 3:
        c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2]
    return (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))

def bousai_hex(rgb):
    """(r, g, b) -> '#rrggbb'. Pixlet's % has no width flags, so pad by hand."""
    digits = "0123456789abcdef"
    out = "#"
    for i in range(3):
        v = max(0, min(255, int(rgb[i])))
        out += digits[v // 16] + digits[v % 16]
    return out

def bousai_mix(a, b, t):
    """Blend colour a toward b by fraction t (0..1)."""
    x, y = bousai_rgb(a), bousai_rgb(b)
    return bousai_hex([x[i] + (y[i] - x[i]) * t for i in range(3)])

def bousai_luma(c):
    r, g, b = bousai_rgb(c)
    return 0.299 * r + 0.587 * g + 0.114 * b

def bousai_on(c):
    """Readable text colour (black or white) on background c."""
    return "#000000" if bousai_luma(c) > 140 else "#ffffff"

# Seismic intensity scale. Keys are normalised JMA labels.
BOUSAI_INTENSITY_ORDER = ["0", "1", "2", "3", "4", "5-", "5+", "6-", "6+", "7"]

BOUSAI_INTENSITY_PALETTES = {
    # JMA-like ramp tuned for LEDs.
    "normal": ["#5a6070", "#8899aa", "#3d8bff", "#22c39a", "#f5e15b", "#ffb020", "#ff7a00", "#ff2e2e", "#c8102e", "#c03cff"],
    # Okabe-Ito based: blue/yellow/orange/purple axis plus a luminance ramp, no red-green pairs.
    "protan": ["#5a6070", "#8899aa", "#56b4e9", "#0072b2", "#f0e442", "#e69f00", "#d55e00", "#cc79a7", "#a0307a", "#ffffff"],
    # Red/cyan axis plus luminance, no blue-yellow pairs.
    "tritan": ["#5a6070", "#8899aa", "#4dd0e1", "#00897b", "#ffcdd2", "#ff8a80", "#ff5252", "#d50000", "#8b0000", "#ffffff"],
    "mono": ["#3a3a3a", "#555555", "#707070", "#8a8a8a", "#a3a3a3", "#bcbcbc", "#cfcfcf", "#e0e0e0", "#efefef", "#ffffff"],
}

# Severity scale shared by warnings, tsunami, volcano and alerts:
# 0 none, 1 info/forecast, 2 advisory (Lv2), 3 warning (Lv3), 4 urgent warning (Lv4), 5 emergency (Lv5).
BOUSAI_SEVERITY_PALETTES = {
    "normal": ["#5a6070", "#3d8bff", "#f2e700", "#ff2800", "#c040c0", "#ff40ff"],
    "protan": ["#5a6070", "#56b4e9", "#f0e442", "#e69f00", "#cc79a7", "#ffffff"],
    "tritan": ["#5a6070", "#4dd0e1", "#ffcdd2", "#ff5252", "#d50000", "#ffffff"],
    "mono": ["#555555", "#8a8a8a", "#a3a3a3", "#c8c8c8", "#e6e6e6", "#ffffff"],
}

BOUSAI_SEVERITY_EN = ["None", "Info", "Advisory", "Warning", "Urgent Warning", "Emergency Warning"]

BOUSAI_FONTS = {
    # text_size: (body font, line height, big font for numbers)
    "small": ("CG-pixel-3x5-mono", 6, "tb-8"),
    "standard": ("tom-thumb", 7, "6x13"),
    "large": ("tb-8", 9, "6x13"),
    "xlarge": ("6x10", 11, "10x20"),
}

def bousai_ui(config):
    """Resolve accessibility settings into colours and fonts. Returns a dict."""
    theme = config.get("theme") or "dark"
    palette = config.get("palette") or "normal"
    if palette not in BOUSAI_SEVERITY_PALETTES:
        palette = "normal"
    contrast = config.get("contrast") or "normal"
    size = config.get("text_size") or "standard"
    if size not in BOUSAI_FONTS:
        size = "standard"
    bold = (config.get("text_weight") or "normal") == "bold"

    if theme == "light":
        bg, fg, muted, faint, panel = "#f4f4f4", "#000000", "#555555", "#c8c8c8", "#dddddd"
        land = -0.3
    else:
        bg, fg, muted, faint, panel = "#000000", "#ffffff", "#9a9a9a", "#3a3a3a", "#141414"
        land = -0.62

    sev = list(BOUSAI_SEVERITY_PALETTES[palette])
    inten = list(BOUSAI_INTENSITY_PALETTES[palette])
    if theme == "light":
        # Pull bright LED colours down so they stay readable on a light background.
        sev = [bousai_mix(c, "#000000", 0.3) for c in sev]
        inten = [bousai_mix(c, "#000000", 0.3) for c in inten]

    if contrast == "low":
        fg = bousai_mix(fg, bg, 0.3)
        muted = bousai_mix(muted, bg, 0.3)
        sev = [bousai_mix(c, bg, 0.35) for c in sev]
        inten = [bousai_mix(c, bg, 0.35) for c in inten]
        land = land - 0.1 if theme != "light" else land + 0.1
    elif contrast == "high":
        muted = bousai_mix(muted, fg, 0.45)
        faint = bousai_mix(faint, fg, 0.3)
        land = land + 0.15 if theme != "light" else land - 0.15

    font, line_h, big = BOUSAI_FONTS[size]
    return {
        "theme": theme,
        "palette": palette,
        "contrast": contrast,
        "size": size,
        "bold": bold,
        "bg": bg,
        "fg": fg,
        "muted": muted,
        "faint": faint,
        "panel": panel,
        "accent": sev[1],
        "sev": sev,
        "intensity": dict(zip(BOUSAI_INTENSITY_ORDER, inten)),
        "land_brightness": land,
        "frame": contrast == "high",
        "font": font,
        "line_h": line_h,
        "big_font": big,
        "small_font": "CG-pixel-3x5-mono" if size in ("small", "standard") else font,
        "delay": 100,
    }

# ---------------------------------------------------------------------------
# Text and layout

def bousai_text(ui, s, color = None, font = None):
    """Text honouring the bold setting."""
    font = font or ui["font"]
    color = color or ui["fg"]
    if not ui["bold"]:
        return render.Text(s, font = font, color = color)
    return render.Stack(children = [
        render.Text(s, font = font, color = color),
        render.Padding(pad = (1, 0, 0, 0), child = render.Text(s, font = font, color = color)),
    ])

def bousai_text_width(ui, s, font = None):
    w = render.Text(s, font = font or ui["font"]).size()[0]
    return w + (1 if ui["bold"] else 0)

def bousai_budget_frames():
    """Frames available for the whole animation (dwell time / 100 ms; 150 when unbounded)."""
    budget = canvas.max_duration_ms()
    if budget <= 0:
        budget = 15000
    return max(1, budget // 100)

def bousai_ticker(ui, s, width, color = None, font = None, frames = None):
    """Scroll text that is wider than `width` within exactly `frames` frames.

    Unlike render.Marquee (fixed 1 px/frame, so long text overruns the dwell time), the ticker
    pauses, scrolls at whatever speed fits the frame budget (never faster than needed), then holds.
    """
    frames = frames or bousai_budget_frames()
    text = bousai_text(ui, s, color, font)
    h = bousai_font_height(ui, font) + 1
    travel = bousai_text_width(ui, s, font) - width
    if travel <= 0 or frames < 2:
        return render.Box(width = width, height = h, child = render.Row(expanded = True, children = [text]))
    lead = min(8, frames // 4)
    tail = min(8, frames // 6)
    moving = max(1, frames - lead - tail)
    children = []
    for i in range(frames):
        step = max(0, i - lead)
        if travel <= moving:
            off = min(travel, step)
        else:
            off = min(travel, (step * travel + moving - 1) // moving)
        children.append(render.Box(width = width, height = h, child = render.Row(expanded = True, children = [render.Padding(pad = (-off, 0, 0, 0), child = text)])))
    return render.Animation(children = children)

def bousai_fit(ui, s, width = None, color = None, font = None, align = "start", frames = None):
    """One line of text; scrolls (bounded to `frames`, default the whole dwell) when wider than width."""
    width = width or canvas.width()
    if bousai_text_width(ui, s, font) <= width:
        return render.Box(width = width, height = bousai_font_height(ui, font) + 1, child = render.Row(main_align = align, expanded = True, children = [bousai_text(ui, s, color, font)]))
    return bousai_ticker(ui, s, width, color, font, frames)

def bousai_font_height(ui, font = None):
    return render.Text("Mg", font = font or ui["font"]).size()[1]

def bousai_header(ui, title, color = None, right = None, frames = None):
    """Title band. color is the band colour (defaults to panel); text picks a readable colour."""
    band = color or ui["panel"]
    text_color = bousai_on(band) if color else ui["fg"]
    h = ui["line_h"]
    width = canvas.width()
    right_w = 0
    children = []
    if right:
        right_w = bousai_text_width(ui, right) + 2
    children.append(render.Padding(pad = (1, 0, 0, 0), child = bousai_fit(ui, title, width = width - right_w - 1, color = text_color, frames = frames)))
    if right:
        children.append(render.Padding(pad = (width - right_w + 1, 0, 0, 0), child = bousai_text(ui, right, text_color)))
    return render.Box(width = width, height = h, color = band, child = render.Stack(children = children))

def bousai_row(ui, item, frames = None):
    """Normalise a row: str or (text, color) become a text line inset 1 px from the left edge
    (like the header title); a prebuilt widget is used as is."""
    if type(item) == "string":
        item = (item, None)
    if type(item) == "tuple" or type(item) == "list":
        line = bousai_fit(ui, item[0], width = canvas.width() - 1, color = item[1], frames = frames)
        return render.Padding(pad = (1, 0, 0, 0), child = line)
    return item

def bousai_hold_frames(pages, min_ms = 2500):
    """Frames per page when `pages` pages share the dwell time (at least min_ms each)."""
    return max(min_ms // 100, bousai_budget_frames() // max(1, pages))

def bousai_hold(widget, frames):
    """Keep widget on screen for at least `frames` frames (marquees keep scrolling)."""
    return render.Stack(children = [widget, render.Animation(children = [render.Box(width = 1, height = 1)] * max(1, frames))])

def bousai_pages(ui, header, rows, footer = None):
    """Paginate rows under a header to fit the text size. Returns a widget.

    header: None, a title string, a (title, band_color[, right_text]) tuple, or a prebuilt widget.
    rows: str | (text, color) | widget. Strings/tuples scroll within their page's share of the
    dwell time; prebuilt widgets are used as is (keep their animation within bousai_hold_frames).
    """
    height = canvas.height()
    header_h = ui["line_h"] if header != None else 0
    footer_h = ui["line_h"] if footer != None else 0
    per_page = max(1, (height - header_h - footer_h) // ui["line_h"])
    rows = rows or [("No data", ui["muted"])]
    n_pages = (len(rows) + per_page - 1) // per_page
    frames = bousai_hold_frames(n_pages) if n_pages > 1 else bousai_budget_frames()
    if type(header) == "string":
        header = bousai_header(ui, header, frames = frames)
    elif type(header) == "tuple" or type(header) == "list":
        header = bousai_header(ui, header[0], header[1] if len(header) > 1 else None, header[2] if len(header) > 2 else None, frames = frames)
    rows = [bousai_row(ui, r, frames) for r in rows]
    pages = []
    for i in range(0, len(rows), per_page):
        children = []
        if header != None:
            children.append(header)
        for r in rows[i:i + per_page]:
            children.append(render.Box(width = canvas.width(), height = ui["line_h"], child = r))
        body = render.Box(width = canvas.width(), height = height, child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = children))
        if footer != None:
            body = render.Stack(children = [body, render.Padding(pad = (0, height - footer_h, 0, 0), child = footer)])
        pages.append(body)
    if len(pages) == 1:
        return pages[0]
    return render.Sequence(children = [bousai_hold(p, frames) for p in pages])

def bousai_root(ui, child):
    return render.Root(delay = ui["delay"], child = render.Box(width = canvas.width(), height = canvas.height(), color = ui["bg"], child = child))

def bousai_message(ui, title, lines, color = None):
    """Full-screen notice (errors, 'no data', setup hints)."""
    return bousai_root(ui, bousai_pages(ui, (title, color), [(l, ui["muted"]) for l in lines]))

def bousai_badge(ui, label, color, width = None, font = None):
    """Coloured box with a centred label (colour is never the only cue)."""
    font = font or ui["font"]
    w = width or (bousai_text_width(ui, label, font) + 3)
    h = bousai_font_height(ui, font) + 2
    return render.Box(width = w, height = h, color = color, child = bousai_text(ui, label, bousai_on(color), font))

def bousai_blink(ui, widget, width, height, on_frames = 6, off_frames = 3):
    """Blinking emphasis; kept static in low-contrast mode to avoid stimulation."""
    if ui["contrast"] == "low":
        return widget
    return render.Animation(children = [widget] * on_frames + [render.Box(width = width, height = height)] * off_frames)

# ---------------------------------------------------------------------------
# Severity and seismic intensity

def bousai_sev_color(ui, level):
    return ui["sev"][max(0, min(5, level))]

def bousai_intensity_norm(v):
    """Normalise JMA / P2PQuake / EEW intensity notations to '0'..'7', '5-', '5+', '6-', '6+'. Unknown -> None."""
    if v == None:
        return None
    s = str(v).strip()
    table = {
        "5弱": "5-",
        "5強": "5+",
        "6弱": "6-",
        "6強": "6+",
        "5-": "5-",
        "5+": "5+",
        "6-": "6-",
        "6+": "6+",
        "5L": "5-",
        "5U": "5+",
        "6L": "6-",
        "6U": "6+",
        "10": "1",
        "20": "2",
        "30": "3",
        "40": "4",
        "45": "5-",
        "46": "5-",
        "50": "5+",
        "55": "6-",
        "60": "6+",
        "70": "7",
    }
    if s in table:
        return table[s]
    if s in BOUSAI_INTENSITY_ORDER:
        return s
    if s.startswith("震度"):
        return bousai_intensity_norm(s[2:])
    return None

def bousai_intensity_rank(label):
    """Index in BOUSAI_INTENSITY_ORDER, -1 for unknown."""
    if label in BOUSAI_INTENSITY_ORDER:
        return BOUSAI_INTENSITY_ORDER.index(label)
    return -1

def bousai_intensity_color(ui, label):
    return ui["intensity"].get(label, ui["muted"])

def bousai_intensity_from_value(x):
    if x < 0.5:
        return "0"
    if x < 1.5:
        return "1"
    if x < 2.5:
        return "2"
    if x < 3.5:
        return "3"
    if x < 4.5:
        return "4"
    if x < 5.0:
        return "5-"
    if x < 5.5:
        return "5+"
    if x < 6.0:
        return "6-"
    if x < 6.5:
        return "6+"
    return "7"

# ---------------------------------------------------------------------------
# Time

def bousai_now():
    return time.now().in_location(BOUSAI_JST)

def bousai_parse_time(s):
    """Parse JMA / P2PQuake / Wolfx / NIED timestamps (JST when no offset). Returns None if unparseable."""
    if not s:
        return None
    s = str(s).strip()
    if "T" in s and len(s) >= 19:
        if s.endswith("Z") or "+" in s[10:] or s[-6] == "-":
            return time.parse_time(s)
        return time.parse_time(s[:19], format = "2006-01-02T15:04:05", location = BOUSAI_JST)
    if len(s) == 14 and s.isdigit():
        return time.parse_time(s, format = "20060102150405", location = BOUSAI_JST)
    if len(s) >= 19 and s[4] == "/":
        return time.parse_time(s[:19], format = "2006/01/02 15:04:05", location = BOUSAI_JST)
    if len(s) == 16 and s[4] == "/":
        return time.parse_time(s, format = "2006/01/02 15:04", location = BOUSAI_JST)
    if len(s) >= 19 and s[4] == "-":
        return time.parse_time(s[:19], format = "2006-01-02 15:04:05", location = BOUSAI_JST)
    return None

def bousai_tz(config):
    loc = bousai_location(config)
    return loc["tz"]

def bousai_hhmm(t, tz = BOUSAI_JST):
    return t.in_location(tz).format("15:04") if t else "--:--"

def bousai_mdhm(t, tz = BOUSAI_JST):
    return t.in_location(tz).format("1/2 15:04") if t else "--"

def bousai_ago(t, now = None):
    """Compact relative age: 45s, 12m, 3h, 2d."""
    if not t:
        return "?"
    now = now or time.now()
    secs = int((now - t).seconds)
    if secs < 0:
        secs = 0
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm" % (secs // 60)
    if secs < 86400 * 2:
        return "%dh" % (secs // 3600)
    return "%dd" % (secs // 86400)

def bousai_fixed(x, digits = 1):
    """Format a number with exactly `digits` decimals (Starlark's % lacks precision)."""
    m = int(math.pow(10, digits))
    n = int(math.round(abs(float(x)) * m))
    sign = "-" if x < 0 and n != 0 else ""
    if digits <= 0:
        return sign + str(n)
    frac = str(n % m)
    return "%s%d.%s" % (sign, n // m, "0" * (digits - len(frac)) + frac)

# ---------------------------------------------------------------------------
# Geo

def bousai_distance_km(lat1, lon1, lat2, lon2):
    r = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = p2 - p1
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2) * math.sin(dp / 2) + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) * math.sin(dl / 2)
    return 2 * r * math.atan2(math.sqrt(a), math.sqrt(1 - a))

def bousai_bearing_name(lat1, lon1, lat2, lon2):
    """16-point compass direction from point 1 to point 2."""
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    deg = (math.degrees(math.atan2(y, x)) + 360.0) % 360.0
    names = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    return names[int((deg + 11.25) // 22.5) % 16]

# ---------------------------------------------------------------------------
# Location -> JMA areas

def bousai_location(config):
    """Configured location: {lat, lon, label, tz}. Coordinates rounded to 0.001 deg (~100 m)."""
    raw = config.get("location") or BOUSAI_DEFAULT_LOCATION
    loc = json.decode(raw, default = None) or json.decode(BOUSAI_DEFAULT_LOCATION)
    lat = float(loc.get("lat", "35.6812"))
    lon = float(loc.get("lng", "139.7671"))
    return {
        "lat": math.round(lat * 1000) / 1000.0,
        "lon": math.round(lon * 1000) / 1000.0,
        "label": loc.get("locality") or loc.get("description") or "",
        "tz": loc.get("timezone") or BOUSAI_JST,
    }

def bousai_area_table():
    """JMA area.json (centers/offices/class10s/class15s/class20s with enName). Cached for a day."""
    return bousai_get_json(BOUSAI_AREA_JSON, ttl = 86400)

def bousai_in_ring(lon, lat, ring):
    """Even-odd ray casting; ring is [[lon, lat], ...]."""
    inside = False
    j = len(ring) - 1
    for i in range(len(ring)):
        xi, yi = ring[i][0], ring[i][1]
        xj, yj = ring[j][0], ring[j][1]
        if (yi > lat) != (yj > lat) and lon < (xj - xi) * (lat - yi) / (yj - yi) + xi:
            inside = not inside
        j = i
    return inside

def bousai_in_geometry(lon, lat, geometry):
    """Point in a GeoJSON Polygon / MultiPolygon by even-odd parity over every ring.

    JMA's class20 files store separate islands as extra rings of one Polygon, so rings
    cannot be read as outer + holes; parity handles both islands and real holes.
    """
    polys = [geometry["coordinates"]] if geometry["type"] == "Polygon" else geometry["coordinates"]
    hits = 0
    for poly in polys:
        for ring in poly:
            if bousai_in_ring(lon, lat, ring):
                hits += 1
    return hits % 2 == 1

def bousai_locate_class20(lat, lon):
    """Municipality (class20) containing lat/lon, the way JMA's own pages do it.

    Bounding boxes from class20relm.json pick candidates; their simplified polygons decide.
    A point in no polygon (coast, small islands) takes the nearest box centre within ~25 km.
    Only JMA is contacted, and only with area codes.
    """
    if lat < 20.0 or lat > 46.5 or lon < 122.0 or lon > 154.5:
        return None
    relm = bousai_get_json(BOUSAI_CLASS20_BOXES, ttl = 86400)
    if relm == None:
        return None
    candidates = []
    nearest, best = None, 0.25 * 0.25
    for code, box in relm.items():
        sw, ne = box["sw"], box["ne"]
        if sw[0] <= lat and lat <= ne[0] and sw[1] <= lon and lon <= ne[1]:
            candidates.append(((ne[0] - sw[0]) * (ne[1] - sw[1]), code))
        d = ((sw[0] + ne[0]) / 2.0 - lat) * ((sw[0] + ne[0]) / 2.0 - lat) + ((sw[1] + ne[1]) / 2.0 - lon) * ((sw[1] + ne[1]) / 2.0 - lon)
        if d < best:
            nearest, best = code, d
    for _, code in sorted(candidates)[:8]:
        shape = bousai_get_json(BOUSAI_CLASS20_SHAPE % code, ttl = 30 * 86400)
        if shape and shape.get("features") and bousai_in_geometry(lon, lat, shape["features"][0]["geometry"]):
            return code
    return nearest

def bousai_area(config):
    """Resolve the configured location to JMA forecast areas.

    Returns a dict with keys class20, class15, class10, office, center (codes), pref (2-digit),
    and *_en names; or None when the location is outside Japan / cannot be resolved.
    """
    loc = bousai_location(config)
    override = (config.get("area_override") or "").strip()
    cache_key = "bousai_area:%s:%s:%s" % (override, bousai_fixed(loc["lat"], 3), bousai_fixed(loc["lon"], 3))
    cached = cache.get(cache_key)
    if cached:
        return json.decode(cached, default = None)

    table = bousai_area_table()
    if table == None:
        return None
    class20s = table["class20s"]
    if override:
        code = override if override in class20s else None
    else:
        code = bousai_locate_class20(loc["lat"], loc["lon"])
    if code == None or code not in class20s:
        return None

    c20 = class20s[code]
    c15_code = c20["parent"]
    c15 = table["class15s"].get(c15_code, {})
    c10_code = c15.get("parent", "")
    c10 = table["class10s"].get(c10_code, {})
    office_code = c10.get("parent", "")
    office = table["offices"].get(office_code, {})
    area = {
        "class20": code,
        "class15": c15_code,
        "class10": c10_code,
        "office": office_code,
        "center": office.get("parent", ""),
        "pref": code[:2],
        "class20_en": c20.get("enName", code),
        "class15_en": c15.get("enName", ""),
        "class10_en": c10.get("enName", ""),
        "office_en": office.get("enName", ""),
        "lat": loc["lat"],
        "lon": loc["lon"],
    }
    cache.set(cache_key, json.encode(area), ttl_seconds = 7 * 86400)
    return area

def bousai_land_filter(ui, child):
    """Tint a mid-grey land bitmap for the active theme."""
    return filter.Brightness(child = child, change = ui["land_brightness"])

# ---- src/lib/bousai_mapdata.star -------------------------------------------

# name -> {zoom, x0, y0 (Web Mercator world-pixel origin), w, h, png (base64)}
BOUSAI_BASEMAPS = {
    "japan": {
        "zoom": 4,
        "x0": 3413,
        "y0": 1441,
        "w": 398,
        "h": 375,
        "png": "",
    },
    "pacific": {
        "zoom": 2,
        "x0": 782,
        "y0": 297,
        "w": 242,
        "h": 229,
        "png": "",
    },
}

# ---- src/lib/bousai_map.star -----------------------------------------------

BOUSAI_JMATILE = "https://www.jma.go.jp/bosai/jmatile/data"
BOUSAI_MASK_URL = BOUSAI_JMATILE + "/map/none/none/none/surf/mask/{z}/{x}/{y}.png"

def bousai_world_px(lat, lon, zoom):
    """Web Mercator world pixel coordinates (256 px tiles) at a fractional zoom."""
    size = 256.0 * math.pow(2, zoom)
    lat = max(-85.0, min(85.0, lat))
    r = math.radians(lat)
    x = (lon + 180.0) / 360.0 * size
    y = (1.0 - math.log(math.tan(r) + 1.0 / math.cos(r)) / math.pi) / 2.0 * size
    return x, y

def bousai_view(lat, lon, zoom, width = None, height = None):
    """A map view centred on lat/lon. zoom may be fractional."""
    w = width or canvas.width()
    h = height or canvas.height()
    cx, cy = bousai_world_px(lat, lon, zoom)
    return {"zoom": zoom, "ox": cx - w / 2.0, "oy": cy - h / 2.0, "w": w, "h": h}

def bousai_view_fit(points, width = None, height = None, pad = 3, min_zoom = 2.0, max_zoom = 9.0):
    """Smallest-zoom-out view containing every (lat, lon) in points."""
    w = width or canvas.width()
    h = height or canvas.height()
    xs, ys = [], []
    for p in points:
        x, y = bousai_world_px(p[0], p[1], 0)
        xs.append(x)
        ys.append(y)
    dx = max(max(xs) - min(xs), 0.0001)
    dy = max(max(ys) - min(ys), 0.0001)
    fit = min((w - 2 * pad) / dx, (h - 2 * pad) / dy)
    zoom = max(min_zoom, min(max_zoom, math.log(fit, 2)))
    clat, clon = bousai_unproject((min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0, 0)
    return bousai_view(clat, clon, zoom, w, h)

def bousai_unproject(x, y, zoom):
    size = 256.0 * math.pow(2, zoom)
    lon = x / size * 360.0 - 180.0
    n = math.pi - 2.0 * math.pi * y / size
    lat = math.degrees(math.atan(0.5 * (math.exp(n) - math.exp(-n))))
    return lat, lon

def bousai_view_xy(view, lat, lon):
    """Screen pixel of lat/lon in view (ints, may be off-screen)."""
    x, y = bousai_world_px(lat, lon, view["zoom"])
    return int(math.floor(x - view["ox"])), int(math.floor(y - view["oy"]))

def bousai_in_view(view, x, y):
    return x >= 0 and y >= 0 and x < view["w"] and y < view["h"]

def bousai_place(x, y, child):
    """Position child with its top-left at (x, y); negative offsets are clipped by the parent."""
    return render.Padding(pad = (x, y, 0, 0), child = child)

def bousai_basemap(ui, view, name = "japan"):
    """Embedded land silhouette scaled into the view, tinted for the theme."""
    m = BOUSAI_BASEMAPS[name]
    scale = math.pow(2, view["zoom"] - m["zoom"])
    w = max(1, int(m["w"] * scale + 0.5))
    h = max(1, int(m["h"] * scale + 0.5))
    x = int(math.floor(m["x0"] * scale - view["ox"]))
    y = int(math.floor(m["y0"] * scale - view["oy"]))
    img = render.Image(src = base64.decode(m["png"]), width = w, height = h)
    return bousai_place(x, y, bousai_land_filter(ui, img))

def bousai_tile_layer(view, url_template, tile_zoom, ttl = 300, max_tiles = 9):
    """Slippy-map tiles at integer tile_zoom, scaled into view. Missing tiles (no data) are skipped.

    url_template uses {z}/{x}/{y}. Returns a list of positioned widgets for a render.Stack.
    """
    scale = math.pow(2, view["zoom"] - tile_zoom)
    tile_px = 256.0 * scale
    ox = view["ox"] / scale
    oy = view["oy"] / scale
    tx0 = int(math.floor(ox / 256.0))
    ty0 = int(math.floor(oy / 256.0))
    tx1 = int(math.floor((ox + view["w"] / scale - 0.001) / 256.0))
    ty1 = int(math.floor((oy + view["h"] / scale - 0.001) / 256.0))
    n = int(math.pow(2, tile_zoom))
    out = []
    count = 0
    for ty in range(ty0, ty1 + 1):
        if ty < 0 or ty >= n:
            continue
        for tx in range(tx0, tx1 + 1):
            if count >= max_tiles:
                return out
            count += 1
            src = bousai_get_bytes(url_template.format(z = tile_zoom, x = tx % n, y = ty), ttl = ttl)
            if src == None:
                continue
            px = int(math.floor(tx * tile_px - view["ox"]))
            py = int(math.floor(ty * tile_px - view["oy"]))
            nx = int(math.floor((tx + 1) * tile_px - view["ox"]))
            ny = int(math.floor((ty + 1) * tile_px - view["oy"]))
            out.append(bousai_place(px, py, render.Image(src = src, width = nx - px, height = ny - py)))
    return out

def bousai_jmatile_times(path, ttl = 60):
    """JMA tile target-time index, e.g. 'nowc/targetTimes_N1.json'. Returns [] on failure."""
    return bousai_get_json(BOUSAI_JMATILE + "/" + path, ttl = ttl) or []

def bousai_jmatile_url(kind, basetime, validtime, element, member = "none"):
    """Tile URL template for a JMA tile product (kind: nowc, rasrf, wdist, snow, risk, ...)."""
    return "%s/%s/%s/%s/%s/surf/%s/{z}/{x}/{y}.png" % (BOUSAI_JMATILE, kind, basetime, member, validtime, element)

def bousai_mask_layer(view, tile_zoom):
    """JMA coastline/prefecture border overlay."""
    return bousai_tile_layer(view, BOUSAI_MASK_URL, tile_zoom, ttl = 7 * 86400)

def bousai_marker(ui, view, lat, lon, color, size = 3):
    """Square marker centred on lat/lon, with a contrasting outline when contrast is high."""
    x, y = bousai_view_xy(view, lat, lon)
    half = size // 2
    box = render.Box(width = size, height = size, color = color)
    if ui["frame"]:
        box = render.Box(width = size + 2, height = size + 2, color = ui["bg"], child = box)
        half += 1
    return bousai_place(x - half, y - half, box)

def bousai_cross(ui, view, lat, lon, color, arm = 2):
    """'+' marker for epicentres / your location; haloed in high contrast."""
    x, y = bousai_view_xy(view, lat, lon)
    layers = []
    if ui["frame"]:
        layers.append(bousai_place(x - arm - 1, y - 1, render.Box(width = 2 * arm + 3, height = 3, color = ui["bg"])))
        layers.append(bousai_place(x - 1, y - arm - 1, render.Box(width = 3, height = 2 * arm + 3, color = ui["bg"])))
    layers.append(bousai_place(x - arm, y, render.Box(width = 2 * arm + 1, height = 1, color = color)))
    layers.append(bousai_place(x, y - arm, render.Box(width = 1, height = 2 * arm + 1, color = color)))
    return render.Stack(children = layers)

def bousai_map_frame(ui, view, layers):
    """Clip layers to the view size over the theme background."""
    return render.Box(width = view["w"], height = view["h"], color = ui["bg"], child = render.Stack(children = layers))

# ---- src/lib/bousai_typhoon.star -------------------------------------------

BOUSAI_TYPHOON_URL = "https://www.jma.go.jp/bosai/typhoon/data/"

BOUSAI_TYPHOON_CLASS = {
    "TD": "Tropical Depression",
    "TS": "Tropical Storm",
    "STS": "Severe Tropical Storm",
    "TY": "Typhoon",
    "LOW": "Extratropical Cyclone",
}

BOUSAI_TYPHOON_INTENSITY = {
    "強い": "",
    "非常に強い": "Very Strong",
    "猛烈な": "Violent",
}

BOUSAI_TYPHOON_SCALE = {
    "大型": "Large",
    "超大型": "Very large",
}

BOUSAI_TYPHOON_DIRS = {
    "北": "N",
    "北北東": "NNE",
    "北東": "NE",
    "東北東": "ENE",
    "東": "E",
    "東南東": "ESE",
    "南東": "SE",
    "南南東": "SSE",
    "南": "S",
    "南南西": "SSW",
    "南西": "SW",
    "西南西": "WSW",
    "西": "W",
    "西北西": "WNW",
    "北西": "NW",
    "北北西": "NNW",
    "全域": "all around",
}

BOUSAI_TYPHOON_SPEED_WORDS = {
    "ゆっくり": "Slow",
    "ほとんど停滞": "Almost stationary",
}

# ---------------------------------------------------------------------------
# Parsing helpers

def bousai_typhoon_num(v):
    """JMA numeric string/number -> int or float; None for '', '-', words."""
    if v == None:
        return None
    if type(v) == "int" or type(v) == "float":
        return v
    s = str(v).strip()
    if s == "" or not s.replace(".", "", 1).isdigit():
        return None
    return float(s) if "." in s else int(s)

def bousai_typhoon_int(v):
    n = bousai_typhoon_num(v)
    return None if n == None else int(n + 0.5)

def bousai_typhoon_sev(cat, intensity_en = ""):
    """Display severity 0..5 for ui["sev"]: TD 1, TS 2, STS 3, TY 4, Violent TY 5, extratropical 0."""
    if cat == "LOW":
        return 0
    if cat == "TD":
        return 1
    if cat == "TS":
        return 2
    if cat == "STS":
        return 3
    return 5 if intensity_en == "Violent" else 4

def bousai_typhoon_category_en(cat, intensity_en = ""):
    """'Violent Typhoon', 'Typhoon', 'Severe Tropical Storm', ... (JMA English wording)."""
    base = BOUSAI_TYPHOON_CLASS.get(cat, cat or "Tropical Cyclone")
    if cat == "TY" and intensity_en:
        return intensity_en + " Typhoon"
    return base

def bousai_typhoon_dir(jp):
    """English direction for a JMA direction: a Japanese string ('北西'), or a {"jp", "en"} dict, which JMA uses for
    the whole-area wind radius ({"jp": "全域", "en": "All"})."""
    if type(jp) == "dict":
        return BOUSAI_TYPHOON_DIRS.get(jp.get("jp") or "", jp.get("en") or "")
    return BOUSAI_TYPHOON_DIRS.get(jp or "", "")

def bousai_typhoon_area_km(areas):
    """[{area, range: {km}}] -> [(English direction, km)] (empty when the radius is missing)."""
    out = []
    for a in areas or []:
        km = bousai_typhoon_int(((a.get("range") or {}).get("km")))
        if km != None:
            out.append((bousai_typhoon_dir(a.get("area")), km))
    return out

def bousai_typhoon_step(part, loc):
    """Normalise one specifications.json part (analysis or forecast)."""
    pos = (part.get("position") or {}).get("deg") or [None, None]
    wind = part.get("maximumWind") or {}
    cat = ((part.get("category") or {}).get("en")) or ""
    intensity = BOUSAI_TYPHOON_INTENSITY.get(part.get("intensity") or "", "")
    speed = part.get("speed") or {}
    speed_raw = speed.get("km/h")
    lat = pos[0]
    lon = pos[1]
    out = {
        "hours": bousai_typhoon_int(part.get("advancedHours")) or 0,
        "valid": bousai_parse_time(((part.get("validtime") or {}).get("JST"))),
        "lat": lat,
        "lon": lon,
        "cat": cat,
        "intensity_en": intensity,
        "category_en": bousai_typhoon_category_en(cat, intensity),
        "sev": bousai_typhoon_sev(cat, intensity),
        "scale_en": BOUSAI_TYPHOON_SCALE.get(part.get("scale") or "", ""),
        "pressure_hpa": bousai_typhoon_int(part.get("pressure")),
        "wind_ms": bousai_typhoon_int((wind.get("sustained") or {}).get("m/s")),
        "wind_kt": bousai_typhoon_int((wind.get("sustained") or {}).get("kt")),
        "gust_ms": bousai_typhoon_int((wind.get("gust") or {}).get("m/s")),
        "gust_kt": bousai_typhoon_int((wind.get("gust") or {}).get("kt")),
        "course_en": bousai_typhoon_dir(part.get("course")),
        "speed_kmh": bousai_typhoon_int(speed_raw),
        "speed_kt": bousai_typhoon_int(speed.get("kt")),
        "speed_word": BOUSAI_TYPHOON_SPEED_WORDS.get(speed_raw or "", ""),
        "radius_km": bousai_typhoon_int((part.get("probabilityCircleRadius") or {}).get("km")),
        "storm_km": bousai_typhoon_area_km(part.get("stormWarning")),
        "gale_km": bousai_typhoon_area_km(part.get("galeWarning")),
        "distance_km": None,
        "bearing": "",
    }
    if lat != None and lon != None:
        out["distance_km"] = int(bousai_distance_km(loc["lat"], loc["lon"], lat, lon) + 0.5)
        out["bearing"] = bousai_bearing_name(loc["lat"], loc["lon"], lat, lon)
    return out

def bousai_typhoon_build(tc_id, spec, forecast, loc):
    """Typhoon dict from specifications.json (+ optional forecast.json track) or None.

    Keys: tc_id, number, name_en, cat, category_en, intensity_en, scale_en, sev, pressure_hpa,
    wind_ms/kt, gust_ms/kt, lat, lon, course_en, speed_kmh/kt/word, issued, valid, distance_km,
    bearing, storm_km, gale_km ([(direction, km)]), steps (forecast parts, oldest first, each with
    hours, valid, lat, lon, cat, category_en, sev, pressure_hpa, wind_ms, gust_ms, radius_km, ...),
    past ([[lat, lon]] oldest first), gale_circle ([lat, lon, km] or None).
    """
    if type(spec) != "list" or not spec:
        return None
    title = {}
    analysis = None
    steps = []
    for part in spec:
        if type(part) != "dict":
            continue
        if part.get("part") == "title":
            title = part
        elif bousai_typhoon_int(part.get("advancedHours")) == 0 and analysis == None:
            analysis = bousai_typhoon_step(part, loc)
        elif (bousai_typhoon_int(part.get("advancedHours")) or 0) > 0:
            steps.append(bousai_typhoon_step(part, loc))
    if analysis == None or analysis["lat"] == None:
        return None
    number_text = str(title.get("typhoonNumber") or "")
    number = None
    if len(number_text) == 4 and number_text.isdigit():
        number = int(number_text[2:])
    past = []
    gale_circle = None
    for entry in forecast or []:
        if type(entry) != "dict" or bousai_typhoon_int(entry.get("advancedHours")) != 0:
            continue
        track = entry.get("track") or {}
        for pt in (track.get("preTyphoon") or []) + (track.get("typhoon") or []):
            if len(pt) == 2 and (not past or past[-1] != pt):
                past.append(pt)
        gale = entry.get("galeWarningArea") or {}
        if gale.get("center") and gale.get("radius"):
            gale_circle = [gale["center"][0], gale["center"][1], int(gale["radius"] / 1000.0 + 0.5)]
    out = dict(analysis)
    out.update({
        "tc_id": tc_id,
        "number": number,
        "name_en": ((title.get("name") or {}).get("en") or "").strip(),
        "issued": bousai_parse_time(((title.get("issue") or {}).get("JST"))) or analysis["valid"],
        "steps": steps,
        "past": past,
        "gale_circle": gale_circle,
    })
    return out

def bousai_typhoon_list(config, with_track = True):
    """Rich dicts for every active tropical cyclone (extratropical ones dropped), nearest first.

    Returns None when JMA's target list is unavailable, [] when no cyclone is active. Each dict is a
    bousai_typhoon_build result; with_track=False skips forecast.json (no past track).
    """
    targets = bousai_get_json(BOUSAI_TYPHOON_URL + "targetTc.json", ttl = 300)
    if type(targets) != "list":
        return None
    loc = bousai_location(config)
    out = []
    for t in targets:
        if type(t) != "dict" or t.get("category") == "LOW":
            continue
        tc_id = t.get("tropicalCyclone") or ""
        if not tc_id:
            continue
        spec = bousai_get_json(BOUSAI_TYPHOON_URL + "%s/specifications.json" % tc_id, ttl = 600)
        forecast = bousai_get_json(BOUSAI_TYPHOON_URL + "%s/forecast.json" % tc_id, ttl = 600) if with_track else None
        ty = bousai_typhoon_build(tc_id, spec, forecast, loc)
        if ty != None and ty["cat"] != "LOW":
            out.append(ty)
    return sorted(out, key = lambda t: (t["distance_km"] or 0, t["tc_id"]))

def bousai_typhoon_current(config):
    """Active typhoons / tropical cyclones from JMA, nearest to the configured location first.

    Returns [{tc_id, number, name_en, category_en, pressure_hpa, wind_ms, gust_ms, lat, lon,
    course_en, speed_kmh, issued, distance_km, bearing}]: tc_id is JMA's id ("TC2636"), number the
    typhoon number (30 for "Typhoon No. 30", None for a depression), category_en JMA's English class
    ("Violent Typhoon", "Very Strong Typhoon", "Typhoon", "Severe Tropical Storm", "Tropical Storm",
    "Tropical Depression"), pressure in hPa, wind_ms the maximum sustained and gust_ms the maximum
    gust in m/s (None when unpublished), course_en the movement as a 16-point compass name (or
    "Slow"/"Almost stationary"), speed_kmh in km/h (None when slow), issued the analysis issue time
    (time object) and distance_km / bearing (16-point compass name from the configured location to
    the typhoon centre). [] when none is active or the feed is unavailable.
    """
    out = []
    for t in bousai_typhoon_list(config, False) or []:
        out.append({
            "tc_id": t["tc_id"],
            "number": t["number"],
            "name_en": t["name_en"],
            "category_en": t["category_en"],
            "pressure_hpa": t["pressure_hpa"],
            "wind_ms": t["wind_ms"],
            "gust_ms": t["gust_ms"],
            "lat": t["lat"],
            "lon": t["lon"],
            "course_en": t["course_en"] or t["speed_word"],
            "speed_kmh": t["speed_kmh"],
            "issued": t["issued"],
            "distance_km": t["distance_km"],
            "bearing": t["bearing"],
        })
    return out

# ---------------------------------------------------------------------------
# Geometry

def bousai_typhoon_circle(lat, lon, radius_km, points = 24):
    """Great-circle ring of `points` (lat, lon) vertices at radius_km around a centre."""
    d = radius_km / 6371.0
    p1 = math.radians(lat)
    l1 = math.radians(lon)
    out = []
    for i in range(points):
        b = 2 * math.pi * i / points
        p2 = math.asin(math.sin(p1) * math.cos(d) + math.cos(p1) * math.sin(d) * math.cos(b))
        l2 = l1 + math.atan2(math.sin(b) * math.sin(d) * math.cos(p1), math.cos(d) - math.sin(p1) * math.sin(p2))
        out.append((math.degrees(p2), math.degrees(l2)))
    return out

def bousai_typhoon_closest(ty, loc):
    """Closest approach of the forecast centre line to the configured location: (km, hours) or None."""
    pts = [(0, ty["lat"], ty["lon"])]
    for s in ty["steps"]:
        pts.append((s["hours"], s["lat"], s["lon"]))
    if len(pts) < 2:
        return None
    best = None
    for i in range(len(pts) - 1):
        a = pts[i]
        b = pts[i + 1]
        for k in range(0, 7):
            t = k / 6.0
            lat = a[1] + (b[1] - a[1]) * t
            lon = a[2] + (b[2] - a[2]) * t
            d = bousai_distance_km(loc["lat"], loc["lon"], lat, lon)
            if best == None or d < best[0]:
                best = (d, a[0] + (b[0] - a[0]) * t)
    return (int(best[0] + 0.5), int(best[1] + 0.5))

# ---------------------------------------------------------------------------
# Demo sample

def bousai_typhoon_stamp(base, hours):
    """{"JST": RFC3339 time} for `hours` after base, in JMA's specifications.json shape."""
    return {"JST": (base + time.parse_duration("%dh" % hours)).format("2006-01-02T15:04:05-07:00")}

def bousai_typhoon_demo(config):
    """Embedded sample for previews and the 'Show sample alert' toggle: a list with one typhoon.

    Modelled on Typhoon No. 10 (Shanshan) approaching Kyushu on 28-29 August 2024: a large, very
    strong typhoon heading north-north-west then north-east over Kyushu and Shikoku. Positions,
    intensities and radii are rounded illustrations, not an archived JMA record; times are relative
    to now so the sample always looks current.
    """
    loc = bousai_location(config)
    n = bousai_now()
    base = time.time(year = n.year, month = n.month, day = n.day, hour = n.hour, location = BOUSAI_JST)

    # advancedHours, lat, lon, category, intensity, hPa, wind, gust, radius km, course, km/h
    rows = [
        (0, 30.1, 129.9, "TY", "非常に強い", 945, 45, 65, 0, "北北西", 20),
        (12, 32.0, 130.2, "TY", "強い", 955, 40, 55, 70, "北", 15),
        (24, 33.1, 131.5, "STS", "-", 980, 28, 40, 90, "北東", 20),
        (45, 34.0, 134.4, "TS", "-", 990, 23, 35, 150, "東北東", 20),
        (69, 35.2, 137.8, "TS", "-", 992, 20, 30, 220, "東北東", 30),
        (93, 36.8, 141.5, "LOW", "-", 996, 0, 0, 320, "東北東", 45),
        (117, 38.2, 146.5, "LOW", "-", 998, 0, 0, 460, "東", 50),
    ]
    spec = [{
        "part": "title",
        "issue": bousai_typhoon_stamp(base, 0),
        "typhoonNumber": "2410",
        "name": {"jp": "サンサン", "en": "Shanshan"},
        "category": {"jp": "台風", "en": "TY"},
    }]
    for hours, lat, lon, cat, intensity, hpa, wind, gust, radius, course, speed in rows:
        part = {
            "advancedHours": hours,
            "category": {"en": cat},
            "intensity": intensity,
            "position": {"deg": [lat, lon]},
            "course": course,
            "speed": {"km/h": str(speed), "kt": str(int(speed / 1.852 + 0.5))},
            "pressure": str(hpa),
            "validtime": bousai_typhoon_stamp(base, hours),
        }
        if wind > 0:
            part["maximumWind"] = {"sustained": {"m/s": str(wind), "kt": str(int(wind * 1.944 + 0.5))}, "gust": {"m/s": str(gust), "kt": str(int(gust * 1.944 + 0.5))}}
        if hours == 0:
            part["scale"] = "大型"
            part["galeWarning"] = [{"area": "北東", "range": {"km": 650}}, {"area": "南西", "range": {"km": 500}}]
            part["stormWarning"] = [{"area": "北東", "range": {"km": 300}}, {"area": "南西", "range": {"km": 220}}]
        else:
            part["probabilityCircleRadius"] = {"km": radius}
            if wind > 0:
                part["stormWarning"] = [{"area": "全域", "range": {"km": 200 + radius}}]
        spec.append(part)
    past = [[24.0, 136.5], [25.0, 135.2], [26.0, 134.0], [27.0, 132.9], [28.0, 131.9], [29.0, 130.9], [30.1, 129.9]]
    forecast = [{"advancedHours": 0, "track": {"preTyphoon": [], "typhoon": past}, "galeWarningArea": {"center": [30.1, 129.9], "radius": 575000}}]
    ty = bousai_typhoon_build("TC2410", spec, forecast, loc)
    return [ty]

# ---------------------------------------------------------------------------
# Text layout helpers (bounded scrolling comes from core: bousai_fit / bousai_ticker with `frames`).

def bousai_typhoon_fit_len(ui, s, width, font = None):
    """Length of the longest prefix of s that renders within width px."""
    lo = 0
    hi = len(s)
    for _ in range(8):
        if lo >= hi:
            break
        mid = (lo + hi + 1) // 2
        if bousai_text_width(ui, s[:mid], font) <= width:
            lo = mid
        else:
            hi = mid - 1
    return lo

def bousai_typhoon_wrap(ui, s, width, font = None):
    """Word-wrap s into lines of at most width px (over-long words are cut)."""
    lines = []
    cur = ""
    for word in s.split(" "):
        trial = cur + " " + word if cur else word
        if bousai_text_width(ui, trial, font) <= width:
            cur = trial
            continue
        if cur:
            lines.append(cur)
        cur = word
        for _ in range(6):
            k = bousai_typhoon_fit_len(ui, cur, width, font)
            if k >= len(cur) or k < 1:
                break
            lines.append(cur[:k])
            cur = cur[k:]
    if cur:
        lines.append(cur)
    return lines

def bousai_typhoon_page(ui, header, rows, frames):
    """One top-aligned page: header band (widget or None) plus rows (str | (text, colour) | widget).

    Over-long strings scroll within exactly `frames` frames, so the page never outlasts its share
    of the animation budget.
    """
    width = canvas.width()
    kids = []
    if header != None:
        kids.append(header)
    for r in rows:
        if type(r) == "string":
            r = bousai_fit(ui, r, frames = frames)
        elif type(r) == "tuple" or type(r) == "list":
            r = bousai_fit(ui, r[0], color = r[1], frames = frames)
        kids.append(render.Box(width = width, height = ui["line_h"], child = r))
    return render.Box(width = width, height = canvas.height(), child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))

def bousai_typhoon_scroll_frames(ui, rows, base):
    """Frames for a page whose over-wide strings should scroll at about 2 px/frame or slower (base .. 60)."""
    travel = 0
    for r in rows:
        text = None
        if type(r) == "string":
            text = r
        elif type(r) == "tuple" or type(r) == "list":
            text = r[0]
        if text != None:
            travel = max(travel, bousai_text_width(ui, text) - canvas.width())
    if travel <= 0:
        return base
    return min(60, max(base, 16 + (travel + 1) // 2))

def bousai_typhoon_polygon(points, fill_color = None, stroke_color = None):
    """render.Polygon at absolute screen coordinates (the widget itself always draws at its own origin)."""
    x0 = min([p[0] for p in points])
    y0 = min([p[1] for p in points])
    poly = render.Polygon(vertices = [(p[0] - x0, p[1] - y0) for p in points], fill_color = fill_color, stroke_color = stroke_color, stroke_width = 1)
    return render.Padding(pad = (x0, y0, 0, 0), child = poly)

def bousai_typhoon_line(a, b, color):
    """1 px render.Line between two screen points (the widget itself always draws at its own origin)."""
    x0 = min(a[0], b[0])
    y0 = min(a[1], b[1])
    line = render.Line(x1 = a[0] - x0, y1 = a[1] - y0, x2 = b[0] - x0, y2 = b[1] - y0, color = color, width = 1)
    return render.Padding(pad = (x0, y0, 0, 0), child = line)

# ---- src/apps/bousai_typhoon/bousai_typhoon.star ---------------------------

TEXT_FRAMES = 24
NOW_FRAMES = 18
STEP_FRAMES = 14

# JMA anchor cities that join the map fit when the track passes near them.
JAPAN_ANCHORS = [(26.2, 127.7), (31.6, 130.6), (34.7, 135.5), (35.7, 139.7), (38.3, 140.9), (43.1, 141.4)]

def to_int(v, default):
    if v == None or not str(v).isdigit():
        return default
    return int(v)

def rows_per_page(ui, header = True):
    return max(1, canvas.height() // ui["line_h"] - (1 if header else 0))

def fit_text(ui, candidates):
    """First candidate that fits one line, else the last (it scrolls)."""
    for c in candidates:
        if bousai_text_width(ui, c) <= canvas.width():
            return c
    return candidates[0]

def text_rows(ui, text, color):
    """Word-wrapped lines when they fit one page, else a single scrolling line."""
    lines = bousai_typhoon_wrap(ui, text, canvas.width())
    if len(lines) <= rows_per_page(ui):
        return [(l, color) for l in lines]
    return [(text, color)]

def chunk_pages(ui, head_fn, rows, base):
    """[(page, frames)]: header band plus rows; with large text only the first page keeps the band."""
    per_h = rows_per_page(ui)
    keep = per_h >= 3
    per_n = per_h if keep else rows_per_page(ui, False)
    groups = [rows[:per_h]]
    for i in range(per_h, len(rows), per_n):
        groups.append(rows[i:i + per_n])
    out = []
    for i, group in enumerate(groups):
        frames = bousai_typhoon_scroll_frames(ui, group, base)
        head = head_fn(frames) if (i == 0 or keep) else None
        out.append((bousai_typhoon_page(ui, head, group, frames), frames))
    return out

# ---------------------------------------------------------------------------
# Formatting

def wind_text(ms, kt, unit):
    if ms == None:
        return ""
    if unit == "kt":
        return "%dkt" % (kt if kt != None else int(ms * 1.944 + 0.5))
    if unit == "kmh":
        return "%dkm/h" % int(ms * 3.6 + 0.5)
    return "%dm/s" % ms

def position_text(lat, lon):
    return "%s%s %s%s" % (bousai_fixed(abs(lat), 1), "N" if lat >= 0 else "S", bousai_fixed(abs(lon), 1), "E" if lon >= 0 else "W")

def move_text(ui, t):
    if t["speed_kmh"] != None and t["course_en"]:
        return fit_text(ui, ["Moving %s %dkm/h" % (t["course_en"], t["speed_kmh"]), "Moves %s %dkm/h" % (t["course_en"], t["speed_kmh"]), "%s %dkm/h" % (t["course_en"], t["speed_kmh"])])
    if t["speed_word"]:
        return (t["speed_word"] + " " + t["course_en"]).strip()
    return "Movement unknown"

def category_text(ui, t):
    cands = [t["category_en"]]
    if t["cat"] == "TY" and t["intensity_en"]:
        cands.append(t["intensity_en"] + " TY")
    elif t["cat"] == "STS":
        cands.append("Severe TS")
    cands.append(t["cat"])
    return fit_text(ui, cands)

def title_text(t):
    num = "No.%d" % t["number"] if t["number"] else t["cat"]
    return "%s %s" % (num, t["name_en"] or t["tc_id"])

# ---------------------------------------------------------------------------
# Text pages

def pages_info(ui, t, unit, tz, show_dist, loc):
    """Identity card, then movement / position / distance, then size and radii."""
    wind = wind_text(t["wind_ms"], t["wind_kt"], unit)
    gust = wind_text(t["gust_ms"], t["gust_kt"], unit)
    rows = [(category_text(ui, t), ui["fg"])]
    rows.append((("%dhPa %s" % (t["pressure_hpa"], wind)).strip() if t["pressure_hpa"] else wind, ui["fg"]))
    if gust:
        rows.append(("Gust %s" % gust, ui["fg"]))
    rows.append((move_text(ui, t), ui["fg"]))
    rows.append((position_text(t["lat"], t["lon"]), ui["fg"]))
    if show_dist:
        rows.append((fit_text(ui, ["%dkm %s of you" % (t["distance_km"], t["bearing"]), "%dkm %s" % (t["distance_km"], t["bearing"])]), ui["muted"]))
    if t["storm_km"]:
        rows.append(("Storm radius %dkm" % max([k for _, k in t["storm_km"]]), ui["muted"]))
    if t["gale_km"]:
        rows.append(("Gale radius %dkm" % max([k for _, k in t["gale_km"]]), ui["muted"]))
    if t["scale_en"]:
        rows.append(("Size: %s" % t["scale_en"], ui["muted"]))
    closest = bousai_typhoon_closest(t, loc)
    if show_dist and closest != None and closest[0] < t["distance_km"] and closest[0] <= 800:
        rows.append((fit_text(ui, ["Closest %dkm in %dh" % closest, "Near %dkm %dh" % closest]), ui["muted"]))
    rows.append(("Issued %s" % bousai_hhmm(t["issued"], tz), ui["muted"]))
    band = bousai_sev_color(ui, t["sev"])
    return chunk_pages(ui, lambda fr: bousai_header(ui, title_text(t), band, None, fr), rows, TEXT_FRAMES)

# ---------------------------------------------------------------------------
# Map frames

def anchor_points(items):
    """Japan anchors near the track, so land stays visible."""
    pts = []
    for a in JAPAN_ANCHORS:
        for s in items:
            if bousai_distance_km(a[0], a[1], s["lat"], s["lon"]) < 600:
                pts.append(a)
                break
    return pts

def map_view(t, items, loc, mh):
    """One view for every frame of a typhoon: track, probability circles, nearby Japan and you."""
    pts = []
    for i, s in enumerate(items):
        pts.append((s["lat"], s["lon"]))
        r = s.get("radius_km") or 0
        if i == 0 and s.get("storm_km"):
            r = max([d for _, d in s["storm_km"]])
        if r:
            dlat = r / 111.2
            dlon = r / (111.2 * max(0.2, math.cos(math.radians(s["lat"]))))
            pts.extend([(s["lat"] + dlat, s["lon"]), (s["lat"] - dlat, s["lon"]), (s["lat"], s["lon"] + dlon), (s["lat"], s["lon"] - dlon)])
    for p in t["past"]:
        if bousai_distance_km(p[0], p[1], t["lat"], t["lon"]) <= 900:
            pts.append((p[0], p[1]))
    pts.extend(anchor_points(items))
    near_user = False
    for s in items:
        if bousai_distance_km(loc["lat"], loc["lon"], s["lat"], s["lon"]) < 1500:
            near_user = True
            break
    if near_user:
        pts.append((loc["lat"], loc["lon"]))
    return bousai_view_fit(pts, canvas.width(), mh, pad = 4, min_zoom = 0.3, max_zoom = 5.5)

def project_ring(view, ring):
    return [bousai_view_xy(view, p[0], p[1]) for p in ring]

def line_layers(view, pts, color):
    """Line chain through [(lat, lon)] points; segments wholly outside the view are skipped."""
    out = []
    xy = [bousai_view_xy(view, p[0], p[1]) for p in pts]
    w = view["w"]
    h = view["h"]
    for i in range(len(xy) - 1):
        a = xy[i]
        b = xy[i + 1]
        if a == b or (a[0] < 0 and b[0] < 0) or (a[1] < 0 and b[1] < 0) or (a[0] >= w and b[0] >= w) or (a[1] >= h and b[1] >= h):
            continue
        out.append(bousai_typhoon_line(a, b, color))
    return out

def footer_row(ui, step, label, unit, frames):
    """[CAT chip] label wind  — one line on the panel colour."""
    fh = bousai_font_height(ui)
    color = bousai_sev_color(ui, step["sev"])
    chip_text = step["cat"] or "TC"
    chip_w = bousai_text_width(ui, chip_text) + 2
    wind = wind_text(step["wind_ms"], step["wind_kt"], unit)
    text = ("%s %s" % (label, wind)).strip()
    chip = render.Box(width = chip_w, height = fh, color = color, child = bousai_text(ui, chip_text, bousai_on(color)))
    body = bousai_fit(ui, text, width = canvas.width() - chip_w - 2, color = ui["fg"], frames = frames)
    return render.Box(width = canvas.width(), height = ui["line_h"], color = ui["panel"], child = render.Row(cross_align = "center", children = [render.Padding(pad = (1, 0, 0, 0), child = chip), render.Padding(pad = (1, 0, 0, 0), child = body)]))

def frame_map(ui, t, items, k, view, loc, unit, frames):
    """Map with the past track, forecast line up to item k, its circle and a status footer."""
    step = items[k]
    layers = [bousai_basemap(ui, view, "pacific")]
    if view["zoom"] >= 1.8:
        layers.append(bousai_basemap(ui, view, "japan"))
    if t["past"]:
        layers.extend(line_layers(view, t["past"], ui["muted"]))
    color = bousai_sev_color(ui, step["sev"])
    if k == 0:
        if t["gale_circle"]:
            g = t["gale_circle"]
            ring = project_ring(view, bousai_typhoon_circle(g[0], g[1], g[2], 28))
            layers.append(bousai_typhoon_polygon(ring, ui["muted"] + "30", ui["muted"]))
        if t["storm_km"]:
            km = max([d for _, d in t["storm_km"]])
            ring = project_ring(view, bousai_typhoon_circle(step["lat"], step["lon"], km, 20))
            layers.append(bousai_typhoon_polygon(ring, color + "60", color))
    elif step["radius_km"]:
        ring = project_ring(view, bousai_typhoon_circle(step["lat"], step["lon"], step["radius_km"], 20))
        layers.append(bousai_typhoon_polygon(ring, color + "50", color))
    layers.extend(line_layers(view, [(s["lat"], s["lon"]) for s in items[:k + 1]], ui["fg"]))
    for i, s in enumerate(items[:k + 1]):
        if i < k:
            layers.append(bousai_marker(ui, view, s["lat"], s["lon"], ui["fg"], 1))
    layers.append(bousai_marker(ui, view, step["lat"], step["lon"], color, 3))
    layers.append(bousai_cross(ui, view, loc["lat"], loc["lon"], ui["accent"], 2))
    label = "Now" if k == 0 else "+%dh" % step["hours"]
    return render.Column(children = [bousai_map_frame(ui, view, layers), footer_row(ui, step, label, unit, frames)])

def frames_map(ui, t, loc, unit, steps_mode):
    """[(widget, frames, priority)] for the 'Now' frame and the forecast steps."""
    wanted = []
    last = 0
    for s in t["steps"]:
        if steps_mode == "all" or (s["hours"] >= 24 and s["hours"] - last >= 20):
            wanted.append(s)
            last = s["hours"]
    items = [t] + wanted
    view = map_view(t, items, loc, canvas.height() - ui["line_h"])

    # Drop order when time is short: keep the farthest, middle and first steps longest.
    n = len(wanted)
    rank = {}
    for idx in [n, (n + 1) // 2, 1]:
        if idx >= 1 and idx not in rank:
            rank[idx] = 3 + len(rank)
    for idx in range(1, n + 1):
        if idx not in rank:
            rank[idx] = 3 + len(rank)
    out = []
    for k in range(len(items)):
        fr = NOW_FRAMES if k == 0 else STEP_FRAMES
        out.append((frame_map(ui, t, items, k, view, loc, unit, fr), fr, 1 if k == 0 else rank[k]))
    return out

# ---------------------------------------------------------------------------
# Assembly

def typhoon_pages(ui, t, loc, tz, unit, steps_mode, share, show_dist):
    """Pages for one typhoon within `share` frames: [(widget, frames)] in display order."""
    info = pages_info(ui, t, unit, tz, show_dist, loc)
    maps = frames_map(ui, t, loc, unit, steps_mode)

    # (display order, priority, widget, frames)
    items = []
    order = 0
    for i, p in enumerate(info):
        items.append((order, 0 if i == 0 else (2 if i == 1 else 8), p[0], p[1]))
        order += 1
    for m in maps:
        items.append((order, m[2], m[0], m[1]))
        order += 1
    chosen = []
    total = 0
    for it in sorted(items, key = lambda i: (i[1], i[0])):
        if chosen and total + it[3] > share:
            continue
        chosen.append(it)
        total += it[3]
    return [(c[2], c[3]) for c in sorted(chosen, key = lambda i: i[0])]

def sequence(pages):
    return render.Sequence(children = [bousai_hold(p[0], p[1]) for p in pages])

def main(config):
    ui = bousai_ui(config)
    loc = bousai_location(config)
    tz = loc["tz"]
    demo = bousai_bool(config, "demo", False)
    show_idle = bousai_bool(config, "show_idle", False)
    unit = config.get("wind_unit") or "ms"
    steps_mode = config.get("steps") or "daily"
    count = max(1, min(4, to_int(config.get("count"), 3)))
    budget = canvas.max_duration_ms() // ui["delay"]

    typhoons = bousai_typhoon_demo(config) if demo else bousai_typhoon_list(config)
    if typhoons == None or not typhoons:
        if not show_idle:
            return []
        rows = text_rows(ui, "JMA typhoon data is unavailable" if typhoons == None else "No active typhoon", ui["fg"])
        rows.append(("Checked %s" % bousai_hhmm(bousai_now(), tz), ui["muted"]))
        return bousai_root(ui, sequence(chunk_pages(ui, lambda fr: bousai_header(ui, "TYPHOON", None, None, fr), rows, TEXT_FRAMES)[:3]))

    typhoons = typhoons[:count]
    share = budget // len(typhoons)
    pages = []
    for t in typhoons:
        show_dist = t["distance_km"] != None
        pages.extend(typhoon_pages(ui, t, loc, tz, unit, steps_mode, share, show_dist))
    return bousai_root(ui, sequence(pages))

def get_schema():
    return bousai_schema([
        schema.Toggle(
            id = "show_idle",
            name = "Show when idle",
            desc = "Show a calm card while no typhoon is active. Off skips the app, so it only appears for a typhoon (use with Tronbyt AutoPin).",
            icon = "bell",
            default = False,
        ),
        schema.Dropdown(
            id = "wind_unit",
            name = "Wind unit",
            desc = "Unit for maximum wind and gusts.",
            icon = "wind",
            default = "ms",
            options = [
                schema.Option(display = "Metres per second", value = "ms"),
                schema.Option(display = "Knots", value = "kt"),
                schema.Option(display = "Kilometres per hour", value = "kmh"),
            ],
        ),
        schema.Dropdown(
            id = "steps",
            name = "Forecast steps",
            desc = "Which forecast times to animate on the track map.",
            icon = "clock",
            default = "daily",
            options = [
                schema.Option(display = "Daily (24, 48, 72, 96, 120 h)", value = "daily"),
                schema.Option(display = "All JMA forecast times", value = "all"),
            ],
        ),
        schema.Dropdown(
            id = "count",
            name = "Typhoons shown",
            desc = "How many active typhoons to cycle through, nearest to you first.",
            icon = "hurricane",
            default = "3",
            options = [schema.Option(display = "Nearest %d" % n if n > 1 else "Nearest only", value = str(n)) for n in (1, 2, 3, 4)],
        ),
        schema.Toggle(
            id = "demo",
            name = "Show sample alert",
            desc = "Show a sample modelled on Typhoon No. 10 (Shanshan) of August 2024 near Kyushu instead of live data.",
            icon = "play",
            default = False,
        ),
    ])
