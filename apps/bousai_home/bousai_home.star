]

# NIED Kyoshin Monitor image layers (352 x 400 px) are an equirectangular map: pixel = A * lon + B,
# pixel_y = C * lat + D, fitted against Natural Earth coastlines (IoU 0.98) and cross-checked
# against the P/S-wave circle centre of the 2024-01-01 Noto earthquake (within 1 px).
BOUSAI_EEW_KMONI_W = 352
BOUSAI_EEW_KMONI_H = 400
BOUSAI_EEW_KMONI_X = (20.258, -2604.984)
BOUSAI_EEW_KMONI_Y = (-24.5517, 1135.033)

# ---------------------------------------------------------------------------
# Parsing helpers

def bousai_eew_num(v, default = None):
    """Number from an int/float or a string such as '37.6' or '10km'; `default` otherwise."""
    t = type(v)
    if t == "int" or t == "float":
        return float(v)
    if t != "string":
        return default
    s = v.strip().replace("km", "")
    body = s[1:] if s.startswith("-") else s
    if body and body.count(".") <= 1 and body.replace(".", "").isdigit():
        return float(s)
    return default

def bousai_eew_flag(v):
    return v == True or v == "true" or v == "True" or v == "1"

def bousai_eew_int_label(v):
    """JMA intensity label ('0'..'7', '5-', '5+', '6-', '6+') from feed text such as '5強', '6+', '5弱以上'."""
    if v == None:
        return None
    s = str(v).strip()
    for junk in ["震度", "程度", "以上", "以下", " "]:
        s = s.replace(junk, "")
    for sep in ["～", "~", "から"]:
        if sep in s:
            s = s.split(sep)[-1]
    return bousai_intensity_norm(s)

def bousai_eew_region_code(text):
    """Epicentre area code (e.g. '190') from a raw JMA EEW telegram, or None."""
    if not text:
        return None
    t = str(text).split()
    for i in range(1, len(t) - 1):
        a, b = t[i], t[i + 1]
        if len(a) == 4 and a[0] == "N" and a[1:].isdigit() and len(b) == 5 and b[0] == "E" and b[1:].isdigit():
            c = t[i - 1]
            if len(c) == 3 and c.isdigit():
                return c
    return None

def bousai_eew_pref_codes(names):
    """JMA prefecture codes ('17') for warning-area names that start with a prefecture name."""
    out = []
    for n in names:
        s = str(n)
        for i in range(47):
            if s.startswith(BOUSAI_EEW_PREF_JP[i]):
                code = ("0" + str(i + 1))[-2:]
                if code not in out:
                    out.append(code)
                break
    return out

def bousai_eew_pref_en(code):
    """Short English prefecture name for a JMA prefecture code ('13' -> 'Tokyo')."""
    return BOUSAI_PREF_EN.get(code, "").replace(" Prefecture", "").replace(" Metropolis", "")

def bousai_eew_blank():
    return {
        "event_id": "",
        "serial": 0,
        "warn": False,
        "final": False,
        "cancel": False,
        "assumption": False,
        "training": False,
        "origin": None,
        "announced": None,
        "lat": None,
        "lon": None,
        "depth_km": None,
        "mag": None,
        "region_code": None,
        "max_int": None,
        "areas": [],
        "source": "",
    }

def bousai_eew_parse_wolfx(d):
    """Wolfx jma_eew.json -> event dict (None when it is not an EEW report)."""
    if type(d) != "dict" or not d.get("EventID"):
        return None
    ev = bousai_eew_blank()
    mag = bousai_eew_num(d.get("Magnitude"))
    if mag == None:
        mag = bousai_eew_num(d.get("Magunitude"))
    title = str(d.get("Title") or "")
    ev["event_id"] = str(d["EventID"])
    ev["serial"] = int(bousai_eew_num(d.get("Serial"), 0))
    ev["warn"] = bousai_eew_flag(d.get("isWarn")) or "警報" in title
    ev["final"] = bousai_eew_flag(d.get("isFinal"))
    ev["cancel"] = bousai_eew_flag(d.get("isCancel"))
    ev["assumption"] = bousai_eew_flag(d.get("isAssumption"))
    ev["training"] = bousai_eew_flag(d.get("isTraining"))
    ev["origin"] = bousai_parse_time(d.get("OriginTime"))
    ev["announced"] = bousai_parse_time(d.get("AnnouncedTime"))
    lat = bousai_eew_num(d.get("Latitude"))
    lon = bousai_eew_num(d.get("Longitude"))
    if ev["cancel"] or (lat == 0 and lon == 0):
        lat, lon = None, None  # cancellations and 0/0 placeholders carry no hypocentre
    ev["lat"] = lat
    ev["lon"] = lon
    ev["depth_km"] = bousai_eew_num(d.get("Depth")) if lat != None else None
    ev["mag"] = mag if lat != None and mag != None and mag > 0 else None
    ev["region_code"] = None if ev["cancel"] else bousai_eew_region_code(d.get("OriginalText"))
    ev["max_int"] = None if ev["cancel"] else bousai_eew_int_label(d.get("MaxIntensity"))
    areas = [a.get("Chiiki") for a in (d.get("WarnArea") or []) if type(a) == "dict"]
    ev["areas"] = bousai_eew_pref_codes([a for a in areas if a])
    ev["source"] = "Wolfx"
    return ev

def bousai_eew_parse_kmoni(d):
    """NIED kmoni hypo/eew JSON -> event dict (None when no EEW is current)."""
    if type(d) != "dict" or not d.get("report_time") or not d.get("report_id"):
        return None
    ev = bousai_eew_blank()
    lat = bousai_eew_num(d.get("latitude"))
    lon = bousai_eew_num(d.get("longitude"))
    code = str(d.get("region_code") or "")
    ev["event_id"] = str(d["report_id"])
    ev["serial"] = int(bousai_eew_num(d.get("report_num"), 0))
    ev["warn"] = d.get("alertflg") == "警報"
    ev["final"] = bousai_eew_flag(d.get("is_final"))
    ev["cancel"] = bousai_eew_flag(d.get("is_cancel"))
    ev["training"] = bousai_eew_flag(d.get("is_training"))
    ev["origin"] = bousai_parse_time(d.get("origin_time"))
    ev["announced"] = bousai_parse_time(d.get("report_time"))
    ev["lat"] = lat
    ev["lon"] = lon
    ev["assumption"] = lat == None or lon == None
    ev["depth_km"] = bousai_eew_num(d.get("depth"))
    ev["mag"] = bousai_eew_num(d.get("magunitude"))
    ev["region_code"] = code if len(code) == 3 and code.isdigit() else None
    ev["max_int"] = bousai_eew_int_label(d.get("calcintensity"))
    ev["source"] = "NIED"
    return ev

def bousai_eew_parse_p2p(e):
    """P2PQuake code 556 entry -> event dict. Every 556 is a warning; no 'final' flag exists."""
    issue = e.get("issue") or {}
    eid = str(issue.get("eventId") or "")
    if not eid:
        return None
    ev = bousai_eew_blank()
    eq = e.get("earthquake") or {}
    hypo = eq.get("hypocenter") or {}
    lat = bousai_eew_num(hypo.get("latitude"))
    lon = bousai_eew_num(hypo.get("longitude"))
    if lat != None and lat < -90:
        lat = None
    if lon != None and lon < -180:
        lon = None
    mag = bousai_eew_num(hypo.get("magnitude"))
    depth = bousai_eew_num(hypo.get("depth"))
    areas = e.get("areas") or []
    top = None
    for a in areas:
        x = bousai_eew_num(a.get("scaleTo"))
        label = bousai_intensity_norm(str(int(x))) if x != None and x >= 0 and x < 99 else None
        if label != None and bousai_intensity_rank(label) > bousai_intensity_rank(top or ""):
            top = label
    ev["event_id"] = eid
    ev["serial"] = int(bousai_eew_num(issue.get("serial"), 0))
    ev["warn"] = True
    ev["cancel"] = bousai_eew_flag(e.get("cancelled"))
    ev["training"] = bousai_eew_flag(e.get("test"))
    ev["announced"] = bousai_parse_time(issue.get("time"))
    ev["origin"] = bousai_parse_time(eq.get("originTime"))
    ev["lat"] = lat
    ev["lon"] = lon
    ev["assumption"] = eq.get("condition") == "仮定震源要素" or lat == None or lon == None
    ev["mag"] = mag if mag != None and mag > 0 else None
    ev["depth_km"] = depth if depth != None and depth >= 0 else None
    ev["max_int"] = top
    ev["areas"] = bousai_eew_pref_codes([a.get("pref") for a in areas if a.get("pref")])
    ev["source"] = "P2PQuake"
    return ev

def bousai_eew_merge(a, b):
    """Merge two reports of one event: the newer serial wins, gaps are filled from the other."""
    first, second = (a, b) if a["serial"] >= b["serial"] else (b, a)
    out = dict(first)
    for k in second:
        if out.get(k) in (None, "", []) and second[k] not in (None, "", []):
            out[k] = second[k]
    out["warn"] = first["warn"] or second["warn"]
    return out

def bousai_eew_add(events, ev):
    """Add ev to the {event_id: event} dict, merging with an earlier report of the same event."""
    eid = ev["event_id"]
    events[eid] = bousai_eew_merge(events[eid], ev) if eid in events else ev

# ---------------------------------------------------------------------------
# Travel time and local estimate

def bousai_eew_bracket(nodes, x):
    """(i, j, f): x lies between nodes[i] and nodes[j] at fraction f; clamped to the ends."""
    n = len(nodes)
    if x <= nodes[0]:
        return 0, 0, 0.0
    if x >= nodes[n - 1]:
        return n - 1, n - 1, 0.0
    for i in range(n - 1):
        if x < nodes[i + 1]:
            return i, i + 1, (x - nodes[i]) / (nodes[i + 1] - nodes[i])
    return n - 1, n - 1, 0.0

def bousai_eew_s_travel(depth_km, epi_km):
    """S-wave travel time in seconds from the JMA2001 table (bilinear). None beyond 2000 km."""
    if epi_km > 2000:
        return None
    i0, i1, fi = bousai_eew_bracket(BOUSAI_EEW_TT_DEPTH, depth_km)
    j0, j1, fj = bousai_eew_bracket(BOUSAI_EEW_TT_DIST, epi_km)
    rows = BOUSAI_EEW_TT_S
    a = rows[i0][j0] * (1 - fj) + rows[i0][j1] * fj
    b = rows[i1][j0] * (1 - fj) + rows[i1][j1] * fj
    return a * (1 - fi) + b * fi

def bousai_eew_estimate(mag, depth_km, epi_km):
    """Estimated JMA instrumental intensity (float) at epicentral distance epi_km.

    PGV on Vs30 = 600 m/s ground from Si & Midorikawa (1999), crustal event, point source:
        log10 PGV = 0.58 Mw + 0.0038 D - 1.29 - log10(X + 0.0028 * 10^(0.5 Mw)) - 0.002 X   [cm/s]
    (X = hypocentral distance in km, D = depth in km; Mj is used for Mw). Multiplied by the
    nationwide-average site amplification BOUSAI_EEW_ARV, then converted with Midorikawa,
    Fujimoto & Muramatsu (1999): I_JMA = 2.68 + 1.72 log10 PGV.
    A point-source estimate: it can read low close to the rupture of great earthquakes, and a
    single average site cannot reflect soft ground. JMA's area forecast is authoritative.
    """
    x = math.sqrt(epi_km * epi_km + depth_km * depth_km)
    log_pgv = 0.58 * mag + 0.0038 * depth_km - 1.29 - math.log(x + 0.0028 * math.pow(10, 0.5 * mag), 10) - 0.002 * x
    log_pgv += math.log(BOUSAI_EEW_ARV, 10)
    return 2.68 + 1.72 * log_pgv

def bousai_eew_latlon_text(lat, lon):
    if lat == None or lon == None:
        return "Unknown"
    return "%s%s %s%s" % (bousai_fixed(abs(lat), 1), "N" if lat >= 0 else "S", bousai_fixed(abs(lon), 1), "E" if lon >= 0 else "W")

def bousai_eew_epicenter_en(ev):
    """English epicentre name from the telegram area code; latitude/longitude text as fallback."""
    code = ev.get("region_code")
    if code and code in BOUSAI_EPICENTER_EN:
        return BOUSAI_EPICENTER_EN[code].replace("\u200b", "").replace("  ", " ")
    if ev.get("lat") != None and ev.get("lon") != None:
        return bousai_eew_latlon_text(ev["lat"], ev["lon"])
    return "Unknown epicentre"

def bousai_eew_localize(ev, loc):
    """Copy of ev with epicenter_en and the estimate for loc {lat, lon}: dist_km, s_travel,
    s_arrival (Pixlet time), est_value (float), local_int (label). Estimate keys stay None for
    assumed (PLUM/level) sources, cancellations, missing source parameters and > 2000 km."""
    out = dict(ev)
    out["epicenter_en"] = bousai_eew_epicenter_en(ev)
    out["dist_km"] = None
    out["s_travel"] = None
    out["s_arrival"] = None
    out["est_value"] = None
    out["local_int"] = None
    mag = ev["mag"]
    if ev["cancel"] or ev["assumption"] or ev["lat"] == None or ev["lon"] == None or mag == None or mag <= 0 or ev["origin"] == None:
        return out
    epi = bousai_distance_km(loc["lat"], loc["lon"], ev["lat"], ev["lon"])
    out["dist_km"] = epi
    if epi > 2000:
        return out
    depth = ev["depth_km"] if ev["depth_km"] != None else 10.0
    travel = bousai_eew_s_travel(depth, epi)
    out["s_travel"] = travel
    out["s_arrival"] = ev["origin"] + time.parse_duration("%dms" % int(travel * 1000))
    out["est_value"] = bousai_eew_estimate(mag, depth, epi)
    out["local_int"] = bousai_intensity_from_value(out["est_value"])
    return out

def bousai_eew_sev(ev):
    """Severity index 0..5 for ui['sev']: warning 5; forecast 2 when JMA expects Int 3+, else 1;
    cancellation 1."""
    if ev["cancel"]:
        return 1
    if ev["warn"]:
        return 5
    rank = bousai_intensity_rank(ev.get("max_int") or "")
    return 2 if rank >= bousai_intensity_rank("3") else 1

def bousai_eew_mag_text(mag):
    return "M" + bousai_fixed(mag, 1) if mag != None and mag > 0 else "M?"

def bousai_eew_depth_text(depth_km):
    if depth_km == None:
        return "D?"
    return "D%dkm" % int(depth_km + 0.5) if depth_km >= 1 else "Shallow"

# ---------------------------------------------------------------------------
# Feed polling

def bousai_eew_fetch(feed, url, ttl):
    """Guarded GET (body bytes, or None) from feed 'wolfx', 'kmoni' or 'p2p'. None also means the host is
    being skipped because an earlier request to it never finished (BOUSAI_EEW_COOLDOWN)."""
    return bousai_guarded_get(url, ttl, None, BOUSAI_EEW_COOLDOWN[feed])

def bousai_eew_fetch_json(feed, url, ttl):
    """bousai_eew_fetch + JSON decode (None on any failure)."""
    return bousai_guarded_json(url, ttl, None, BOUSAI_EEW_COOLDOWN[feed])

def bousai_eew_kmoni_now():
    """(time, 'YYYYMMDDhhmmss') of the newest NIED Kyoshin Monitor observation, or (None, None)."""
    d = bousai_eew_fetch_json("kmoni", BOUSAI_EEW_KMONI + "/webservice/server/pros/latest.json", 1)
    if type(d) != "dict":
        return None, None
    t = bousai_parse_time(d.get("latest_time"))
    if t == None:
        return None, None
    return t, t.in_location(BOUSAI_JST).format("20060102150405")

def bousai_eew_collect():
    """Poll the EEW feeds as a fallback chain that touches as few third-party hosts as possible.

    1. Wolfx (primary): ONE request when idle.
    2. NIED kmoni (latest.json + hypo/eew) only when Wolfx gave nothing usable (host skipped, HTTP error or
       no report), or when BOUSAI_EEW_KMONI_ALWAYS is set.
    3. P2PQuake 556 (warnings only) only as a last resort, when neither Wolfx nor kmoni answered. It is
       never asked to enrich an event a primary source already carries: it is the host seen stalling, and
       a stalled request fails the whole render, which would be exactly while an EEW is live.
    Every request is guarded (bousai_eew_fetch): a host whose previous request never finished is skipped
    for its cooldown, which simply moves the chain on.

    Returns {events: {event_id: event}, ok: {wolfx, kmoni, p2p} (True/False when asked, None when not
    asked), last: newest Wolfx report (even when old) or None}. No filtering by age happens here.
    """
    events = {}
    ok = {"wolfx": False, "kmoni": None, "p2p": None}
    last = None
    now = time.now()

    raw = bousai_eew_fetch_json("wolfx", BOUSAI_EEW_WOLFX, 1)
    if type(raw) == "dict" and raw.get("EventID"):
        ok["wolfx"] = True
        ev = bousai_eew_parse_wolfx(raw)
        if ev != None:
            last = ev
            bousai_eew_add(events, ev)

    if BOUSAI_EEW_KMONI_ALWAYS or not ok["wolfx"]:
        ok["kmoni"] = False
        _, stamp = bousai_eew_kmoni_now()
        if stamp != None:
            k = bousai_eew_fetch_json("kmoni", BOUSAI_EEW_KMONI + "/webservice/hypo/eew/" + stamp + ".json", 1)
            if type(k) == "dict" and (k.get("result") or {}).get("status") == "success":
                ok["kmoni"] = True
                ev = bousai_eew_parse_kmoni(k)
                if ev != None:
                    bousai_eew_add(events, ev)

    if not ok["wolfx"] and not ok["kmoni"]:
        p = bousai_eew_fetch_json("p2p", BOUSAI_EEW_P2P + "?codes=556&limit=30", 2)
        ok["p2p"] = type(p) == "list"
        for e in (p if type(p) == "list" else []):
            if type(e) != "dict":
                continue
            ev = bousai_eew_parse_p2p(e)
            if ev != None and ev["announced"] != None and (now - ev["announced"]).seconds < 600:
                bousai_eew_add(events, ev)
    return {"events": events, "ok": ok, "last": last}

def bousai_eew_window(ev):
    """Seconds after its latest report that ev is still shown."""
    if ev["cancel"]:
        return BOUSAI_EEW_CANCEL_S
    if ev["final"]:
        return BOUSAI_EEW_FINAL_S
    return BOUSAI_EEW_ACTIVE_S

def bousai_eew_pack(ev):
    d = dict(ev)
    d["origin"] = ev["origin"].unix if ev["origin"] != None else None
    d["announced"] = ev["announced"].unix if ev["announced"] != None else None
    return d

def bousai_eew_unpack(d):
    ev = dict(d)
    ev["origin"] = time.from_timestamp(int(d["origin"])) if d.get("origin") else None
    ev["announced"] = time.from_timestamp(int(d["announced"])) if d.get("announced") else None
    return ev

def bousai_eew_remembered():
    """Events seen by earlier renders (a feed only carries its latest report, so a second,
    overlapping EEW would otherwise displace the first). Empty when the cache is not persistent."""
    raw = cache.get(BOUSAI_EEW_CACHE_KEY)
    data = json.decode(raw, default = None) if raw else None
    out = {}
    if type(data) == "list":
        for d in data:
            if type(d) == "dict" and d.get("event_id") and d.get("announced"):
                out[d["event_id"]] = bousai_eew_unpack(d)
    return out

def bousai_eew_active_events(collected, now = None):
    """Events from a bousai_eew_collect() result that are still active, merged with remembered
    ones; training reports dropped; warnings first, then newest first."""
    now = now or time.now()
    merged = bousai_eew_remembered()
    for ev in collected["events"].values():
        bousai_eew_add(merged, ev)
    live = []
    for ev in merged.values():
        if ev["training"] or ev["announced"] == None:
            continue
        age = (now - ev["announced"]).seconds
        if age <= bousai_eew_window(ev):
            live.append(ev)
    if live:
        cache.set(BOUSAI_EEW_CACHE_KEY, json.encode([bousai_eew_pack(e) for e in live]), ttl_seconds = BOUSAI_EEW_ACTIVE_S)
    return sorted(live, key = lambda e: (0 if e["warn"] else 1, -e["announced"].unix))

def bousai_eew_demo_event(loc, now = None):
    """Embedded sample modelled on the 2024-01-01 Noto Peninsula earthquake (EventID 20240101161010,
    JMA warning report no. 30 at +57 s: M7.4, Off the Coast of Noto Peninsula, max Int 7; warned
    prefectures Ishikawa, Toyama, Niigata, Nagano, Fukui). Times are relative to now: the sample is
    placed on its own timeline so the S-wave reaches loc about 9 s from now (an already-past arrival
    when loc is close to Noto; no estimate beyond 2000 km)."""
    now = now or time.now()
    epi = bousai_distance_km(loc["lat"], loc["lon"], 37.6, 137.2)
    elapsed = 60.0
    if epi <= 2000:
        elapsed = max(60.0, bousai_eew_s_travel(10.0, epi) - 9.0)
    origin = now - time.parse_duration("%dms" % int(elapsed * 1000))
    ev = bousai_eew_blank()
    ev["event_id"] = "20240101161010"
    ev["serial"] = 30
    ev["warn"] = True
    ev["origin"] = origin
    ev["announced"] = origin + time.parse_duration("57100ms")
    ev["lat"] = 37.6
    ev["lon"] = 137.2
    ev["depth_km"] = 10.0
    ev["mag"] = 7.4
    ev["region_code"] = "495"
    ev["max_int"] = "7"
    ev["areas"] = ["17", "16", "15", "20", "18"]
    ev["source"] = "Sample"
    return ev

def bousai_eew_poll(config, demo = False):
    """Everything an EEW display needs, for the configured location.

    Returns {events, ok, last, checked, loc}: events = active EEWs as rich dicts (see
    bousai_eew_active for the public subset; extra keys: areas (JMA prefecture codes), dist_km,
    s_travel, est_value, source), ok = feed health (see bousai_eew_collect), last = newest Wolfx report even when
    no longer active (for idle displays), checked = poll time. demo=True returns the embedded
    sample instead of live data.
    """
    loc = bousai_location(config)
    now = time.now()
    if demo:
        sample = bousai_eew_localize(bousai_eew_demo_event(loc, now), loc)
        return {"events": [sample], "ok": {"wolfx": True, "kmoni": None, "p2p": None}, "last": None, "checked": now, "loc": loc}
    got = bousai_eew_collect()
    events = [bousai_eew_localize(ev, loc) for ev in bousai_eew_active_events(got, now)]
    last = bousai_eew_localize(got["last"], loc) if got["last"] != None else None
    return {"events": events, "ok": got["ok"], "last": last, "checked": now, "loc": loc}

def bousai_eew_public(ev):
    """The documented summary shape of one EEW (see bousai_eew_active)."""
    return {
        "event_id": ev["event_id"],
        "serial": ev["serial"],
        "warn": ev["warn"],
        "final": ev["final"],
        "cancel": ev["cancel"],
        "assumption": ev["assumption"],
        "origin": ev["origin"],
        "announced": ev["announced"],
        "lat": ev["lat"],
        "lon": ev["lon"],
        "depth_km": ev["depth_km"],
        "mag": ev["mag"],
        "epicenter_en": ev["epicenter_en"],
        "max_int": ev["max_int"],
        "local_int": ev["local_int"],
        "s_arrival": ev["s_arrival"],
    }

def bousai_eew_active(config):
    """Active Earthquake Early Warnings for the configured location; [] when none (or no feed).

    One dict per EventID, warnings first, then newest report first:
      event_id (str), serial (int report number), warn (bool, Warning rather than Forecast),
      final (bool), cancel (bool; cancellations are listed for 60 s so displays can retract),
      assumption (bool; PLUM / level / assumed hypocentre: lat/lon/mag are placeholders),
      origin, announced (Pixlet times), lat, lon, depth_km, mag (floats or None),
      epicenter_en (English epicentre name, or 'lat lon' text), max_int (JMA max expected intensity
      label '0'..'7','5-','5+','6-','6+' or None), local_int (UNOFFICIAL estimated intensity label at
      the configured location, None when not computable), s_arrival (Pixlet time the S-wave is
      estimated to reach the location, None when not computable).
    A report stays active 180 s (final report 90 s, cancellation 60 s). Training reports are
    ignored. Renders no widgets. bousai_eew_sev(event) maps any of these dicts to the severity
    index 0..5 used with ui["sev"] (cancel 1, warn 5, forecast 1 or 2). The estimate behind
    local_int / s_arrival is documented on bousai_eew_estimate and bousai_eew_s_travel.
    """
    return [bousai_eew_public(ev) for ev in bousai_eew_poll(config)["events"]]

# ---------------------------------------------------------------------------
# Shaking detection (P2PQuake)

def bousai_eew_p2p_level(confidence):
    """P2PQuake 9611 confidence value -> level 1..4 (0 = below the display threshold)."""
    c = bousai_eew_num(confidence, 0.0)
    if c <= 0:
        return 0
    best, gap = 0, 1.0
    for level, v in BOUSAI_EEW_P2P_LEVELS:
        if abs(c - v) < gap:
            best, gap = level, abs(c - v)
    return best

def bousai_eew_shaking():
    """Recent shaking detection from P2PQuake, or None when the feed is unavailable (or its host is being
    skipped after a request that never finished, see BOUSAI_EEW_COOLDOWN).

    Returns {detected (bool), time (Pixlet time of the newest evaluation, None when nothing),
    areas_en (prefecture names, most confident first, up to 6), confidence (str)}.
    detected is True when a 9611 evaluation (user-reported "it shook", confidence level 1-4, newest
    update within 5 min) exists, or when a 554 EEW-warning detection arrived in the last 3 min.
    confidence: 'Lv2/4' for 9611 (P2PQuake level), 'EEW' for a 554 detection, '' when not detected.
    """
    d = bousai_eew_fetch_json("p2p", BOUSAI_EEW_P2P + "?codes=554&codes=9611&limit=30", 5)
    if type(d) != "list":
        return None
    now = time.now()
    best = None
    best_t = None
    chime_t = None
    for e in d:
        if type(e) != "dict":
            continue
        code = e.get("code")
        if code == 554:
            t = bousai_parse_time(e.get("time"))
            if t != None and (now - t).seconds <= 180 and (chime_t == None or t > chime_t):
                chime_t = t
        elif code == 9611 and bousai_eew_p2p_level(e.get("confidence")) > 0:
            t = bousai_parse_time(e.get("updated_at") or e.get("time"))
            if t != None and (now - t).seconds <= 300 and (best_t == None or t > best_t):
                best, best_t = e, t
    if best == None and chime_t == None:
        return {"detected": False, "time": None, "areas_en": [], "confidence": ""}
    areas = []
    confidence = "EEW"
    when = chime_t
    if best != None and (chime_t == None or best_t >= chime_t):
        confidence = "Lv%d/4" % bousai_eew_p2p_level(best.get("confidence"))
        when = best_t
        scored = []
        for code, a in (best.get("area_confidences") or {}).items():
            blk = int(code) // 10 if code.isdigit() else -1
            if blk in BOUSAI_EEW_P2P_PREF:
                scored.append((-(bousai_eew_num((a or {}).get("confidence"), 0.0)), BOUSAI_EEW_P2P_PREF[blk]))
        for _, pref in sorted(scored):
            name = bousai_eew_pref_en(("0" + str(pref))[-2:])
            if name and name not in areas:
                areas.append(name)
    return {"detected": True, "time": when, "areas_en": areas[:6], "confidence": confidence}

# ---------------------------------------------------------------------------
# NIED Kyoshin Monitor images

def bousai_eew_kmoni_xy(lat, lon):
    """Pixel (x, y floats) of lat/lon in the 352 x 400 Kyoshin Monitor images. The map covers
    about 128.6-146.0 E, 29.9-46.2 N (the Okinawa inset uses another transform: not supported)."""
    return BOUSAI_EEW_KMONI_X[0] * lon + BOUSAI_EEW_KMONI_X[1], BOUSAI_EEW_KMONI_Y[0] * lat + BOUSAI_EEW_KMONI_Y[1]

def bousai_eew_kmoni_url(kind, stamp = None):
    """URL of a Kyoshin Monitor image. kind: 'real' (realtime shindo dots), 'est' (EEW estimated
    intensity), 'ps' (EEW P/S-wave circles) take a 'YYYYMMDDhhmmss' stamp; 'base_b' / 'base_w'
    are the dark / white base maps."""
    root = BOUSAI_EEW_KMONI + "/data/map_img/"
    if kind == "base_b":
        return root + "CommonImg/base_map_b.gif"
    if kind == "base_w":
        return root + "CommonImg/base_map_w.gif"
    day = stamp[:8]
    if kind == "real":
        return "%sRealTimeImg/jma_s/%s/%s.jma_s.gif" % (root, day, stamp)
    if kind == "est":
        return "%sEstShindoImg/eew/%s/%s.eew.gif" % (root, day, stamp)
    return "%sPSWaveImg/eew/%s/%s.eew.gif" % (root, day, stamp)

def bousai_eew_kmoni_stamp(t, back = 0):
    """'YYYYMMDDhhmmss' (JST) of time t shifted `back` seconds into the past."""
    if back:
        t = t - time.parse_duration("%ds" % back)
    return t.in_location(BOUSAI_JST).format("20060102150405")

# ---- src/lib/bousai_quake.star ---------------------------------------------

BOUSAI_QUAKE_LIST = "https://www.jma.go.jp/bosai/quake/data/list.json"
BOUSAI_QUAKE_DATA = "https://www.jma.go.jp/bosai/quake/data/"
BOUSAI_QUAKE_EST_LIST = "https://www.jma.go.jp/bosai/estimated_intensity_map/data/list.json"
BOUSAI_QUAKE_EST_DATA = "https://www.jma.go.jp/bosai/estimated_intensity_map/data/"
BOUSAI_QUAKE_MULTI = "https://www.data.jma.go.jp/multi/data/"

# list.json `ttl` (report title) -> report kind. Other titles (Nankai Trough commentary...) are ignored.
BOUSAI_QUAKE_KINDS = {
    "震度速報": "flash",
    "震源に関する情報": "epicenter",
    "震源・震度情報": "detail",
    "震源・震度に関する情報": "detail",
    "遠地地震に関する情報": "distant",
}

BOUSAI_QUAKE_KIND_EN = {
    "flash": "Flash",
    "epicenter": "Epicenter",
    "detail": "Detailed",
    "distant": "Overseas",
}

# Fixed tsunami phrases in the report's ForecastComment (JMA code table) -> short English.
BOUSAI_QUAKE_TSUNAMI_SHORT = {
    "0211": "Tsunami warning/advisory in effect",
    "0212": "Slight sea-level change, no damage expected",
    "0213": "Sea-level changes may continue: take care at the shore",
    "0214": "Sea-level changes may continue: take care when fishing",
    "0215": "No tsunami risk",
    "0216": "Tsunami possible if the epicenter is under the sea",
    "0217": "Check upcoming reports",
    "0221": "Ocean-wide Pacific tsunami possible",
    "0222": "Regional Pacific tsunami possible",
    "0226": "Local tsunami possible near epicenter",
    "0230": "No tsunami risk to Japan",
}

# Nankai Trough extra information (VYSE50) code -> [kind, severity, default display hours].
# Display hours mirror other/temporary_info_config.json (JMA's own web display rule).
BOUSAI_QUAKE_NANKAI = {
    "111": ["Under Analysis", 2, 24],
    "112": ["Under Analysis", 2, 24],
    "113": ["Under Analysis", 2, 24],
    "120": ["Megathrust Earthquake Alert", 4, 336],
    "130": ["Megathrust Earthquake Attention", 3, 168],
}
BOUSAI_QUAKE_NANKAI_CONFIG = {
    "111": "underAnalysisTimeForJnantoraringi",
    "112": "underAnalysisTimeForJnantoraringi",
    "113": "underAnalysisTimeForJnantoraringi",
    "120": "mgathrustEarthquakeAlertTimeForJnantoraringi",
    "130": "megathrustEarthquakeAttentionTimeForJnantoraringi",
}

def bousai_quake_as_list(x):
    """JMA's XML-to-JSON conversion gives a bare object when there is one child; always return a list."""
    if x == None:
        return []
    if type(x) == "list":
        return x
    return [x]

def bousai_quake_tidy(s):
    """Collapse the double spaces JMA leaves in some English names."""
    return " ".join(str(s or "").split())

def bousai_quake_parse_cod(cod):
    """Parse a JMA hypocenter coordinate such as '+35.2+139.0-10000/'.

    Returns (lat, lon, depth_km) or None. depth_km is None when the report has no
    depth (overseas events); 0.0 means 'very shallow'.
    """
    s = str(cod or "").strip().rstrip("/")
    if s == "":
        return None
    for ch in s.elems():
        if ch not in "+-.0123456789":
            return None
    signs = [i for i in range(len(s)) if s[i] == "+" or s[i] == "-"]
    if len(signs) < 2 or signs[0] != 0:
        return None
    lat = float(s[signs[0]:signs[1]])
    end = signs[2] if len(signs) > 2 else len(s)
    lon = float(s[signs[1]:end])
    depth = None
    if len(signs) > 2:
        depth = abs(float(s[signs[2]:])) / 1000.0
    return (lat, lon, depth)

def bousai_quake_mag_text(mag):
    """Magnitude as text ('7.6'). 'M8 or larger' (not yet determined) becomes '8+'; unknown becomes ''."""
    s = str(mag or "").strip()
    if s == "":
        return ""
    numeric = True
    for ch in s.elems():
        if ch not in "0123456789.":
            numeric = False
    if numeric:
        return s
    if "超" in s:
        return "8+"
    return ""

def bousai_quake_depth_text(depth_km, long = False):
    """'10km'; very shallow quakes read 'Very shallow' (long) or '0km'; unknown depth is ''."""
    if depth_km == None:
        return ""
    if depth_km < 1:
        return "Very shallow" if long else "0km"
    return "%dkm" % int(depth_km + 0.5)

def bousai_quake_merge(eid, entries):
    """Build one event from its list.json reports (newest first). None when the newest report cancels it."""
    entries = sorted(entries, key = lambda x: str(x[1].get("ctt") or ""), reverse = True)
    newest_kind, newest = entries[0]
    if "取消" in str(newest.get("ift") or ""):
        return None

    hypo = None
    max_int = None
    areas = []
    for _, e in entries:
        if hypo == None and (e.get("cod") or e.get("acd")):
            hypo = e
        if max_int == None and e.get("maxi"):
            max_int = bousai_intensity_norm(e.get("maxi"))
        if len(areas) == 0 and e.get("int"):
            areas = e.get("int")
    src = hypo or newest

    coord = bousai_quake_parse_cod(src.get("cod"))
    acd = str(src.get("acd") or "")
    epi = bousai_quake_tidy(src.get("en_anm")) or BOUSAI_EPICENTER_EN.get(acd) or bousai_quake_tidy(src.get("anm")) or "Epicenter pending"
    origin = bousai_parse_time(src.get("at") or newest.get("at"))
    reported = bousai_parse_time(newest.get("rdt")) or origin
    if origin == None:
        return None
    return {
        "id": eid,
        "kind": newest_kind,
        "kind_en": BOUSAI_QUAKE_KIND_EN[newest_kind],
        "time": origin,
        "reported": reported,
        "title_en": bousai_quake_tidy(newest.get("en_ttl")) or BOUSAI_QUAKE_KIND_EN[newest_kind],
        "epi_en": epi,
        "acd": acd,
        "lat": coord[0] if coord else None,
        "lon": coord[1] if coord else None,
        "depth": coord[2] if coord else None,
        "mag": bousai_quake_mag_text(src.get("mag")),
        "max_int": max_int,
        "areas": areas,
        "json": str(newest.get("json") or ""),
    }

def bousai_quake_events(feed = None):
    """All earthquake events in the JMA list (about a month), newest origin time first.

    Reports of one event (flash, epicenter, detailed, corrections) are merged. Drills and
    cancelled events are dropped. Returns None when the feed cannot be read.
    """
    raw = feed
    if raw == None:
        raw = bousai_get_json(BOUSAI_QUAKE_LIST, ttl = 30)
    if type(raw) != "list":
        return None
    groups = {}
    order = []
    for e in raw:
        kind = BOUSAI_QUAKE_KINDS.get(e.get("ttl") or "")
        if kind == None or "_K" in str(e.get("ift") or ""):
            continue
        eid = str(e.get("eid") or "")
        if eid == "":
            continue
        if eid not in groups:
            groups[eid] = []
            order.append(eid)
        groups[eid].append((kind, e))
    out = []
    for eid in order:
        ev = bousai_quake_merge(eid, groups[eid])
        if ev != None:
            out.append(ev)
    return sorted(out, key = lambda ev: -ev["time"].unix)

def bousai_quake_filter(events, min_int = "1", overseas = False, now = None):
    """Events felt at min_int or stronger ('1'..'7', '5-', '5+'...). Overseas events only when asked.

    An epicenter-only report whose intensities are still pending (under 10 minutes old) is kept
    so the display follows the flash -> epicenter -> detailed progression.
    """
    min_rank = max(1, bousai_intensity_rank(bousai_intensity_norm(min_int) or "1"))
    now = now or bousai_now()
    out = []
    for ev in events:
        if ev["kind"] == "distant":
            if overseas:
                out.append(ev)
            continue
        rank = bousai_intensity_rank(ev["max_int"])
        if rank >= min_rank:
            out.append(ev)
        elif rank < 0 and ev["kind"] == "epicenter" and (now - ev["reported"]).minutes < 10:
            out.append(ev)
    return out

def bousai_quake_detail(event):
    """Detail JSON of the event's newest report (comments, observation points). None if unavailable."""
    if not event.get("json"):
        return None
    return bousai_get_json(BOUSAI_QUAKE_DATA + event["json"], ttl = 86400)

def bousai_quake_tsunami_text(detail):
    """Short English tsunami comment of a report ('No tsunami risk'), or None."""
    comments = ((detail or {}).get("Body") or {}).get("Comments") or {}
    fc = comments.get("ForecastComment")
    if type(fc) != "dict":
        return None
    codes = str(fc.get("Code") or "").split()
    lines = [bousai_quake_tidy(l) for l in str(fc.get("enText") or "").split("\n") if bousai_quake_tidy(l)]
    parts = []
    for i in range(len(lines)):
        code = codes[i] if len(codes) == len(lines) else ""
        if code == "0245":
            continue
        parts.append(BOUSAI_QUAKE_TSUNAMI_SHORT.get(code) or lines[i])
    if len(parts) == 0:
        return None
    return "; ".join(parts)

def bousai_quake_stations(detail):
    """Intensity observation points of a detailed report: [(lat, lon, label)], strongest first."""
    out = []
    obs = (((detail or {}).get("Body") or {}).get("Intensity") or {}).get("Observation") or {}
    for p in bousai_quake_as_list(obs.get("Pref")):
        for a in bousai_quake_as_list(p.get("Area")):
            for c in bousai_quake_as_list(a.get("City")):
                for s in bousai_quake_as_list(c.get("IntensityStation")):
                    ll = s.get("latlon") or {}
                    label = bousai_intensity_norm(s.get("Int"))
                    if label == None or ll.get("lat") == None or ll.get("lon") == None:
                        continue
                    out.append((float(ll["lat"]), float(ll["lon"]), label))
    return sorted(out, key = lambda s: -bousai_intensity_rank(s[2]))

def bousai_quake_place(config):
    """The configured place in quake-report terms, or None outside Japan / when it cannot be resolved.

    Returns {codes: [7-digit city codes], pref: 2-digit prefecture, wards: None or (low, high)}.
    Reports list the wards of designated cities (Yokohama, Osaka...) individually while JMA's
    forecast area is the whole city (code like 2710000) or a part of it (Yokohama 1410011 / 1410012),
    so for those cities `wards` bounds the ward codes between the city's own code and the next
    municipality's code (designated cities are municipality numbers 100, 130, 140 and 150).
    """
    area = bousai_area(config)
    if area == None:
        return None
    code = area["class20"]
    wards = None
    if code[2:5] in ["100", "130", "140", "150"]:
        upper = "9999999"
        for k in sorted((bousai_area_table() or {}).get("class20s") or {}):
            if k > code and k[:5] != code[:5]:
                upper = k
                break
        wards = (code[:5] + "00", upper)
    return {"codes": [code], "pref": area["pref"], "wards": wards}

def bousai_quake_local(event, place):
    """Intensity felt at `place` (from bousai_quake_place): {city, wards, pref}.

    city is the municipality's intensity label, or the strongest of the city's wards when `wards`
    is True (designated cities); pref is the prefecture's maximum. None where not reported.
    """
    city = None
    ward_max = None
    pref_label = None
    if place == None:
        return {"city": None, "wards": False, "pref": None}
    for p in event.get("areas") or []:
        if p.get("code") == place["pref"]:
            pref_label = bousai_intensity_norm(p.get("maxi"))
        for c in p.get("city") or []:
            code = str(c.get("code") or "")
            if code in place["codes"]:
                city = bousai_intensity_norm(c.get("maxi"))
            elif place["wards"] != None and code > place["wards"][0] and code < place["wards"][1]:
                label = bousai_intensity_norm(c.get("maxi"))
                if bousai_intensity_rank(label) > bousai_intensity_rank(ward_max):
                    ward_max = label
    if city == None and ward_max != None:
        return {"city": ward_max, "wards": True, "pref": pref_label}
    return {"city": city, "wards": False, "pref": pref_label}

def bousai_quake_places(event, table = None):
    """Strongest-shaking places as [(English name, intensity label)], strongest first.

    Cities when the report lists them (names from JMA area.json), prefectures otherwise.
    """
    names = (table or {}).get("class20s") or {}
    found = []
    for p in event.get("areas") or []:
        pref_name = BOUSAI_PREF_EN.get(str(p.get("code") or ""), "")
        cities = p.get("city") or []
        for c in cities:
            label = bousai_intensity_norm(c.get("maxi"))
            name = (names.get(c.get("code")) or {}).get("enName") or pref_name
            if label != None and name:
                found.append((name, label))
        if len(cities) == 0:
            label = bousai_intensity_norm(p.get("maxi"))
            if label != None and pref_name:
                found.append((pref_name, label))
    return sorted(found, key = lambda f: -bousai_intensity_rank(f[1]))

def bousai_quake_estimate(event):
    """JMA estimated seismic intensity distribution map for the event, or None.

    Only strong events have one. Returns {dir, meshes, bounds, comment}. Each mesh is a PNG
    '<dir>/<mesh>.png' (800x800, transparent background) covering 1 degree of longitude by 40
    minutes of latitude: see bousai_quake_mesh_bounds().
    """
    prefix = event["time"].in_location(BOUSAI_JST).format("200601021504")
    est = bousai_get_json(BOUSAI_QUAKE_EST_LIST, ttl = 300)
    if type(est) != "list":
        return None
    for e in est:
        url = str(e.get("url") or "")
        if url.startswith(prefix):
            return {
                "dir": BOUSAI_QUAKE_EST_DATA + url + "/",
                "meshes": [str(m) for m in e.get("mesh_num") or []],
                "bounds": e.get("bounds"),
                "comment": e.get("comment") or "",
            }
    return None

def bousai_quake_mesh_bounds(mesh):
    """(south, west, north, east) of a first-order mesh code such as '5339'."""
    south = int(mesh[0:2]) / 1.5
    west = int(mesh[2:4]) + 100.0
    return (south, west, south + 40.0 / 60.0, west + 1.0)

def bousai_quake_recent(config, limit = 5, min_int = "1"):
    """Most recent earthquakes felt at min_int or stronger, newest first.

    Returns a list of dicts: event_id (str), time (origin, Pixlet time), reported (time of the
    newest report), title_en, epicenter_en, lat, lon (floats, None if unknown), depth_km (float,
    None if unknown, 0.0 = very shallow), mag (str like '4.2', '' if unknown), max_int
    (label '1'..'7', '5-', '5+', '6-', '6+'; '' while pending), local_int (label felt in the
    configured municipality, None when not reported) and tsunami_en (JMA tsunami comment,
    None if absent). Returns [] when the JMA feed is unavailable.
    """
    events = bousai_quake_events()
    if events == None:
        return []
    place = bousai_quake_place(config)
    out = []
    for ev in bousai_quake_filter(events, min_int)[:limit]:
        local = bousai_quake_local(ev, place)
        out.append({
            "event_id": ev["id"],
            "time": ev["time"],
            "reported": ev["reported"],
            "title_en": ev["title_en"],
            "epicenter_en": ev["epi_en"],
            "lat": ev["lat"],
            "lon": ev["lon"],
            "depth_km": ev["depth"],
            "mag": ev["mag"],
            "max_int": ev["max_int"] or "",
            "local_int": local["city"],
            "tsunami_en": bousai_quake_tsunami_text(bousai_quake_detail(ev)),
        })
    return out

def bousai_quake_special():
    """Nankai Trough Earthquake Extra Information and Hokkaido/Sanriku Subsequent Earthquake Advisory in effect.

    Uses JMA's multilingual VYSE50 / VYSE60 files and the same display rule as JMA's own site:
    the report is ANNOUNCED/UPDATED and not older than the configured display period
    (Under Analysis 24 h, Attention 7 days, Alert 14 days, Hokkaido/Sanriku 7 days; 'Analysis
    Complete' is never shown). Returns a list of {title_en, kind_en, issued (time), sev}; sev is
    2 under analysis, 3 attention / subsequent-earthquake advisory, 4 alert. [] when none or unreadable.
    """
    out = []
    now = bousai_now()
    cfg = None
    for name in ["VYSE50", "VYSE60"]:
        j = bousai_get_json(BOUSAI_QUAKE_MULTI + name + "/en.json", ttl = 120)
        if type(j) != "dict" or j.get("infoType") not in ["ANNOUNCED", "UPDATED"]:
            continue
        issued = bousai_parse_time(j.get("reportDateTime"))
        if issued == None:
            continue
        if name == "VYSE50":
            code = str((j.get("earthquakeInfo") or {}).get("code") or "")
            if code not in BOUSAI_QUAKE_NANKAI:
                continue
            kind, sev, hours = BOUSAI_QUAKE_NANKAI[code]
            cfg_key = BOUSAI_QUAKE_NANKAI_CONFIG[code]
            title = "Nankai Trough Earthquake Extra Information"
        else:
            kind, sev, hours = "Subsequent Earthquake Advisory", 3, 168
            cfg_key = "timeForJkouhatsu"
            title = "Off the Coast of Hokkaido and Sanriku Subsequent Earthquake Advisory"
        age_h = (now - issued).hours
        if age_h > 336:
            continue
        if cfg == None:
            cfg = bousai_get_json(BOUSAI_QUAKE_MULTI + "other/temporary_info_config.json", ttl = 86400) or {}
        if age_h > cfg.get(cfg_key, hours):
            continue
        out.append({"title_en": title, "kind_en": kind, "issued": issued, "sev": sev})
    return out

# ---------------------------------------------------------------------------
# Layout helpers shared by the quake and tsunami apps (not part of the data exports).
# A row is (height, builder); builder(frames) makes the widget once the page count, and so each
# page's share of the dwell time for scrolling text, is known.

def bousai_quake_wrap(ui, text, width, max_lines):
    """Greedy word wrap of text to width pixels in the UI font; extra lines are joined onto the last."""
    lines = []
    cur = ""
    for word in text.split(" "):
        trial = cur + " " + word if cur else word
        if cur == "" or bousai_text_width(ui, trial) <= width:
            cur = trial
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    if len(lines) > max_lines:
        lines = lines[:max_lines - 1] + [" ".join(lines[max_lines - 1:])]
    return lines

def bousai_quake_name_lines(ui, text, max_lines = None):
    """A place name wrapped over up to two lines (one at the largest text size); long JMA phrases
    are abbreviated ('Prefecture' -> 'Pref.') before the last line would have to scroll."""
    max_lines = max_lines or (1 if ui["size"] == "xlarge" else 2)
    width = canvas.width() - 1
    lines = bousai_quake_wrap(ui, text, width, max_lines)
    full_n = len(bousai_quake_wrap(ui, text, width, 9))
    if full_n > max_lines or max([bousai_text_width(ui, l) for l in lines]) > width:
        short = text
        for a, b in [(" Prefecture", " Pref."), ("Adjacent Sea of ", "Sea of "), ("Off the Coast of ", "Off "), ("Off the ", "Off ")]:
            short = short.replace(a, b)
        if len(bousai_quake_wrap(ui, short, width, 9)) <= full_n:
            lines = bousai_quake_wrap(ui, short, width, max_lines)
    return lines

def bousai_quake_pack(rows, head_first, head_rest):
    """Greedy pagination of (height, builder) rows. Heads are (height, builder) or None; head_rest repeats on later pages."""
    pages = []
    cur = []
    used = 0
    head = head_first
    avail = canvas.height() - (head[0] if head else 0)
    for r in rows:
        if used + r[0] > avail and len(cur) > 0:
            pages.append({"head": head, "rows": cur})
            cur = []
            used = 0
            head = head_rest
            avail = canvas.height() - (head[0] if head else 0)
        cur.append(r)
        used += r[0]
    if len(cur) > 0:
        pages.append({"head": head, "rows": cur})
    return pages

def bousai_quake_page(page, frames):
    """One page: a {'full': builder} page, or a head over rows from bousai_quake_pack."""
    if "full" in page:
        return page["full"](frames)
    kids = []
    if page["head"]:
        kids.append(page["head"][1](frames))
    for h, build in page["rows"]:
        kids.append(render.Box(width = canvas.width(), height = h, child = build(frames)))
    return render.Box(width = canvas.width(), height = canvas.height(), child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))

def bousai_quake_render(pages):
    """Pages share the dwell time (at least 2.5 s each); a single page uses all of it."""
    n = len(pages)
    if n == 1:
        return bousai_quake_page(pages[0], bousai_budget_frames())
    frames = bousai_hold_frames(n)
    return render.Sequence(children = [bousai_hold(bousai_quake_page(p, frames), frames) for p in pages])

# ---- src/lib/bousai_tsunami.star -------------------------------------------

BOUSAI_TSUNAMI_LIST = "https://www.jma.go.jp/bosai/tsunami/data/list.json"
BOUSAI_TSUNAMI_CLEAR = "https://www.jma.go.jp/bosai/tsunami/data/clearweb.json"
BOUSAI_TSUNAMI_DATA = "https://www.jma.go.jp/bosai/tsunami/data/"
BOUSAI_TSUNAMI_COAST = "https://www.jma.go.jp/bosai/common/const/geojson/tsunami.json"

# Reports older than this are never treated as current, even if the clear time is missing.
BOUSAI_TSUNAMI_MAX_HOURS = 96

# list.json titles that are information rather than a warning / advisory / forecast.
BOUSAI_TSUNAMI_INFO = {
    "各地の満潮時刻・津波到達予想時刻に関する情報": "arrival",
    "津波観測に関する情報": "observed",
    "沖合の津波観測に関する情報": "offshore",
}

# Kind code (Category.Kind.Code) -> severity. 00 = no tsunami, 50 / 60 = warning / advisory lifted.
BOUSAI_TSUNAMI_SEV = {"52": 5, "53": 5, "51": 3, "62": 2, "71": 1, "72": 1, "73": 1}

BOUSAI_TSUNAMI_GRADE_EN = {5: "Major Tsunami Warning", 3: "Tsunami Warning", 2: "Tsunami Advisory", 1: "Tsunami Forecast"}

# Short grade words for narrow rows, and the one-letter chips used on maps.
BOUSAI_TSUNAMI_GRADE_SHORT = {5: "Major", 3: "Warn", 2: "Adv", 1: "Fcst"}
BOUSAI_TSUNAMI_GRADE_LETTER = {5: "M", 3: "W", 2: "A", 1: "F"}

# First-wave conditions (FirstHeight.Condition) -> short English.
BOUSAI_TSUNAMI_COND_EN = {
    "ただちに津波来襲と予測": "Imminent",
    "津波到達中と推測": "Arriving now",
    "第１波の到達を確認": "Arrived",
    "第1波の到達を確認": "Arrived",
    "早いところでは既に津波到達と推定": "May have arrived",
    "第１波識別不能": "Unclear",
    "第1波識別不能": "Unclear",
}

# Qualitative heights (MaxHeight.Condition) -> short English.
BOUSAI_TSUNAMI_HEIGHT_EN = {
    "巨大": "Huge",
    "高い": "High",
    "観測中": "Observing",
    "推定中": "Estimating",
    "微弱": "Tiny",
    "欠測": "No data",
    "今後最大波到達": "More to come",
}

def bousai_tsunami_title(s):
    """JMA writes some English names in capitals ('IWATE PREF.'); title-case those, keep the rest."""
    s = bousai_quake_tidy(s)
    if s != "" and s == s.upper():
        return s.title()
    return s

def bousai_tsunami_height(h):
    """MaxHeight element -> (metres or None, short English text).

    '3' -> (3.0, '3m'), '<0.2' -> (0.2, '<0.2m'), '10+' -> (10.0, '10m+'); qualitative values
    ('巨大') give (None, 'Huge'); nothing gives (None, '').
    """
    h = h or {}
    raw = str(h.get("TsunamiHeight") or "").strip()
    cond = str(h.get("Condition") or "")
    digits = raw.replace("<", "").replace(">", "").replace("+", "").replace("≧", "").replace("≦", "").strip()
    numeric = digits != ""
    for ch in digits.elems():
        if ch not in "0123456789.":
            numeric = False
    if numeric:
        lead = "<" if "<" in raw else (">" if ">" in raw else "")
        return float(digits), lead + digits + "m" + ("+" if "+" in raw else "")
    return None, BOUSAI_TSUNAMI_HEIGHT_EN.get(cond, "")

def bousai_tsunami_first(first):
    """FirstHeight element -> (arrival time or None, condition text '' or e.g. 'Arriving now')."""
    first = first or {}
    return bousai_parse_time(first.get("ArrivalTime")), BOUSAI_TSUNAMI_COND_EN.get(str(first.get("Condition") or ""), "")

def bousai_tsunami_area_name(area):
    """English name of a forecast region: JMA's table by code, else the report's own enName."""
    area = area or {}
    code = str(area.get("Code") or "")
    return BOUSAI_TSUNAMI_AREA_EN.get(code) or bousai_tsunami_title(area.get("enName")) or str(area.get("Name") or code)

def bousai_tsunami_items(detail):
    """Regions listed in a warning / forecast report (VTSE41 or VTSE51 Forecast section).

    Returns [{code, area_en, kcode, kind_en, sev, arrival, cond, height_m, height_en, stations}];
    regions whose warning was lifted (kind 50 / 60 / 00) are left out.
    """
    out = []
    forecast = (((detail or {}).get("Body") or {}).get("Tsunami") or {}).get("Forecast") or {}
    for it in bousai_quake_as_list(forecast.get("Item")):
        kind = ((it.get("Category") or {}).get("Kind")) or {}
        kcode = str(kind.get("Code") or "")
        sev = BOUSAI_TSUNAMI_SEV.get(kcode)
        if sev == None:
            continue
        area = it.get("Area") or {}
        arrival, cond = bousai_tsunami_first(it.get("FirstHeight"))
        h_m, h_en = bousai_tsunami_height(it.get("MaxHeight"))
        stations = []
        for s in bousai_quake_as_list(it.get("Station")):
            ll = s.get("latlon") or {}
            s_arrival, s_cond = bousai_tsunami_first(s.get("FirstHeight"))
            stations.append({
                "name_en": bousai_tsunami_title(s.get("enName") or s.get("Name")),
                "lat": float(ll["lat"]) if ll.get("lat") != None else None,
                "lon": float(ll["lon"]) if ll.get("lon") != None else None,
                "high_tide": bousai_parse_time(s.get("HighTideDateTime")),
                "arrival": s_arrival,
                "cond": s_cond,
            })
        out.append({
            "code": str(area.get("Code") or ""),
            "area_en": bousai_tsunami_area_name(area),
            "kcode": kcode,
            "kind_en": BOUSAI_TSUNAMI_KIND_EN.get(kcode, BOUSAI_TSUNAMI_GRADE_EN[sev]),
            "sev": sev,
            "arrival": arrival,
            "cond": cond,
            "height_m": h_m,
            "height_en": h_en,
            "stations": stations,
        })
    return out

def bousai_tsunami_quakes(detail):
    """Causative earthquakes of a report: [{name_en, lat, lon, depth, mag, time}]."""
    out = []
    for q in bousai_quake_as_list(((detail or {}).get("Body") or {}).get("Earthquake")):
        area = ((q.get("Hypocenter") or {}).get("Area")) or {}
        coord = bousai_quake_parse_cod(area.get("Coordinate"))
        out.append({
            "name_en": bousai_quake_tidy(area.get("enName")) or BOUSAI_EPICENTER_EN.get(str(area.get("Code") or ""), ""),
            "lat": coord[0] if coord else None,
            "lon": coord[1] if coord else None,
            "depth": coord[2] if coord else None,
            "mag": bousai_quake_mag_text(q.get("Magnitude")),
            "time": bousai_parse_time(q.get("OriginTime")),
        })
    return out

def bousai_tsunami_observations(detail):
    """Tide-gauge readings of an observation report (VTSE51 coastal / VTSE52 offshore).

    Returns [{name_en, area_en, lat, lon, height_m, height_en, time, first, rise}] strongest first
    (height_m None for qualitative readings, which sort last); time is when the maximum was
    seen, first the first-wave time, rise 'Rise' / 'Fall' / ''.
    """
    out = []
    obs = (((detail or {}).get("Body") or {}).get("Tsunami") or {}).get("Observation") or {}
    for it in bousai_quake_as_list(obs.get("Item")):
        area_en = bousai_tsunami_area_name(it.get("Area")) if it.get("Area") else ""
        for s in bousai_quake_as_list(it.get("Station")):
            ll = s.get("latlon") or {}
            h = s.get("MaxHeight") or {}
            h_m, h_en = bousai_tsunami_height(h)
            first = s.get("FirstHeight") or {}
            f_time, _ = bousai_tsunami_first(first)
            out.append({
                "name_en": bousai_tsunami_title(s.get("enName") or s.get("Name")),
                "area_en": area_en,
                "lat": float(ll["lat"]) if ll.get("lat") != None else None,
                "lon": float(ll["lon"]) if ll.get("lon") != None else None,
                "height_m": h_m,
                "height_en": h_en,
                "time": bousai_parse_time(h.get("DateTime")),
                "first": f_time,
                "rise": {"押し": "Rise", "引き": "Fall"}.get(str(first.get("Initial") or ""), ""),
            })
    return sorted(out, key = lambda o: -(o["height_m"] if o["height_m"] != None else -1.0))

def bousai_tsunami_state(now = None):
    """The tsunami situation right now, or None when the JMA feed cannot be read.

    Returns a dict:
      active (bool): a warning, advisory or forecast is in effect;
      sev (int): highest severity in effect (0 when none);
      issued: time of the newest warning report (None if the list is empty);
      items: regions in effect, strongest first (see bousai_tsunami_items), after the
        in-effect rule described in the module docstring;
      valid_until: ValidDateTime of the report when it is a forecast, else None;
      quakes: causative earthquakes (bousai_tsunami_quakes);
      last: {title_en, quake_en, mag, time} of the newest warning report, even when expired;
      stations: regions with tide-gauge arrival / high tide times (arrival report, if in effect);
      observed, offshore: tide-gauge readings (bousai_tsunami_observations) of the coastal and
        offshore observation reports, newest report each; info_time: time of the newest of them.
    """
    now = now or bousai_now()
    listing = bousai_get_json(BOUSAI_TSUNAMI_LIST, ttl = 30)
    if type(listing) != "list":
        return None
    clear = bousai_get_json(BOUSAI_TSUNAMI_CLEAR, ttl = 30) or {}
    clear_w = bousai_parse_time(clear.get("w"))
    clear_f = bousai_parse_time(clear.get("f"))

    state = {
        "now": now,
        "active": False,
        "sev": 0,
        "issued": None,
        "items": [],
        "valid_until": None,
        "quakes": [],
        "last": None,
        "stations": [],
        "observed": [],
        "offshore": [],
        "info_time": None,
    }
    warn = None
    info = {}
    for e in listing:
        if "_K" in str(e.get("ift") or ""):
            continue
        kind = BOUSAI_TSUNAMI_INFO.get(e.get("ttl") or "")
        if kind == None:
            if warn == None:
                warn = e
        elif kind not in info:
            info[kind] = e

    if warn != None:
        rdt = bousai_parse_time(warn.get("rdt"))
        state["issued"] = rdt
        state["last"] = {
            "title_en": bousai_quake_tidy(warn.get("en_ttl")),
            "quake_en": bousai_quake_tidy(warn.get("en_anm")),
            "mag": bousai_quake_mag_text(warn.get("mag")),
            "time": bousai_parse_time(warn.get("at")),
        }
        recent = rdt != None and (now - rdt).hours < BOUSAI_TSUNAMI_MAX_HOURS
        if recent and "取消" not in str(warn.get("ift") or "") and warn.get("json"):
            detail = bousai_get_json(BOUSAI_TSUNAMI_DATA + warn["json"], ttl = 86400)
            fresh = clear_w == None or rdt > clear_w
            valid = bousai_parse_time(((detail or {}).get("Head") or {}).get("ValidDateTime"))
            kept = []
            for it in bousai_tsunami_items(detail):
                if it["sev"] >= 2 and fresh:
                    kept.append(it)
                elif it["sev"] == 1 and ((valid != None and now < valid) or (valid == None and fresh)):
                    kept.append(it)
            state["items"] = sorted(kept, key = lambda it: (-it["sev"], it["arrival"].unix if it["arrival"] else 0, it["area_en"]))
            state["quakes"] = bousai_tsunami_quakes(detail)
            if len(kept) > 0:
                state["active"] = True
                state["sev"] = state["items"][0]["sev"]
                if state["sev"] == 1:
                    state["valid_until"] = valid

    for kind, e in info.items():
        rdt = bousai_parse_time(e.get("rdt"))
        if rdt == None or "取消" in str(e.get("ift") or "") or not e.get("json"):
            continue
        if (now - rdt).hours >= BOUSAI_TSUNAMI_MAX_HOURS or (clear_f != None and rdt <= clear_f):
            continue
        detail = bousai_get_json(BOUSAI_TSUNAMI_DATA + e["json"], ttl = 86400)
        if detail == None:
            continue
        if state["info_time"] == None or rdt > state["info_time"]:
            state["info_time"] = rdt
        if kind == "arrival":
            state["stations"] = [it for it in bousai_tsunami_items(detail) if len(it["stations"]) > 0]
        elif kind == "observed":
            state["observed"] = bousai_tsunami_observations(detail)
        else:
            state["offshore"] = bousai_tsunami_observations(detail)
    return state

def bousai_tsunami_coast():
    """JMA tsunami forecast-region coastlines: {region code: [[[lon, lat], ...], ...]}, or None."""
    geo = bousai_get_json(BOUSAI_TSUNAMI_COAST, ttl = 7 * 86400)
    if type(geo) != "dict":
        return None
    out = {}
    for f in geo.get("features") or []:
        code = str((f.get("properties") or {}).get("code") or "")
        g = f.get("geometry") or {}
        lines = g.get("coordinates") or []
        if g.get("type") == "LineString":
            lines = [lines]
        out[code] = lines
    return out

def bousai_tsunami_distances(coast, lat, lon):
    """{region code: km} from lat/lon to the nearest coastline vertex of every forecast region."""
    k = math.cos(math.radians(lat))
    out = {}
    for code, lines in (coast or {}).items():
        best_d = 1.0e9
        best_pt = None
        for line in lines:
            for p in line:
                dx = (p[0] - lon) * k
                dy = p[1] - lat
                d = dx * dx + dy * dy
                if d < best_d:
                    best_d = d
                    best_pt = p
        if best_pt != None:
            out[code] = bousai_distance_km(lat, lon, best_pt[1], best_pt[0])
    return out

def bousai_tsunami_nearest(distances):
    """(region code, km) of the nearest forecast region in a bousai_tsunami_distances() result."""
    best = None
    for code, km in distances.items():
        if best == None or km < distances[best]:
            best = code
    if best == None:
        return None, None
    return best, distances[best]

def bousai_tsunami_arrival_text(item, tz = BOUSAI_JST):
    """'16:40', 'Arriving now', 'Imminent'... for a region / station (arrival time in tz), '' when unknown."""
    if item.get("arrival") != None:
        return bousai_hhmm(item["arrival"], tz)
    return item.get("cond") or ""

def bousai_tsunami_current():
    """Current tsunami warnings, advisories and forecasts for other apps (Home panel, Timeline).

    Returns None when the JMA feed is unavailable, else
    {active (bool), issued (time of the newest warning report, or None), sev (highest severity in
    effect, 0 when none; 5 major warning, 3 warning, 2 advisory, 1 forecast), items: [{area_en,
    kind_en, sev, arrival_en, height_en}]} with the strongest regions first. arrival_en is the
    expected first-wave time as 'HH:MM' in JST, or 'Arriving now' / 'Imminent' / 'Arrived'
    (''); height_en is e.g. '3m', '<0.2m', 'Huge' ('' if not given).
    """
    state = bousai_tsunami_state()
    if state == None:
        return None
    items = []
    for it in state["items"]:
        items.append({
            "area_en": it["area_en"],
            "kind_en": it["kind_en"],
            "sev": it["sev"],
            "arrival_en": bousai_tsunami_arrival_text(it),
            "height_en": it["height_en"],
        })
    return {"active": state["active"], "issued": state["issued"], "sev": state["sev"], "items": items}

# ---- src/lib/bousai_volcano.star -------------------------------------------

BOUSAI_VOLCANO_URL = "https://www.jma.go.jp/bosai/volcano/data/"
BOUSAI_VOLCANO_MULTI_URL = "https://www.data.jma.go.jp/multi/data/VFVO50/en.json"

# Kind code of the "target volcano" line of warning.json ->
# [alert level or None, severity 0..5, official English keyword, short English phrase, badge label].
BOUSAI_VOLCANO_KINDS = {
    "11": [1, 1, "Level 1 (Potential for increased activity)", "Potential for increased activity", "Lv1"],
    "12": [2, 2, "Level 2 (Do not approach the crater)", "Do not approach the crater", "Lv2"],
    "13": [3, 3, "Level 3 (Do not approach the volcano)", "Do not approach the volcano", "Lv3"],
    "14": [4, 4, "Level 4 (Evacuation of the elderly, etc.)", "Prepare to evacuate", "Lv4"],
    "15": [5, 5, "Level 5 (Evacuate)", "Evacuate", "Lv5"],
    "21": [None, 1, "Potential for increased activity", "Potential for increased activity", "Calm"],
    "22": [None, 2, "Caution advised around the crater", "Caution around the crater", "Cau"],
    "23": [None, 3, "Caution in non-residential areas near the crater", "Caution near the crater", "Cau+"],
    "24": [None, 4, "Extreme caution advised at the foot of the mountain", "Extreme caution at the foot", "Ext"],
    "25": [None, 5, "Extreme caution advised in residential areas", "Extreme caution in residential areas", "Ext+"],
    "35": [None, 1, "Potential for increased activity (submarine volcano)", "Potential for increased activity", "Calm"],
    "36": [None, 3, "Caution advised for the sea area in the vicinity of the volcano", "Caution in the nearby sea area", "Sea"],
}

# Volcanoes where Volcanic Alert Levels are applied (volcano_list.json levelOperation). Everything
# else is covered by keyword-only warnings. A level volcano missing from warning.json is at Lv1.
BOUSAI_VOLCANO_LEVEL_OPS = {c: True for c in "104 105 107 108 109 111 112 113 114 202 203 204 205 207 208 209 210 212 213 214 215 301 302 306 307 309 310 311 312 313 314 315 316 317 318 319 320 321 322 350 351 502 503 504 506 508 509 511 513 550 551 552 553".split(" ")}

# warning.json "condition" -> English.
BOUSAI_VOLCANO_COND = {
    "発表": "Issued",
    "継続": "Continued",
    "切替": "Updated",
    "引上げ": "Raised",
    "引下げ": "Lowered",
    "解除": "Lifted",
}

# Eruption flash report phenomenon codes (volcano_dictionary.json warningCode).
BOUSAI_VOLCANO_FLASH_KINDS = {
    "51": "Explosive eruption",
    "52": "Eruption",
    "54": "Continuous eruption ongoing",
    "55": "Continuous eruption stopped",
    "56": "Multiple eruptions",
    "61": "Possible explosion",
    "62": "Possible eruption",
    "64": "Continuous eruption ongoing",
    "65": "Eruption appears to have stopped",
}

# Ashfall forecast polygon codes.
BOUSAI_VOLCANO_ASH_KINDS = {
    "70": "Ash fall",
    "71": "Light ash fall",
    "72": "Moderate ash fall",
    "73": "Heavy ash fall",
    "75": "Small cinders",
}

BOUSAI_VOLCANO_ASH_TYPES = {
    "scheduled": "Scheduled",
    "quick": "Preliminary",
    "detail": "Detailed",
}

# ---------------------------------------------------------------------------
# Warnings

def bousai_volcano_entry(loc, code, kind_code, issued, cond = "", prev_code = ""):
    """One volcano state dict (see bousai_volcano_status) or None for an unknown volcano/kind."""
    row = BOUSAI_VOLCANOES.get(code)
    kind = BOUSAI_VOLCANO_KINDS.get(kind_code)
    if row == None or kind == None:
        return None
    prev = BOUSAI_VOLCANO_KINDS.get(prev_code)
    return {
        "code": code,
        "name_en": row[0],
        "level": kind[0],
        "sev": kind[1],
        "kind_en": kind[2],
        "short_en": kind[3],
        "label": kind[4],
        "issued": issued,
        "lat": row[1],
        "lon": row[2],
        "distance_km": int(bousai_distance_km(loc["lat"], loc["lon"], row[1], row[2]) + 0.5),
        "bearing": bousai_bearing_name(loc["lat"], loc["lon"], row[1], row[2]),
        "cond_en": BOUSAI_VOLCANO_COND.get(cond, ""),
        "prev_label": prev[4] if prev else "",
        "prev_sev": prev[1] if prev else None,
    }

def bousai_volcano_sort(states):
    """Severity descending, alert-level volcanoes before keyword-only ones, then nearest first."""
    return sorted(states, key = lambda s: (-s["sev"], 0 if s["level"] else 1, s["distance_km"], s["name_en"]))

def bousai_volcano_status(config):
    """Rich state of every volcano in JMA's current warning list, severest first.

    Each dict has code, name_en, level (1..5 or None), sev (0..5), kind_en (official keyword),
    short_en, label (badge text), issued (time), lat, lon, distance_km, bearing (compass name from
    the configured location to the volcano), cond_en (Raised/Lowered/...), prev_label, prev_sev.
    Returns None when the feed is unavailable and [] when it lists nothing.
    """
    data = bousai_get_json(BOUSAI_VOLCANO_URL + "warning.json", ttl = 60)
    if type(data) != "list":
        return None
    loc = bousai_location(config)
    out = []
    for report in data:
        if type(report) != "dict":
            continue
        issued = bousai_parse_time(report.get("reportDatetime"))
        for info in report.get("volcanoInfos") or []:
            if "対象火山" not in (info.get("type") or ""):
                continue
            for item in info.get("items") or []:
                for area in item.get("areas") or []:
                    entry = bousai_volcano_entry(loc, area.get("code") or "", item.get("code") or "", issued, item.get("condition") or "", item.get("lastCode") or "")
                    if entry != None:
                        out.append(entry)
    return bousai_volcano_sort(out)

def bousai_volcano_current(config):
    """Volcanoes in JMA's current warning list, severest first (sev desc, alert-level volcanoes
    before keyword-only warnings, then nearest to the configured location).

    Returns [{code, name_en, level, sev, kind_en, issued, lat, lon, distance_km}] where level is the
    Volcanic Alert Level 1..5 (None for volcanoes without alert levels), sev is the 0..5 severity
    index for ui["sev"] (Lv2 -> 2 ... Lv5 -> 5; Lv1/forecast-only entries are 1, filter with
    sev >= 2 for alerts), kind_en is JMA's English keyword (e.g. "Level 3 (Do not approach the
    volcano)"), issued is a time object and distance_km is measured from the configured location.
    [] when the feed is unavailable or nothing is listed.
    """
    out = []
    for s in bousai_volcano_status(config) or []:
        out.append({
            "code": s["code"],
            "name_en": s["name_en"],
            "level": s["level"],
            "sev": s["sev"],
            "kind_en": s["kind_en"],
            "issued": s["issued"],
            "lat": s["lat"],
            "lon": s["lon"],
            "distance_km": s["distance_km"],
        })
    return out

def bousai_volcano_nearest(config, count = 3, states = None):
    """The `count` volcanoes closest to the configured location (any alert level), nearest first.

    Each dict has code, name_en, lat, lon, distance_km, bearing, sev, label, level. Volcanoes missing
    from `states` (a bousai_volcano_status result) are Lv1 when they use alert levels, else sev 0.
    """
    loc = bousai_location(config)
    by_code = {}
    for s in states or []:
        by_code[s["code"]] = s
    ranked = []
    for code, row in BOUSAI_VOLCANOES.items():
        ranked.append((bousai_distance_km(loc["lat"], loc["lon"], row[1], row[2]), code))
    out = []
    for r in sorted(ranked)[:count]:
        code = r[1]
        row = BOUSAI_VOLCANOES[code]
        s = by_code.get(code)
        out.append({
            "code": code,
            "name_en": row[0],
            "lat": row[1],
            "lon": row[2],
            "distance_km": int(r[0] + 0.5),
            "bearing": bousai_bearing_name(loc["lat"], loc["lon"], row[1], row[2]),
            "sev": s["sev"] if s else (1 if code in BOUSAI_VOLCANO_LEVEL_OPS else 0),
            "label": s["label"] if s else ("Lv1" if code in BOUSAI_VOLCANO_LEVEL_OPS else "Calm"),
            "level": s["level"] if s else (1 if code in BOUSAI_VOLCANO_LEVEL_OPS else None),
        })
    return out

def bousai_volcano_places(code):
    """English municipality names under a volcano's warning (JMA multilingual VFVO50); [] if unknown."""
    data = bousai_get_json(BOUSAI_VOLCANO_MULTI_URL, ttl = 600)
    if type(data) != "dict":
        return []
    for report in data.get("report") or []:
        area = (report.get("volcanoInfo") or {}).get("area") or {}
        if area.get("code") != code:
            continue
        names = []
        for group in report.get("volcanoAreaInfo") or []:
            for a in group.get("areas") or []:
                name = (a.get("name") or "").split(":")[-1].strip()
                if name and name not in names:
                    names.append(name)
        return names
    return []

# ---------------------------------------------------------------------------
# Eruption flash reports

def bousai_volcano_event_code(event_id):
    """Volcano code in a JMA event id ('20260101123456_506' or '506')."""
    s = str(event_id or "")
    return s.split("_")[-1] if "_" in s else s[-3:]

def bousai_volcano_flash_reports(max_age_hours = 24, limit = 3):
    """Recent eruption flash reports (噴火速報), newest first, cancelled ones removed.

    Each dict has code, name_en, time, kind_code, text_en, event_id, age_minutes. [] when nothing is
    listed or the feed is unavailable.
    """
    listing = bousai_get_json(BOUSAI_VOLCANO_URL + "eruption.json", ttl = 30)
    if type(listing) != "list":
        return []
    cancelled = {}
    for e in listing:
        if type(e) == "dict" and e.get("infoType") == "取消":
            cancelled[e.get("eventId")] = True
    now = time.now()
    out = []
    seen = {}
    for e in sorted([e for e in listing if type(e) == "dict"], key = lambda e: e.get("reportDatetime") or "", reverse = True):
        event_id = e.get("eventId") or ""
        if event_id in cancelled or event_id in seen or e.get("infoType") == "取消":
            continue
        seen[event_id] = True
        issued = bousai_parse_time(e.get("reportDatetime"))
        if issued == None:
            continue
        age = int((now - issued).seconds // 60)
        if age > max_age_hours * 60:
            continue
        code = bousai_volcano_event_code(event_id)
        row = BOUSAI_VOLCANOES.get(code)
        if row == None:
            continue
        kind_code = ""
        if len(out) < limit:
            detail = bousai_get_json(BOUSAI_VOLCANO_URL + "eruption/%s.json" % event_id, ttl = 300)
            for info in (detail or {}).get("volcanoInfos") or []:
                items = info.get("items") or []
                if items:
                    kind_code = items[0].get("code") or ""
                    break
        out.append({
            "code": code,
            "name_en": row[0],
            "time": issued,
            "kind_code": kind_code,
            "text_en": BOUSAI_VOLCANO_FLASH_KINDS.get(kind_code, "Eruption"),
            "event_id": event_id,
            "age_minutes": age,
        })
        if len(out) >= limit:
            break
    return out

def bousai_volcano_flash():
    """Recent eruption flash reports (JMA 噴火速報) within the last 24 hours, newest first.

    Returns [{name_en, time, text_en}] e.g. {"Sakurajima", <time>, "Explosive eruption"}; [] when
    there is none or the feed is unavailable.
    """
    out = []
    for f in bousai_volcano_flash_reports():
        out.append({"name_en": f["name_en"], "time": f["time"], "text_en": f["text_en"]})
    return out

# ---------------------------------------------------------------------------
# Ashfall forecasts

def bousai_volcano_coord(s):
    """'+3135.55+13039.40+1117/' (ddmm.mm, dddmm.mm, elevation) -> (lat, lon) or None."""
    s = s or ""
    signs = [i for i in range(len(s)) if s[i] == "+" or s[i] == "-"]
    if len(signs) < 2:
        return None
    end = signs[2] if len(signs) > 2 else len(s)
    parts = []
    for a, b in ((signs[0], signs[1]), (signs[1], end)):
        raw = s[a:b].rstrip("/")
        v = float(raw[1:])
        deg = math.floor(v / 100)
        val = deg + (v - deg * 100) / 60.0
        parts.append(-val if raw[0] == "-" else val)
    return (parts[0], parts[1])

def bousai_volcano_ring(poly):
    """'+32.20+131.80/+32.21+131.82/...' -> [(lat, lon), ...]."""
    ring = []
    for part in (poly or "").split("/"):
        if len(part) < 4:
            continue
        cut = -1
        for i in range(1, len(part)):
            if part[i] == "+" or part[i] == "-":
                cut = i
                break
        if cut < 0:
            continue
        ring.append((float(part[:cut]), float(part[cut:])))
    return ring

def bousai_volcano_inside(rings, lat, lon):
    """True when (lat, lon) lies inside any of the rings (ray casting on the lat/lon plane)."""
    for ring in rings:
        inside = False
        j = len(ring) - 1
        for i in range(len(ring)):
            yi, xi = ring[i]
            yj, xj = ring[j]
            if (yi > lat) != (yj > lat) and lon < (xj - xi) * (lat - yi) / (yj - yi) + xi:
                inside = not inside
            j = i
        if inside:
            return True
    return False

def bousai_volcano_extent(rings, lat0, lon0):
    """(distance km, compass name) from the crater to the farthest ring vertex; (0, "") if no rings."""
    best = 0.0
    where = None
    for ring in rings:
        for p in ring:
            d = bousai_distance_km(lat0, lon0, p[0], p[1])
            if d > best:
                best = d
                where = p
    if where == None:
        return 0, ""
    return int(best + 0.5), bousai_bearing_name(lat0, lon0, where[0], where[1])

def bousai_volcano_window(info, lat0, lon0, loc):
    """Normalise one JMA ashinfos entry: layers by polygon code, cinders, extent and user hit flags."""
    layers = []
    cinders = []
    ash_rings = []
    for item in sorted(info.get("items") or [], key = lambda i: i.get("code") or ""):
        rings = [bousai_volcano_ring(p) for p in item.get("polygons") or []]
        code = item.get("code") or ""
        if code == "75":
            cinders.extend(rings)
        elif code in BOUSAI_VOLCANO_ASH_KINDS:
            layers.append((code, rings))
            ash_rings.extend(rings)
    ash_km, ash_dir = bousai_volcano_extent(ash_rings, lat0, lon0)
    cinder_km, cinder_dir = bousai_volcano_extent(cinders, lat0, lon0)
    return {
        "start": bousai_parse_time(info.get("startTime")),
        "end": bousai_parse_time(info.get("endTime")),
        "layers": layers,
        "cinders": cinders,
        "ash_km": ash_km,
        "ash_dir": ash_dir,
        "cinder_km": cinder_km,
        "cinder_dir": cinder_dir,
        "ash_hit": bousai_volcano_inside(ash_rings, loc["lat"], loc["lon"]),
        "cinder_hit": bousai_volcano_inside(cinders, loc["lat"], loc["lon"]),
    }

def bousai_volcano_ash_codes():
    """Volcano codes with a published ashfall forecast: {code: {"type": ..., "reportDatetime": ...}}."""
    data = bousai_get_json(BOUSAI_VOLCANO_URL + "ashfall/japan.json", ttl = 300)
    return data if type(data) == "dict" else {}

def bousai_volcano_ashfall(code, config):
    """Normalised ashfall forecast for a volcano, or None.

    {code, name_en, type ("scheduled" | "quick" | "detail"), type_en, issued, lat, lon, windows}
    where every window has start, end, layers [(polygon code, rings)], cinders (rings), ash_km,
    ash_dir, cinder_km, cinder_dir, ash_hit and cinder_hit (the configured location is inside).
    A scheduled forecast describes where ash would fall IF an eruption occurred; quick and detail
    forecasts follow an actual eruption.
    """
    data = bousai_get_json(BOUSAI_VOLCANO_URL + "ashfall/%s.json" % code, ttl = 300)
    row = BOUSAI_VOLCANOES.get(code)
    if type(data) != "dict" or row == None:
        return None
    best = data.get("scheduled") if type(data.get("scheduled")) == "dict" else None
    best_time = None
    now = time.now()
    for other in data.get("others") or []:
        if type(other) != "dict":
            continue
        t = bousai_parse_time(other.get("reportDatetime"))
        if t == None or (now - t).hours > 12:
            continue
        if best_time == None or t > best_time:
            best = other
            best_time = t
    if best == None:
        return None
    coord = bousai_volcano_coord(best.get("coordinate")) or (row[1], row[2])
    loc = bousai_location(config)
    windows = [bousai_volcano_window(i, coord[0], coord[1], loc) for i in best.get("ashinfos") or []]
    kind = best.get("type") or "scheduled"
    return {
        "code": code,
        "name_en": row[0],
        "type": kind,
        "type_en": BOUSAI_VOLCANO_ASH_TYPES.get(kind, "Forecast"),
        "issued": bousai_parse_time(best.get("reportDatetime")),
        "lat": coord[0],
        "lon": coord[1],
        "windows": windows,
    }

# ---------------------------------------------------------------------------
# Demo sample

def bousai_volcano_plume(lat0, lon0, bearing, length_km, width_km):
    """Teardrop-shaped ring (lat, lon) from the crater towards `bearing` degrees (demo ash plume)."""
    sb = math.sin(math.radians(bearing))
    cb = math.cos(math.radians(bearing))
    kx = 111.2 * math.cos(math.radians(lat0))
    left = []
    right = []
    steps = 10
    for i in range(steps + 1):
        t = i / float(steps)
        along = length_km * t
        half = width_km / 2.0 * math.sin(math.pi * math.pow(t, 1.3))
        for side, bucket in ((1, left), (-1, right)):
            east = along * sb + side * half * cb
            north = along * cb - side * half * sb
            bucket.append((lat0 + north / 111.2, lon0 + east / kx))
    return left + list(reversed(right))

def bousai_volcano_demo(config):
    """Embedded sample for previews and the 'Show sample alert' toggle.

    Sakurajima at Lv3 with a just-issued eruption flash report and a preliminary ashfall forecast,
    plus a few other volcanoes at Lv2 / caution. Modelled on the explosive eruption of Sakurajima
    (Minamidake crater) on 24 July 2022; the other states and the ash plume are illustrative.
    Returns {"states": [...], "flash": [...], "ash": {code: forecast}} in the shapes of the live functions.
    """
    loc = bousai_location(config)
    now = time.now()
    states = []
    for code, kind, days in (("506", "13", 90), ("511", "12", 400), ("551", "12", 365), ("503", "12", 50), ("108", "12", 5), ("326", "22", 40)):
        entry = bousai_volcano_entry(loc, code, kind, now - time.parse_duration("%dh" % (days * 24)))
        if entry != None:
            states.append(entry)
    erupted = now - time.parse_duration("7m")
    flash = [{
        "code": "506",
        "name_en": "Sakurajima",
        "time": erupted,
        "kind_code": "51",
        "text_en": BOUSAI_VOLCANO_FLASH_KINDS["51"],
        "event_id": "demo_506",
        "age_minutes": 7,
    }]
    crater = BOUSAI_VOLCANOES["506"]
    ash = bousai_volcano_plume(crater[1], crater[2], 85, 48, 16)
    heavy = bousai_volcano_plume(crater[1], crater[2], 85, 22, 6)
    cinders = bousai_volcano_plume(crater[1], crater[2], 85, 5, 3)
    ash_km, ash_dir = bousai_volcano_extent([ash], crater[1], crater[2])
    cinder_km, cinder_dir = bousai_volcano_extent([cinders], crater[1], crater[2])
    forecast = {
        "code": "506",
        "name_en": "Sakurajima",
        "type": "quick",
        "type_en": BOUSAI_VOLCANO_ASH_TYPES["quick"],
        "issued": erupted + time.parse_duration("5m"),
        "lat": crater[1],
        "lon": crater[2],
        "windows": [{
            "start": erupted,
            "end": erupted + time.parse_duration("1h"),
            "layers": [("70", [ash]), ("72", [heavy])],
            "cinders": [cinders],
            "ash_km": ash_km,
            "ash_dir": ash_dir,
            "cinder_km": cinder_km,
            "cinder_dir": cinder_dir,
            "ash_hit": False,
            "cinder_hit": False,
        }],
    }
    return {"states": bousai_volcano_sort(states), "flash": flash, "ash": {"506": forecast}}

# ---------------------------------------------------------------------------
# Text layout helpers (bounded scrolling comes from core: bousai_fit / bousai_ticker with `frames`).

def bousai_volcano_fit_len(ui, s, width, font = None):
    """Length of the longest prefix of s that renders within width px."""
    lo = 0
    hi = len(s)
    for _ in range(8):
        if lo >= hi:
            break
        mid = (lo + hi + 1) // 2
        if bousai_text_width(ui, s[:mid], font) <= width:
            lo = mid
        else:
            hi = mid - 1
    return lo

def bousai_volcano_wrap(ui, s, width, font = None):
    """Word-wrap s into lines of at most width px (over-long words are cut)."""
    lines = []
    cur = ""
    for word in s.split(" "):
        trial = cur + " " + word if cur else word
        if bousai_text_width(ui, trial, font) <= width:
            cur = trial
            continue
        if cur:
            lines.append(cur)
        cur = word
        for _ in range(6):
            k = bousai_volcano_fit_len(ui, cur, width, font)
            if k >= len(cur) or k < 1:
                break
            lines.append(cur[:k])
            cur = cur[k:]
    if cur:
        lines.append(cur)
    return lines

def bousai_volcano_page(ui, header, rows, frames):
    """One top-aligned page: header band (widget or None) plus rows (str | (text, colour) | widget).

    Over-long strings scroll within exactly `frames` frames, so the page never outlasts its share
    of the animation budget.
    """
    width = canvas.width()
    kids = []
    if header != None:
        kids.append(header)
    for r in rows:
        if type(r) == "string":
            r = bousai_fit(ui, r, frames = frames)
        elif type(r) == "tuple" or type(r) == "list":
            r = bousai_fit(ui, r[0], color = r[1], frames = frames)
        kids.append(render.Box(width = width, height = ui["line_h"], child = r))
    return render.Box(width = width, height = canvas.height(), child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))

def bousai_volcano_scroll_frames(ui, rows, base):
    """Frames for a page whose over-wide strings should scroll at about 2 px/frame or slower (base .. 60)."""
    travel = 0
    for r in rows:
        text = None
        if type(r) == "string":
            text = r
        elif type(r) == "tuple" or type(r) == "list":
            text = r[0]
        if text != None:
            travel = max(travel, bousai_text_width(ui, text) - canvas.width())
    if travel <= 0:
        return base
    return min(60, max(base, 16 + (travel + 1) // 2))

def bousai_volcano_polygon(points, fill_color = None, stroke_color = None):
    """render.Polygon at absolute screen coordinates (the widget itself always draws at its own origin)."""
    x0 = min([p[0] for p in points])
    y0 = min([p[1] for p in points])
    poly = render.Polygon(vertices = [(p[0] - x0, p[1] - y0) for p in points], fill_color = fill_color, stroke_color = stroke_color, stroke_width = 1)
    return render.Padding(pad = (x0, y0, 0, 0), child = poly)

# ---- src/lib/bousai_typhoon.star -------------------------------------------

BOUSAI_TYPHOON_URL = "https://www.jma.go.jp/bosai/typhoon/data/"

BOUSAI_TYPHOON_CLASS = {
    "TD": "Tropical Depression",
    "TS": "Tropical Storm",
    "STS": "Severe Tropical Storm",
    "TY": "Typhoon",
    "LOW": "Extratropical Cyclone",
}

BOUSAI_TYPHOON_INTENSITY = {
    "強い": "",
    "非常に強い": "Very Strong",
    "猛烈な": "Violent",
}

BOUSAI_TYPHOON_SCALE = {
    "大型": "Large",
    "超大型": "Very large",
}

BOUSAI_TYPHOON_DIRS = {
    "北": "N",
    "北北東": "NNE",
    "北東": "NE",
    "東北東": "ENE",
    "東": "E",
    "東南東": "ESE",
    "南東": "SE",
    "南南東": "SSE",
    "南": "S",
    "南南西": "SSW",
    "南西": "SW",
    "西南西": "WSW",
    "西": "W",
    "西北西": "WNW",
    "北西": "NW",
    "北北西": "NNW",
    "全域": "all around",
}

BOUSAI_TYPHOON_SPEED_WORDS = {
    "ゆっくり": "Slow",
    "ほとんど停滞": "Almost stationary",
}

# ---------------------------------------------------------------------------
# Parsing helpers

def bousai_typhoon_num(v):
    """JMA numeric string/number -> int or float; None for '', '-', words."""
    if v == None:
        return None
    if type(v) == "int" or type(v) == "float":
        return v
    s = str(v).strip()
    if s == "" or not s.replace(".", "", 1).isdigit():
        return None
    return float(s) if "." in s else int(s)

def bousai_typhoon_int(v):
    n = bousai_typhoon_num(v)
    return None if n == None else int(n + 0.5)

def bousai_typhoon_sev(cat, intensity_en = ""):
    """Display severity 0..5 for ui["sev"]: TD 1, TS 2, STS 3, TY 4, Violent TY 5, extratropical 0."""
    if cat == "LOW":
        return 0
    if cat == "TD":
        return 1
    if cat == "TS":
        return 2
    if cat == "STS":
        return 3
    return 5 if intensity_en == "Violent" else 4

def bousai_typhoon_category_en(cat, intensity_en = ""):
    """'Violent Typhoon', 'Typhoon', 'Severe Tropical Storm', ... (JMA English wording)."""
    base = BOUSAI_TYPHOON_CLASS.get(cat, cat or "Tropical Cyclone")
    if cat == "TY" and intensity_en:
        return intensity_en + " Typhoon"
    return base

def bousai_typhoon_dir(jp):
    """English direction for a JMA direction: a Japanese string ('北西'), or a {"jp", "en"} dict, which JMA uses for
    the whole-area wind radius ({"jp": "全域", "en": "All"})."""
    if type(jp) == "dict":
        return BOUSAI_TYPHOON_DIRS.get(jp.get("jp") or "", jp.get("en") or "")
    return BOUSAI_TYPHOON_DIRS.get(jp or "", "")

def bousai_typhoon_area_km(areas):
    """[{area, range: {km}}] -> [(English direction, km)] (empty when the radius is missing)."""
    out = []
    for a in areas or []:
        km = bousai_typhoon_int(((a.get("range") or {}).get("km")))
        if km != None:
            out.append((bousai_typhoon_dir(a.get("area")), km))
    return out

def bousai_typhoon_step(part, loc):
    """Normalise one specifications.json part (analysis or forecast)."""
    pos = (part.get("position") or {}).get("deg") or [None, None]
    wind = part.get("maximumWind") or {}
    cat = ((part.get("category") or {}).get("en")) or ""
    intensity = BOUSAI_TYPHOON_INTENSITY.get(part.get("intensity") or "", "")
    speed = part.get("speed") or {}
    speed_raw = speed.get("km/h")
    lat = pos[0]
    lon = pos[1]
    out = {
        "hours": bousai_typhoon_int(part.get("advancedHours")) or 0,
        "valid": bousai_parse_time(((part.get("validtime") or {}).get("JST"))),
        "lat": lat,
        "lon": lon,
        "cat": cat,
        "intensity_en": intensity,
        "category_en": bousai_typhoon_category_en(cat, intensity),
        "sev": bousai_typhoon_sev(cat, intensity),
        "scale_en": BOUSAI_TYPHOON_SCALE.get(part.get("scale") or "", ""),
        "pressure_hpa": bousai_typhoon_int(part.get("pressure")),
        "wind_ms": bousai_typhoon_int((wind.get("sustained") or {}).get("m/s")),
        "wind_kt": bousai_typhoon_int((wind.get("sustained") or {}).get("kt")),
        "gust_ms": bousai_typhoon_int((wind.get("gust") or {}).get("m/s")),
        "gust_kt": bousai_typhoon_int((wind.get("gust") or {}).get("kt")),
        "course_en": bousai_typhoon_dir(part.get("course")),
        "speed_kmh": bousai_typhoon_int(speed_raw),
        "speed_kt": bousai_typhoon_int(speed.get("kt")),
        "speed_word": BOUSAI_TYPHOON_SPEED_WORDS.get(speed_raw or "", ""),
        "radius_km": bousai_typhoon_int((part.get("probabilityCircleRadius") or {}).get("km")),
        "storm_km": bousai_typhoon_area_km(part.get("stormWarning")),
        "gale_km": bousai_typhoon_area_km(part.get("galeWarning")),
        "distance_km": None,
        "bearing": "",
    }
    if lat != None and lon != None:
        out["distance_km"] = int(bousai_distance_km(loc["lat"], loc["lon"], lat, lon) + 0.5)
        out["bearing"] = bousai_bearing_name(loc["lat"], loc["lon"], lat, lon)
    return out

def bousai_typhoon_build(tc_id, spec, forecast, loc):
    """Typhoon dict from specifications.json (+ optional forecast.json track) or None.

    Keys: tc_id, number, name_en, cat, category_en, intensity_en, scale_en, sev, pressure_hpa,
    wind_ms/kt, gust_ms/kt, lat, lon, course_en, speed_kmh/kt/word, issued, valid, distance_km,
    bearing, storm_km, gale_km ([(direction, km)]), steps (forecast parts, oldest first, each with
    hours, valid, lat, lon, cat, category_en, sev, pressure_hpa, wind_ms, gust_ms, radius_km, ...),
    past ([[lat, lon]] oldest first), gale_circle ([lat, lon, km] or None).
    """
    if type(spec) != "list" or not spec:
        return None
    title = {}
    analysis = None
    steps = []
    for part in spec:
        if type(part) != "dict":
            continue
        if part.get("part") == "title":
            title = part
        elif bousai_typhoon_int(part.get("advancedHours")) == 0 and analysis == None:
            analysis = bousai_typhoon_step(part, loc)
        elif (bousai_typhoon_int(part.get("advancedHours")) or 0) > 0:
            steps.append(bousai_typhoon_step(part, loc))
    if analysis == None or analysis["lat"] == None:
        return None
    number_text = str(title.get("typhoonNumber") or "")
    number = None
    if len(number_text) == 4 and number_text.isdigit():
        number = int(number_text[2:])
    past = []
    gale_circle = None
    for entry in forecast or []:
        if type(entry) != "dict" or bousai_typhoon_int(entry.get("advancedHours")) != 0:
            continue
        track = entry.get("track") or {}
        for pt in (track.get("preTyphoon") or []) + (track.get("typhoon") or []):
            if len(pt) == 2 and (not past or past[-1] != pt):
                past.append(pt)
        gale = entry.get("galeWarningArea") or {}
        if gale.get("center") and gale.get("radius"):
            gale_circle = [gale["center"][0], gale["center"][1], int(gale["radius"] / 1000.0 + 0.5)]
    out = dict(analysis)
    out.update({
        "tc_id": tc_id,
        "number": number,
        "name_en": ((title.get("name") or {}).get("en") or "").strip(),
        "issued": bousai_parse_time(((title.get("issue") or {}).get("JST"))) or analysis["valid"],
        "steps": steps,
        "past": past,
        "gale_circle": gale_circle,
    })
    return out

def bousai_typhoon_list(config, with_track = True):
    """Rich dicts for every active tropical cyclone (extratropical ones dropped), nearest first.

    Returns None when JMA's target list is unavailable, [] when no cyclone is active. Each dict is a
    bousai_typhoon_build result; with_track=False skips forecast.json (no past track).
    """
    targets = bousai_get_json(BOUSAI_TYPHOON_URL + "targetTc.json", ttl = 300)
    if type(targets) != "list":
        return None
    loc = bousai_location(config)
    out = []
    for t in targets:
        if type(t) != "dict" or t.get("category") == "LOW":
            continue
        tc_id = t.get("tropicalCyclone") or ""
        if not tc_id:
            continue
        spec = bousai_get_json(BOUSAI_TYPHOON_URL + "%s/specifications.json" % tc_id, ttl = 600)
        forecast = bousai_get_json(BOUSAI_TYPHOON_URL + "%s/forecast.json" % tc_id, ttl = 600) if with_track else None
        ty = bousai_typhoon_build(tc_id, spec, forecast, loc)
        if ty != None and ty["cat"] != "LOW":
            out.append(ty)
    return sorted(out, key = lambda t: (t["distance_km"] or 0, t["tc_id"]))

def bousai_typhoon_current(config):
    """Active typhoons / tropical cyclones from JMA, nearest to the configured location first.

    Returns [{tc_id, number, name_en, category_en, pressure_hpa, wind_ms, gust_ms, lat, lon,
    course_en, speed_kmh, issued, distance_km, bearing}]: tc_id is JMA's id ("TC2636"), number the
    typhoon number (30 for "Typhoon No. 30", None for a depression), category_en JMA's English class
    ("Violent Typhoon", "Very Strong Typhoon", "Typhoon", "Severe Tropical Storm", "Tropical Storm",
    "Tropical Depression"), pressure in hPa, wind_ms the maximum sustained and gust_ms the maximum
    gust in m/s (None when unpublished), course_en the movement as a 16-point compass name (or
    "Slow"/"Almost stationary"), speed_kmh in km/h (None when slow), issued the analysis issue time
    (time object) and distance_km / bearing (16-point compass name from the configured location to
    the typhoon centre). [] when none is active or the feed is unavailable.
    """
    out = []
    for t in bousai_typhoon_list(config, False) or []:
        out.append({
            "tc_id": t["tc_id"],
            "number": t["number"],
            "name_en": t["name_en"],
            "category_en": t["category_en"],
            "pressure_hpa": t["pressure_hpa"],
            "wind_ms": t["wind_ms"],
            "gust_ms": t["gust_ms"],
            "lat": t["lat"],
            "lon": t["lon"],
            "course_en": t["course_en"] or t["speed_word"],
            "speed_kmh": t["speed_kmh"],
            "issued": t["issued"],
            "distance_km": t["distance_km"],
            "bearing": t["bearing"],
        })
    return out

# ---------------------------------------------------------------------------
# Geometry

def bousai_typhoon_circle(lat, lon, radius_km, points = 24):
    """Great-circle ring of `points` (lat, lon) vertices at radius_km around a centre."""
    d = radius_km / 6371.0
    p1 = math.radians(lat)
    l1 = math.radians(lon)
    out = []
    for i in range(points):
        b = 2 * math.pi * i / points
        p2 = math.asin(math.sin(p1) * math.cos(d) + math.cos(p1) * math.sin(d) * math.cos(b))
        l2 = l1 + math.atan2(math.sin(b) * math.sin(d) * math.cos(p1), math.cos(d) - math.sin(p1) * math.sin(p2))
        out.append((math.degrees(p2), math.degrees(l2)))
    return out

def bousai_typhoon_closest(ty, loc):
    """Closest approach of the forecast centre line to the configured location: (km, hours) or None."""
    pts = [(0, ty["lat"], ty["lon"])]
    for s in ty["steps"]:
        pts.append((s["hours"], s["lat"], s["lon"]))
    if len(pts) < 2:
        return None
    best = None
    for i in range(len(pts) - 1):
        a = pts[i]
        b = pts[i + 1]
        for k in range(0, 7):
            t = k / 6.0
            lat = a[1] + (b[1] - a[1]) * t
            lon = a[2] + (b[2] - a[2]) * t
            d = bousai_distance_km(loc["lat"], loc["lon"], lat, lon)
            if best == None or d < best[0]:
                best = (d, a[0] + (b[0] - a[0]) * t)
    return (int(best[0] + 0.5), int(best[1] + 0.5))

# ---------------------------------------------------------------------------
# Demo sample

def bousai_typhoon_stamp(base, hours):
    """{"JST": RFC3339 time} for `hours` after base, in JMA's specifications.json shape."""
    return {"JST": (base + time.parse_duration("%dh" % hours)).format("2006-01-02T15:04:05-07:00")}

def bousai_typhoon_demo(config):
    """Embedded sample for previews and the 'Show sample alert' toggle: a list with one typhoon.

    Modelled on Typhoon No. 10 (Shanshan) approaching Kyushu on 28-29 August 2024: a large, very
    strong typhoon heading north-north-west then north-east over Kyushu and Shikoku. Positions,
    intensities and radii are rounded illustrations, not an archived JMA record; times are relative
    to now so the sample always looks current.
    """
    loc = bousai_location(config)
    n = bousai_now()
    base = time.time(year = n.year, month = n.month, day = n.day, hour = n.hour, location = BOUSAI_JST)

    # advancedHours, lat, lon, category, intensity, hPa, wind, gust, radius km, course, km/h
    rows = [
        (0, 30.1, 129.9, "TY", "非常に強い", 945, 45, 65, 0, "北北西", 20),
        (12, 32.0, 130.2, "TY", "強い", 955, 40, 55, 70, "北", 15),
        (24, 33.1, 131.5, "STS", "-", 980, 28, 40, 90, "北東", 20),
        (45, 34.0, 134.4, "TS", "-", 990, 23, 35, 150, "東北東", 20),
        (69, 35.2, 137.8, "TS", "-", 992, 20, 30, 220, "東北東", 30),
        (93, 36.8, 141.5, "LOW", "-", 996, 0, 0, 320, "東北東", 45),
        (117, 38.2, 146.5, "LOW", "-", 998, 0, 0, 460, "東", 50),
    ]
    spec = [{
        "part": "title",
        "issue": bousai_typhoon_stamp(base, 0),
        "typhoonNumber": "2410",
        "name": {"jp": "サンサン", "en": "Shanshan"},
        "category": {"jp": "台風", "en": "TY"},
    }]
    for hours, lat, lon, cat, intensity, hpa, wind, gust, radius, course, speed in rows:
        part = {
            "advancedHours": hours,
            "category": {"en": cat},
            "intensity": intensity,
            "position": {"deg": [lat, lon]},
            "course": course,
            "speed": {"km/h": str(speed), "kt": str(int(speed / 1.852 + 0.5))},
            "pressure": str(hpa),
            "validtime": bousai_typhoon_stamp(base, hours),
        }
        if wind > 0:
            part["maximumWind"] = {"sustained": {"m/s": str(wind), "kt": str(int(wind * 1.944 + 0.5))}, "gust": {"m/s": str(gust), "kt": str(int(gust * 1.944 + 0.5))}}
        if hours == 0:
            part["scale"] = "大型"
            part["galeWarning"] = [{"area": "北東", "range": {"km": 650}}, {"area": "南西", "range": {"km": 500}}]
            part["stormWarning"] = [{"area": "北東", "range": {"km": 300}}, {"area": "南西", "range": {"km": 220}}]
        else:
            part["probabilityCircleRadius"] = {"km": radius}
            if wind > 0:
                part["stormWarning"] = [{"area": "全域", "range": {"km": 200 + radius}}]
        spec.append(part)
    past = [[24.0, 136.5], [25.0, 135.2], [26.0, 134.0], [27.0, 132.9], [28.0, 131.9], [29.0, 130.9], [30.1, 129.9]]
    forecast = [{"advancedHours": 0, "track": {"preTyphoon": [], "typhoon": past}, "galeWarningArea": {"center": [30.1, 129.9], "radius": 575000}}]
    ty = bousai_typhoon_build("TC2410", spec, forecast, loc)
    return [ty]

# ---------------------------------------------------------------------------
# Text layout helpers (bounded scrolling comes from core: bousai_fit / bousai_ticker with `frames`).

def bousai_typhoon_fit_len(ui, s, width, font = None):
    """Length of the longest prefix of s that renders within width px."""
    lo = 0
    hi = len(s)
    for _ in range(8):
        if lo >= hi:
            break
        mid = (lo + hi + 1) // 2
        if bousai_text_width(ui, s[:mid], font) <= width:
            lo = mid
        else:
            hi = mid - 1
    return lo

def bousai_typhoon_wrap(ui, s, width, font = None):
    """Word-wrap s into lines of at most width px (over-long words are cut)."""
    lines = []
    cur = ""
    for word in s.split(" "):
        trial = cur + " " + word if cur else word
        if bousai_text_width(ui, trial, font) <= width:
            cur = trial
            continue
        if cur:
            lines.append(cur)
        cur = word
        for _ in range(6):
            k = bousai_typhoon_fit_len(ui, cur, width, font)
            if k >= len(cur) or k < 1:
                break
            lines.append(cur[:k])
            cur = cur[k:]
    if cur:
        lines.append(cur)
    return lines

def bousai_typhoon_page(ui, header, rows, frames):
    """One top-aligned page: header band (widget or None) plus rows (str | (text, colour) | widget).

    Over-long strings scroll within exactly `frames` frames, so the page never outlasts its share
    of the animation budget.
    """
    width = canvas.width()
    kids = []
    if header != None:
        kids.append(header)
    for r in rows:
        if type(r) == "string":
            r = bousai_fit(ui, r, frames = frames)
        elif type(r) == "tuple" or type(r) == "list":
            r = bousai_fit(ui, r[0], color = r[1], frames = frames)
        kids.append(render.Box(width = width, height = ui["line_h"], child = r))
    return render.Box(width = width, height = canvas.height(), child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))

def bousai_typhoon_scroll_frames(ui, rows, base):
    """Frames for a page whose over-wide strings should scroll at about 2 px/frame or slower (base .. 60)."""
    travel = 0
    for r in rows:
        text = None
        if type(r) == "string":
            text = r
        elif type(r) == "tuple" or type(r) == "list":
            text = r[0]
        if text != None:
            travel = max(travel, bousai_text_width(ui, text) - canvas.width())
    if travel <= 0:
        return base
    return min(60, max(base, 16 + (travel + 1) // 2))

def bousai_typhoon_polygon(points, fill_color = None, stroke_color = None):
    """render.Polygon at absolute screen coordinates (the widget itself always draws at its own origin)."""
    x0 = min([p[0] for p in points])
    y0 = min([p[1] for p in points])
    poly = render.Polygon(vertices = [(p[0] - x0, p[1] - y0) for p in points], fill_color = fill_color, stroke_color = stroke_color, stroke_width = 1)
    return render.Padding(pad = (x0, y0, 0, 0), child = poly)

def bousai_typhoon_line(a, b, color):
    """1 px render.Line between two screen points (the widget itself always draws at its own origin)."""
    x0 = min(a[0], b[0])
    y0 = min(a[1], b[1])
    line = render.Line(x1 = a[0] - x0, y1 = a[1] - y0, x2 = b[0] - x0, y2 = b[1] - y0, color = color, width = 1)
    return render.Padding(pad = (x0, y0, 0, 0), child = line)

# ---- src/lib/bousai_warnings.star ------------------------------------------

BOUSAI_WARNINGS_R8_URL = "https://www.jma.go.jp/bosai/warning/data/r8/%s.json"
BOUSAI_WARNINGS_FLOOD_URL = "https://www.jma.go.jp/bosai/flood/data/r8/flood_xml.json"
BOUSAI_WARNINGS_FEED_URL = "https://www.data.jma.go.jp/developer/xml/feed/extra_l.xml"
BOUSAI_WARNINGS_FEED_KEY = "bousai_warnings:feed:v1"
BOUSAI_WARNINGS_XML_KEY = "bousai_warnings:xml:v2:"

# Bulletins older than this are never fetched. A tornado watch carries its own ValidDateTime (about one hour);
# record short-term heavy rain has no validity, so it stays visible for two hours.
BOUSAI_WARNINGS_FEED_MAX_AGE = 6 * 3600
BOUSAI_WARNINGS_TORNADO_MAX_AGE = 3 * 3600
BOUSAI_WARNINGS_RECORD_RAIN_AGE = 2 * 3600

# Severity index (ui["sev"]) of the notices. Flood notices use the flood level / 10.
BOUSAI_WARNINGS_TORNADO_SEV = 3
BOUSAI_WARNINGS_RECORD_RAIN_SEV = 4

BOUSAI_WARNINGS_MAX_SAVED = 5

# Level -> JMA English term.
BOUSAI_WARNINGS_LEVEL_EN = {20: "Advisory", 30: "Warning", 40: "Urgent Warning", 50: "Emergency Warning"}

# r8 element -> [English name at Lv2, English name at Lv3 and above]. Terms follow the dictionary of the JMA
# warning page (e.g. 強風 Gale / 暴風 Storm, 風雪 Gale and Snow / 暴風雪 Snowstorm); the dictionary spells
# 雷 "Thunder Storm", here it is written "Thunderstorm". Insertion order is the display order.
BOUSAI_WARNINGS_ELEMENTS = {
    "rain": ["Heavy Rain", "Heavy Rain"],
    "landslide": ["Landslide", "Landslide"],
    "tide": ["Storm Surge", "Storm Surge"],
    "wind": ["Gale", "Storm"],
    "wind_snow": ["Gale and Snow", "Snowstorm"],
    "snow": ["Heavy Snow", "Heavy Snow"],
    "wave": ["High Wave", "High Wave"],
    "thunder": ["Thunderstorm", "Thunderstorm"],
    "snow_melting": ["Snow Melting", "Snow Melting"],
    "fog": ["Dense Fog", "Dense Fog"],
    "dry": ["Dry Air", "Dry Air"],
    "avalanche": ["Avalanche", "Avalanche"],
    "cold": ["Low Temperature", "Low Temperature"],
    "frost": ["Frost", "Frost"],
    "ice_accretion": ["Ice Accretion", "Ice Accretion"],
    "snow_accretion": ["Snow Accretion", "Snow Accretion"],
}

# r8 kind status -> English. 解除 (cancelled) and 発表警報・注意報はなし (none issued) are not active.
BOUSAI_WARNINGS_INACTIVE = ["解除", "発表警報・注意報はなし"]
BOUSAI_WARNINGS_STATUS_EN = {
    "発表": "Issued",
    "継続": "Continued",
    "警報から注意報": "Downgraded from Warning",
    "特別警報から警報": "Downgraded from Emergency Warning",
    "特別警報から注意報": "Downgraded from Emergency Warning",
}

# Designated-river flood forecast item.code -> level (table of the JMA warning page JS; 50 and 52 are shown as
# "flood occurrence" colours by the JMA flood page).
BOUSAI_WARNINGS_FLOOD_LEVEL = {"20": 20, "21": 20, "22": 20, "30": 30, "31": 30, "40": 40, "41": 40, "50": 50, "51": 50, "52": 50, "53": 50}

# Fallback when an unknown item.code arrives: level from the Japanese item.name (old and Lv-style names).
BOUSAI_WARNINGS_FLOOD_NAMES = [
    ["レベル５", 50],
    ["氾濫発生", 50],
    ["氾濫特別警報", 50],
    ["レベル４", 40],
    ["氾濫危険", 40],
    ["レベル３", 30],
    ["氾濫警戒", 30],
    ["氾濫警報", 30],
    ["レベル２", 20],
    ["氾濫注意", 20],
]
BOUSAI_WARNINGS_FLOOD_INFO_EN = {20: "flood caution", 30: "flood warning", 40: "flood danger", 50: "flood occurrence"}

BOUSAI_WARNINGS_FULLWIDTH = [["０", "0"], ["１", "1"], ["２", "2"], ["３", "3"], ["４", "4"], ["５", "5"], ["６", "6"], ["７", "7"], ["８", "8"], ["９", "9"]]

# ---------------------------------------------------------------------------
# Areas

def bousai_warnings_ascii(s):
    """Replace full-width digits by ASCII digits."""
    for pair in BOUSAI_WARNINGS_FULLWIDTH:
        s = s.replace(pair[0], pair[1])
    return s

def bousai_warnings_parse_codes(text):
    """Split a free-text list of 7-digit JMA municipality codes.

    Accepts commas, spaces, semicolons, newlines and full-width digits. Returns [codes, rejected]; codes are
    unique and capped at BOUSAI_WARNINGS_MAX_SAVED.
    """
    flat = bousai_warnings_ascii(text or "")
    for sep in ["，", "、", "；", ";", "\n", "\t", "　", " "]:
        flat = flat.replace(sep, ",")
    codes = []
    rejected = []
    for raw in flat.split(","):
        c = raw.strip()
        if not c:
            continue
        if len(c) == 7 and c.isdigit():
            if c not in codes and len(codes) < BOUSAI_WARNINGS_MAX_SAVED:
                codes.append(c)
        elif c not in rejected:
            rejected.append(c)
    return [codes, rejected]

def bousai_warnings_area_for_code(code, table = None):
    """bousai_area()-shaped dict for a 7-digit JMA municipality code (lat/lon are None); None when unknown."""
    table = table or bousai_area_table()
    if not table:
        return None
    c20 = (table.get("class20s") or {}).get(code)
    if c20 == None:
        return None
    c15_code = c20.get("parent") or ""
    c15 = (table.get("class15s") or {}).get(c15_code) or {}
    c10_code = c15.get("parent") or ""
    c10 = (table.get("class10s") or {}).get(c10_code) or {}
    office_code = c10.get("parent") or ""
    office = (table.get("offices") or {}).get(office_code) or {}
    return {
        "class20": code,
        "class15": c15_code,
        "class10": c10_code,
        "office": office_code,
        "center": office.get("parent") or "",
        "pref": code[:2],
        "class20_en": c20.get("enName") or code,
        "class15_en": c15.get("enName") or "",
        "class10_en": c10.get("enName") or "",
        "office_en": office.get("enName") or "",
        "lat": None,
        "lon": None,
    }

def bousai_warnings_region_name(area):
    """English name of the area's class10 region, with the office when that disambiguates it."""
    region = area.get("class10_en") or ""
    office = area.get("office_en") or ""
    if region and office and office not in region:
        return "%s, %s" % (region, office)
    return region or office or (area.get("class20_en") or "")

# ---------------------------------------------------------------------------
# r8 warnings

def bousai_warnings_reports(office):
    """Decoded r8 reports of a JMA office (one per dataTypeCode), or None when unavailable."""
    if not office:
        return None
    data = bousai_get_json(BOUSAI_WARNINGS_R8_URL % office, ttl = 60)
    if type(data) != "list":
        return None
    return data

def bousai_warnings_collect(reports, code, key):
    """Union of the active kinds of one area code across every report.

    Returns [found, kinds]: found is True when the area is listed in any report (even with nothing active);
    kinds maps kind code -> [status, reportDatetime of the newest report mentioning it].
    """
    found = False
    kinds = {}
    for rep in reports:
        if type(rep) != "dict":
            continue
        stamp = rep.get("reportDatetime") or ""
        for item in (rep.get("warning") or {}).get(key) or []:
            if item.get("areaCode") != code:
                continue
            found = True
            for kind in item.get("kinds") or []:
                kcode = kind.get("code")
                status = kind.get("status") or ""
                if not kcode or status in BOUSAI_WARNINGS_INACTIVE:
                    continue
                prev = kinds.get(kcode)
                if prev == None or stamp > prev[1]:
                    kinds[kcode] = [status, stamp]
    return [found, kinds]

def bousai_warnings_build(reports, area):
    """Active warnings of an area from decoded r8 reports. Returns [items, area name used].

    Uses the municipality (class20) when any report lists it, otherwise the class10 region.
    """
    c20 = area.get("class20") or ""
    found = False
    kinds = {}
    name = area.get("class20_en") or c20
    if c20:
        res = bousai_warnings_collect(reports, c20, "class20Items")
        found, kinds = res[0], res[1]
    if not found:
        res = bousai_warnings_collect(reports, area.get("class10") or "", "class10Items")
        kinds = res[1]
        name = bousai_warnings_region_name(area)

    best = {}
    for kcode, state in kinds.items():
        info = BOUSAI_WARN_CODES.get(kcode)
        if info == None:
            continue
        element, level = info[0], info[1]
        cur = best.get(element)
        if cur == None or level > cur["level"] or (level == cur["level"] and state[1] > cur["stamp"]):
            best[element] = {"element": element, "level": level, "status": state[0], "stamp": state[1]}

    order = {}
    for i, element in enumerate(BOUSAI_WARNINGS_ELEMENTS.keys()):
        order[element] = i

    now = time.now()
    items = []
    for element, b in best.items():
        names = BOUSAI_WARNINGS_ELEMENTS.get(element) or [element.replace("_", " ").title()] * 2
        element_en = names[0] if b["level"] <= 20 else names[1]
        level = b["level"]
        items.append({
            "element": element,
            "element_en": element_en,
            "level": level,
            "sev": level // 10,
            "label_en": "%s: %s" % (BOUSAI_WARNINGS_LEVEL_EN.get(level) or "Warning", element_en),
            "status": BOUSAI_WARNINGS_STATUS_EN.get(b["status"]) or "Active",
            "issued": bousai_parse_time(b["stamp"]) or now,
            "area_en": name,
        })
    return [sorted(items, key = lambda w: (-w["level"], order.get(w["element"], 99))), name]

def bousai_warnings_current(area):
    """Active weather warnings for an area (area = bousai_area(config) dict), most severe first.

    Returns a list of dicts, [] when nothing is active, the area is None or the JMA feed is unavailable:
      element    r8 element id: rain, landslide, tide, wind, wind_snow, snow, wave, thunder, snow_melting, fog,
                 dry, avalanche, cold, frost, ice_accretion, snow_accretion
      element_en JMA English name, level dependent for wind ("Gale" Lv2 / "Storm" Lv3+) and wind_snow
                 ("Gale and Snow" / "Snowstorm")
      level      20 advisory, 30 warning, 40 urgent warning (Lv4), 50 emergency warning (Lv5)
      sev        2..5 index into ui["sev"] (level // 10)
      label_en   e.g. "Urgent Warning: Heavy Rain"
      status     "Issued", "Continued" or "Downgraded from ..."
      issued     Pixlet time of the newest r8 report that carries the warning
      area_en    municipality (class20), or "<class10 region>, <office>" when the municipality is not listed
    One entry per element (the highest level). Landslide is the JMA landslide alert level
    (Lv2 advisory ... Lv4 landslide alert information ... Lv5).
    """
    if not area:
        return []
    reports = bousai_warnings_reports(area.get("office"))
    if reports == None:
        return []
    return bousai_warnings_build(reports, area)[0]

# ---------------------------------------------------------------------------
# Designated-river flood forecasts (flood_xml.json)

def bousai_warnings_flood_level(entry):
    """Flood level (20..50) of a flood_xml.json entry, None when the entry is not an active forecast."""
    if (entry.get("infoType") or "") in ["取消", "訓練", "試験"]:
        return None
    item = entry.get("item")
    if type(item) != "dict":
        item = {}
    if (item.get("status") or "") == "解除":
        return None
    level = BOUSAI_WARNINGS_FLOOD_LEVEL.get(str(item.get("code") or ""))
    if level != None:
        return level
    name = item.get("name") or ""
    if name.endswith("解除"):
        return None
    name = bousai_warnings_ascii(name)
    for pair in BOUSAI_WARNINGS_FLOOD_NAMES:
        if bousai_warnings_ascii(pair[0]) in name:
            return pair[1]
    return None

def bousai_warnings_flood_notices(data, area):
    """Notices for the active designated-river flood forecasts that touch an area.

    Entry schema (from the JMA page JS): infoType, reportDatetime, riverCode, riverName, officeCodes,
    class10Codes, class20Codes, item {code, name}. A forecast matches on the municipality (class20Codes) or
    on the class10 region (class10Codes). Returns one notice per (level, match kind).
    """
    if type(data) != "list" or not area:
        return []
    c20 = area.get("class20") or ""
    c10 = area.get("class10") or ""
    groups = {}
    for i, entry in enumerate(data):
        if type(entry) != "dict":
            continue
        level = bousai_warnings_flood_level(entry)
        if level == None:
            continue
        hit = ""
        if c20 and c20 in (entry.get("class20Codes") or []):
            hit = "city"
        elif c10 and c10 in (entry.get("class10Codes") or []):
            hit = "region"
        if not hit:
            continue
        key = "%d:%s" % (level, hit)
        g = groups.setdefault(key, {"level": level, "hit": hit, "rivers": [], "issued": None})
        river = str(entry.get("riverCode") or entry.get("riverName") or i)
        if river not in g["rivers"]:
            g["rivers"].append(river)
        t = bousai_parse_time(entry.get("reportDatetime"))
        if t != None and (g["issued"] == None or t > g["issued"]):
            g["issued"] = t
    now = time.now()
    out = []
    for g in groups.values():
        n = len(g["rivers"])
        plural = "" if n == 1 else "s"
        text = "%d river%s: %s" % (n, plural, BOUSAI_WARNINGS_FLOOD_INFO_EN[g["level"]])
        if g["hit"] == "region":
            text = "Nearby: %d river%s, %s" % (n, plural, BOUSAI_WARNINGS_FLOOD_INFO_EN[g["level"]])
        out.append({
            "kind_en": "River Flood " + BOUSAI_WARNINGS_LEVEL_EN[g["level"]],
            "text_en": text,
            "issued": g["issued"] or now,
            "sev": g["level"] // 10,
        })
    return out

# ---------------------------------------------------------------------------
# Bulletins from the XML long feed: tornado watch and record short-term heavy rain

def bousai_warnings_feed():
    """Tornado watch / record rain entries of the JMA long feed, newest first; None when the feed is unavailable.

    Each entry: {kind: "tornado" | "record", href, updated, code}. `code` is the issuing office code that
    ends the XML file name (e.g. 390000 for Kochi). Only the small filtered list is cached (120 s), the 2.8 MB
    feed itself is parsed at most once per cache period.
    """
    cached = cache.get(BOUSAI_WARNINGS_FEED_KEY)
    if cached:
        return json.decode(cached, default = None)
    body = bousai_get_bytes(BOUSAI_WARNINGS_FEED_URL, ttl = 120)
    if body == None:
        return None
    doc = xpath.loads(body)
    nodes = doc.query_all_nodes("//entry[title='竜巻注意情報' or title='竜巻注意情報（目撃情報付き）' or title='記録的短時間大雨情報' or title='府県気象防災速報']")
    now = time.now()
    out = []
    for n in nodes:
        title = n.query("title") or ""
        href = n.query("link/@href") or n.query("id") or ""
        content = n.query("content") or ""
        updated = n.query("updated") or ""
        if not href or not updated:
            continue
        kind = ""
        if title.startswith("竜巻注意情報"):
            kind = "tornado"
        elif title == "記録的短時間大雨情報" or "（記録的短時間大雨）" in content:
            kind = "record"
        t = bousai_parse_time(updated)
        if not kind or t == None or (now - t).seconds > BOUSAI_WARNINGS_FEED_MAX_AGE:
            continue
        tail = href.split("/")[-1].replace(".xml", "")
        out.append({
            "kind": kind,
            "href": href,
            "updated": updated,
            "code": tail.split("_")[-1],
        })
    cache.set(BOUSAI_WARNINGS_FEED_KEY, json.encode(out), ttl_seconds = 120)
    return out

def bousai_warnings_parse_bulletin(text):
    """Plain-value summary of a JMA tornado watch / record rain XML document (None when it cannot be parsed)."""
    if not text:
        return None
    doc = xpath.loads(text)
    places = []
    for n in doc.query_all_nodes("//MeteorologicalInfo/Item"):
        code = n.query("Area/Code") or ""
        amount = "*[local-name()='Precipitation']"
        mm = n.query("Kind/Property/PrecipitationPart/" + amount) or ""
        if code and mm:
            places.append({"code": code, "mm": mm, "cond": n.query("Kind/Property/PrecipitationPart/" + amount + "/@condition") or ""})
    return {
        "status": doc.query("//Control/Status") or "",
        "info_type": doc.query("//Head/InfoType") or "",
        "issued": doc.query("//Head/ReportDateTime") or "",
        "valid": doc.query("//Head/ValidDateTime") or "",
        "codes": doc.query_all("//Headline/Information/Item/Areas/Area/Code") or [],
        "sight_codes": doc.query_all("//Headline/Information[@type='竜巻注意情報（目撃情報あり）']/Item/Areas/Area/Code") or [],
        "tags": doc.query_all("//Headline/Information/Item/Kind/Condition") or [],
        "headline": doc.query("//Headline/Text") or "",
        "places": places,
    }

def bousai_warnings_detail(entry):
    """Parsed XML of a feed entry (cached six hours, the documents never change); None when unavailable."""
    key = BOUSAI_WARNINGS_XML_KEY + entry["href"].split("/")[-1]
    cached = cache.get(key)
    if cached:
        return json.decode(cached, default = None)
    body = bousai_get_bytes(entry["href"], ttl = 3600)
    if body == None:
        return None
    detail = bousai_warnings_parse_bulletin(body)
    if detail != None:
        cache.set(key, json.encode(detail), ttl_seconds = 6 * 3600)
    return detail

def bousai_warnings_area_hit(area, codes):
    """How the area codes of a bulletin relate to an area: "city", "region" or "" (no match).

    7-digit codes are municipalities: a bulletin that lists municipalities matches only when the area's own
    (same 5-digit municipality stem) is listed. Otherwise 6-digit class15 / class10 / prefecture-wide codes decide.
    """
    c20 = area.get("class20") or ""
    sevens = [c for c in codes if len(c) == 7]
    if sevens:
        for c in sevens:
            if c20 and c[:5] == c20[:5]:
                return "city"
        return ""
    for key in ["class15", "class10"]:
        if area.get(key) and area.get(key) in codes:
            return "region"
    office = area.get("office") or ""
    pref = area.get("pref") or ""
    for c in codes:
        if c == office or (len(c) == 6 and pref and c[:2] == pref and c[2:] == "0000"):
            return "region"
    return ""

def bousai_warnings_amount(cond, mm):
    """'About 120 mm/h' style text for an amount (JMA condition 約 / 以上) and millimetres of rain in one hour."""
    prefix = {"約": "About ", "以上": "Over "}.get(cond) or ""
    return "%s%s mm/h" % (prefix, mm)

def bousai_warnings_rain_lines(headline):
    """Places and amounts of a legacy record rain headline: [{name, mm, cond}] (names stay Japanese)."""
    out = []
    for raw in bousai_warnings_ascii(headline or "").split("\n"):
        line = raw.strip()
        i = line.find("ミリ")
        j = line.find("付近")
        if i <= 0 or j <= 0 or j > i:
            continue
        digits = ""
        for p in range(i - 1, -1, -1):
            if line[p] in "0123456789":
                digits = line[p] + digits
            else:
                break
        if not digits:
            continue
        cond = ""
        if line[:i].endswith(digits) and line[:i - len(digits)].endswith("約"):
            cond = "約"
        elif line[i:].startswith("ミリ以上"):
            cond = "以上"
        out.append({"name": line[:j], "mm": digits, "cond": cond})
    return out

def bousai_warnings_municipality(table, pref, name):
    """[code, English name] of the class20 area called `name` (Japanese) in a prefecture; longest prefix wins."""
    best = ["", ""]
    best_len = 0
    for code, c in (table.get("class20s") or {}).items():
        if code[:2] != pref:
            continue
        n = c.get("name") or ""
        if n and len(n) > best_len and (name == n or name.startswith(n)):
            best = [code, c.get("enName") or code]
            best_len = len(n)
    return best

def bousai_warnings_record_rain(detail, area, table):
    """[match, text] for a record rain bulletin and an area, or None when it does not concern the area.

    match is "city" (the area's own municipality is named; the text is just the amount) or "region" (elsewhere in
    its region / prefecture; the text names the place).
    """
    c20 = area.get("class20") or ""
    c10 = area.get("class10") or ""
    if detail["places"]:
        # New VPBS50 bulletin: class20 codes with the 1-hour analysed rainfall in the body.
        if "記録雨" not in detail["tags"]:
            return None
        city = None
        region = None
        for p in detail["places"]:
            code = p["code"]
            if c20 and code[:5] == c20[:5]:
                city = city or p
            elif table:
                c15 = (table.get("class20s") or {}).get(code, {}).get("parent") or ""
                if c10 and (table.get("class15s") or {}).get(c15, {}).get("parent") == c10:
                    region = region or p
        hit = city or region
        if hit == None:
            return None
        name = ""
        if city == None and table:
            name = (table.get("class20s") or {}).get(hit["code"], {}).get("enName") or ""
        text = bousai_warnings_amount(hit["cond"], bousai_warnings_ascii(hit["mm"]))
        return ["city" if city != None else "region", text + (" near " + name if name else "")]

    # Legacy VPOA50: area codes of the regions (class10 / prefecture) and the places in the Japanese headline.
    codes = detail["codes"]
    if not bousai_warnings_area_hit(area, codes):
        return None
    lines = bousai_warnings_rain_lines(detail["headline"])
    pref = area.get("pref") or ""
    city = None
    first = None
    for line in lines:
        if not table:
            break
        res = bousai_warnings_municipality(table, pref, line["name"])
        if not res[0]:
            continue
        line["en"] = res[1]
        first = first or line
        if c20 and res[0][:5] == c20[:5]:
            city = city or line
    hit = city or first
    if hit == None:
        return ["region", "Record heavy rain in " + bousai_warnings_region_name(area)]
    text = bousai_warnings_amount(hit["cond"], hit["mm"])
    return ["city", text] if city != None else ["region", text + " near " + hit["en"]]

def bousai_warnings_bulletin_notices(area, now, entries, details, table):
    """Pure matching step for tornado watch / record rain notices.

    entries are feed entries, details maps href -> parsed XML (bousai_warnings_parse_bulletin), table is the JMA
    area table (or None). Returns notices {kind_en, text_en, issued, sev} that are still valid at `now`.
    """
    pref = area.get("pref") or ""
    cancelled = {}
    for e in entries:
        d = details.get(e["href"])
        if d != None and d["info_type"] == "取消":
            t = bousai_parse_time(d["issued"]) or bousai_parse_time(e["updated"])
            key = e["kind"] + e["code"]
            if t != None and (cancelled.get(key) == None or t > cancelled[key]):
                cancelled[key] = t

    found = []
    for e in entries:
        d = details.get(e["href"])
        if d == None or e["code"][:2] != pref or d["info_type"] == "取消" or d["status"] in ["訓練", "試験"]:
            continue
        issued = bousai_parse_time(d["issued"]) or bousai_parse_time(e["updated"])
        if issued == None:
            continue
        cut = cancelled.get(e["kind"] + e["code"])
        if cut != None and cut > issued:
            continue
        if e["kind"] == "tornado":
            valid = bousai_parse_time(d["valid"]) if d["valid"] else issued + time.parse_duration("1h")
            if valid == None or now > valid or not bousai_warnings_area_hit(area, d["codes"]):
                continue
            text = "Until %s JST" % valid.in_location("Asia/Tokyo").format("15:04")
            sighted = bousai_warnings_area_hit(area, d.get("sight_codes") or []) if d.get("sight_codes") else ""
            if sighted:
                text = "Tornado seen. " + text
            found.append({"kind_en": "Tornado Watch", "text_en": text, "issued": issued, "sev": BOUSAI_WARNINGS_TORNADO_SEV, "key": "tornado" + e["code"], "rank": 1 if sighted else 0})
        else:
            if (now - issued).seconds > BOUSAI_WARNINGS_RECORD_RAIN_AGE:
                continue
            res = bousai_warnings_record_rain(d, area, table)
            if res == None:
                continue
            found.append({"kind_en": "Record Short-Term Heavy Rain", "text_en": res[1], "issued": issued, "sev": BOUSAI_WARNINGS_RECORD_RAIN_SEV, "key": "record" + res[1], "rank": 1 if res[0] == "city" else 0})

    # VPHW50 and VPHW51 are issued together for the same watch; keep the newest of each key, preferring the richer one.
    best = {}
    for n in found:
        cur = best.get(n["key"])
        if cur == None or (n["issued"], n["rank"]) > (cur["issued"], cur["rank"]):
            best[n["key"]] = n
    out = []
    for n in best.values():
        out.append({"kind_en": n["kind_en"], "text_en": n["text_en"], "issued": n["issued"], "sev": n["sev"]})
    return out

def bousai_warnings_notices(area):
    """Currently valid notices for an area (area = bousai_area(config) dict), most severe then newest first.

    Returns a list of dicts, [] when there are none, the area is None or the feeds are unavailable:
      kind_en  "Tornado Watch", "Record Short-Term Heavy Rain" or "River Flood <Advisory|Warning|Urgent Warning|
               Emergency Warning>"
      text_en  short English text (tornado: validity in JST; record rain: amount and place; flood: river count)
      issued   Pixlet time the bulletin was issued
      sev      2..5 index into ui["sev"]: tornado watch 3, record rain 4, river flood level // 10
    Tornado watch is kept while its XML ValidDateTime has not passed (about one hour), record rain for two
    hours after issue. Matching uses the municipality (class20), falling back to the class10 region.
    """
    if not area:
        return []
    out = bousai_warnings_flood_notices(bousai_get_json(BOUSAI_WARNINGS_FLOOD_URL, ttl = 60), area)
    entries = bousai_warnings_feed()
    if entries:
        now = time.now()
        pref = area.get("pref") or ""
        details = {}
        for e in entries:
            age = (now - bousai_parse_time(e["updated"])).seconds
            limit = BOUSAI_WARNINGS_TORNADO_MAX_AGE if e["kind"] == "tornado" else BOUSAI_WARNINGS_RECORD_RAIN_AGE
            if e["code"][:2] == pref and age <= limit:
                details[e["href"]] = bousai_warnings_detail(e)
        if details:
            wanted = [e for e in entries if details.get(e["href"]) != None]
            out.extend(bousai_warnings_bulletin_notices(area, now, wanted, details, bousai_area_table()))
    return sorted(out, key = lambda n: (-n["sev"], -n["issued"].unix))

# ---------------------------------------------------------------------------
# One place (location) for the app, and the demo sample

def bousai_warnings_place(area):
    """Everything the app shows for one location: {area, name, ok, current, notices}.

    ok is False when the r8 warning feed could not be read (the lists are then empty).
    """
    reports = bousai_warnings_reports(area.get("office"))
    items = []
    name = area.get("class20_en") or ""
    if reports != None:
        res = bousai_warnings_build(reports, area)
        items, name = res[0], res[1]
    return {"area": area, "name": name, "ok": reports != None, "current": items, "notices": bousai_warnings_notices(area)}

def bousai_warnings_sample_warning(element, element_en, level, minutes_ago, status, area_en):
    """One bousai_warnings_current()-shaped entry for the demo sample."""
    return {
        "element": element,
        "element_en": element_en,
        "level": level,
        "sev": level // 10,
        "label_en": "%s: %s" % (BOUSAI_WARNINGS_LEVEL_EN[level], element_en),
        "status": status,
        "issued": time.now() - time.parse_duration("%dm" % minutes_ago),
        "area_en": area_en,
    }

def bousai_warnings_demo():
    """Embedded sample for the demo toggle: [main place, saved place] shaped like bousai_warnings_place().

    Modelled on a July-2025-type prolonged heavy rain event, written in the 2026 level system: Lv4 Heavy Rain
    and Landslide urgent warnings, a Lv4 designated-river flood forecast and a record short-term heavy rain
    report, plus a Lv3 storm warning and Lv2 advisories. Not an actual bulletin; place names are fictional.
    """
    now = time.now()
    city = "Sample City"
    main = {
        "area": {"class20": "", "class20_en": city},
        "name": city,
        "ok": True,
        "current": [
            bousai_warnings_sample_warning("rain", "Heavy Rain", 40, 38, "Issued", city),
            bousai_warnings_sample_warning("landslide", "Landslide", 40, 22, "Issued", city),
            bousai_warnings_sample_warning("wind", "Storm", 30, 95, "Continued", city),
            bousai_warnings_sample_warning("wave", "High Wave", 20, 140, "Continued", city),
            bousai_warnings_sample_warning("thunder", "Thunderstorm", 20, 140, "Continued", city),
        ],
        "notices": [
            {"kind_en": "Record Short-Term Heavy Rain", "text_en": "About 110 mm/h", "issued": now - time.parse_duration("41m"), "sev": 4},
            {"kind_en": "River Flood Urgent Warning", "text_en": "2 rivers: flood danger", "issued": now - time.parse_duration("16m"), "sev": 4},
        ],
    }
    town = "Sample Town"
    saved = {
        "area": {"class20": "", "class20_en": town},
        "name": town,
        "ok": True,
        "current": [bousai_warnings_sample_warning("rain", "Heavy Rain", 30, 52, "Issued", town)],
        "notices": [],
    }
    return [main, saved]

# ---- src/lib/bousai_forecast.star ------------------------------------------

BOUSAI_FORECAST_URL = "https://www.jma.go.jp/bosai/forecast/data/forecast/%s.json"
BOUSAI_FORECAST_CONST = "https://www.jma.go.jp/bosai/forecast/const/%s.json"
BOUSAI_FORECAST_WDIST = "https://www.jma.go.jp/bosai/jmatile/data/wdist/VPFD/%s.json"
BOUSAI_FORECAST_MULTI = "https://www.data.jma.go.jp/multi/data/VPFD51/%s_en.json"
BOUSAI_FORECAST_AMEDAS = "https://www.jma.go.jp/bosai/amedas/data/"

# 3-hourly (wdist) weather words -> [English, sprite key].
BOUSAI_FORECAST_JP_WEATHER = {
    "晴れ": ["Clear", "sun"],
    "くもり": ["Cloudy", "cloud"],
    "雨": ["Rain", "rain"],
    "雪": ["Snow", "snow"],
    "雨または雪": ["Rain or snow", "rain"],
    "みぞれ": ["Sleet", "rain"],
}

BOUSAI_FORECAST_JP_DIR = {
    "北": "N",
    "北東": "NE",
    "東": "E",
    "南東": "SE",
    "南": "S",
    "南西": "SW",
    "西": "W",
    "北西": "NW",
    "静穏": "Calm",
}

# 7x5 sprites. Y sun, M moon, C cloud, B rain, W snow, L lightning.
BOUSAI_FORECAST_MINI = {
    "sun": [".Y.Y.Y.", "..YYY..", "YYYYYYY", "..YYY..", ".Y.Y.Y."],
    "moon": ["..MMM..", ".MM....", ".MM....", ".MM....", "..MMM.."],
    "partly": [".Y.Y...", "Y.YYCC.", "..YCCCC", "..CCCCC", "......."],
    "pmoon": [".MM....", "MM.CC..", "M.CCCCC", "..CCCCC", "......."],
    "cloud": [".......", "..CC.C.", ".CCCCCC", "CCCCCCC", "CCCCCCC"],
    "rain": ["..CCC..", ".CCCCC.", "CCCCCCC", ".B.B.B.", "B.B.B.."],
    "snow": ["..CCC..", ".CCCCC.", "CCCCCCC", ".W.W.W.", "W.W.W.."],
    "thunder": ["..CCC..", ".CCCCC.", "CCCCCCC", "..LL...", "...L..."],
    "sunrain": ["YY.CC..", "Y.CCCCC", ".CCCCCC", "..B.B.B", "...B.B."],
    "sunsnow": ["YY.CC..", "Y.CCCCC", ".CCCCCC", "..W.W.W", "...W.W."],
}

def bousai_forecast_number(v):
    """Parse a JMA numeric string ('' -> None) to int."""
    if v == None or v == "":
        return None
    if type(v) == "int":
        return v
    if type(v) == "float":
        return int(v + 0.5) if v >= 0 else -int(-v + 0.5)
    f = float(v)
    return int(f + 0.5) if f >= 0 else -int(-f + 0.5)

def bousai_forecast_pad2(n):
    """Two-digit zero padded integer text (Starlark % has no width flags)."""
    return ("0%d" % n) if n < 10 else "%d" % n

def bousai_forecast_nice(s):
    """JMA upper-case English phrase -> sentence case ('MOSTLY CLOUDY' -> 'Mostly cloudy')."""
    if not s:
        return ""
    low = s.lower().replace(",", ", ").replace(",  ", ", ").replace("  ", " ").strip()
    return low[0].upper() + low[1:]

def bousai_forecast_key(code, group, en):
    """Sprite key for a JMA weather code (group = 100/200/300/400 icon group, en = English telop)."""
    c = str(code or "")
    first = c[:1]
    if group == 400:
        return "sunsnow" if first == "1" else "snow"
    if group == 300:
        if "THUNDER" in (en or ""):
            return "thunder"
        return "sunrain" if first == "1" else "rain"
    if group == 200:
        return "partly" if c in ("201", "210", "211") else "cloud"
    return "sun" if c == "100" else "partly"

def bousai_forecast_weather(code):
    """JMA code -> (English text, icon group int, sprite key)."""
    row = BOUSAI_WEATHER_EN.get(str(code or ""))
    if row == None:
        group = 200
        if code and str(code)[:1] in ("1", "2", "3", "4"):
            group = int(str(code)[:1]) * 100
        return "", group, bousai_forecast_key(code, group, "")
    en = row[0]
    group = int(row[1])
    return bousai_forecast_nice(en), group, bousai_forecast_key(code, group, en)

def bousai_forecast_val(pair):
    """AMeDAS [value, quality] -> float or None (quality >= 5 means not observed)."""
    if type(pair) != "list" or len(pair) < 2 or pair[0] == None:
        return None
    if pair[1] != None and pair[1] >= 5:
        return None
    return pair[0]

def bousai_forecast_find(areas, code):
    """Pick the entry whose area.code == code; fall back to the first entry."""
    for a in areas or []:
        if (a.get("area") or {}).get("code") == code:
            return a
    return (areas or [None])[0]

def bousai_forecast_set(info, date, key, value):
    """First writer wins: store info[date][key] unless value is empty or already set."""
    if value == None or value == "":
        return
    d = info.setdefault(date, {})
    if d.get(key) == None:
        d[key] = value

def bousai_forecast_unit_temp(c, unit):
    """Celsius number -> display number in the chosen unit (int)."""
    if c == None:
        return None
    if unit == "F":
        v = c * 9.0 / 5.0 + 32
        return int(v + 0.5) if v >= 0 else -int(-v + 0.5)
    return int(c + 0.5) if c >= 0 else -int(-c + 0.5)

def bousai_forecast_unit_diff(d, unit):
    """Celsius difference -> difference in unit (int)."""
    if d == None:
        return None
    if unit == "F":
        v = d * 9.0 / 5.0
        return int(v + 0.5) if v >= 0 else -int(-v + 0.5)
    return d

def bousai_forecast_diff_phrase(diff, ref):
    """3 -> '3 degrees higher than yesterday'; 0 -> 'same as yesterday'; None -> ''."""
    if diff == None:
        return ""
    if diff == 0:
        return "same as %s" % ref
    n = abs(diff)
    return "%d %s %s than %s" % (n, "degree" if n == 1 else "degrees", "higher" if diff > 0 else "lower", ref)

def bousai_forecast_signed(n):
    """'+3' / '-2' / '0'."""
    if n == None:
        return "--"
    return ("+%d" % n) if n > 0 else ("%d" % n)

# ---------------------------------------------------------------------------
# Data

def bousai_forecast_mapping(office, class10):
    """JMA forecast/const/week_area.json entry {srf, week, amedas} for a class10 area, or None."""
    table = bousai_get_json(BOUSAI_FORECAST_CONST % "week_area", ttl = 86400)
    if type(table) != "dict":
        return None
    for key in [office] + list(table.keys()):
        for m in table.get(key, []):
            if m.get("srf") == class10:
                return m
    return None

def bousai_forecast_yesterday(point):
    """Yesterday's observed {high, low} (Celsius floats or None) at an AMeDAS point, or None."""
    y = bousai_now() - time.parse_duration("24h")
    d = bousai_get_json(BOUSAI_FORECAST_AMEDAS + "point/%s/%s_21.json" % (point, y.format("20060102")), ttl = 86400)
    if type(d) != "dict" or len(d) == 0:
        return None
    last = d[sorted(d.keys())[-1]]
    hi = bousai_forecast_val(last.get("maxTemp"))
    lo = bousai_forecast_val(last.get("minTemp"))
    if hi == None and lo == None:
        return None
    return {"high": hi, "low": lo}

def bousai_forecast_observed(point):
    """Today's observed {high, low, temp, time} so far at an AMeDAS point, or None."""
    lt = bousai_get_bytes(BOUSAI_FORECAST_AMEDAS + "latest_time.txt", ttl = 60)
    t = bousai_parse_time((lt or "").strip())
    if t == None:
        return None
    block = "%s_%s" % (t.format("20060102"), bousai_forecast_pad2((t.hour // 3) * 3))
    d = bousai_get_json(BOUSAI_FORECAST_AMEDAS + "point/%s/%s.json" % (point, block), ttl = 120)
    if type(d) != "dict" or len(d) == 0:
        return None
    last = d[sorted(d.keys())[-1]]
    return {
        "high": bousai_forecast_val(last.get("maxTemp")),
        "low": bousai_forecast_val(last.get("minTemp")),
        "temp": bousai_forecast_val(last.get("temp")),
        "time": bousai_parse_time(sorted(d.keys())[-1]),
    }

def bousai_forecast_multi_office(class10):
    """JMA multilingual publishing office code (e.g. JPTK) for a class10 code."""
    special = BOUSAI_MULTI_OFFICE_SPECIAL.get(class10)
    if special:
        return special
    return BOUSAI_MULTI_OFFICE_BY_PREFIX.get(class10[:3]) or BOUSAI_MULTI_OFFICE_BY_PREF.get(class10[:2])

def bousai_forecast_day_label(date, today_date, idx):
    """Today / Tomorrow / weekday name for a forecast date string (relative to today_date)."""
    if date == today_date:
        return "Today"
    if idx == 1:
        return "Tomorrow"
    t = time.parse_time(date, format = "2006-01-02", location = BOUSAI_JST)
    return t.format("Monday")

def bousai_forecast_official_text(class10, rel_labels):
    """Official English forecast sentences from JMA VPFD51 for a class10 area (list of str).

    rel_labels name the forecast days of the 3-day block (e.g. ['Today', 'Tomorrow']).
    """
    office = bousai_forecast_multi_office(class10)
    if not office:
        return []
    d = bousai_get_json(BOUSAI_FORECAST_MULTI % office, ttl = 600)
    if type(d) != "dict":
        return []
    infos = (d.get("meteorologicalInfos") or {}).get("timeSeriesInfoWeather") or []
    match = None
    for it in infos:
        if str((it.get("area") or {}).get("code")) == class10:
            match = it
    if match == None:
        return []
    parts = (match.get("kind") or {}).get("weatherPart") or []
    out = []
    area_en = (match.get("area") or {}).get("name") or ""
    for i, p in enumerate(parts):
        label = rel_labels[i] if i < len(rel_labels) else "Day %d" % (i + 1)
        out.append("%s%s: %s." % (area_en + " - " if i == 0 and area_en else "", label, bousai_forecast_nice(p.get("weather"))))
    return out

def bousai_forecast_model(area):
    """Full forecast model for a JMA area (from bousai_area), or None when JMA data is unavailable.

    Keys: office, class10, class10_en, point (AMeDAS id of the temperature point), point_en,
    report (time), days (7 dicts, today first: date, label, weekday, code, weather_en, icon_group,
    key, high, low, pop, reliability, high_obs, low_obs), pops6 (list of {time, pop} six-hour
    blocks), yesterday ({high, low} or None), official (list of English sentences).
    Temperatures are Celsius ints (None if JMA gives none); times are Pixlet time objects.
    """
    office = area["office"]
    c10 = area["class10"]
    data = bousai_get_json(BOUSAI_FORECAST_URL % office, ttl = 600)
    if type(data) != "list" or len(data) == 0 or type(data[0]) != "dict":
        return None
    daily = data[0]
    week = data[1] if len(data) > 1 and type(data[1]) == "dict" else {}
    mapping = bousai_forecast_mapping(office, c10)
    week_code = mapping["week"] if mapping else c10
    point = mapping["amedas"] if mapping else None

    info = {}
    pops6 = []
    daily_dates = []
    ts = daily.get("timeSeries") or []

    # 3-day block: weather, 6-hourly rain chance, temperatures.
    if len(ts) > 0:
        a = bousai_forecast_find(ts[0].get("areas"), c10)
        if a:
            for i, td in enumerate(ts[0]["timeDefines"]):
                if i < len(a.get("weatherCodes", [])):
                    bousai_forecast_set(info, td[:10], "code", a["weatherCodes"][i])
                daily_dates.append(td[:10])
    if len(ts) > 1:
        a = bousai_forecast_find(ts[1].get("areas"), c10)
        if a:
            for i, td in enumerate(ts[1]["timeDefines"]):
                if i < len(a.get("pops", [])):
                    pops6.append({"time": bousai_parse_time(td), "pop": bousai_forecast_number(a["pops"][i])})
    if len(ts) > 2:
        a = bousai_forecast_find(ts[2].get("areas"), point) if point else bousai_forecast_find(ts[2].get("areas"), "")
        if a:
            point = a["area"]["code"]
            for i, td in enumerate(ts[2]["timeDefines"]):
                v = bousai_forecast_number(a["temps"][i]) if i < len(a.get("temps", [])) else None
                if v == None:
                    continue
                if td[11:13] == "09":
                    bousai_forecast_set(info, td[:10], "high", v)
                elif td[11:13] == "00":
                    bousai_forecast_set(info, td[:10], "low", v)

    # JMA repeats the maximum in today's 00:00 (minimum) slot once the morning minimum has passed.
    for date in info:
        d = info[date]
        if d.get("low") != None and d.get("high") != None and d["low"] >= d["high"]:
            d.pop("low")

    # Weekly block: day weather, rain chance, reliability, temperatures.
    wts = week.get("timeSeries") or []
    if len(wts) > 0:
        a = bousai_forecast_find(wts[0].get("areas"), week_code)
        if a:
            for i, td in enumerate(wts[0]["timeDefines"]):
                bousai_forecast_set(info, td[:10], "code", a["weatherCodes"][i] if i < len(a.get("weatherCodes", [])) else None)
                bousai_forecast_set(info, td[:10], "pop", bousai_forecast_number(a["pops"][i]) if i < len(a.get("pops", [])) else None)
                bousai_forecast_set(info, td[:10], "rel", a["reliabilities"][i] if i < len(a.get("reliabilities", [])) else None)
    if len(wts) > 1:
        a = bousai_forecast_find(wts[1].get("areas"), point) if point else bousai_forecast_find(wts[1].get("areas"), "")
        if a:
            point = point or a["area"]["code"]
            for i, td in enumerate(wts[1]["timeDefines"]):
                bousai_forecast_set(info, td[:10], "high", bousai_forecast_number(a["tempsMax"][i]) if i < len(a.get("tempsMax", [])) else None)
                bousai_forecast_set(info, td[:10], "low", bousai_forecast_number(a["tempsMin"][i]) if i < len(a.get("tempsMin", [])) else None)

    now = bousai_now()
    today_date = now.format("2006-01-02")
    days = []
    for i in range(7):
        t = now + time.parse_duration("%dh" % (24 * i))
        date = t.format("2006-01-02")
        d = info.get(date, {})
        code = d.get("code")
        en, group, key = bousai_forecast_weather(code) if code else ("", 200, "cloud")
        day_pops = [p["pop"] for p in pops6 if p["time"] != None and p["time"].format("2006-01-02") == date and p["pop"] != None]
        pop = max(day_pops) if day_pops else d.get("pop")
        days.append({
            "date": date,
            "label": "Today" if i == 0 else ("Tomorrow" if i == 1 else t.format("Mon")),
            "weekday": t.format("Mon"),
            "code": code,
            "weather_en": en,
            "icon_group": group,
            "key": key,
            "high": d.get("high"),
            "low": d.get("low"),
            "pop": pop,
            "reliability": d.get("rel"),
            "high_obs": False,
            "low_obs": False,
        })

    # Today's missing high (evening) / low (morning) -> observed so far.
    if point and (days[0]["high"] == None or days[0]["low"] == None):
        obs = bousai_forecast_observed(point)
        if obs:
            if days[0]["high"] == None and obs["high"] != None:
                days[0]["high"] = bousai_forecast_number(obs["high"])
                days[0]["high_obs"] = True
            if days[0]["low"] == None and obs["low"] != None:
                days[0]["low"] = bousai_forecast_number(obs["low"])
                days[0]["low_obs"] = True

    yesterday = bousai_forecast_yesterday(point) if point else None
    names = bousai_get_json(BOUSAI_FORECAST_CONST % "en_amedas", ttl = 86400) or {}
    labels = [bousai_forecast_day_label(dd, today_date, i) for i, dd in enumerate(daily_dates)]
    return {
        "office": office,
        "class10": c10,
        "class10_en": area.get("class10_en") or "",
        "point": point,
        "point_en": names.get(point or "", ""),
        "report": bousai_parse_time(daily.get("reportDatetime")),
        "days": days,
        "pops6": pops6,
        "yesterday": yesterday,
        "official": bousai_forecast_official_text(c10, labels),
    }

def bousai_forecast_round(x):
    """Round a number to the nearest int (half away from zero)."""
    return int(x + 0.5) if x >= 0 else -int(-x + 0.5)

def bousai_forecast_pop_now(model):
    """Chance of rain (int %) for the six-hour block that contains now, else the next block."""
    now = bousai_now()
    best = None
    for p in model["pops6"]:
        if p["time"] == None or p["pop"] == None:
            continue
        end = p["time"] + time.parse_duration("6h")
        if now < end:
            return p["pop"]
        best = p["pop"]
    if best != None:
        return best
    return model["days"][0]["pop"]

def bousai_forecast_sun(lat, lon, offset_days = 0):
    """Sunrise/sunset (Pixlet times in JST, or None in polar conditions) for today + offset_days."""
    now = bousai_now() + time.parse_duration("%dh" % (24 * offset_days))
    noon = time.time(year = now.year, month = now.month, day = now.day, hour = 12, location = BOUSAI_JST)
    rise = sunrise.sunrise(lat, lon, noon)
    sset = sunrise.sunset(lat, lon, noon)
    return (rise.in_location(BOUSAI_JST) if rise else None), (sset.in_location(BOUSAI_JST) if sset else None)

def bousai_forecast_hourly(class10):
    """3-hourly forecast slots from the JMA wdist point series for a class10 area.

    Returns [] when unavailable. Each slot: {time, weather_en, key, temp, wind_dir_en,
    wind_ms}. Weather is one of Clear/Cloudy/Rain/Snow/Rain or snow; temp is the point
    forecast in Celsius (int or None); wind_ms is the forecast mean speed in m/s.
    """
    d = bousai_get_json(BOUSAI_FORECAST_WDIST % class10, ttl = 600)
    if type(d) != "dict":
        return []
    series = d.get("areaTimeSeries") or {}
    pts = d.get("pointTimeSeries") or {}
    temps = {}
    for i, td in enumerate(pts.get("timeDefines") or []):
        temps[td["dateTime"]] = bousai_forecast_number((pts.get("temperature") or [])[i]) if i < len(pts.get("temperature") or []) else None
    out = []
    for i, td in enumerate(series.get("timeDefines") or []):
        w = (series.get("weather") or [""])[i] if i < len(series.get("weather") or []) else ""
        wind = (series.get("wind") or [{}])[i] if i < len(series.get("wind") or []) else {}
        conv = BOUSAI_FORECAST_JP_WEATHER.get(w, ["Unknown", "cloud"])
        out.append({
            "time": bousai_parse_time(td["dateTime"]),
            "weather_en": conv[0],
            "key": conv[1],
            "temp": temps.get(td["dateTime"]),
            "wind_dir_en": BOUSAI_FORECAST_JP_DIR.get(wind.get("direction", ""), ""),
            "wind_ms": wind.get("speed"),
        })
    return out

def bousai_forecast_today(area, _config):
    """Summary of today's forecast for home/timeline panels.

    Returns None when JMA data is unavailable, else a dict:
      weather_en  English telop, e.g. 'Mostly cloudy'
      code        JMA weather code string, e.g. '201'
      icon_group  100 sun / 200 cloud / 300 rain / 400 snow (int)
      high, low   Celsius ints (observed-so-far fallback when JMA no longer gives today's value; None if neither)
      pop_now     chance of rain (int %) of the six-hour block containing now (None if unknown)
      sunrise, sunset  Pixlet time objects in JST (None in polar conditions)
      text_en     one-paragraph official English forecast (JMA multilingual VPFD51), or None
    area is the dict from bousai_area(config); _config is the app config (accepted for a uniform call signature).
    """
    if not area:
        return None
    model = bousai_forecast_model(area)
    if model == None:
        return None
    d = model["days"][0]
    rise, sset = bousai_forecast_sun(area["lat"], area["lon"], 0)
    text = " ".join(model["official"]) if model["official"] else None
    return {
        "weather_en": d["weather_en"],
        "code": d["code"],
        "icon_group": d["icon_group"],
        "high": d["high"],
        "low": d["low"],
        "pop_now": bousai_forecast_pop_now(model),
        "sunrise": rise,
        "sunset": sset,
        "text_en": text,
    }

# ---------------------------------------------------------------------------
# Screen-reader style sentences

def bousai_forecast_sentences(model, unit, rise, sset):
    """English sentences for today and tomorrow ('Forecast high of 26 (3 degrees lower than yesterday)')."""
    out = []
    t0 = model["days"][0]
    t1 = model["days"][1]
    y = model["yesterday"] or {}
    deg = "F" if unit == "F" else "C"
    if t0["weather_en"]:
        out.append("Today: %s." % t0["weather_en"])
    if t0["high"] != None:
        diff = (t0["high"] - bousai_forecast_round(y["high"])) if y.get("high") != None else None
        phrase = bousai_forecast_diff_phrase(bousai_forecast_unit_diff(diff, unit), "yesterday")
        out.append("%s high of %d%s%s" % ("Observed" if t0["high_obs"] else "Forecast", bousai_forecast_unit_temp(t0["high"], unit), deg, (" (%s)" % phrase) if phrase else ""))
    if t0["low"] != None:
        diff = (t0["low"] - bousai_forecast_round(y["low"])) if y.get("low") != None else None
        phrase = bousai_forecast_diff_phrase(bousai_forecast_unit_diff(diff, unit), "yesterday")
        out.append("%s low of %d%s%s" % ("Observed" if t0["low_obs"] else "Forecast", bousai_forecast_unit_temp(t0["low"], unit), deg, (" (%s)" % phrase) if phrase else ""))
    pop = bousai_forecast_pop_now(model)
    if pop != None:
        out.append("Chance of rain now %d%%." % pop)
    if t1["weather_en"]:
        out.append("Tomorrow: %s." % t1["weather_en"])
    if t1["high"] != None:
        diff = (t1["high"] - t0["high"]) if t0["high"] != None else None
        phrase = bousai_forecast_diff_phrase(bousai_forecast_unit_diff(diff, unit), "today")
        out.append("Tomorrow's forecast high of %d%s%s" % (bousai_forecast_unit_temp(t1["high"], unit), deg, (" (%s)" % phrase) if phrase else ""))
    if t1["low"] != None:
        diff = (t1["low"] - t0["low"]) if t0["low"] != None else None
        phrase = bousai_forecast_diff_phrase(bousai_forecast_unit_diff(diff, unit), "today")
        out.append("Tomorrow's forecast low of %d%s%s" % (bousai_forecast_unit_temp(t1["low"], unit), deg, (" (%s)" % phrase) if phrase else ""))
    if t1["pop"] != None:
        out.append("Chance of rain tomorrow %d%%." % t1["pop"])
    if rise and sset:
        out.append("Sunrise %s, sunset %s." % (rise.format("15:04"), sset.format("15:04")))
    return out

# ---------------------------------------------------------------------------
# Pixel icons (drawn here; colours come from ui)

def bousai_forecast_palette(ui):
    return {
        "Y": ui["sev"][2],
        "M": ui["fg"],
        "C": bousai_mix(ui["fg"], ui["bg"], 0.45),
        "B": ui["sev"][1],
        "W": ui["fg"],
        "L": ui["sev"][2],
    }

def bousai_forecast_render_grid(ui, rows):
    """Render a list of equal-width strings ('.' transparent) as 1-px boxes with run-length merging."""
    pal = bousai_forecast_palette(ui)
    line_widgets = []
    for r in rows:
        runs = []
        i = 0
        n = len(r)
        for _ in range(n):
            if i >= n:
                break
            ch = r[i]
            j = i
            for _ in range(n):
                if j + 1 < n and r[j + 1] == ch:
                    j += 1
                else:
                    break
            runs.append(render.Box(width = j - i + 1, height = 1, color = pal.get(ch) if ch != "." else None))
            i = j + 1
        line_widgets.append(render.Row(children = runs))
    return render.Column(children = line_widgets)

def bousai_forecast_blank(w, h):
    return [["."] * w for _ in range(h)]

def bousai_forecast_dot(g, x, y, ch):
    if y >= 0 and y < len(g) and x >= 0 and x < len(g[0]):
        g[y][x] = ch

def bousai_forecast_disc(g, cx, cy, r2, ch):
    for y in range(len(g)):
        for x in range(len(g[0])):
            if (x - cx) * (x - cx) + (y - cy) * (y - cy) <= r2:
                g[y][x] = ch

def bousai_forecast_sun_layer(g, cx, cy, r2, ch, ray_in, ray_out):
    bousai_forecast_disc(g, cx, cy, r2, ch)
    for d in range(ray_in, ray_out + 1):
        for v in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            bousai_forecast_dot(g, cx + v[0] * d, cy + v[1] * d, ch)
    diag = ray_in - 1
    for v in [(1, 1), (1, -1), (-1, 1), (-1, -1)]:
        bousai_forecast_dot(g, cx + v[0] * diag, cy + v[1] * diag, ch)

def bousai_forecast_cloud_layer(g, ox, oy, ch):
    for x in range(ox + 1, ox + 12):
        for y in range(oy + 4, oy + 7):
            bousai_forecast_dot(g, x, y, ch)
    bousai_forecast_disc(g, ox + 3, oy + 4, 5, ch)
    bousai_forecast_disc(g, ox + 7, oy + 3, 10, ch)
    bousai_forecast_disc(g, ox + 10, oy + 4, 5, ch)

def bousai_forecast_big(ui, key):
    """16x12 weather icon for a sprite key."""
    g = bousai_forecast_blank(16, 12)
    if key == "sun":
        bousai_forecast_sun_layer(g, 8, 6, 9, "Y", 5, 6)
    elif key == "partly":
        bousai_forecast_sun_layer(g, 5, 4, 4, "Y", 4, 5)
        bousai_forecast_cloud_layer(g, 3, 5, "C")
    elif key == "cloud":
        bousai_forecast_cloud_layer(g, 1, 2, "C")
    elif key in ("rain", "thunder"):
        bousai_forecast_cloud_layer(g, 1, 0, "C")
        if key == "rain":
            for x in (3, 7, 11):
                bousai_forecast_dot(g, x, 8, "B")
                bousai_forecast_dot(g, x - 1, 9, "B")
            for x in (5, 9, 13):
                bousai_forecast_dot(g, x, 10, "B")
                bousai_forecast_dot(g, x - 1, 11, "B")
        else:
            for p in [(8, 7), (9, 7), (7, 8), (8, 8), (7, 9), (8, 9), (9, 9), (6, 10), (7, 10), (6, 11)]:
                bousai_forecast_dot(g, p[0], p[1], "L")
    elif key == "snow":
        bousai_forecast_cloud_layer(g, 1, 0, "C")
        for p in [(3, 9), (7, 9), (11, 9), (5, 11), (9, 11), (13, 11)]:
            bousai_forecast_dot(g, p[0], p[1], "W")
            bousai_forecast_dot(g, p[0] + 1, p[1], "W")
    elif key in ("sunrain", "sunsnow"):
        bousai_forecast_sun_layer(g, 4, 4, 4, "Y", 4, 5)
        bousai_forecast_cloud_layer(g, 3, 3, "C")
        ch = "B" if key == "sunrain" else "W"
        for x in (6, 10, 14):
            bousai_forecast_dot(g, x, 10, ch)
            bousai_forecast_dot(g, x - 1, 11, ch)
    else:
        bousai_forecast_cloud_layer(g, 1, 2, "C")
    return bousai_forecast_render_grid(ui, ["".join(r) for r in g])

def bousai_forecast_mini(ui, key):
    """7x5 weather icon for a sprite key."""
    return bousai_forecast_render_grid(ui, BOUSAI_FORECAST_MINI.get(key) or BOUSAI_FORECAST_MINI["cloud"])

def bousai_forecast_is_night(t, rise, sset):
    """True when t (a time) lies outside sunrise..sunset by clock time of day."""
    if rise == None or sset == None:
        return False
    tod = t.hour * 60 + t.minute
    return tod < rise.hour * 60 + rise.minute or tod >= sset.hour * 60 + sset.minute

# ---------------------------------------------------------------------------
# Layout helper

def bousai_forecast_clip(ui, text, width):
    """Trim text (no ellipsis) until it fits width, so pages never contain scrolling marquees
    (a marquee stretches its page's duration in a Sequence)."""
    t = text
    for _ in range(len(text)):
        if bousai_text_width(ui, t) <= width:
            break
        t = t[:-1]
    return t

def bousai_forecast_header(ui, title, right = None):
    """Title band whose title is clipped to fit (never scrolls)."""
    avail = canvas.width() - 2
    if right:
        avail -= bousai_text_width(ui, right) + 2
    return bousai_header(ui, bousai_forecast_clip(ui, title, avail), right = right)

def bousai_forecast_pager(ui, header, left, left_w, rows):
    """Pages of header + left widget + right-hand text rows. rows are (text, color).

    Returns a list of page widgets (not yet held); each page shows as many rows as fit.
    """
    width = canvas.width()
    body_h = canvas.height() - ui["line_h"]
    cap = max(1, body_h // ui["line_h"])
    right_w = width - left_w - 1
    pages = []
    for i in range(0, max(1, len(rows)), cap):
        chunk = rows[i:i + cap]
        col = render.Column(children = [render.Box(width = right_w, height = ui["line_h"], child = bousai_fit(ui, bousai_forecast_clip(ui, r[0], right_w), width = right_w, color = r[1])) for r in chunk])
        pages.append(render.Column(children = [
            header,
            render.Row(children = [
                render.Box(width = left_w, height = body_h, child = left),
                col,
            ]),
        ]))
    return pages

def bousai_forecast_rotate(pages, key, min_frames = 25):
    """Sequence of pages that each stay on screen at least min_frames (2.5 s by default).

    pages is a list of (widget, weight); a page holds min_frames * weight frames. When all pages
    fit the dwell budget (bousai_budget_frames) they are all shown and the spare time is shared.
    Otherwise a window of consecutive pages that fits is shown, starting at an offset stored in
    the cache under `key` and advanced on every render, so every page appears across renders.
    """
    n = len(pages)
    budget = bousai_budget_frames()
    base = [int(min_frames * p[1]) for p in pages]
    total = 0
    for f in base:
        total += f
    chosen = list(range(n))
    if total > budget and n > 1:
        start = int(cache.get(key) or "0") % n
        chosen = []
        used = 0
        for k in range(n):
            i = (start + k) % n
            if chosen and used + base[i] > budget:
                break
            chosen.append(i)
            used += base[i]
        cache.set(key, str(start + len(chosen)), ttl_seconds = 86400)
        total = used

    # Share spare time, but never stretch a page beyond twice its minimum.
    kids = []
    for i in chosen:
        frames = base[i]
        if total < budget:
            frames = min(base[i] * 2, int(base[i] * budget / total))
        kids.append(bousai_hold(render.Column(expanded = True, main_align = "start", children = [pages[i][0]]), frames))
    return kids[0] if len(kids) == 1 else render.Sequence(children = kids)

# ---- src/lib/bousai_amedas.star --------------------------------------------

BOUSAI_AMEDAS_BASE = "https://www.jma.go.jp/bosai/amedas/"
BOUSAI_AMEDAS_MAX_KM = 120

# windDirection index 0..16 (1 = NNE ... 16 = N).
BOUSAI_AMEDAS_DIRS = ["Calm", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW", "N"]

def bousai_amedas_table():
    """AMeDAS station table {id: {type, elems, lat, lon, alt, kjName, enName}} (cached a day)."""
    t = bousai_get_json(BOUSAI_AMEDAS_BASE + "const/amedastable.json", ttl = 86400)
    return t if type(t) == "dict" else {}

def bousai_amedas_coords(st):
    """(lat, lon) in decimal degrees of a station-table entry."""
    return st["lat"][0] + st["lat"][1] / 60.0, st["lon"][0] + st["lon"][1] / 60.0

def bousai_amedas_observes(st, what):
    """True when the station's elems string says it observes temp / wind / precip."""
    e = st.get("elems") or "00000000"
    if what == "temp":
        return e[0] == "1"
    if what == "wind":
        return e[2] == "1" and e[3] == "1"
    return e[1] == "1"

def bousai_amedas_nearest(table, lat, lon):
    """Nearest station that observes temperature and wind. Returns (id, distance_km) or (None, None)."""
    k = 0.01745329
    cos_lat = math.cos(lat * k)
    best = None
    best_d = 1.0e9
    for sid in table:
        st = table[sid]
        e = st.get("elems") or "00000000"
        if e[0] != "1" or e[2] != "1" or e[3] != "1":
            continue
        slat = st["lat"][0] + st["lat"][1] / 60.0
        slon = st["lon"][0] + st["lon"][1] / 60.0
        dy = slat - lat
        dx = (slon - lon) * cos_lat
        d = dx * dx + dy * dy
        if d < best_d:
            best_d = d
            best = sid
    if best == None:
        return None, None
    slat, slon = bousai_amedas_coords(table[best])
    return best, bousai_distance_km(lat, lon, slat, slon)

def bousai_amedas_find(table, query):
    """Station id for an id or (English / Japanese) name fragment; None if no match."""
    q = (query or "").strip()
    if not q:
        return None
    if q in table:
        return q
    low = q.lower()
    exact, prefix, contains = [], [], []
    for sid in sorted(table.keys()):
        st = table[sid]
        en = (st.get("enName") or "").lower()
        jp = st.get("kjName") or ""
        if en == low or jp == q:
            exact.append(sid)
        elif en.startswith(low) or jp.startswith(q):
            prefix.append(sid)
        elif low in en or q in jp:
            contains.append(sid)
    for group in [exact, prefix, contains]:
        if group:
            for sid in group:
                if bousai_amedas_observes(table[sid], "temp"):
                    return sid
            return group[0]
    return None

def bousai_amedas_val(pair):
    """[value, quality] -> value, or None when missing / not observed (quality >= 5)."""
    if type(pair) != "list" or len(pair) < 2 or pair[0] == None:
        return None
    if pair[1] != None and pair[1] >= 5:
        return None
    return pair[0]

def bousai_amedas_series(station, hours = 6):
    """Last `hours` of 10-minute observations for a station.

    Returns None if the feed is unavailable, else a list of {time, e} oldest first, where e is
    the raw AMeDAS entry ({element: [value, quality], ...}).
    """
    lt = bousai_get_bytes(BOUSAI_AMEDAS_BASE + "data/latest_time.txt", ttl = 60)
    latest = bousai_parse_time((lt or "").strip())
    if latest == None:
        return None
    merged = {}
    for k in range(hours // 3 + 1):
        b = latest - time.parse_duration("%dh" % (3 * k))
        h3 = (b.hour // 3) * 3
        name = "%s_%s" % (b.format("20060102"), ("0%d" % h3) if h3 < 10 else "%d" % h3)
        d = bousai_get_json(BOUSAI_AMEDAS_BASE + "data/point/%s/%s.json" % (station, name), ttl = 120 if k == 0 else 3600)
        if type(d) == "dict":
            merged.update(d)
    if not merged:
        return None
    cutoff = latest - time.parse_duration("%dm" % (hours * 60 + 5))
    out = []
    for key in sorted(merged.keys()):
        t = bousai_parse_time(key)
        if t != None and t >= cutoff and t <= latest:
            out.append({"time": t, "e": merged[key]})
    return out

def bousai_amedas_current(series):
    """Newest series entry that carries any real observation, else None."""
    for i in range(len(series) - 1, -1, -1):
        e = series[i]["e"]
        if bousai_amedas_val(e.get("temp")) != None or bousai_amedas_val(e.get("wind")) != None or bousai_amedas_val(e.get("precipitation10m")) != None:
            return series[i]
    return None

def bousai_amedas_dir(index):
    """16-point English wind direction name from the AMeDAS direction index (None if unknown)."""
    if index == None:
        return None
    i = int(index)
    if i < 0 or i >= len(BOUSAI_AMEDAS_DIRS):
        return None
    return BOUSAI_AMEDAS_DIRS[i]

def bousai_amedas_station(config_station, lat, lon):
    """Resolve station: text override (id or name) else the nearest suitable one.

    Returns (id, table entry, distance_km) or (None, None, None). A station that cannot be
    matched, or no station within BOUSAI_AMEDAS_MAX_KM, gives None.
    """
    table = bousai_amedas_table()
    if not table:
        return None, None, None
    sid = None
    dist = None
    if config_station and config_station.strip():
        sid = bousai_amedas_find(table, config_station)
        if sid == None:
            return None, None, None
        slat, slon = bousai_amedas_coords(table[sid])
        dist = bousai_distance_km(lat, lon, slat, slon)
    else:
        sid, dist = bousai_amedas_nearest(table, lat, lon)
        if sid == None or dist > BOUSAI_AMEDAS_MAX_KM:
            return None, None, None
    return sid, table[sid], dist

def bousai_amedas_latest(lat, lon, station = None):
    """Latest AMeDAS observation for the nearest suitable station (or a station id / name).

    Returns None when no station is within 120 km, the station cannot be found, or the feed is
    unavailable. Otherwise a dict (None for elements the station does not observe):
      station_id, station_en, distance_km (float), time (Pixlet time of the observation),
      temp (C), humidity (%), precip_10m / precip_1h / precip_24h (mm),
      wind_ms (m/s), wind_dir_en (16-point name or 'Calm'), snow_cm (snow depth).
    """
    sid, st, dist = bousai_amedas_station(station, lat, lon)
    if sid == None:
        return None
    series = bousai_amedas_series(sid, 3)
    cur = bousai_amedas_current(series) if series else None
    if cur == None:
        return None
    e = cur["e"]
    return {
        "station_id": sid,
        "station_en": st.get("enName") or sid,
        "distance_km": dist,
        "time": cur["time"],
        "temp": bousai_amedas_val(e.get("temp")),
        "humidity": bousai_amedas_val(e.get("humidity")),
        "precip_10m": bousai_amedas_val(e.get("precipitation10m")),
        "precip_1h": bousai_amedas_val(e.get("precipitation1h")),
        "precip_24h": bousai_amedas_val(e.get("precipitation24h")),
        "wind_ms": bousai_amedas_val(e.get("wind")),
        "wind_dir_en": bousai_amedas_dir(bousai_amedas_val(e.get("windDirection"))),
        "snow_cm": bousai_amedas_val(e.get("snow")),
    }

# ---------------------------------------------------------------------------
# Units

def bousai_amedas_temp(c, unit):
    """Temperature text with one decimal, e.g. '23.5'."""
    if c == None:
        return "--"
    v = c * 9.0 / 5.0 + 32 if unit == "F" else c
    return bousai_fixed(v, 1)

def bousai_amedas_wind(ms, unit):
    """Wind speed number text in m/s, km/h, kt or mph."""
    if ms == None:
        return "--"
    if unit == "kmh":
        return bousai_fixed(ms * 3.6, 0)
    if unit == "kt":
        return bousai_fixed(ms * 1.94384, 0)
    if unit == "mph":
        return bousai_fixed(ms * 2.23694, 0)
    return bousai_fixed(ms, 1)

def bousai_amedas_wind_unit(unit):
    return {"kmh": "km/h", "kt": "kt", "mph": "mph"}.get(unit, "m/s")

def bousai_amedas_precip(mm, unit):
    """Precipitation / snowfall text (mm or inches)."""
    if mm == None:
        return "--"
    if unit == "in":
        return bousai_fixed(mm / 25.4, 2)
    return bousai_fixed(mm, 1)

def bousai_amedas_depth(cm, unit):
    """Snow depth text (cm or inches)."""
    if cm == None:
        return "--"
    if unit == "in":
        return bousai_fixed(cm / 2.54, 1)
    return "%d" % int(cm + 0.5)

# ---------------------------------------------------------------------------
# Widgets

def bousai_amedas_values(series, key):
    """Series values for an element, None where missing."""
    return [bousai_amedas_val(s["e"].get(key)) for s in series]

def bousai_amedas_spark(ui, values, width, height, color, fill = False, lo = None, hi = None):
    """Line chart of values (None skipped). Returns None when fewer than 2 points."""
    pts = [(i, v) for i, v in enumerate(values) if v != None]
    if len(pts) < 2:
        return None
    ys = [p[1] for p in pts]
    ymin = lo if lo != None else min(ys)
    ymax = hi if hi != None else max(ys)
    if ymax - ymin < 1.0:
        mid = (ymax + ymin) / 2.0
        ymin = mid - 0.5
        ymax = mid + 0.5
    return render.Plot(
        data = pts,
        width = width,
        height = height,
        color = color,
        fill = fill,
        fill_color = bousai_mix(color, ui["bg"], 0.55),
        x_lim = (0, max(1, len(values) - 1)),
        y_lim = (ymin, ymax),
    )

def bousai_amedas_clip(ui, text, width):
    """Trim text until it fits width (pages must not contain scrolling marquees: a marquee
    stretches its page's duration inside a Sequence)."""
    t = text
    for _ in range(len(text)):
        if bousai_text_width(ui, t) <= width:
            break
        t = t[:-1]
    return t

def bousai_amedas_header(ui, title, right = None):
    """Title band whose title is clipped to fit (never scrolls)."""
    avail = canvas.width() - 2
    if right:
        avail -= bousai_text_width(ui, right) + 2
    return bousai_header(ui, bousai_amedas_clip(ui, title, avail), right = right)

def bousai_amedas_pager(ui, header, left, left_w, rows):
    """Pages of header + left widget + right-hand text rows; rows are (text, color)."""
    width = canvas.width()
    body_h = canvas.height() - ui["line_h"]
    cap = max(1, body_h // ui["line_h"])
    right_w = width - left_w - 1
    pages = []
    for i in range(0, max(1, len(rows)), cap):
        chunk = rows[i:i + cap]
        col = render.Column(children = [render.Box(width = right_w, height = ui["line_h"], child = bousai_fit(ui, bousai_amedas_clip(ui, r[0], right_w - 1), width = right_w, color = r[1])) for r in chunk])
        pages.append(render.Column(children = [
            header,
            render.Row(children = [
                render.Box(width = left_w, height = body_h, child = left),
                col,
            ]),
        ]))
    return pages

def bousai_amedas_rotate(pages, key, min_frames = 25):
    """Sequence of pages that each stay on screen at least min_frames (2.5 s by default).

    pages is a list of (widget, weight); a page holds min_frames * weight frames. When all pages
    fit the dwell budget (bousai_budget_frames) they are all shown and the spare time is shared.
    Otherwise a window of consecutive pages that fits is shown, starting at an offset stored in
    the cache under `key` and advanced on every render, so every page appears across renders.
    """
    n = len(pages)
    budget = bousai_budget_frames()
    base = [int(min_frames * p[1]) for p in pages]
    total = 0
    for f in base:
        total += f
    chosen = list(range(n))
    if total > budget and n > 1:
        start = int(cache.get(key) or "0") % n
        chosen = []
        used = 0
        for k in range(n):
            i = (start + k) % n
            if chosen and used + base[i] > budget:
                break
            chosen.append(i)
            used += base[i]
        cache.set(key, str(start + len(chosen)), ttl_seconds = 86400)
        total = used

    # Share spare time, but never stretch a page beyond twice its minimum.
    kids = []
    for i in chosen:
        frames = base[i]
        if total < budget:
            frames = min(base[i] * 2, int(base[i] * budget / total))
        kids.append(bousai_hold(render.Column(expanded = True, main_align = "start", children = [pages[i][0]]), frames))
    return kids[0] if len(kids) == 1 else render.Sequence(children = kids)

# ---- src/lib/bousai_home.star ----------------------------------------------

BOUSAI_HOME_CLASSES = ["eew", "tsunami", "urgent", "eruption", "notice", "quake", "warning", "typhoon", "advisory", "calm"]

# Source id -> option key ("src_<id>"). Order is the order of the menu.
BOUSAI_HOME_SOURCES = ["eew", "shaking", "tsunami", "warnings", "volcano", "quake", "special", "typhoon", "amedas", "forecast"]

# Eruption flash: urgent for this long after the report.
BOUSAI_HOME_ERUPTION_URGENT_MIN = 180

# Warning level -> band texts, longest first.
BOUSAI_HOME_LEVEL_BANDS = {
    20: ["Lv2 Advisory", "Lv2 Advis.", "Lv2"],
    30: ["Lv3 Warning", "Lv3 Warn.", "Lv3"],
    40: ["Lv4 Urgent Warning", "Lv4 Urgent", "Lv4"],
    50: ["Lv5 Emergency Warning", "Lv5 Emergency", "Lv5"],
}

BOUSAI_HOME_TSUNAMI_BANDS = {
    5: ["Major Tsunami Warning", "Major Tsunami", "Tsunami"],
    3: ["Tsunami Warning", "Tsunami Warn.", "Tsunami"],
    2: ["Tsunami Advisory", "Tsunami Adv.", "Tsunami"],
    1: ["Tsunami Forecast", "Tsunami Fcst", "Tsunami"],
}

# Typhoon category (JMA English, bousai_typhoon_current) -> severity inside the radius.
BOUSAI_HOME_TYPHOON_SEV = {
    "Violent Typhoon": 3,
    "Very Strong Typhoon": 3,
    "Typhoon": 3,
    "Severe Tropical Storm": 3,
    "Tropical Storm": 2,
    "Tropical Depression": 1,
}

# ---------------------------------------------------------------------------
# Options

def bousai_home_int(config, key, default, lo, hi):
    """Integer option clamped to lo..hi; default when missing or not a number."""
    v = str(config.get(key) or "")
    if not v.isdigit():
        return default
    return max(lo, min(hi, int(v)))

def bousai_home_options(config):
    """Parse the app options into one dict: a bool per source id (all on by default), quake_hours,
    volcano_km, typhoon_km, alert_only, alert_level (1..5) and demo."""
    opts = {
        "demo": bousai_bool(config, "demo", False),
        "alert_only": bousai_bool(config, "alert_only", False),
        "alert_level": bousai_home_int(config, "alert_level", 3, 1, 5),
        "quake_hours": bousai_home_int(config, "quake_hours", 1, 1, 72),
        "volcano_km": bousai_home_int(config, "volcano_km", 100, 1, 3000),
        "typhoon_km": bousai_home_int(config, "typhoon_km", 500, 1, 5000),
    }
    for s in BOUSAI_HOME_SOURCES:
        opts[s] = bousai_bool(config, "src_" + s, True)
    return opts

# ---------------------------------------------------------------------------
# Priority

def bousai_home_key(item):
    """Sort key of an item: (-severity, class rank, -time)."""
    when = item["when"]
    return (-item["sev"], BOUSAI_HOME_CLASSES.index(item["cls"]), -(when.unix if when != None else 0))

def bousai_home_sort(items):
    """Items in display order: most important first (see the priority model above)."""
    return sorted(items, key = bousai_home_key)

def bousai_home_active(items):
    """Number of individual alerts at severity 2 or more."""
    n = 0
    for it in items:
        if it["sev"] >= 2:
            n += it["count"]
    return n

def bousai_home_item(kind, sev, cls, when, bands, lines, count = 1, data = None):
    return {"kind": kind, "sev": sev, "cls": cls, "when": when, "bands": bands, "lines": lines, "count": count, "data": data}

def bousai_home_level_class(sev, landslide = False):
    """Urgency class of a warning-like item of severity sev (landslide alerts rank as urgent from Lv3)."""
    if sev >= 4 or (sev == 3 and landslide):
        return "urgent"
    return "warning" if sev == 3 else "advisory"

def bousai_home_km(v):
    return "%dkm" % int(v + 0.5)

# ---------------------------------------------------------------------------
# Items from each source

def bousai_home_eew_items(events):
    """Items for the active EEWs of bousai_eew_active (one per event)."""
    out = []
    for ev in events:
        word = "Cancelled" if ev["cancel"] else ("Warning" if ev["warn"] else "Forecast")
        short = {"Cancelled": "Cancel", "Warning": "Warn", "Forecast": "Fcst"}[word]
        place = "Assumed epicentre" if ev["assumption"] else ev["epicenter_en"]
        head = place if ev["assumption"] else "%s %s" % (bousai_eew_mag_text(ev["mag"]), place)
        lines = [head]
        if ev["local_int"] != None and not ev["cancel"]:
            lines.append("Est. Int %s here" % ev["local_int"])
        if ev["max_int"]:
            lines.append("Max Int %s" % ev["max_int"] + ("" if ev["assumption"] or ev["depth_km"] == None else " %s" % bousai_eew_depth_text(ev["depth_km"])))
        lines.append("Report %d%s" % (ev["serial"], " (final)" if ev["final"] else ""))
        out.append(bousai_home_item("eew", bousai_eew_sev(ev), "eew", ev["announced"], ["EEW " + word, "EEW " + short, "EEW"], lines, 1, ev))
    return out

def bousai_home_shaking_item(sh, pref_en):
    """Shaking-detection item (P2PQuake), or None. Severity 2 when pref_en (your prefecture) is named."""
    if sh == None or not sh["detected"]:
        return None
    areas = sh["areas_en"]
    near = len(areas) == 0 or (pref_en != None and pref_en in areas)
    conf = sh["confidence"]
    lines = [", ".join(areas) if areas else "Area not given", "Unconfirmed"]
    if conf.startswith("Lv"):
        lines.append("Confidence %s" % conf[2:])
    elif conf:
        lines.append("EEW detected")
    return bousai_home_item("shaking", 2 if near else 1, "quake", sh["time"], ["Shaking Detected", "Shaking"], lines, 1, sh)

def bousai_home_tsunami_item(ts):
    """Item for a bousai_tsunami_current() result, or None when nothing is in effect."""
    if ts == None or not ts["active"] or len(ts["items"]) == 0:
        return None
    sev = ts["sev"]
    top = ts["items"][0]
    arrival = top["arrival_en"]
    if ":" in arrival:
        arrival = "ETA " + arrival
    parts = [x for x in [arrival, top["height_en"]] if x]
    detail = ", ".join(parts)
    if len(detail) > 15:
        detail = " ".join(parts)
    lines = [top["area_en"], detail or "No timing yet"]
    if len(ts["items"]) > 1:
        lines.append("+%d more region%s" % (len(ts["items"]) - 1, "" if len(ts["items"]) == 2 else "s"))
    return bousai_home_item("tsunami", sev, "tsunami", ts["issued"], BOUSAI_HOME_TSUNAMI_BANDS.get(sev) or ["Tsunami"], lines, 1, ts)

def bousai_home_warning_items(current):
    """One item per warning level of a bousai_warnings_current() list."""
    groups = {}
    for w in current:
        groups.setdefault(w["level"], []).append(w)
    out = []
    for level in sorted(groups.keys(), reverse = True):
        ws = groups[level]
        sev = level // 10
        landslide = len([w for w in ws if w["element"] == "landslide"]) > 0
        when = ws[0]["issued"]
        for w in ws:
            if w["issued"] > when:
                when = w["issued"]
        lines = [w["element_en"] for w in ws] + [ws[0]["area_en"]]
        out.append(bousai_home_item("warnings", sev, bousai_home_level_class(sev, landslide), when, BOUSAI_HOME_LEVEL_BANDS.get(level) or ["Warning"], lines, len(ws), ws))
    return out

def bousai_home_notice_items(notices):
    """Items for bousai_warnings_notices(): tornado watch, record heavy rain, river flood."""
    out = []
    for n in notices:
        kind = n["kind_en"]
        sev = n["sev"]
        if kind.startswith("Tornado"):
            cls = "notice"
            bands = ["Tornado Watch", "Tornado"]
        elif kind.startswith("Record"):
            cls = "notice"
            bands = ["Record Short-Term Heavy Rain", "Record Heavy Rain", "Record Rain", "Rain"]
        else:
            cls = bousai_home_level_class(sev)
            bands = ["River Flood Lv%d" % sev, "Flood Lv%d" % sev, "Lv%d" % sev]
        out.append(bousai_home_item("notice", sev, cls, n["issued"], bands, [n["text_en"]], 1, n))
    return out

def bousai_home_volcano_meaning(kind_en):
    """'Level 3 (Do not approach the volcano)' -> 'Do not approach the volcano'."""
    if "(" in kind_en:
        return kind_en.split("(", 1)[1].rstrip(")")
    return kind_en

def bousai_home_volcano_items(volcanoes, loc, radius_km):
    """One item per alert level (2..5) of the volcanoes of bousai_volcano_current within radius_km."""
    groups = {}
    for v in volcanoes:
        if v["sev"] >= 2 and v["distance_km"] <= radius_km:
            groups.setdefault(v["sev"], []).append(v)
    out = []
    for sev in sorted(groups.keys(), reverse = True):
        vs = sorted(groups[sev], key = lambda v: v["distance_km"])
        when = vs[0]["issued"]
        lines = [bousai_home_volcano_meaning(vs[0]["kind_en"])]
        for v in vs:
            lines.append("%s %s %s" % (v["name_en"], bousai_home_km(v["distance_km"]), bousai_bearing_name(loc["lat"], loc["lon"], v["lat"], v["lon"])))
            if v["issued"] != None and (when == None or v["issued"] > when):
                when = v["issued"]
        level = vs[0]["level"]
        label = "Volcano Lv%d" % level if level else "Volcano " + BOUSAI_SEVERITY_EN[sev]
        out.append(bousai_home_item("volcano", sev, bousai_home_level_class(sev), when, [label, "Volc. Lv%d" % level if level else "Volcano", "Lv%d" % level if level else "Vol"], lines, len(vs), vs))
    return out

def bousai_home_eruption_items(flashes, loc, radius_km, now):
    """Items for bousai_volcano_flash() reports whose volcano lies within radius_km (24 h of reports)."""
    rows = {}
    for row in BOUSAI_VOLCANOES.values():
        rows[row[0]] = row
    out = []
    for f in flashes:
        row = rows.get(f["name_en"])
        if row == None:
            continue
        km = bousai_distance_km(loc["lat"], loc["lon"], row[1], row[2])
        if km > radius_km:
            continue
        age_min = (now - f["time"]).minutes
        sev = 4 if age_min <= BOUSAI_HOME_ERUPTION_URGENT_MIN else 2
        lines = [f["name_en"], f["text_en"], "%s %s" % (bousai_home_km(km), bousai_bearing_name(loc["lat"], loc["lon"], row[1], row[2]))]
        out.append(bousai_home_item("eruption", sev, "eruption", f["time"], ["Eruption Flash", "Eruption"], lines, 1, f))
    return out

def bousai_home_quake_sev(q):
    """Severity of a quake for this location (see the priority model): the stronger of the intensity felt
    here and a two-step discount of the maximum intensity anywhere (strong quakes elsewhere still show)."""
    local = bousai_intensity_rank(q["local_int"] or "")
    top = bousai_intensity_rank(q["max_int"] or "")
    sev = 1
    if local >= bousai_intensity_rank("6-"):
        sev = 5
    elif local >= bousai_intensity_rank("5-"):
        sev = 4
    elif local == bousai_intensity_rank("4"):
        sev = 3
    elif local == bousai_intensity_rank("3"):
        sev = 2
    if top >= bousai_intensity_rank("6-"):
        sev = max(sev, 3)
    elif top >= bousai_intensity_rank("5-"):
        sev = max(sev, 2)
    return sev

def bousai_home_quake_facts(q):
    """'M5.1 D10km' (magnitude and depth; 'shallow' for depth 0, 'Magnitude pending' without magnitude)."""
    parts = []
    if q["mag"]:
        parts.append("M" + q["mag"])
    if q["depth_km"] != None:
        parts.append("D%dkm" % int(q["depth_km"] + 0.5) if q["depth_km"] >= 1 else "shallow")
    return " ".join(parts) or "Magnitude pending"

def bousai_home_quake_items(quakes, hours, now):
    """Items for the quakes inside the recency window whose severity is 2 or more."""
    out = []
    for q in quakes:
        if (now - q["time"]).hours > hours:
            continue
        sev = bousai_home_quake_sev(q)
        if sev < 2:
            continue
        top = q["max_int"] or "?"
        lines = [q["epicenter_en"], bousai_home_quake_facts(q)]
        if q["local_int"]:
            lines.append("Your area Int %s" % q["local_int"])
        out.append(bousai_home_item("quake", sev, "quake", q["time"], ["Quake Int " + top, "Int " + top, "Quake"], lines, 1, q))
    return out

def bousai_home_special_items(specials):
    """Items for bousai_quake_special(): Nankai Trough / Hokkaido-Sanriku information."""
    out = []
    for s in specials:
        nankai = "Nankai" in s["title_en"]
        bands = ["Nankai Trough", "Nankai"] if nankai else ["Hokkaido-Sanriku", "Sanriku"]
        out.append(bousai_home_item("special", s["sev"], bousai_home_level_class(s["sev"]), s["issued"], bands, [s["kind_en"]], 1, s))
    return out

def bousai_home_typhoon_items(typhoons, radius_km):
    """Items for the typhoons of bousai_typhoon_current within radius_km (nearest first)."""
    out = []
    for t in typhoons:
        if t["distance_km"] == None or t["distance_km"] > radius_km:
            continue
        sev = BOUSAI_HOME_TYPHOON_SEV.get(t["category_en"], 2)
        name = ("%s %s" % (t["name_en"], t["category_en"])).strip()
        lines = ["%s %s of you" % (bousai_home_km(t["distance_km"]), t["bearing"]), name]
        stats = []
        if t["pressure_hpa"] != None:
            stats.append("%dhPa" % t["pressure_hpa"])
        if t["wind_ms"] != None:
            stats.append("%d%sm/s" % (t["wind_ms"], "/%d" % t["gust_ms"] if t["gust_ms"] != None else ""))
        if stats:
            lines.append(" ".join(stats))
        move = t["course_en"] or ""
        if move and t["speed_kmh"] != None:
            move = "%s %dkm/h" % (move, t["speed_kmh"])
        if move:
            lines.append("Move " + move)
        bands = ["Typhoon No.%d" % t["number"], "Typhoon %d" % t["number"], "Typhoon"] if t["number"] else ["Tropical Cyclone", "Cyclone"]
        out.append(bousai_home_item("typhoon", sev, "typhoon", t["issued"], bands, lines, 1, t))
    return out

# ---------------------------------------------------------------------------
# Calm information

def bousai_home_last_quake(quakes):
    """The quake for the calm card: the newest one felt at the location, else the newest listed."""
    for q in quakes:
        if q["local_int"]:
            return q
    return quakes[0] if quakes else None

# ---------------------------------------------------------------------------
# Demo

def bousai_home_demo_tsunami(now):
    """Embedded sample in bousai_tsunami_current() shape: the Tsunami Advisory regions of JMA's 16:22
    report of the 2024-01-01 Noto Peninsula earthquake (1 m expected), arrival times relative to now."""
    items = []
    for code, minutes in [("200", 28), ("230", 28), ("500", 38), ("550", 38)]:
        arrival = (now + time.parse_duration("%dm" % minutes)).in_location(BOUSAI_JST).format("15:04")
        items.append({"area_en": BOUSAI_TSUNAMI_AREA_EN[code], "kind_en": BOUSAI_TSUNAMI_KIND_EN["62"], "sev": 2, "arrival_en": arrival, "height_en": "1m"})
    return {"active": True, "issued": now - time.parse_duration("3m"), "sev": 2, "items": items}

def bousai_home_demo(config):
    """Combined sample state (same shape as bousai_home_gather): an EEW warning (the 2024-01-01 Noto
    Peninsula report of the EEW library, countdown timed for the location), a tsunami advisory
    (that event's advisory regions) and the urgent part of the warnings library's sample: Lv4 Heavy
    Rain + Landslide and a record short-term heavy rain notice (a July-2025-type event). Not real."""
    loc = bousai_location(config)
    now = time.now()
    items = bousai_home_eew_items([bousai_eew_public(ev) for ev in bousai_eew_poll(config, demo = True)["events"]])
    tsunami = bousai_home_tsunami_item(bousai_home_demo_tsunami(now))
    if tsunami != None:
        items.append(tsunami)
    place = bousai_warnings_demo()[0]
    items.extend(bousai_home_warning_items([w for w in place["current"] if w["level"] >= 40]))
    items.extend(bousai_home_notice_items([n for n in place["notices"] if n["kind_en"].startswith("Record")]))
    return bousai_home_finish(loc, None, now, items, [], {"warnings": True, "tsunami": True}, True)

# ---------------------------------------------------------------------------
# Gathering

def bousai_home_finish(loc, area, now, items, quakes, ok, demo):
    """The state dict every consumer gets: loc, area, now, items (sorted), active, top_sev, quakes, ok, demo."""
    items = bousai_home_sort(items)
    return {
        "loc": loc,
        "area": area,
        "now": now,
        "items": items,
        "active": bousai_home_active(items),
        "top_sev": items[0]["sev"] if items else 0,
        "quakes": quakes,
        "ok": ok,
        "demo": demo,
    }

def bousai_home_gather(config, opts):
    """Collect and prioritise everything for the configured location.

    Returns {loc, area (bousai_area or None), now, items (sorted, see the priority model), active (alerts at
    sev >= 2), top_sev, quakes (the recent felt quakes listed by JMA, newest first), ok, demo}; ok =
    {warnings, tsunami}: True / False when the feed was read / not readable, None when not asked. The calm
    feeds are not read here: see bousai_home_calm.
    """
    if opts["demo"]:
        return bousai_home_demo(config)
    loc = bousai_location(config)
    now = time.now()
    area = bousai_area(config)
    items = []
    ok = {"warnings": None, "tsunami": None}
    quakes = []

    if opts["eew"]:
        items.extend(bousai_home_eew_items(bousai_eew_active(config)))
    if opts["shaking"]:
        pref_en = BOUSAI_PREF_EN.get(area["pref"]) if area else None
        sh = bousai_home_shaking_item(bousai_eew_shaking(), pref_en)
        if sh != None:
            items.append(sh)
    if opts["tsunami"]:
        ts = bousai_tsunami_current()
        ok["tsunami"] = ts != None
        tsunami = bousai_home_tsunami_item(ts)
        if tsunami != None:
            items.append(tsunami)
    if opts["warnings"] and area != None:
        place = bousai_warnings_place(area)
        ok["warnings"] = place["ok"]
        items.extend(bousai_home_warning_items(place["current"]))
        items.extend(bousai_home_notice_items(place["notices"]))
    if opts["volcano"]:
        items.extend(bousai_home_volcano_items(bousai_volcano_current(config), loc, opts["volcano_km"]))
        items.extend(bousai_home_eruption_items(bousai_volcano_flash(), loc, opts["volcano_km"], now))
    if opts["quake"]:
        quakes = bousai_quake_recent(config, 5, "1")
        items.extend(bousai_home_quake_items(quakes, opts["quake_hours"], now))
    if opts["special"]:
        items.extend(bousai_home_special_items(bousai_quake_special()))
    if opts["typhoon"]:
        items.extend(bousai_home_typhoon_items(bousai_typhoon_current(config), opts["typhoon_km"]))

    return bousai_home_finish(loc, area, now, items, quakes, ok, False)

def bousai_home_calm(config, opts, state):
    """The calm-information feeds for a gathered state: {quake (the newest felt quake, or None), amedas
    (current conditions, or None), forecast (today's forecast, or None)}. Separate from bousai_home_gather
    so the caller reads the weather feeds only when there is dwell time left for them."""
    loc = state["loc"]
    amedas = bousai_amedas_latest(loc["lat"], loc["lon"]) if opts["amedas"] else None
    forecast = bousai_forecast_today(state["area"], config) if opts["forecast"] and state["area"] != None else None
    return {"quake": bousai_home_last_quake(state["quakes"]), "amedas": amedas, "forecast": forecast}

# ---- src/apps/bousai_home/bousai_home.star ---------------------------------

# Every card page stays up at least this long (frames of 100 ms).
HOME_MIN_FRAMES = 25

# Night variants of the forecast sprites (the weather library only draws daytime icons).
HOME_NIGHT_KEY = {"sun": "moon", "partly": "pmoon", "sunrain": "rain", "sunsnow": "snow"}

# Lines of an item from this index on are secondary (muted); every line is primary when absent.
HOME_MUTED_FROM = {"tsunami": 2, "eruption": 2, "typhoon": 3, "shaking": 1}

# ---------------------------------------------------------------------------
# Layout metrics. Every page is: header (location and alert count), band (card title on its severity
# colour), then body rows. Large text leaves one body row per page, so cards page.

def home_metrics(ui):
    height = canvas.height()
    hh = bousai_font_height(ui, ui["small_font"])
    bh = ui["line_h"]
    top = hh + bh
    fh = bousai_font_height(ui)
    return {
        "hh": hh,
        "bh": bh,
        "rows": 1 + max(0, (height - top - fh) // ui["line_h"]),
        "body": height - top,
    }

def home_clip(ui, text, width, font = None):
    """Trim text (no ellipsis, never scrolls) until it fits width."""
    t = text
    for _ in range(len(text)):
        if bousai_text_width(ui, t, font) <= width:
            break
        t = t[:-1]
    return t

def home_pick(ui, options, width, font = None):
    """First option that fits width, else the last one trimmed."""
    for o in options:
        if bousai_text_width(ui, o, font) <= width:
            return o
    return home_clip(ui, options[-1], width, font)

def home_when(t, tz, now):
    """Clock time when t is today, month/day and clock within half a year, else the date with its year."""
    if t.in_location(tz).format("2006-01-02") == now.in_location(tz).format("2006-01-02"):
        return bousai_hhmm(t, tz)
    if (now - t).hours > 24 * 180:
        return t.in_location(tz).format("2006-01-02")
    return bousai_mdhm(t, tz)

def home_short_place(text):
    """Abbreviate long JMA place phrases before they would have to scroll."""
    for a, b in [(" Prefecture", " Pref."), ("Adjacent Sea of ", "Sea of "), ("Off the Coast of ", "Off "), ("Off the ", "Off ")]:
        text = text.replace(a, b)
    return text

# ---------------------------------------------------------------------------
# Header and band

def home_header(ui, label, active, top_sev, m):
    """Location on the left; on the right the number of active alerts on the colour of the strongest one."""
    width = canvas.width()
    font = ui["small_font"]
    label_w = bousai_text_width(ui, label, font)
    if active > 0:
        word = "%d alert%s" % (active, "" if active == 1 else "s")
        text = word if label_w + bousai_text_width(ui, word, font) + 7 <= width else "!%d" % active
        color = bousai_sev_color(ui, top_sev)
        right_w = bousai_text_width(ui, text, font) + 3
        right = render.Box(width = right_w, height = m["hh"], color = color, child = bousai_text(ui, text, bousai_on(color), font))
    else:
        right_w = bousai_text_width(ui, "Calm", font) + 3
        right = bousai_text(ui, "Calm", ui["muted"], font)
    kids = [
        render.Box(width = width, height = 1),
        render.Padding(pad = (1, 0, 0, 0), child = bousai_text(ui, home_clip(ui, label, width - right_w - 3, font), ui["fg"], font)),
        render.Padding(pad = (width - right_w, 0, 0, 0), child = right),
    ]
    return render.Box(width = width, height = m["hh"], color = ui["panel"], child = render.Stack(children = kids))

def home_band(ui, card, m):
    """Card title on its severity colour with the age on the right. Emergencies blink."""
    width = canvas.width()
    color = card["color"]
    ink = bousai_on(color)
    title = home_pick(ui, card["bands"], width - 2)
    right = card["right"] or ""
    right_w = bousai_text_width(ui, right) + 2 if right else 0
    kids = [render.Box(width = width, height = 1), render.Padding(pad = (1, 0, 0, 0), child = bousai_text(ui, title, ink))]
    if right and bousai_text_width(ui, title) + right_w + 3 <= width:
        kids.append(render.Padding(pad = (width - right_w + 1, 0, 0, 0), child = bousai_text(ui, right, ink)))
    band = render.Box(width = width, height = m["bh"], color = color, child = render.Stack(children = kids))
    if card["sev"] >= 5:
        band = bousai_blink(ui, band, width, m["bh"])
    return band

# ---------------------------------------------------------------------------
# Rows. A row spec is a dict; home_row turns it into a widget one line high and one screen wide.
#   text  {k, t, c}                  one line, scrolls (within the page's frames) when too wide
#   pair  {k, l, r, lc, rc}          label on the left, value on the right
#   segs  {k, segs}                  [("t", text, color) | ("c", chip label, chip color)]; the last text may scroll
#   eew   {k, ev}                    estimated intensity with a once-a-second S-wave countdown

def home_text(text, color):
    return {"k": "text", "t": text, "c": color}

def home_pair(ui, label, value, color):
    return {"k": "pair", "l": label, "r": value, "lc": ui["muted"], "rc": color}

def home_segs_row(ui, segs, frames):
    """A row of chips and text. Chips are font-high boxes; only the last text may scroll."""
    room = canvas.width() - 1
    fh = bousai_font_height(ui)
    kids = []
    used = 0
    for i, s in enumerate(segs):
        if s[0] == "c":
            w = bousai_text_width(ui, s[1]) + 3
            kids.append(render.Box(width = w, height = fh, color = s[2], child = bousai_text(ui, s[1], bousai_on(s[2]))))
            used += w
        elif i == len(segs) - 1:
            kids.append(bousai_fit(ui, s[1], width = max(1, room - used), color = s[2], frames = frames))
        else:
            kids.append(bousai_text(ui, s[1], s[2]))
            used += bousai_text_width(ui, s[1])
    return render.Row(children = kids)

def home_segs_width(ui, segs):
    w = 0
    for s in segs:
        w += bousai_text_width(ui, s[1]) + (3 if s[0] == "c" else 0)
    return w

def home_eew_segs(ui, ev, remain, variant):
    """Segments of the estimate row for `remain` seconds to the S-wave."""
    if remain > 0:
        tail = " in %ds" % int(math.ceil(remain))
    elif remain > -10:
        tail = " now"
    else:
        tail = " passed"
    chip = ("c", ev["local_int"], bousai_intensity_color(ui, ev["local_int"]))
    if variant == 0:
        return [("t", "Est ", ui["muted"]), chip, ("t", tail, ui["fg"])]
    return [chip, ("t", tail, ui["fg"])]

def home_eew_row(ui, spec, frames, t0):
    """The estimate row: one widget per second of the page, counting down to the S-wave from the moment
    the page is built (t0 = the frame at which this page starts, so later pages stay in step)."""
    ev = spec["ev"]
    r0 = (ev["s_arrival"] - time.now()).seconds
    widest = home_eew_segs(ui, ev, max(r0, 99.0), 0)
    variant = 0 if home_segs_width(ui, widest) <= canvas.width() - 1 else 1
    seconds = frames // 10 + 1
    per_second = [home_segs_row(ui, home_eew_segs(ui, ev, r0 - t0 / 10.0 - s, variant), frames) for s in range(seconds)]
    return render.Animation(children = [per_second[min(f // 10, seconds - 1)] for f in range(frames)])

def home_row(ui, spec, frames, t0):
    width = canvas.width()
    kind = spec["k"]
    if kind == "pair":
        lw = bousai_text_width(ui, spec["l"])
        rw = bousai_text_width(ui, spec["r"])
        if lw + rw + 3 <= width - 1:
            child = render.Stack(children = [
                bousai_text(ui, spec["l"], spec["lc"]),
                render.Padding(pad = (width - 1 - rw, 0, 0, 0), child = bousai_text(ui, spec["r"], spec["rc"])),
            ])
        else:
            child = bousai_fit(ui, spec["l"] + " " + spec["r"], width = width - 1, color = spec["rc"], frames = frames)
    elif kind == "segs":
        child = home_segs_row(ui, spec["segs"], frames)
    elif kind == "eew":
        child = home_eew_row(ui, spec, frames, t0)
    else:
        child = bousai_fit(ui, spec["t"], width = width - 1, color = spec["c"], frames = frames)
    return render.Box(width = width, height = ui["line_h"], child = render.Row(expanded = True, children = [render.Padding(pad = (1, 0, 0, 0), child = child)]))

# ---------------------------------------------------------------------------
# Cards. A card is {sev, color, bands, right, hero, rows, max_pages}; `hero` (or None) builds the body of
# the first page from the page's frame count, `rows` fill the pages (or the pages after the hero).

def home_card(ui, sev, bands, right, rows, max_pages = 2):
    return {"sev": sev, "color": bousai_sev_color(ui, sev), "bands": bands, "right": right, "hero": None, "rows": rows, "max_pages": max_pages}

def home_line_color(ui, item, i):
    kind = item["kind"]
    if kind == "warnings":
        muted = i == len(item["lines"]) - 1
    else:
        muted = i >= HOME_MUTED_FROM.get(kind, 99)
    return ui["muted"] if muted else ui["fg"]

def home_eew_rows(ui, item):
    ev = item["data"]
    rows = [home_text(home_short_place(item["lines"][0]), ui["fg"])]
    if ev["local_int"] != None and not ev["cancel"]:
        if ev["s_arrival"] != None:
            rows.append({"k": "eew", "ev": ev})
        else:
            rows.append({"k": "segs", "segs": [("t", "Est ", ui["muted"]), ("c", ev["local_int"], bousai_intensity_color(ui, ev["local_int"]))]})
    extra = []
    for line in item["lines"][1:]:
        if line.startswith("Max"):
            rows.append(home_text(line, ui["fg"]))
        elif not line.startswith("Est."):
            extra.append(home_text(line, ui["muted"]))
    return rows, extra

def home_quake_rows(ui, item, state):
    q = item["data"]
    rows = [home_text(home_short_place(item["lines"][0]), ui["fg"]), home_text(item["lines"][1], ui["fg"])]
    if q["local_int"]:
        rows.append({"k": "segs", "segs": [("t", "Your area ", ui["muted"]), ("c", "Int " + q["local_int"], bousai_intensity_color(ui, q["local_int"]))]})
    extra = [home_text("%s  %s ago" % (home_when(q["time"], state["loc"]["tz"], state["now"]), bousai_ago(q["time"], state["now"])), ui["muted"])]
    if q["tsunami_en"]:
        extra.append(home_text(q["tsunami_en"], ui["muted"]))
    return rows, extra

def home_item_rows(ui, item, state, per_page):
    """Rows of an item's card: the essentials, then the optional lines (time of issue...) only while the
    last page has room, so a card does not grow a page for them."""
    kind = item["kind"]
    if kind == "eew":
        rows, extra = home_eew_rows(ui, item)
    elif kind == "quake":
        rows, extra = home_quake_rows(ui, item, state)
    else:
        rows = [home_text(home_short_place(line), home_line_color(ui, item, i)) for i, line in enumerate(item["lines"])]
        extra = []
        if item["when"] != None:
            label = "Issued" if kind in ("tsunami", "warnings", "notice", "special", "volcano") else "At"
            extra.append(home_text("%s %s" % (label, home_when(item["when"], state["loc"]["tz"], state["now"])), ui["muted"]))
    for e in extra:
        if len(rows) % per_page == 0:
            break
        rows.append(e)
    return rows

def home_item_card(ui, item, state, per_page):
    sev = item["sev"]
    right = bousai_ago(item["when"], state["now"]) if item["when"] != None else None
    return home_card(ui, sev, item["bands"], right, home_item_rows(ui, item, state, per_page), 3 if sev >= 4 else 2)

# ---- calm cards ------------------------------------------------------------

def home_icon(ui, key, night, mini):
    """Weather sprite for a forecast key; at night the sun becomes a moon."""
    if night:
        key = HOME_NIGHT_KEY.get(key, key)
    if mini:
        return bousai_forecast_mini(ui, key)
    if key in ("moon", "pmoon"):
        g = bousai_forecast_blank(16, 12)
        if key == "moon":
            bousai_forecast_disc(g, 6, 6, 30, "M")
            bousai_forecast_disc(g, 9, 5, 22, ".")
        else:
            bousai_forecast_disc(g, 5, 5, 22, "M")
            bousai_forecast_disc(g, 8, 4, 14, ".")
            bousai_forecast_cloud_layer(g, 3, 5, "C")
        return bousai_forecast_render_grid(ui, ["".join(r) for r in g])
    return bousai_forecast_big(ui, key)

def home_weather_facts(calm, tz, per_page):
    """Weather lines in priority order: [(short text, label, value)]. One-line pages (large text) get
    sunrise and sunset as one fact and skip the station readings."""
    am = calm["amedas"]
    fc = calm["forecast"]
    facts = []
    if fc != None:
        hi = fc["high"]
        lo = fc["low"]
        if hi != None and lo != None:
            facts.append(("H%d L%d" % (hi, lo), "High/Low", "%d/%dC" % (hi, lo)))
        elif hi != None:
            facts.append(("High %dC" % hi, "High", "%dC" % hi))
        elif lo != None:
            facts.append(("Low %dC" % lo, "Low", "%dC" % lo))
        if fc["pop_now"] != None:
            facts.append(("Rain %d%%" % fc["pop_now"], "Rain", "%d%%" % fc["pop_now"]))
        rise = fc["sunrise"]
        sset = fc["sunset"]
        if rise != None and sset != None:
            if per_page == 1:
                span = "%s-%s" % (bousai_hhmm(rise, tz), bousai_hhmm(sset, tz))
                facts.append(("Sun " + span, "Sun", span))
            else:
                facts.append(("Rise " + bousai_hhmm(rise, tz), "Sunrise", bousai_hhmm(rise, tz)))
                facts.append(("Set " + bousai_hhmm(sset, tz), "Sunset", bousai_hhmm(sset, tz)))
    if am != None and per_page > 1:
        if am["humidity"] != None:
            pct = "%d%%" % int(am["humidity"] + 0.5)
            facts.append(("Humid " + pct, "Humidity", pct))
        if am["precip_1h"] != None:
            mm = bousai_fixed(am["precip_1h"], 1) + "mm"
            facts.append(("Rain " + mm + "/h", "Precip 1h", mm))
        if am["wind_ms"] != None:
            wind = bousai_fixed(am["wind_ms"], 1) + "m/s"
            if am["wind_dir_en"] and am["wind_dir_en"] != "Calm":
                wind += " " + am["wind_dir_en"]
            facts.append(("Wind " + wind, "Wind", wind))
    return facts

def home_hero_layout(ui, m):
    """Weather hero geometry: sprite (16x12, or 7x5 at the largest text), big temperature, extra lines
    beside it, and whether a line fits under the sprite (the chance of rain)."""
    mini = ui["size"] == "xlarge"
    font = ui["font"] if mini else ui["big_font"]
    tf = bousai_font_height(ui, font)
    fh = bousai_font_height(ui)
    space = m["body"] - tf - 1
    icon_h = 5 if mini else 12
    icon_top = max(0, (tf - icon_h) // 2)
    return {
        "mini": mini,
        "font": font,
        "tf": tf,
        "n_extra": 1 + (space - fh) // ui["line_h"] if space >= fh else 0,
        "left": 10 if mini else 19,
        "icon_top": icon_top,
        "under": (not mini) and m["body"] - icon_top - icon_h - 1 >= fh,
    }

def home_weather_hero(ui, lay, temp_text, key, night, extras, under, frames):
    """Body of the weather card's first page: sprite (with `under` text beneath it), big temperature, then the extra lines."""
    right = [bousai_text(ui, temp_text, ui["fg"], lay["font"])]
    for e in extras:
        right.append(render.Padding(pad = (0, 1 if len(right) == 1 else 0, 0, 0), child = bousai_fit(ui, e, width = canvas.width() - lay["left"] - 1, color = ui["fg"], frames = frames)))
    left = []
    if key:
        left.append(render.Padding(pad = (1, lay["icon_top"], 2, 0), child = home_icon(ui, key, night, lay["mini"])))
        if under:
            left.append(render.Padding(pad = (1, 1, 0, 0), child = bousai_text(ui, under, ui["sev"][1])))
    else:
        left.append(render.Box(width = 3, height = 1))
    return render.Row(children = [render.Column(children = left), render.Column(children = right)])

def home_weather_card(ui, state, calm, m, max_pages):
    """Weather: sprite, temperature now (AMeDAS) and the forecast facts. None without any data."""
    am = calm["amedas"]
    fc = calm["forecast"]
    if am == None and fc == None:
        return None
    tz = state["loc"]["tz"]
    facts = home_weather_facts(calm, tz, m["rows"])
    key = None
    night = False
    telop = ""
    if fc != None and fc["code"]:
        telop, _, key = bousai_forecast_weather(fc["code"])
        night = bousai_forecast_is_night(state["now"].in_location(tz), fc["sunrise"], fc["sunset"])
    temp_text = (bousai_fixed(am["temp"], 1) + "C") if am != None and am["temp"] != None else "--"
    lay = home_hero_layout(ui, m)
    extras = [f[0] for f in facts[:lay["n_extra"]]]
    rest = facts[lay["n_extra"]:]
    rows = [home_text(f[0], ui["fg"]) for f in rest] if m["rows"] == 1 else [home_pair(ui, f[1], f[2], ui["fg"]) for f in rest]
    under = None
    if fc != None and fc["pop_now"] != None and lay["under"] and len([e for e in extras if e.startswith("Rain")]) == 0:
        under = "%d%%" % fc["pop_now"]
    card = home_card(ui, 0, [x for x in [telop, "Weather"] if x], bousai_hhmm(am["time"], tz) if am != None else None, rows, max_pages)
    card["hero"] = lambda frames: home_weather_hero(ui, lay, temp_text, key, night, extras, under, frames)
    return card

def home_quake_card(ui, state, calm, per_page):
    """The newest felt quake, for when nothing urgent fills the panel."""
    q = calm["quake"]
    if q == None:
        return None
    label = q["local_int"] or q["max_int"]
    chip = ("c", "Int " + label if label else "Int ?", bousai_intensity_color(ui, label))
    mag = bousai_home_quake_facts(q)
    place = home_short_place(q["epicenter_en"])
    if per_page == 1:
        rows = [{"k": "segs", "segs": [chip, ("t", " %s %s" % (mag, place), ui["fg"])]}]
    else:
        rows = [
            {"k": "segs", "segs": [("t", "Your area " if q["local_int"] else "Max ", ui["muted"]), chip]},
            home_text(mag, ui["fg"]),
            home_text(place, ui["fg"]),
        ]
    return home_card(ui, 0, ["Last felt quake", "Last quake", "Quake"], bousai_ago(q["time"], state["now"]), rows, 1)

def home_status_card(ui, state, opts):
    """'No warnings' (or a no-data notice) with the time of the check and what was clear."""
    if len([s for s in ["eew", "shaking", "tsunami", "warnings", "volcano", "quake", "special", "typhoon"] if opts[s]]) == 0:
        return home_message_card(ui, "No sources on", ["Every source is", "switched off.", "Turn some on."])
    stamp = bousai_hhmm(state["now"], state["loc"]["tz"])
    checked = home_pick(ui, ["Checked " + stamp, "As of " + stamp, "At " + stamp], canvas.width() - 2)
    if opts["warnings"] and state["ok"]["warnings"] == False:
        return home_card(ui, 1, ["No warning data", "No data"], None, [home_text("JMA warning feed", ui["fg"]), home_text("unavailable", ui["fg"]), home_text(checked, ui["muted"])], 1)
    clear = []
    for s, name in [("eew", "EEW"), ("tsunami", "Tsunami"), ("volcano", "Volcano"), ("typhoon", "Typhoon")]:
        if opts[s] and not (s == "tsunami" and state["ok"]["tsunami"] == False):
            clear.append(name)
    rows = [home_text(checked, ui["muted"])]
    if clear:
        rows.append(home_text("Clear: " + ", ".join(clear), ui["fg"]))
    return home_card(ui, 0, ["No warnings", "Calm"] if opts["warnings"] else ["All clear", "Calm"], None, rows, 1)

def home_message_card(ui, title, lines):
    return home_card(ui, 1, [title], None, [home_text(l, ui["fg"]) for l in lines], 2)

def home_alert_cards(ui, state, opts, m):
    """Cards of the items in priority order (only severity 2 and up in alert-only mode)."""
    items = state["items"]
    if opts["alert_only"]:
        items = [it for it in items if it["sev"] >= 2]
    return [home_item_card(ui, it, state, m["rows"]) for it in items]

def home_calm_cards(ui, state, opts, m, calm):
    """Calm cards: weather, the last felt quake and, when nothing is at severity 2 or more, 'No warnings'.
    With alerts the weather shows only its first page."""
    steady = state["top_sev"] < 2
    if state["area"] == None:
        return [home_message_card(ui, "Outside Japan", ["No JMA area for", "this location.", "Set a new one."])] if steady else []
    cards = []
    weather = home_weather_card(ui, state, calm, m, (4 if m["rows"] == 1 else 3) if steady else 1)
    if weather != None:
        cards.append(weather)
    shown = [it["data"]["event_id"] for it in state["items"] if it["kind"] == "quake"]
    quake = home_quake_card(ui, state, calm, m["rows"])
    if quake != None and calm["quake"]["event_id"] not in shown:
        cards.append(quake)
    if steady:
        cards.append(home_status_card(ui, state, opts))
    return cards

# ---------------------------------------------------------------------------
# Pages and planning

def home_page_count(card, per_page):
    pages = (len(card["rows"]) + per_page - 1) // per_page + (1 if card["hero"] != None else 0)
    return max(1, min(pages, card["max_pages"]))

def home_choose(cards, per_page, capacity, key):
    """[(card, pages shown)] of the alert cards in priority order.

    When everything fits the dwell time every card is shown. Otherwise the top card, and the
    urgent cards (severity 4+) that follow it while at least two pages stay free, are pinned; the
    other cards rotate: a window of consecutive ones is shown, starting where the previous render
    stopped (a counter kept in the cache), so every card appears across renders.
    """
    counts = [home_page_count(c, per_page) for c in cards]
    total = 0
    for n in counts:
        total += n
    if total <= capacity:
        return [(cards[i], counts[i]) for i in range(len(cards))]
    pinned = [(0, min(counts[0], capacity))]
    used = pinned[0][1]
    for i in range(1, len(cards)):
        if cards[i]["sev"] >= 4 and used + counts[i] <= capacity - 2:
            pinned.append((i, counts[i]))
            used += counts[i]
        else:
            break
    taken = [p[0] for p in pinned]
    rest = [i for i in range(len(cards)) if i not in taken]
    chosen = []
    if rest and used < capacity:
        start = int(cache.get(key) or "0") % len(rest)
        for k in range(len(rest)):
            if used >= capacity:
                break
            j = rest[(start + k) % len(rest)]
            take = min(counts[j], capacity - used)
            chosen.append((j, take))
            used += take
        cache.set(key, str(start + len(chosen)), ttl_seconds = 86400)
    return [(cards[i], n) for i, n in sorted(pinned + chosen)]

def home_plan(ui, config, opts, state, m):
    """[(card, pages shown)]: the chosen alert cards, then calm cards while dwell time is left. The calm
    feeds (weather) are only read when there is room for their cards."""
    per_page = m["rows"]
    loc = state["loc"]
    key = "bousai_home_rot:%s:%s" % (bousai_fixed(loc["lat"], 2), bousai_fixed(loc["lon"], 2))
    capacity = max(1, bousai_budget_frames() // HOME_MIN_FRAMES)
    picks = home_choose(home_alert_cards(ui, state, opts, m), per_page, capacity, key)
    used = 0
    for _, n in picks:
        used += n
    if used >= capacity or opts["alert_only"] or state["demo"]:
        return picks
    for c in home_calm_cards(ui, state, opts, m, bousai_home_calm(config, opts, state)):
        n = min(home_page_count(c, per_page), capacity - used)
        if n <= 0:
            break
        picks.append((c, n))
        used += n
    return picks

def home_frames(picks):
    """Frames per page of each pick: every page at least HOME_MIN_FRAMES, the spare dwell time shared by
    weight (alerts count double) and never more than three times the minimum."""
    pages = 0
    weight = 0
    for card, n in picks:
        pages += n
        weight += n * (2 if card["sev"] >= 2 else 1)
    spare = max(0, bousai_budget_frames() - pages * HOME_MIN_FRAMES)
    return [min(3 * HOME_MIN_FRAMES, HOME_MIN_FRAMES + spare * (2 if card["sev"] >= 2 else 1) // max(1, weight)) for card, _ in picks]

def home_page(ui, header, card, page, per_page, frames, t0, m):
    """One held page: header, band and the hero or the rows of page `page` of the card."""
    width = canvas.width()
    height = canvas.height()
    kids = [header, home_band(ui, card, m)]
    first = 1 if card["hero"] != None else 0
    if first and page == 0:
        kids.append(card["hero"](frames))
    else:
        start = (page - first) * per_page
        for spec in card["rows"][start:start + per_page]:
            kids.append(home_row(ui, spec, frames, t0))
    body = render.Box(width = width, height = height, child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = kids))
    if ui["frame"]:
        body = render.Stack(children = [
            body,
            render.Padding(pad = (0, height - 1, 0, 0), child = render.Box(width = width, height = 1, color = card["color"])),
            render.Padding(pad = (width - 1, 0, 0, 0), child = render.Box(width = 1, height = height, color = card["color"])),
        ])
    return bousai_hold(body, frames)

def home_render(ui, state, picks, m):
    loc = state["loc"]
    label = loc["label"] or (state["area"] or {}).get("class20_en") or "Home"
    header = home_header(ui, label, state["active"], state["top_sev"], m)
    pages = []
    t0 = 0
    for (card, count), frames in zip(picks, home_frames(picks)):
        for page in range(count):
            pages.append(home_page(ui, header, card, page, m["rows"], frames, t0, m))
            t0 += frames
    return pages[0] if len(pages) == 1 else render.Sequence(children = pages)

def main(config):
    ui = bousai_ui(config)
    opts = bousai_home_options(config)
    state = bousai_home_gather(config, opts)
    if opts["alert_only"] and state["top_sev"] < opts["alert_level"]:
        return []
    m = home_metrics(ui)
    picks = home_plan(ui, config, opts, state, m)
    if not picks:
        return bousai_message(ui, "Home", ["Nothing to show.", "Enable a source in", "the app settings."])
    return bousai_root(ui, home_render(ui, state, picks, m))

# ---------------------------------------------------------------------------
# Schema

def home_source(sid, name, desc, icon, default = True):
    return schema.Toggle(id = "src_" + sid, name = name, desc = desc, icon = icon, default = default)

def home_km_options(values):
    return [schema.Option(display = "%d km" % v, value = str(v)) for v in values]

def get_schema():
    return bousai_schema([
        home_source("eew", "Earthquake early warning", "Show active JMA EEW warnings and forecasts with the estimated intensity and S-wave countdown for your location.", "towerBroadcast"),
        home_source("shaking", "Shaking detection", "Show P2PQuake shaking detection, an unofficial evaluation of user reports and EEW detection. P2PQuake is a volunteer service that sometimes stalls, which fails that render; the app then skips it for a few minutes. Switch it off if your display shows render errors.", "signal"),
        home_source("tsunami", "Tsunami", "Show tsunami warnings, advisories and forecasts.", "water"),
        home_source("warnings", "Weather warnings and notices", "Show JMA warnings and advisories (Lv2 to Lv5) for your municipality plus landslide, river flood, tornado watch and record heavy rain notices.", "triangleExclamation"),
        home_source("volcano", "Volcano", "Show volcanic alert levels (Lv2 and up) and eruption flash reports within the volcano radius.", "volcano"),
        home_source("quake", "Recent earthquakes", "Show earthquakes felt in the recent-quake window, and the last felt quake when calm.", "waveSquare"),
        home_source("special", "Special earthquake information", "Show the Nankai Trough earthquake extra information and the Hokkaido / Sanriku subsequent-earthquake advisory.", "circleExclamation"),
        home_source("typhoon", "Typhoons", "Show typhoons whose centre is within the typhoon radius.", "hurricane"),
        home_source("amedas", "Current conditions", "Show the temperature measured by the nearest AMeDAS station on the weather card. Weather cards only fill the dwell time the alerts leave.", "temperatureHalf"),
        home_source("forecast", "Today's forecast", "Show today's weather, high and low, chance of rain and sunrise / sunset on the weather card. Weather cards only fill the dwell time the alerts leave.", "cloudSun"),
        schema.Dropdown(id = "quake_hours", name = "Recent quake window", desc = "How long an earthquake stays in the panel as an alert: felt at Int 3 or more at your location, or Int 5- or more anywhere in Japan. Weaker ones only appear as the last felt quake.", icon = "clockRotateLeft", default = "1", options = [
            schema.Option(display = "1 hour", value = "1"),
            schema.Option(display = "3 hours", value = "3"),
            schema.Option(display = "6 hours", value = "6"),
            schema.Option(display = "12 hours", value = "12"),
            schema.Option(display = "24 hours", value = "24"),
        ]),
        schema.Dropdown(id = "volcano_km", name = "Volcano radius", desc = "Volcanoes and eruption reports farther away than this are ignored.", icon = "mountain", default = "100", options = home_km_options([30, 50, 100, 200, 500])),
        schema.Dropdown(id = "typhoon_km", name = "Typhoon radius", desc = "Typhoons whose centre is farther away than this are ignored.", icon = "ruler", default = "500", options = home_km_options([300, 500, 1000, 2000])),
        schema.Toggle(id = "alert_only", name = "Only show alerts", desc = "Show nothing (the app is skipped) unless an item reaches the alert level below. Turn on Tronbyt AutoPin so an alert takes over the display; the weather feeds are not read in this mode. A long-standing alert, such as a volcano held at Lv3 for years, keeps the panel up: raise the level or switch that source off.", icon = "bell", default = False),
        schema.Dropdown(id = "alert_level", name = "Alert level", desc = "Lowest severity that counts as an alert when Only show alerts is on. Advisory: Lv2, EEW forecast of Int 3+, tsunami advisory. Warning: Lv3, tornado watch, tsunami warning, typhoon in range. Urgent: Lv4, record heavy rain, fresh eruption. Emergency: Lv5, EEW warning, major tsunami warning.", icon = "gaugeHigh", default = "3", options = [
            schema.Option(display = "Advisory (Lv2)", value = "2"),
            schema.Option(display = "Warning (Lv3)", value = "3"),
            schema.Option(display = "Urgent warning (Lv4)", value = "4"),
            schema.Option(display = "Emergency warning (Lv5)", value = "5"),
        ]),
        schema.Toggle(id = "demo", name = "Show sample alert", desc = "Show an embedded sample: an early warning (2024-01-01 Noto Peninsula report), a tsunami advisory and a Lv4 heavy rain and landslide warning, ordered by priority.", icon = "flask", default = False),
    ])
