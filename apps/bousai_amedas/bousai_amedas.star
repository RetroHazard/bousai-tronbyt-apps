"""
Applet: Bousai AMeDAS
Summary: Live JMA observations
Description: Real-time AMeDAS observations from the Japan Meteorological Agency every 10 minutes: temperature, humidity, rain, wind, gusts, snow and sunshine, with a trend chart.
Author: Bousai Apps
"""

# GENERATED by tools/build.py from src/lib/bousai_core.star, src/lib/bousai_amedas.star, src/apps/bousai_amedas/bousai_amedas.star.
# Edit the sources and rebuild; do not edit this file.

load("cache.star", "cache")
load("encoding/json.star", "json")
load("filter.star", "filter")
load("http.star", "http")
load("math.star", "math")
load("render.star", "canvas", "render")
load("schema.star", "schema")
load("time.star", "time")

# ---- src/lib/bousai_core.star ----------------------------------------------

BOUSAI_JST = "Asia/Tokyo"
BOUSAI_UA = {"User-Agent": "bousai-tronbyt-apps (+https://www.jma.go.jp/)"}

BOUSAI_DEFAULT_LOCATION = json.encode({
    "lat": "35.6812",
    "lng": "139.7671",
    "description": "Tokyo Station, Chiyoda, Tokyo, Japan",
    "locality": "Chiyoda",
    "timezone": "Asia/Tokyo",
})

BOUSAI_CLASS20_BOXES = "https://www.jma.go.jp/bosai/common/const/class20relm.json"
BOUSAI_CLASS20_SHAPE = "https://www.jma.go.jp/bosai/common/const/geojson/class20s/%s.json"
BOUSAI_AREA_JSON = "https://www.jma.go.jp/bosai/common/const/area.json"

# ---------------------------------------------------------------------------
# HTTP

def bousai_get_json(url, ttl = 60, params = None):
    """GET url and decode JSON. Returns None on transport-level non-200 or bad JSON."""
    resp = http.get(url, params = params or {}, headers = BOUSAI_UA, ttl_seconds = ttl)
    if resp.status_code != 200:
        return None
    return json.decode(resp.body(), default = None)

def bousai_get_bytes(url, ttl = 60):
    resp = http.get(url, headers = BOUSAI_UA, ttl_seconds = ttl)
    if resp.status_code != 200:
        return None
    return resp.body()

def bousai_guarded_get(url, ttl = 60, params = None, cooldown = 300):
    """GET from a host that may stall, without crash-looping. Returns the body or None.

    A transport error or Pixlet's 5 s HTTP timeout aborts the whole render and Starlark
    cannot catch it. So a "pending:<unix time>" marker is cached before the request and cleared
    after it. A marker older than the HTTP timeout found at the start means an earlier attempt
    died mid-request: the host is then skipped (None) for `cooldown` seconds. A younger marker
    is a concurrent render still in flight and is ignored. Use for third-party feeds (Wolfx,
    P2PQuake, NIED); keep cooldown above the app's render interval.
    """
    key = "bousai_guard:" + url.split("/")[2]
    state = cache.get(key) or ""
    now = time.now().unix
    if state == "down":
        return None
    if state.startswith("pending:") and now - int(state[8:]) > 6:
        cache.set(key, "down", ttl_seconds = cooldown)
        return None
    cache.set(key, "pending:%d" % now, ttl_seconds = cooldown)
    resp = http.get(url, params = params or {}, headers = BOUSAI_UA, ttl_seconds = ttl)
    cache.set(key, "ok", ttl_seconds = 1)
    if resp.status_code != 200:
        return None
    return resp.body()

def bousai_guarded_json(url, ttl = 60, params = None, cooldown = 300):
    """bousai_guarded_get + JSON decode (None on any failure)."""
    body = bousai_guarded_get(url, ttl, params, cooldown)
    return json.decode(body, default = None) if body != None else None

# ---------------------------------------------------------------------------
# Schema

def bousai_schema(fields, location = True, location_desc = "Your location in Japan. Matched to a JMA municipality on the server using JMA's own area polygons; coordinates are never sent anywhere."):
    """Build the app schema: optional location, app fields, then accessibility fields."""
    out = []
    if location:
        out.append(schema.Location(id = "location", name = "Location", desc = location_desc, icon = "locationDot"))
        out.append(schema.Text(id = "area_override", name = "JMA area code (optional)", desc = "7-digit JMA municipality code (e.g. 1310100). Overrides the location lookup.", icon = "mapPin", default = ""))
    out.extend(fields)
    out.extend(bousai_accessibility_fields())
    return schema.Schema(version = "1", fields = out)

def bousai_accessibility_fields():
    return [
        schema.Dropdown(id = "theme", name = "Theme", desc = "Dark or light display theme.", icon = "circleHalfStroke", default = "dark", options = [
            schema.Option(display = "Dark", value = "dark"),
            schema.Option(display = "Light", value = "light"),
        ]),
        schema.Dropdown(id = "palette", name = "Colour vision", desc = "Colour scheme optimised for your colour vision. Levels are always also shown as text.", icon = "eye", default = "normal", options = [
            schema.Option(display = "Normal vision", value = "normal"),
            schema.Option(display = "Protanopia / Deuteranopia (red-green)", value = "protan"),
            schema.Option(display = "Tritanopia (blue-yellow)", value = "tritan"),
            schema.Option(display = "Monochromacy", value = "mono"),
        ]),
        schema.Dropdown(id = "contrast", name = "Contrast", desc = "Low is calmer and paler; high gives brighter text and frames.", icon = "circleHalfStroke", default = "normal", options = [
            schema.Option(display = "Low", value = "low"),
            schema.Option(display = "Normal", value = "normal"),
            schema.Option(display = "High", value = "high"),
        ]),
        schema.Dropdown(id = "text_size", name = "Text size", desc = "Larger text shows fewer lines per page.", icon = "textHeight", default = "standard", options = [
            schema.Option(display = "Small", value = "small"),
            schema.Option(display = "Standard", value = "standard"),
            schema.Option(display = "Large", value = "large"),
            schema.Option(display = "Extra large", value = "xlarge"),
        ]),
        schema.Dropdown(id = "text_weight", name = "Text weight", desc = "Bold draws each glyph one pixel wider.", icon = "bold", default = "normal", options = [
            schema.Option(display = "Normal", value = "normal"),
            schema.Option(display = "Bold", value = "bold"),
        ]),
    ]

def bousai_bool(config, key, default = False):
    v = config.get(key)
    if v == None or v == "":
        return default
    return v == True or v == "true" or v == "True" or v == "1"

# ---------------------------------------------------------------------------
# Colour

def bousai_rgb(c):
    c = c.lstrip("#")
    if len(c) == 3:
        c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2]
    return (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))

def bousai_hex(rgb):
    """(r, g, b) -> '#rrggbb'. Pixlet's % has no width flags, so pad by hand."""
    digits = "0123456789abcdef"
    out = "#"
    for i in range(3):
        v = max(0, min(255, int(rgb[i])))
        out += digits[v // 16] + digits[v % 16]
    return out

def bousai_mix(a, b, t):
    """Blend colour a toward b by fraction t (0..1)."""
    x, y = bousai_rgb(a), bousai_rgb(b)
    return bousai_hex([x[i] + (y[i] - x[i]) * t for i in range(3)])

def bousai_luma(c):
    r, g, b = bousai_rgb(c)
    return 0.299 * r + 0.587 * g + 0.114 * b

def bousai_on(c):
    """Readable text colour (black or white) on background c."""
    return "#000000" if bousai_luma(c) > 140 else "#ffffff"

# Seismic intensity scale. Keys are normalised JMA labels.
BOUSAI_INTENSITY_ORDER = ["0", "1", "2", "3", "4", "5-", "5+", "6-", "6+", "7"]

BOUSAI_INTENSITY_PALETTES = {
    # JMA-like ramp tuned for LEDs.
    "normal": ["#5a6070", "#8899aa", "#3d8bff", "#22c39a", "#f5e15b", "#ffb020", "#ff7a00", "#ff2e2e", "#c8102e", "#c03cff"],
    # Okabe-Ito based: blue/yellow/orange/purple axis plus a luminance ramp, no red-green pairs.
    "protan": ["#5a6070", "#8899aa", "#56b4e9", "#0072b2", "#f0e442", "#e69f00", "#d55e00", "#cc79a7", "#a0307a", "#ffffff"],
    # Red/cyan axis plus luminance, no blue-yellow pairs.
    "tritan": ["#5a6070", "#8899aa", "#4dd0e1", "#00897b", "#ffcdd2", "#ff8a80", "#ff5252", "#d50000", "#8b0000", "#ffffff"],
    "mono": ["#3a3a3a", "#555555", "#707070", "#8a8a8a", "#a3a3a3", "#bcbcbc", "#cfcfcf", "#e0e0e0", "#efefef", "#ffffff"],
}

# Severity scale shared by warnings, tsunami, volcano and alerts:
# 0 none, 1 info/forecast, 2 advisory (Lv2), 3 warning (Lv3), 4 urgent warning (Lv4), 5 emergency (Lv5).
BOUSAI_SEVERITY_PALETTES = {
    "normal": ["#5a6070", "#3d8bff", "#f2e700", "#ff2800", "#c040c0", "#ff40ff"],
    "protan": ["#5a6070", "#56b4e9", "#f0e442", "#e69f00", "#cc79a7", "#ffffff"],
    "tritan": ["#5a6070", "#4dd0e1", "#ffcdd2", "#ff5252", "#d50000", "#ffffff"],
    "mono": ["#555555", "#8a8a8a", "#a3a3a3", "#c8c8c8", "#e6e6e6", "#ffffff"],
}

BOUSAI_SEVERITY_EN = ["None", "Info", "Advisory", "Warning", "Urgent Warning", "Emergency Warning"]

BOUSAI_FONTS = {
    # text_size: (body font, line height, big font for numbers)
    "small": ("CG-pixel-3x5-mono", 6, "tb-8"),
    "standard": ("tom-thumb", 7, "6x13"),
    "large": ("tb-8", 9, "6x13"),
    "xlarge": ("6x10", 11, "10x20"),
}

def bousai_ui(config):
    """Resolve accessibility settings into colours and fonts. Returns a dict."""
    theme = config.get("theme") or "dark"
    palette = config.get("palette") or "normal"
    if palette not in BOUSAI_SEVERITY_PALETTES:
        palette = "normal"
    contrast = config.get("contrast") or "normal"
    size = config.get("text_size") or "standard"
    if size not in BOUSAI_FONTS:
        size = "standard"
    bold = (config.get("text_weight") or "normal") == "bold"

    if theme == "light":
        bg, fg, muted, faint, panel = "#f4f4f4", "#000000", "#555555", "#c8c8c8", "#dddddd"
        land = -0.3
    else:
        bg, fg, muted, faint, panel = "#000000", "#ffffff", "#9a9a9a", "#3a3a3a", "#141414"
        land = -0.62

    sev = list(BOUSAI_SEVERITY_PALETTES[palette])
    inten = list(BOUSAI_INTENSITY_PALETTES[palette])
    if theme == "light":
        # Pull bright LED colours down so they stay readable on a light background.
        sev = [bousai_mix(c, "#000000", 0.3) for c in sev]
        inten = [bousai_mix(c, "#000000", 0.3) for c in inten]

    if contrast == "low":
        fg = bousai_mix(fg, bg, 0.3)
        muted = bousai_mix(muted, bg, 0.3)
        sev = [bousai_mix(c, bg, 0.35) for c in sev]
        inten = [bousai_mix(c, bg, 0.35) for c in inten]
        land = land - 0.1 if theme != "light" else land + 0.1
    elif contrast == "high":
        muted = bousai_mix(muted, fg, 0.45)
        faint = bousai_mix(faint, fg, 0.3)
        land = land + 0.15 if theme != "light" else land - 0.15

    font, line_h, big = BOUSAI_FONTS[size]
    return {
        "theme": theme,
        "palette": palette,
        "contrast": contrast,
        "size": size,
        "bold": bold,
        "bg": bg,
        "fg": fg,
        "muted": muted,
        "faint": faint,
        "panel": panel,
        "accent": sev[1],
        "sev": sev,
        "intensity": dict(zip(BOUSAI_INTENSITY_ORDER, inten)),
        "land_brightness": land,
        "frame": contrast == "high",
        "font": font,
        "line_h": line_h,
        "big_font": big,
        "small_font": "CG-pixel-3x5-mono" if size in ("small", "standard") else font,
        "delay": 100,
    }

# ---------------------------------------------------------------------------
# Text and layout

def bousai_text(ui, s, color = None, font = None):
    """Text honouring the bold setting."""
    font = font or ui["font"]
    color = color or ui["fg"]
    if not ui["bold"]:
        return render.Text(s, font = font, color = color)
    return render.Stack(children = [
        render.Text(s, font = font, color = color),
        render.Padding(pad = (1, 0, 0, 0), child = render.Text(s, font = font, color = color)),
    ])

def bousai_text_width(ui, s, font = None):
    w = render.Text(s, font = font or ui["font"]).size()[0]
    return w + (1 if ui["bold"] else 0)

def bousai_budget_frames():
    """Frames available for the whole animation (dwell time / 100 ms; 150 when unbounded)."""
    budget = canvas.max_duration_ms()
    if budget <= 0:
        budget = 15000
    return max(1, budget // 100)

def bousai_ticker(ui, s, width, color = None, font = None, frames = None):
    """Scroll text that is wider than `width` within exactly `frames` frames.

    Unlike render.Marquee (fixed 1 px/frame, so long text overruns the dwell time), the ticker
    pauses, scrolls at whatever speed fits the frame budget (never faster than needed), then holds.
    """
    frames = frames or bousai_budget_frames()
    text = bousai_text(ui, s, color, font)
    h = bousai_font_height(ui, font) + 1
    travel = bousai_text_width(ui, s, font) - width
    if travel <= 0 or frames < 2:
        return render.Box(width = width, height = h, child = render.Row(expanded = True, children = [text]))
    lead = min(8, frames // 4)
    tail = min(8, frames // 6)
    moving = max(1, frames - lead - tail)
    children = []
    for i in range(frames):
        step = max(0, i - lead)
        if travel <= moving:
            off = min(travel, step)
        else:
            off = min(travel, (step * travel + moving - 1) // moving)
        children.append(render.Box(width = width, height = h, child = render.Row(expanded = True, children = [render.Padding(pad = (-off, 0, 0, 0), child = text)])))
    return render.Animation(children = children)

def bousai_fit(ui, s, width = None, color = None, font = None, align = "start", frames = None):
    """One line of text; scrolls (bounded to `frames`, default the whole dwell) when wider than width."""
    width = width or canvas.width()
    if bousai_text_width(ui, s, font) <= width:
        return render.Box(width = width, height = bousai_font_height(ui, font) + 1, child = render.Row(main_align = align, expanded = True, children = [bousai_text(ui, s, color, font)]))
    return bousai_ticker(ui, s, width, color, font, frames)

def bousai_font_height(ui, font = None):
    return render.Text("Mg", font = font or ui["font"]).size()[1]

def bousai_header(ui, title, color = None, right = None, frames = None):
    """Title band. color is the band colour (defaults to panel); text picks a readable colour."""
    band = color or ui["panel"]
    text_color = bousai_on(band) if color else ui["fg"]
    h = ui["line_h"]
    width = canvas.width()
    right_w = 0
    children = []
    if right:
        right_w = bousai_text_width(ui, right) + 2
    children.append(render.Padding(pad = (1, 0, 0, 0), child = bousai_fit(ui, title, width = width - right_w - 1, color = text_color, frames = frames)))
    if right:
        children.append(render.Padding(pad = (width - right_w + 1, 0, 0, 0), child = bousai_text(ui, right, text_color)))
    return render.Box(width = width, height = h, color = band, child = render.Stack(children = children))

def bousai_row(ui, item, frames = None):
    """Normalise a row: str or (text, color) become a text line inset 1 px from the left edge
    (like the header title); a prebuilt widget is used as is."""
    if type(item) == "string":
        item = (item, None)
    if type(item) == "tuple" or type(item) == "list":
        line = bousai_fit(ui, item[0], width = canvas.width() - 1, color = item[1], frames = frames)
        return render.Padding(pad = (1, 0, 0, 0), child = line)
    return item

def bousai_hold_frames(pages, min_ms = 2500):
    """Frames per page when `pages` pages share the dwell time (at least min_ms each)."""
    return max(min_ms // 100, bousai_budget_frames() // max(1, pages))

def bousai_hold(widget, frames):
    """Keep widget on screen for at least `frames` frames (marquees keep scrolling)."""
    return render.Stack(children = [widget, render.Animation(children = [render.Box(width = 1, height = 1)] * max(1, frames))])

def bousai_pages(ui, header, rows, footer = None):
    """Paginate rows under a header to fit the text size. Returns a widget.

    header: None, a title string, a (title, band_color[, right_text]) tuple, or a prebuilt widget.
    rows: str | (text, color) | widget. Strings/tuples scroll within their page's share of the
    dwell time; prebuilt widgets are used as is (keep their animation within bousai_hold_frames).
    """
    height = canvas.height()
    header_h = ui["line_h"] if header != None else 0
    footer_h = ui["line_h"] if footer != None else 0
    per_page = max(1, (height - header_h - footer_h) // ui["line_h"])
    rows = rows or [("No data", ui["muted"])]
    n_pages = (len(rows) + per_page - 1) // per_page
    frames = bousai_hold_frames(n_pages) if n_pages > 1 else bousai_budget_frames()
    if type(header) == "string":
        header = bousai_header(ui, header, frames = frames)
    elif type(header) == "tuple" or type(header) == "list":
        header = bousai_header(ui, header[0], header[1] if len(header) > 1 else None, header[2] if len(header) > 2 else None, frames = frames)
    rows = [bousai_row(ui, r, frames) for r in rows]
    pages = []
    for i in range(0, len(rows), per_page):
        children = []
        if header != None:
            children.append(header)
        for r in rows[i:i + per_page]:
            children.append(render.Box(width = canvas.width(), height = ui["line_h"], child = r))
        body = render.Box(width = canvas.width(), height = height, child = render.Column(expanded = True, main_align = "start", cross_align = "start", children = children))
        if footer != None:
            body = render.Stack(children = [body, render.Padding(pad = (0, height - footer_h, 0, 0), child = footer)])
        pages.append(body)
    if len(pages) == 1:
        return pages[0]
    return render.Sequence(children = [bousai_hold(p, frames) for p in pages])

def bousai_root(ui, child):
    return render.Root(delay = ui["delay"], child = render.Box(width = canvas.width(), height = canvas.height(), color = ui["bg"], child = child))

def bousai_message(ui, title, lines, color = None):
    """Full-screen notice (errors, 'no data', setup hints)."""
    return bousai_root(ui, bousai_pages(ui, (title, color), [(l, ui["muted"]) for l in lines]))

def bousai_badge(ui, label, color, width = None, font = None):
    """Coloured box with a centred label (colour is never the only cue)."""
    font = font or ui["font"]
    w = width or (bousai_text_width(ui, label, font) + 3)
    h = bousai_font_height(ui, font) + 2
    return render.Box(width = w, height = h, color = color, child = bousai_text(ui, label, bousai_on(color), font))

def bousai_blink(ui, widget, width, height, on_frames = 6, off_frames = 3):
    """Blinking emphasis; kept static in low-contrast mode to avoid stimulation."""
    if ui["contrast"] == "low":
        return widget
    return render.Animation(children = [widget] * on_frames + [render.Box(width = width, height = height)] * off_frames)

# ---------------------------------------------------------------------------
# Severity and seismic intensity

def bousai_sev_color(ui, level):
    return ui["sev"][max(0, min(5, level))]

def bousai_intensity_norm(v):
    """Normalise JMA / P2PQuake / EEW intensity notations to '0'..'7', '5-', '5+', '6-', '6+'. Unknown -> None."""
    if v == None:
        return None
    s = str(v).strip()
    table = {
        "5弱": "5-",
        "5強": "5+",
        "6弱": "6-",
        "6強": "6+",
        "5-": "5-",
        "5+": "5+",
        "6-": "6-",
        "6+": "6+",
        "5L": "5-",
        "5U": "5+",
        "6L": "6-",
        "6U": "6+",
        "10": "1",
        "20": "2",
        "30": "3",
        "40": "4",
        "45": "5-",
        "46": "5-",
        "50": "5+",
        "55": "6-",
        "60": "6+",
        "70": "7",
    }
    if s in table:
        return table[s]
    if s in BOUSAI_INTENSITY_ORDER:
        return s
    if s.startswith("震度"):
        return bousai_intensity_norm(s[2:])
    return None

def bousai_intensity_rank(label):
    """Index in BOUSAI_INTENSITY_ORDER, -1 for unknown."""
    if label in BOUSAI_INTENSITY_ORDER:
        return BOUSAI_INTENSITY_ORDER.index(label)
    return -1

def bousai_intensity_color(ui, label):
    return ui["intensity"].get(label, ui["muted"])

def bousai_intensity_from_value(x):
    if x < 0.5:
        return "0"
    if x < 1.5:
        return "1"
    if x < 2.5:
        return "2"
    if x < 3.5:
        return "3"
    if x < 4.5:
        return "4"
    if x < 5.0:
        return "5-"
    if x < 5.5:
        return "5+"
    if x < 6.0:
        return "6-"
    if x < 6.5:
        return "6+"
    return "7"

# ---------------------------------------------------------------------------
# Time

def bousai_now():
    return time.now().in_location(BOUSAI_JST)

def bousai_parse_time(s):
    """Parse JMA / P2PQuake / Wolfx / NIED timestamps (JST when no offset). Returns None if unparseable."""
    if not s:
        return None
    s = str(s).strip()
    if "T" in s and len(s) >= 19:
        if s.endswith("Z") or "+" in s[10:] or s[-6] == "-":
            return time.parse_time(s)
        return time.parse_time(s[:19], format = "2006-01-02T15:04:05", location = BOUSAI_JST)
    if len(s) == 14 and s.isdigit():
        return time.parse_time(s, format = "20060102150405", location = BOUSAI_JST)
    if len(s) >= 19 and s[4] == "/":
        return time.parse_time(s[:19], format = "2006/01/02 15:04:05", location = BOUSAI_JST)
    if len(s) == 16 and s[4] == "/":
        return time.parse_time(s, format = "2006/01/02 15:04", location = BOUSAI_JST)
    if len(s) >= 19 and s[4] == "-":
        return time.parse_time(s[:19], format = "2006-01-02 15:04:05", location = BOUSAI_JST)
    return None

def bousai_tz(config):
    loc = bousai_location(config)
    return loc["tz"]

def bousai_hhmm(t, tz = BOUSAI_JST):
    return t.in_location(tz).format("15:04") if t else "--:--"

def bousai_mdhm(t, tz = BOUSAI_JST):
    return t.in_location(tz).format("1/2 15:04") if t else "--"

def bousai_ago(t, now = None):
    """Compact relative age: 45s, 12m, 3h, 2d."""
    if not t:
        return "?"
    now = now or time.now()
    secs = int((now - t).seconds)
    if secs < 0:
        secs = 0
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm" % (secs // 60)
    if secs < 86400 * 2:
        return "%dh" % (secs // 3600)
    return "%dd" % (secs // 86400)

def bousai_fixed(x, digits = 1):
    """Format a number with exactly `digits` decimals (Starlark's % lacks precision)."""
    m = int(math.pow(10, digits))
    n = int(math.round(abs(float(x)) * m))
    sign = "-" if x < 0 and n != 0 else ""
    if digits <= 0:
        return sign + str(n)
    frac = str(n % m)
    return "%s%d.%s" % (sign, n // m, "0" * (digits - len(frac)) + frac)

# ---------------------------------------------------------------------------
# Geo

def bousai_distance_km(lat1, lon1, lat2, lon2):
    r = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = p2 - p1
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2) * math.sin(dp / 2) + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) * math.sin(dl / 2)
    return 2 * r * math.atan2(math.sqrt(a), math.sqrt(1 - a))

def bousai_bearing_name(lat1, lon1, lat2, lon2):
    """16-point compass direction from point 1 to point 2."""
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    deg = (math.degrees(math.atan2(y, x)) + 360.0) % 360.0
    names = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    return names[int((deg + 11.25) // 22.5) % 16]

# ---------------------------------------------------------------------------
# Location -> JMA areas

def bousai_location(config):
    """Configured location: {lat, lon, label, tz}. Coordinates rounded to 0.001 deg (~100 m)."""
    raw = config.get("location") or BOUSAI_DEFAULT_LOCATION
    loc = json.decode(raw, default = None) or json.decode(BOUSAI_DEFAULT_LOCATION)
    lat = float(loc.get("lat", "35.6812"))
    lon = float(loc.get("lng", "139.7671"))
    return {
        "lat": math.round(lat * 1000) / 1000.0,
        "lon": math.round(lon * 1000) / 1000.0,
        "label": loc.get("locality") or loc.get("description") or "",
        "tz": loc.get("timezone") or BOUSAI_JST,
    }

def bousai_area_table():
    """JMA area.json (centers/offices/class10s/class15s/class20s with enName). Cached for a day."""
    return bousai_get_json(BOUSAI_AREA_JSON, ttl = 86400)

def bousai_in_ring(lon, lat, ring):
    """Even-odd ray casting; ring is [[lon, lat], ...]."""
    inside = False
    j = len(ring) - 1
    for i in range(len(ring)):
        xi, yi = ring[i][0], ring[i][1]
        xj, yj = ring[j][0], ring[j][1]
        if (yi > lat) != (yj > lat) and lon < (xj - xi) * (lat - yi) / (yj - yi) + xi:
            inside = not inside
        j = i
    return inside

def bousai_in_geometry(lon, lat, geometry):
    """Point in a GeoJSON Polygon / MultiPolygon by even-odd parity over every ring.

    JMA's class20 files store separate islands as extra rings of one Polygon, so rings
    cannot be read as outer + holes; parity handles both islands and real holes.
    """
    polys = [geometry["coordinates"]] if geometry["type"] == "Polygon" else geometry["coordinates"]
    hits = 0
    for poly in polys:
        for ring in poly:
            if bousai_in_ring(lon, lat, ring):
                hits += 1
    return hits % 2 == 1

def bousai_locate_class20(lat, lon):
    """Municipality (class20) containing lat/lon, the way JMA's own pages do it.

    Bounding boxes from class20relm.json pick candidates; their simplified polygons decide.
    A point in no polygon (coast, small islands) takes the nearest box centre within ~25 km.
    Only JMA is contacted, and only with area codes.
    """
    if lat < 20.0 or lat > 46.5 or lon < 122.0 or lon > 154.5:
        return None
    relm = bousai_get_json(BOUSAI_CLASS20_BOXES, ttl = 86400)
    if relm == None:
        return None
    candidates = []
    nearest, best = None, 0.25 * 0.25
    for code, box in relm.items():
        sw, ne = box["sw"], box["ne"]
        if sw[0] <= lat and lat <= ne[0] and sw[1] <= lon and lon <= ne[1]:
            candidates.append(((ne[0] - sw[0]) * (ne[1] - sw[1]), code))
        d = ((sw[0] + ne[0]) / 2.0 - lat) * ((sw[0] + ne[0]) / 2.0 - lat) + ((sw[1] + ne[1]) / 2.0 - lon) * ((sw[1] + ne[1]) / 2.0 - lon)
        if d < best:
            nearest, best = code, d
    for _, code in sorted(candidates)[:8]:
        shape = bousai_get_json(BOUSAI_CLASS20_SHAPE % code, ttl = 30 * 86400)
        if shape and shape.get("features") and bousai_in_geometry(lon, lat, shape["features"][0]["geometry"]):
            return code
    return nearest

def bousai_area(config):
    """Resolve the configured location to JMA forecast areas.

    Returns a dict with keys class20, class15, class10, office, center (codes), pref (2-digit),
    and *_en names; or None when the location is outside Japan / cannot be resolved.
    """
    loc = bousai_location(config)
    override = (config.get("area_override") or "").strip()
    cache_key = "bousai_area:%s:%s:%s" % (override, bousai_fixed(loc["lat"], 3), bousai_fixed(loc["lon"], 3))
    cached = cache.get(cache_key)
    if cached:
        return json.decode(cached, default = None)

    table = bousai_area_table()
    if table == None:
        return None
    class20s = table["class20s"]
    if override:
        code = override if override in class20s else None
    else:
        code = bousai_locate_class20(loc["lat"], loc["lon"])
    if code == None or code not in class20s:
        return None

    c20 = class20s[code]
    c15_code = c20["parent"]
    c15 = table["class15s"].get(c15_code, {})
    c10_code = c15.get("parent", "")
    c10 = table["class10s"].get(c10_code, {})
    office_code = c10.get("parent", "")
    office = table["offices"].get(office_code, {})
    area = {
        "class20": code,
        "class15": c15_code,
        "class10": c10_code,
        "office": office_code,
        "center": office.get("parent", ""),
        "pref": code[:2],
        "class20_en": c20.get("enName", code),
        "class15_en": c15.get("enName", ""),
        "class10_en": c10.get("enName", ""),
        "office_en": office.get("enName", ""),
        "lat": loc["lat"],
        "lon": loc["lon"],
    }
    cache.set(cache_key, json.encode(area), ttl_seconds = 7 * 86400)
    return area

def bousai_land_filter(ui, child):
    """Tint a mid-grey land bitmap for the active theme."""
    return filter.Brightness(child = child, change = ui["land_brightness"])

# ---- src/lib/bousai_amedas.star --------------------------------------------

BOUSAI_AMEDAS_BASE = "https://www.jma.go.jp/bosai/amedas/"
BOUSAI_AMEDAS_MAX_KM = 120

# windDirection index 0..16 (1 = NNE ... 16 = N).
BOUSAI_AMEDAS_DIRS = ["Calm", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW", "N"]

def bousai_amedas_table():
    """AMeDAS station table {id: {type, elems, lat, lon, alt, kjName, enName}} (cached a day)."""
    t = bousai_get_json(BOUSAI_AMEDAS_BASE + "const/amedastable.json", ttl = 86400)
    return t if type(t) == "dict" else {}

def bousai_amedas_coords(st):
    """(lat, lon) in decimal degrees of a station-table entry."""
    return st["lat"][0] + st["lat"][1] / 60.0, st["lon"][0] + st["lon"][1] / 60.0

def bousai_amedas_observes(st, what):
    """True when the station's elems string says it observes temp / wind / precip."""
    e = st.get("elems") or "00000000"
    if what == "temp":
        return e[0] == "1"
    if what == "wind":
        return e[2] == "1" and e[3] == "1"
    return e[1] == "1"

def bousai_amedas_nearest(table, lat, lon):
    """Nearest station that observes temperature and wind. Returns (id, distance_km) or (None, None)."""
    k = 0.01745329
    cos_lat = math.cos(lat * k)
    best = None
    best_d = 1.0e9
    for sid in table:
        st = table[sid]
        e = st.get("elems") or "00000000"
        if e[0] != "1" or e[2] != "1" or e[3] != "1":
            continue
        slat = st["lat"][0] + st["lat"][1] / 60.0
        slon = st["lon"][0] + st["lon"][1] / 60.0
        dy = slat - lat
        dx = (slon - lon) * cos_lat
        d = dx * dx + dy * dy
        if d < best_d:
            best_d = d
            best = sid
    if best == None:
        return None, None
    slat, slon = bousai_amedas_coords(table[best])
    return best, bousai_distance_km(lat, lon, slat, slon)

def bousai_amedas_find(table, query):
    """Station id for an id or (English / Japanese) name fragment; None if no match."""
    q = (query or "").strip()
    if not q:
        return None
    if q in table:
        return q
    low = q.lower()
    exact, prefix, contains = [], [], []
    for sid in sorted(table.keys()):
        st = table[sid]
        en = (st.get("enName") or "").lower()
        jp = st.get("kjName") or ""
        if en == low or jp == q:
            exact.append(sid)
        elif en.startswith(low) or jp.startswith(q):
            prefix.append(sid)
        elif low in en or q in jp:
            contains.append(sid)
    for group in [exact, prefix, contains]:
        if group:
            for sid in group:
                if bousai_amedas_observes(table[sid], "temp"):
                    return sid
            return group[0]
    return None

def bousai_amedas_val(pair):
    """[value, quality] -> value, or None when missing / not observed (quality >= 5)."""
    if type(pair) != "list" or len(pair) < 2 or pair[0] == None:
        return None
    if pair[1] != None and pair[1] >= 5:
        return None
    return pair[0]

def bousai_amedas_series(station, hours = 6):
    """Last `hours` of 10-minute observations for a station.

    Returns None if the feed is unavailable, else a list of {time, e} oldest first, where e is
    the raw AMeDAS entry ({element: [value, quality], ...}).
    """
    lt = bousai_get_bytes(BOUSAI_AMEDAS_BASE + "data/latest_time.txt", ttl = 60)
    latest = bousai_parse_time((lt or "").strip())
    if latest == None:
        return None
    merged = {}
    for k in range(hours // 3 + 1):
        b = latest - time.parse_duration("%dh" % (3 * k))
        h3 = (b.hour // 3) * 3
        name = "%s_%s" % (b.format("20060102"), ("0%d" % h3) if h3 < 10 else "%d" % h3)
        d = bousai_get_json(BOUSAI_AMEDAS_BASE + "data/point/%s/%s.json" % (station, name), ttl = 120 if k == 0 else 3600)
        if type(d) == "dict":
            merged.update(d)
    if not merged:
        return None
    cutoff = latest - time.parse_duration("%dm" % (hours * 60 + 5))
    out = []
    for key in sorted(merged.keys()):
        t = bousai_parse_time(key)
        if t != None and t >= cutoff and t <= latest:
            out.append({"time": t, "e": merged[key]})
    return out

def bousai_amedas_current(series):
    """Newest series entry that carries any real observation, else None."""
    for i in range(len(series) - 1, -1, -1):
        e = series[i]["e"]
        if bousai_amedas_val(e.get("temp")) != None or bousai_amedas_val(e.get("wind")) != None or bousai_amedas_val(e.get("precipitation10m")) != None:
            return series[i]
    return None

def bousai_amedas_dir(index):
    """16-point English wind direction name from the AMeDAS direction index (None if unknown)."""
    if index == None:
        return None
    i = int(index)
    if i < 0 or i >= len(BOUSAI_AMEDAS_DIRS):
        return None
    return BOUSAI_AMEDAS_DIRS[i]

def bousai_amedas_station(config_station, lat, lon):
    """Resolve station: text override (id or name) else the nearest suitable one.

    Returns (id, table entry, distance_km) or (None, None, None). A station that cannot be
    matched, or no station within BOUSAI_AMEDAS_MAX_KM, gives None.
    """
    table = bousai_amedas_table()
    if not table:
        return None, None, None
    sid = None
    dist = None
    if config_station and config_station.strip():
        sid = bousai_amedas_find(table, config_station)
        if sid == None:
            return None, None, None
        slat, slon = bousai_amedas_coords(table[sid])
        dist = bousai_distance_km(lat, lon, slat, slon)
    else:
        sid, dist = bousai_amedas_nearest(table, lat, lon)
        if sid == None or dist > BOUSAI_AMEDAS_MAX_KM:
            return None, None, None
    return sid, table[sid], dist

def bousai_amedas_latest(lat, lon, station = None):
    """Latest AMeDAS observation for the nearest suitable station (or a station id / name).

    Returns None when no station is within 120 km, the station cannot be found, or the feed is
    unavailable. Otherwise a dict (None for elements the station does not observe):
      station_id, station_en, distance_km (float), time (Pixlet time of the observation),
      temp (C), humidity (%), precip_10m / precip_1h / precip_24h (mm),
      wind_ms (m/s), wind_dir_en (16-point name or 'Calm'), snow_cm (snow depth).
    """
    sid, st, dist = bousai_amedas_station(station, lat, lon)
    if sid == None:
        return None
    series = bousai_amedas_series(sid, 3)
    cur = bousai_amedas_current(series) if series else None
    if cur == None:
        return None
    e = cur["e"]
    return {
        "station_id": sid,
        "station_en": st.get("enName") or sid,
        "distance_km": dist,
        "time": cur["time"],
        "temp": bousai_amedas_val(e.get("temp")),
        "humidity": bousai_amedas_val(e.get("humidity")),
        "precip_10m": bousai_amedas_val(e.get("precipitation10m")),
        "precip_1h": bousai_amedas_val(e.get("precipitation1h")),
        "precip_24h": bousai_amedas_val(e.get("precipitation24h")),
        "wind_ms": bousai_amedas_val(e.get("wind")),
        "wind_dir_en": bousai_amedas_dir(bousai_amedas_val(e.get("windDirection"))),
        "snow_cm": bousai_amedas_val(e.get("snow")),
    }

# ---------------------------------------------------------------------------
# Units

def bousai_amedas_temp(c, unit):
    """Temperature text with one decimal, e.g. '23.5'."""
    if c == None:
        return "--"
    v = c * 9.0 / 5.0 + 32 if unit == "F" else c
    return bousai_fixed(v, 1)

def bousai_amedas_wind(ms, unit):
    """Wind speed number text in m/s, km/h, kt or mph."""
    if ms == None:
        return "--"
    if unit == "kmh":
        return bousai_fixed(ms * 3.6, 0)
    if unit == "kt":
        return bousai_fixed(ms * 1.94384, 0)
    if unit == "mph":
        return bousai_fixed(ms * 2.23694, 0)
    return bousai_fixed(ms, 1)

def bousai_amedas_wind_unit(unit):
    return {"kmh": "km/h", "kt": "kt", "mph": "mph"}.get(unit, "m/s")

def bousai_amedas_precip(mm, unit):
    """Precipitation / snowfall text (mm or inches)."""
    if mm == None:
        return "--"
    if unit == "in":
        return bousai_fixed(mm / 25.4, 2)
    return bousai_fixed(mm, 1)

def bousai_amedas_depth(cm, unit):
    """Snow depth text (cm or inches)."""
    if cm == None:
        return "--"
    if unit == "in":
        return bousai_fixed(cm / 2.54, 1)
    return "%d" % int(cm + 0.5)

# ---------------------------------------------------------------------------
# Widgets

def bousai_amedas_values(series, key):
    """Series values for an element, None where missing."""
    return [bousai_amedas_val(s["e"].get(key)) for s in series]

def bousai_amedas_spark(ui, values, width, height, color, fill = False, lo = None, hi = None):
    """Line chart of values (None skipped). Returns None when fewer than 2 points."""
    pts = [(i, v) for i, v in enumerate(values) if v != None]
    if len(pts) < 2:
        return None
    ys = [p[1] for p in pts]
    ymin = lo if lo != None else min(ys)
    ymax = hi if hi != None else max(ys)
    if ymax - ymin < 1.0:
        mid = (ymax + ymin) / 2.0
        ymin = mid - 0.5
        ymax = mid + 0.5
    return render.Plot(
        data = pts,
        width = width,
        height = height,
        color = color,
        fill = fill,
        fill_color = bousai_mix(color, ui["bg"], 0.55),
        x_lim = (0, max(1, len(values) - 1)),
        y_lim = (ymin, ymax),
    )

def bousai_amedas_clip(ui, text, width):
    """Trim text until it fits width (pages must not contain scrolling marquees: a marquee
    stretches its page's duration inside a Sequence)."""
    t = text
    for _ in range(len(text)):
        if bousai_text_width(ui, t) <= width:
            break
        t = t[:-1]
    return t

def bousai_amedas_header(ui, title, right = None):
    """Title band whose title is clipped to fit (never scrolls)."""
    avail = canvas.width() - 2
    if right:
        avail -= bousai_text_width(ui, right) + 2
    return bousai_header(ui, bousai_amedas_clip(ui, title, avail), right = right)

def bousai_amedas_pager(ui, header, left, left_w, rows):
    """Pages of header + left widget + right-hand text rows; rows are (text, color)."""
    width = canvas.width()
    body_h = canvas.height() - ui["line_h"]
    cap = max(1, body_h // ui["line_h"])
    right_w = width - left_w - 1
    pages = []
    for i in range(0, max(1, len(rows)), cap):
        chunk = rows[i:i + cap]
        col = render.Column(children = [render.Box(width = right_w, height = ui["line_h"], child = bousai_fit(ui, bousai_amedas_clip(ui, r[0], right_w - 1), width = right_w, color = r[1])) for r in chunk])
        pages.append(render.Column(children = [
            header,
            render.Row(children = [
                render.Box(width = left_w, height = body_h, child = left),
                col,
            ]),
        ]))
    return pages

def bousai_amedas_rotate(pages, key, min_frames = 25):
    """Sequence of pages that each stay on screen at least min_frames (2.5 s by default).

    pages is a list of (widget, weight); a page holds min_frames * weight frames. When all pages
    fit the dwell budget (bousai_budget_frames) they are all shown and the spare time is shared.
    Otherwise a window of consecutive pages that fits is shown, starting at an offset stored in
    the cache under `key` and advanced on every render, so every page appears across renders.
    """
    n = len(pages)
    budget = bousai_budget_frames()
    base = [int(min_frames * p[1]) for p in pages]
    total = 0
    for f in base:
        total += f
    chosen = list(range(n))
    if total > budget and n > 1:
        start = int(cache.get(key) or "0") % n
        chosen = []
        used = 0
        for k in range(n):
            i = (start + k) % n
            if chosen and used + base[i] > budget:
                break
            chosen.append(i)
            used += base[i]
        cache.set(key, str(start + len(chosen)), ttl_seconds = 86400)
        total = used

    # Share spare time, but never stretch a page beyond twice its minimum.
    kids = []
    for i in chosen:
        frames = base[i]
        if total < budget:
            frames = min(base[i] * 2, int(base[i] * budget / total))
        kids.append(bousai_hold(render.Column(expanded = True, main_align = "start", children = [pages[i][0]]), frames))
    return kids[0] if len(kids) == 1 else render.Sequence(children = kids)

# ---- src/apps/bousai_amedas/bousai_amedas.star -----------------------------

def am_hi(ui):
    """Colour for highs / sun / rise (mono palette falls back to full-contrast text)."""
    return ui["fg"] if ui["palette"] == "mono" else ui["sev"][2]

def am_lo(ui):
    """Colour for lows / rain / set (mono palette falls back to full-contrast text)."""
    return ui["fg"] if ui["palette"] == "mono" else ui["sev"][1]

def am_warn(ui):
    return ui["sev"][3]

def am_row_pages(ui, rows):
    """Full-width text rows, as many per page as fit (no header)."""
    cap = max(1, canvas.height() // ui["line_h"])
    pages = []
    for i in range(0, max(1, len(rows)), cap):
        pages.append(render.Column(children = [render.Box(width = canvas.width(), height = ui["line_h"], child = render.Padding(pad = (1, 0, 0, 0), child = bousai_fit(ui, r[0], color = r[1]))) for r in rows[i:i + cap]]))
    return pages

def am_left_panel(ui, series, temp, unit, body_h, max_big_w):
    """Big temperature with a tiny sparkline. Returns (widget, width)."""
    text = bousai_amedas_temp(temp, unit)
    big = ui["big_font"]
    if bousai_text_width(ui, text, big) > max_big_w:
        big = ui["font"]
    tw = bousai_text_width(ui, text, big)
    uw = bousai_text_width(ui, unit, ui["small_font"])
    width = tw + uw + 3
    th = bousai_font_height(ui, big)
    kids = [render.Row(cross_align = "end", children = [
        bousai_text(ui, text, ui["fg"], big),
        bousai_text(ui, unit, ui["muted"], ui["small_font"]),
    ])]
    spark_h = min(9, body_h - th - 2)
    if spark_h >= 5:
        spark = bousai_amedas_spark(ui, bousai_amedas_values(series, "temp"), width - 2, spark_h, am_hi(ui))
        if spark:
            kids.append(render.Box(width = 1, height = 1))
            kids.append(spark)
    return render.Column(cross_align = "center", children = kids), width

def am_pick(ui, width, options):
    """First option that fits in width (the last option is always short enough to fit)."""
    for o in options:
        if bousai_text_width(ui, o) <= width:
            return o
    return bousai_amedas_clip(ui, options[-1], width)

def am_groups(ui, config, cur, units, dist_km, bearing, sid):
    """Observation items grouped per page. An item is (label, short label, value, unit, colour)."""
    e = cur["e"]
    wu = bousai_amedas_wind_unit(units["wind"])
    pu = units["precip"]
    su = "in" if pu == "in" else "cm"
    g = {
        "overview": {"title": "", "items": []},
        "rain": {"title": "Rain " + pu, "items": []},
        "wind": {"title": "Wind " + wu, "items": []},
        "snow": {"title": "Snow " + su, "items": []},
        "info": {"title": "Stn " + sid, "items": []},
    }
    if (bousai_now() - cur["time"]).minutes > 30:
        g["overview"]["items"].append(("Old", "Old", bousai_ago(cur["time"]), "", am_warn(ui)))
    hum = bousai_amedas_val(e.get("humidity"))
    if bousai_bool(config, "el_humidity", True) and hum != None:
        g["overview"]["items"].append(("Hum", "H", "%d" % int(hum + 0.5), "%", ui["fg"]))
    if bousai_bool(config, "el_extremes", True):
        hi = bousai_amedas_val(e.get("maxTemp"))
        lo = bousai_amedas_val(e.get("minTemp"))
        if hi != None:
            g["overview"]["items"].append(("Hi", "H", bousai_amedas_temp(hi, units["temp"]), units["temp"], am_hi(ui)))
        if lo != None:
            g["overview"]["items"].append(("Lo", "L", bousai_amedas_temp(lo, units["temp"]), units["temp"], am_lo(ui)))
    if bousai_bool(config, "el_precip", True):
        for label, short, key in [("10 min", "10m", "precipitation10m"), ("1 hour", "1h", "precipitation1h"), ("24 hours", "24h", "precipitation24h")]:
            v = bousai_amedas_val(e.get(key))
            if v != None:
                g["rain"]["items"].append((label, short, bousai_amedas_precip(v, pu), pu, am_lo(ui) if v > 0 else ui["fg"]))
    if bousai_bool(config, "el_wind", True):
        ws = bousai_amedas_val(e.get("wind"))
        if ws != None:
            d = bousai_amedas_dir(bousai_amedas_val(e.get("windDirection")))
            if d == "Calm" or (ws < 0.3 and d == None):
                g["wind"]["items"].append(("Wind", "Wind", "calm", "", ui["fg"]))
            else:
                g["wind"]["items"].append((d or "Wind", d or "W", bousai_amedas_wind(ws, units["wind"]), wu, ui["fg"]))
        gust = bousai_amedas_val(e.get("gust"))
        if gust != None:
            g["wind"]["items"].append(("Gust", "G", bousai_amedas_wind(gust, units["wind"]), wu, ui["fg"]))
    if bousai_bool(config, "el_snow", True):
        depth = bousai_amedas_val(e.get("snow"))
        if depth != None and depth > 0:
            g["snow"]["items"].append(("Depth", "D", bousai_amedas_depth(depth, pu), su, ui["fg"]))
        new1 = bousai_amedas_val(e.get("snow1h"))
        if new1 != None and new1 > 0:
            g["snow"]["items"].append(("New 1h", "1h", bousai_amedas_depth(new1, pu), su, ui["fg"]))
    if bousai_bool(config, "el_sun", True):
        sun = bousai_amedas_val(e.get("sun1h"))
        if sun != None:
            g["info"]["items"].append(("Sun", "Sun", "%d" % int(sun * 60 + 0.5), "m/h", am_hi(ui)))
    g["info"]["items"].append(("Dist", "Dist", dist_km, "", ui["muted"]))
    g["info"]["items"].append(("Bearing", "Brg", bearing, "", ui["muted"]))
    return g

def am_group_pages(ui, title, items, inline_unit):
    """Header (title carries the unit) + one full-width row per item; spills onto more pages if needed."""
    header = bousai_amedas_header(ui, am_pick(ui, canvas.width() - 3, [title, title.split(" ")[0], "Station"]))
    cap = max(1, (canvas.height() - ui["line_h"]) // ui["line_h"])
    pages = []
    for i in range(0, len(items), cap):
        kids = [header]
        for it in items[i:i + cap]:
            unit = it[3] if inline_unit else ""
            text = am_pick(ui, canvas.width() - 3, ["%s %s%s" % (it[0], it[2], unit), "%s %s%s" % (it[1], it[2], unit)])
            kids.append(render.Box(width = canvas.width(), height = ui["line_h"], child = render.Padding(pad = (1, 0, 0, 0), child = bousai_fit(ui, text, color = it[4]))))
        pages.append(render.Column(children = kids))
    return pages

def am_trend_page(ui, title, unit_label, values, color, lo, hi, top, bottom):
    """Header + gutter labels + chart filling the rest of the screen."""
    body_h = canvas.height() - ui["line_h"]
    gutter = max(bousai_text_width(ui, top), bousai_text_width(ui, bottom)) + 2
    label_col = render.Box(width = gutter, height = body_h, child = render.Column(main_align = "space_between", expanded = True, children = [
        bousai_text(ui, top, ui["muted"]),
        bousai_text(ui, bottom, ui["muted"]),
    ]))
    plot = bousai_amedas_spark(ui, values, canvas.width() - gutter - 1, body_h - 1, color, True, lo, hi)
    chart = render.Box(width = canvas.width() - gutter, height = body_h, child = plot if plot else bousai_fit(ui, "No data", color = ui["muted"]))
    return render.Column(children = [
        bousai_amedas_header(ui, am_pick(ui, canvas.width() - 4 - bousai_text_width(ui, unit_label), [title, title.split(" /")[0]]), right = unit_label),
        render.Row(children = [label_col, chart]),
    ])

def am_trend_pages(ui, config, series, hours, units):
    mode = config.get("trend") or "temp"
    pages = []
    body_h = canvas.height() - ui["line_h"]
    if mode in ("temp", "both"):
        vals = bousai_amedas_values(series, "temp")
        conv = [v * 9.0 / 5.0 + 32 if (v != None and units["temp"] == "F") else v for v in vals]
        have = [v for v in conv if v != None]
        if len(have) >= 2:
            pages.append(am_trend_page(ui, "Temp %dh" % hours, units["temp"], conv, am_hi(ui), None, None, bousai_fixed(max(have), 1), bousai_fixed(min(have), 1)))
    if mode in ("rain", "both"):
        vals = bousai_amedas_values(series, "precipitation10m")
        raw = [v for v in vals if v != None]
        conv = [v / 25.4 if (v != None and units["precip"] == "in") else v for v in vals]
        if len(raw) >= 2:
            if max(raw) <= 0:
                pages.append(render.Column(children = [
                    bousai_amedas_header(ui, "Rain %dh" % hours, right = units["precip"]),
                    render.Box(width = canvas.width(), height = body_h, child = bousai_text(ui, "No rain", ui["fg"])),
                ]))
            else:
                pages.append(am_trend_page(ui, "Rain %dh /10m" % hours, units["precip"], conv, am_lo(ui), 0.0, max([v for v in conv if v != None]), bousai_amedas_precip(max(raw), units["precip"]), "0"))
    return pages

def main(config):
    ui = bousai_ui(config)
    loc = bousai_location(config)
    station = (config.get("station") or "").strip()
    sid, st, dist = bousai_amedas_station(station, loc["lat"], loc["lon"])
    if sid == None:
        if station:
            return bousai_message(ui, "AMeDAS", ["No station matches '%s'." % station, "Use a station ID or English name."])
        return bousai_message(ui, "AMeDAS", ["No AMeDAS station within %d km." % BOUSAI_AMEDAS_MAX_KM, "Pick a location in Japan or enter a station."])
    hours = int(config.get("trend_hours") or "6")
    series = bousai_amedas_series(sid, hours)
    cur = bousai_amedas_current(series) if series else None
    if cur == None:
        return bousai_message(ui, "AMeDAS", ["Observations for %s are unavailable right now." % (st.get("enName") or sid)])

    units = {
        "temp": "F" if config.get("temp_unit") == "F" else "C",
        "wind": config.get("wind_unit") or "ms",
        "precip": "in" if config.get("precip_unit") == "in" else "mm",
    }
    slat, slon = bousai_amedas_coords(st)
    dist_km = "%dkm" % int(dist + 0.5)
    bearing = bousai_bearing_name(loc["lat"], loc["lon"], slat, slon)
    body_h = canvas.height() - ui["line_h"]
    wide = ui["size"] in ("large", "xlarge")
    left, left_w = am_left_panel(ui, series, bousai_amedas_val(cur["e"].get("temp")), units["temp"], body_h, 62 if wide else 30)
    header = bousai_amedas_header(ui, st.get("enName") or sid, right = bousai_hhmm(cur["time"], loc["tz"]))
    groups = am_groups(ui, config, cur, units, dist_km, bearing, sid)
    if wide:
        # Large text: temperature page, then every value as one full-width row with its unit.
        pages = [render.Column(children = [header, render.Box(width = canvas.width(), height = body_h, child = left)])]
        flat = []
        for g in ["overview", "rain", "wind", "snow", "info"]:
            for it in groups[g]["items"]:
                flat.append((am_pick(ui, canvas.width() - 3, [
                    "%s %s%s" % (it[0], it[2], it[3]),
                    "%s %s%s" % (it[1], it[2], it[3]),
                    "%s%s" % (it[2], it[3]),
                ]), it[4]))
        flat.append(("ID " + sid, ui["muted"]))
        pages.extend(am_row_pages(ui, flat))
    else:
        right_w = canvas.width() - left_w - 2
        rows = []
        for it in groups["overview"]["items"]:
            opts = ["%s %s%s" % (it[0], it[2], it[3]), "%s %s%s" % (it[1], it[2], it[3])]
            if it[3] in ("C", "F"):
                opts = [opts[0], "%s %s" % (it[0], it[2]), opts[1], "%s %s" % (it[1], it[2])]
            rows.append((am_pick(ui, right_w, opts), it[4]))
        pages = bousai_amedas_pager(ui, header, left, left_w, rows)
        for g in ["rain", "wind", "snow", "info"]:
            if groups[g]["items"]:
                pages.extend(am_group_pages(ui, groups[g]["title"], groups[g]["items"], g == "info"))
    pages.extend(am_trend_pages(ui, config, series, hours, units))

    return bousai_root(ui, bousai_amedas_rotate([(p, 1.0) for p in pages], "bousai_amedas_rot:%s:%s" % (sid, ui["size"])))

def get_schema():
    return bousai_schema([
        schema.Location(id = "location", name = "Location", desc = "Your location. The nearest AMeDAS station that measures temperature and wind is used.", icon = "locationDot"),
        schema.Text(id = "station", name = "Station (optional)", desc = "AMeDAS station ID (e.g. 44132) or English name (e.g. Sapporo). Overrides the nearest station.", icon = "towerBroadcast", default = ""),
        schema.Dropdown(id = "temp_unit", name = "Temperature unit", desc = "Celsius or Fahrenheit.", icon = "temperatureHalf", default = "C", options = [
            schema.Option(display = "Celsius (°C)", value = "C"),
            schema.Option(display = "Fahrenheit (°F)", value = "F"),
        ]),
        schema.Dropdown(id = "wind_unit", name = "Wind speed unit", desc = "Unit for wind speed and gusts.", icon = "wind", default = "ms", options = [
            schema.Option(display = "m/s", value = "ms"),
            schema.Option(display = "km/h", value = "kmh"),
            schema.Option(display = "knots", value = "kt"),
            schema.Option(display = "mph", value = "mph"),
        ]),
        schema.Dropdown(id = "precip_unit", name = "Rain and snow unit", desc = "Millimetres / centimetres or inches.", icon = "droplet", default = "mm", options = [
            schema.Option(display = "mm / cm", value = "mm"),
            schema.Option(display = "inches", value = "in"),
        ]),
        schema.Toggle(id = "el_humidity", name = "Humidity", desc = "Show relative humidity.", icon = "droplet", default = True),
        schema.Toggle(id = "el_precip", name = "Precipitation", desc = "Show rain for the last 10 minutes, 1 hour and 24 hours.", icon = "cloudRain", default = True),
        schema.Toggle(id = "el_wind", name = "Wind and gusts", desc = "Show wind direction, speed and gusts.", icon = "wind", default = True),
        schema.Toggle(id = "el_snow", name = "Snow", desc = "Show snow depth and snowfall when there is any.", icon = "snowflake", default = True),
        schema.Toggle(id = "el_sun", name = "Sunshine", desc = "Show sunshine minutes in the last hour.", icon = "sun", default = True),
        schema.Toggle(id = "el_extremes", name = "Today's high and low", desc = "Show the highest and lowest temperature so far today.", icon = "temperatureHalf", default = True),
        schema.Dropdown(id = "trend", name = "Trend chart", desc = "Chart of the recent observations.", icon = "chartLine", default = "temp", options = [
            schema.Option(display = "Temperature", value = "temp"),
            schema.Option(display = "Rain", value = "rain"),
            schema.Option(display = "Both", value = "both"),
            schema.Option(display = "None", value = "off"),
        ]),
        schema.Dropdown(id = "trend_hours", name = "Trend length", desc = "How many hours the trend chart covers.", icon = "clock", default = "6", options = [
            schema.Option(display = "3 hours", value = "3"),
            schema.Option(display = "6 hours", value = "6"),
            schema.Option(display = "12 hours", value = "12"),
        ]),
    ], location = False)
